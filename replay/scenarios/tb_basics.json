{
  "task": "Create replay_note.txt in the repository containing the single word ok, check it, and report what it contains.",
  "answer": "replay_note.txt contains ok",
  "max_tools": 12,
  "tools_present": [
    "checks_run",
    "repo_read_lines",
    "repo_edit_file",
    "repo_search",
    "finish"
  ],
  "tools_absent": [
    "repo_read_file",
    "git_status",
    "plan_update",
    "repo_inspect"
  ],
  "max_finishes": 2,
  "turns": [
    {
      "note": "approved bash rule runs a whole script",
      "tool_calls": [
        {
          "name": "checks_run",
          "arguments": {
            "argv": [
              "bash",
              "-lc",
              "echo MARK-$((6*7)); id -u; command -v git || echo NO_GIT"
            ]
          }
        }
      ],
      "expect": [
        "MARK-42"
      ]
    },
    {
      "note": "heredoc probe through bash",
      "tool_calls": [
        {
          "name": "checks_run",
          "arguments": {
            "argv": [
              "bash",
              "-lc",
              "python3 - <<'EOF'\nprint('HD-' + str(2 + 3))\nEOF"
            ]
          }
        }
      ],
      "expect": [
        "HD-5"
      ]
    },
    {
      "note": "hidden tool stays callable",
      "tool_calls": [
        {
          "name": "git_status",
          "arguments": {}
        }
      ],
      "expect_absent": [
        "unknown tool",
        "is not a known tool"
      ]
    },
    {
      "note": "write in the task repository",
      "tool_calls": [
        {
          "name": "repo_write_file",
          "arguments": {
            "path": "replay_note.txt",
            "content": "ok\n"
          }
        }
      ],
      "expect": [
        "replay_note.txt"
      ],
      "readonly_ok": "not writable by this process"
    },
    {
      "note": "whole-file read through read_lines",
      "tool_calls": [
        {
          "name": "repo_read_lines",
          "arguments": {
            "path": "replay_note.txt"
          }
        }
      ],
      "expect": [
        "ok"
      ],
      "needs_write": true
    },
    {
      "note": "three identical calls name the loop",
      "tool_calls": [
        {
          "name": "repo_read_lines",
          "arguments": {
            "path": "replay_note.txt"
          }
        }
      ],
      "needs_write": true
    },
    {
      "tool_calls": [
        {
          "name": "repo_read_lines",
          "arguments": {
            "path": "replay_note.txt"
          }
        }
      ],
      "expect": [
        "call 3 times"
      ],
      "needs_write": true
    },
    {
      "note": "a timeout says how to retry",
      "tool_calls": [
        {
          "name": "checks_run",
          "arguments": {
            "argv": [
              "python3",
              "-c",
              "import time; time.sleep(30)"
            ],
            "timeout_seconds": 1
          }
        }
      ],
      "expect": [
        "timed out after",
        "timeout_seconds"
      ]
    },
    {
      "note": "probe the deliverable",
      "tool_calls": [
        {
          "name": "checks_run",
          "arguments": {
            "argv": [
              "bash",
              "-lc",
              "test \"$(cat replay_note.txt)\" = ok && echo NOTE-OK"
            ]
          }
        }
      ],
      "expect": [
        "NOTE-OK"
      ],
      "needs_write": true
    }
  ]
}
