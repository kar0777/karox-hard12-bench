     return canonical(path).parts[: len(parent)] == parent
 
 
+def _home_directory():
+    """Prefer the startup environment over the passwd database.
+
+    Managed deployments often create an application user whose passwd home is
+    absent or not writable, while setting HOME to the writable application
+    data directory.
+    """
+    candidates = (
+        (os.environ.get("USERPROFILE"), os.environ.get("HOME"))
+        if os.name == "nt"
+        else (os.environ.get("HOME"),)
+    )
+    if os.name != "nt":
+        try:
+            import pwd
+
+            candidates += (
+                getattr(pwd.getpwuid(os.getuid()), "pw_dir", None),
+            )
+        except (KeyError, OSError):
+            pass
+    for value in candidates:
+        if value and Path(value).is_absolute():
+            return Path(value)
+    return None
+
+
+def _unavailable(path, exc):
+    return RuntimeError(
+        "DEPENDENCY_STATE_ROOT_UNAVAILABLE: cannot use dependency state "
+        f"storage at {path}: {exc}. Set QWENPAW_DEPENDENCY_STATE_DIR to a "
+        "writable absolute path.",
+    )
+
+
