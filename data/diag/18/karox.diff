+@pytest.mark.asyncio
+async def test_on_message_send_failure_after_enqueuing_task_keeps_task_failed():
+    """The consumer is the only writer when the executor fails right after enqueuing its Task.
+
+    Regression: the producer used to persist the FAILED fallback itself, so its
+    insert raced the consumer's save of the Task the executor had just
+    enqueued. One of the two inserts failed, leaving the task SUBMITTED or
+    replacing the agent's Task with the fallback.
+    """
+    pytest.importorskip('sqlalchemy')
+    pytest.importorskip('aiosqlite')
+    from a2a.server.tasks.database_task_store import DatabaseTaskStore
+    from sqlalchemy.ext.asyncio import create_async_engine
+
+    engine = create_async_engine(
+        'sqlite+aiosqlite:///file:failafterenqueuev2?mode=memory&cache=shared&uri=true'
+    )
+    task_store = DatabaseTaskStore(engine=engine)
+    executor = FailsAfterEnqueuingTaskAgentExecutor()
+    request_handler = DefaultRequestHandlerV2(
+        agent_executor=executor,
+        task_store=task_store,
+        agent_card=create_default_agent_card(),
+    )
+    context = create_server_call_context()
+
+    try:
+        # Repeat: the race window is about one store write.
+        for i in range(10):
+            params = SendMessageRequest(
+                message=Message(
+                    role=Role.ROLE_USER,
+                    message_id=f'msg_failure_after_enqueuing_task_{i}',
+                    parts=[Part(text='Hi')],
+                )
+            )
+            with pytest.raises(RuntimeError) as exc_info:
+                await request_handler.on_message_send(params, context)
+
+            assert exc_info.value is executor.exception
+            assert executor.task_id is not None
+            stored_task = await task_store.get(executor.task_id, context)
+            assert stored_task is not None
+            assert stored_task.status.state == TaskState.TASK_STATE_FAILED
+            assert stored_task.metadata['agent_key'] == 'kept'
+    finally:
+        await request_handler.aclose()
+        await engine.dispose()
+
+
 @pytest.mark.asyncio
 async def test_on_message_send_stream_task_id_mismatch():
     mock_task_store = AsyncMock(spec=TaskStore)
