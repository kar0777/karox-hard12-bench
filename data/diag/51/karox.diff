+def _decode_ansi_c_quoted(value: str) -> str:
+    """Decode the escape sequences of the body of a Bash ``$'...'`` string."""
+    result: list[str] = []
+    i = 0
+    while i < len(value):
+        char = value[i]
+        if char != "\\" or i + 1 == len(value):
+            result.append(char)
+            i += 1
+            continue
+        escaped = value[i + 1]
+        if escaped in _ANSI_C_ESCAPES:
+            result.append(_ANSI_C_ESCAPES[escaped])
+            i += 2
+        elif escaped in _OCTAL_DIGITS:
+            end = i + 2
+            while end < min(i + 4, len(value)) and value[end] in _OCTAL_DIGITS:
+                end += 1
+            result.append(chr(int(value[i + 1 : end], 8)))
+            i = end
+        elif escaped in _ANSI_C_HEX_DIGITS:
+            end = i + 2
+            limit = min(i + 2 + _ANSI_C_HEX_DIGITS[escaped], len(value))
+            while end < limit and value[end] in string.hexdigits:
+                end += 1
+            if end == i + 2:
+                result.append(value[i:end])
+            else:
+                code_point = int(value[i + 2 : end], 16)
+                if code_point > 0x10FFFF:
+                    result.append(value[i:end])
+                else:
+                    result.append(chr(code_point))
+            i = end
+        elif escaped == "c" and i + 2 < len(value):
+            control = value[i + 2]
+            result.append(
+                "\x7f" if control == "?" else chr(ord(control.upper()) & 0x1F)
+            )
+            i += 3
+        else:
+            # Not an ANSI-C escape: Bash keeps the backslash and the character.
+            result.append(value[i : i + 2])
+            i += 2
+    return "".join(result)
+
