+def _decode_ansi_c_string(value: str) -> str:
+    """Decode the contents of a Bash ANSI-C quoted string."""
+    result: list[str] = []
+    i = 0
+    while i < len(value):
+        if value[i] != "\\":
+            result.append(value[i])
+            i += 1
+            continue
