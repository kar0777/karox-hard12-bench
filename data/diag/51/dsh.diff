+def _decode_ansi_c_escape(value: str, index: int) -> tuple[str, int]:
+    """Decode one escape sequence and return it with the next index."""
+    escape = value[index]
+    if escape in _ANSI_C_ESCAPES:
+        return _ANSI_C_ESCAPES[escape], index + 1
+    if escape in _OCTAL_DIGITS:
+        end = index + 1
+        while end < len(value) and end < index + 3 and value[end] in _OCTAL_DIGITS:
+            end += 1
+        return chr(int(value[index:end], 8) & 0xFF), end
+    if escape in ("x", "u", "U"):
+        max_digits = {"x": 2, "u": 4, "U": 8}[escape]
+        end = index + 1
+        while (
+            end < len(value)
+            and end < index + 1 + max_digits
+            and value[end] in _HEX_DIGITS
+        ):
+            end += 1
+        if end == index + 1:
+            return f"\\{escape}", index + 1
+        return chr(int(value[index + 1 : end], 16)), end
+    if escape == "c":
