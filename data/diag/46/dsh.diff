+@pytest.mark.aqua
+class TestXarrayKwargsMerge:
+    """Catalog xarray kwargs, explicit source kwargs, and driver defaults have one precedence."""
+
+    def test_merge_does_not_mutate_inputs(self):
+        catalog = {"chunks": {"time": 12, "lat": 4}, "decode_times": False}
+        explicit = {"chunks": {"time": 1}, "decode_times": True}
+
+        merged = merge_xarray_kwargs(catalog, explicit, {"engine": "netcdf4", "chunks": {}})
+
+        assert merged == {"engine": "netcdf4", "chunks": {"time": 1}, "decode_times": True}
+        assert catalog == {"chunks": {"time": 12, "lat": 4}, "decode_times": False}
+        assert explicit == {"chunks": {"time": 1}, "decode_times": True}
+
+    @pytest.mark.parametrize("driver,urlpath,defaults", XARRAY_DRIVERS)
+    def test_catalog_only_options(self, driver, urlpath, defaults):
+        catalog = {"chunks": {"time": 2}, "decode_times": False}
+        source = driver(urlpath, xarray_kwargs=catalog)
+
+        assert source.reader.kwargs["chunks"] == {"time": 2}
+        assert source.reader.kwargs["decode_times"] is False
+        assert source.xarray_kwargs == {**defaults, "chunks": {"time": 2}, "decode_times": False}
+
+    @pytest.mark.parametrize("driver,urlpath,defaults", XARRAY_DRIVERS)
+    def test_explicit_kwargs_override_catalog_options(self, driver, urlpath, defaults):
+        catalog = {"chunks": {"time": 12, "lat": 4}, "decode_times": False}
+        explicit = {"chunks": {"time": 1}, "decode_times": True}
+        source = driver(urlpath, xarray_kwargs=catalog, **explicit)
+
+        # the chunk mapping is replaced as a whole, not combined with the catalog one
+        assert source.reader.kwargs["chunks"] == {"time": 1}
+        assert source.reader.kwargs["decode_times"] is True
+        assert source.xarray_kwargs == {**defaults, "chunks": {"time": 1}, "decode_times": True}
+        assert catalog == {"chunks": {"time": 12, "lat": 4}, "decode_times": False}
+        assert explicit == {"chunks": {"time": 1}, "decode_times": True}
+
+    @pytest.mark.parametrize("driver,urlpath,defaults", XARRAY_DRIVERS)
+    def test_explicit_none_survives(self, driver, urlpath, defaults):
+        source = driver(urlpath, xarray_kwargs={"chunks": {"time": 12}}, chunks=None)
+
+        assert source.reader.kwargs["chunks"] is None
+        assert source.xarray_kwargs == {**defaults, "chunks": None}
+
+    def test_effective_options_used_for_backend_read(self, netcdf_tree):
+        source = IntakeNetCDFSource(
+            str(netcdf_tree / "one.nc"),
+            xarray_kwargs={"chunks": {"time": 12}},
+            chunks={"time": 1},
+        )
+
+        # BackendIntakeXarray reads with source.xarray_kwargs: the explicit override must stick
+        data = source.reader.read(**source.xarray_kwargs)
+
+        assert data["tas"].chunks[0] == (1, 1, 1, 1)
+
+
