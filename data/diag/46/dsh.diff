diff --git a/aqua/core/intake_drivers/xarray/base.py b/aqua/core/intake_drivers/xarray/base.py
index 06ebee3..14652f8 100644
--- a/aqua/core/intake_drivers/xarray/base.py
+++ b/aqua/core/intake_drivers/xarray/base.py
@@ -1,6 +1,32 @@
 from intake.source import base
 
 
+def merge_xarray_kwargs(xarray_kwargs=None, kwargs=None, defaults=None):
+    """Merge xarray open options with a single, explicit precedence.
+
+    Precedence, from lowest to highest, is driver defaults, catalog
+    ``xarray_kwargs`` and explicit source/Reader kwargs. The merge is shallow, so
+    a value such as ``chunks`` replaces the lower-precedence value as a whole
+    (including an explicit ``None``). Neither input mapping is modified.
+
+    Args:
+        xarray_kwargs (dict, optional): Catalog-provided xarray kwargs. Defaults to None.
+        kwargs (dict, optional): Explicit source/Reader kwargs. Defaults to None.
+        defaults (dict, optional): Driver defaults, applied only for missing keys. Defaults to None.
+
+    Returns:
+        dict: A new mapping of the effective xarray open options.
+    """
+    merged = dict(defaults or {})
+    merged.update(xarray_kwargs or {})
+    merged.update(kwargs or {})
+    return merged
+
+
+# Alias for internal callers that use the private helper name.
+_merge_xarray_kwargs = merge_xarray_kwargs
+
+
 class IntakeXarraySourceAdapter(base.DataSource):
     container = "xarray"
     name = "xarray"
