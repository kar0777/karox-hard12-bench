diff --git a/aqua/core/intake_drivers/xarray/base.py b/aqua/core/intake_drivers/xarray/base.py
index 06ebee3..a52ea4d 100644
--- a/aqua/core/intake_drivers/xarray/base.py
+++ b/aqua/core/intake_drivers/xarray/base.py
@@ -1,6 +1,40 @@
 from intake.source import base
 
 
+def merge_xarray_kwargs(xarray_kwargs=None, kwargs=None, defaults=None):
+    """Merge the xarray open options of a source by precedence.
+
+    Layers are applied in increasing priority: the driver ``defaults``, then the catalog
+    ``xarray_kwargs`` block, then the explicit source kwargs (the ``args`` of a catalog
+    entry and whatever the ``Reader`` passes directly). A higher layer replaces a key as
+    a whole, so a chunk mapping comes from the winning layer only and an explicit
+    ``None`` (e.g. ``chunks=None`` to bypass dask) is kept. Neither input dictionary is
+    modified: the caller gets a new one.
+
+    Args:
+        xarray_kwargs (dict, optional): The catalog ``xarray_kwargs`` block. Defaults to None.
+        kwargs (dict, optional): The explicit source kwargs. Defaults to None.
+        defaults (dict, optional): The driver defaults. Defaults to None.
+
+    Returns:
+        dict: The effective kwargs for the xarray open call.
+
+    Example usage::
+
+        # the explicit chunks replace the catalog ones as a whole
+        merge_xarray_kwargs({"chunks": {"time": 12}}, {"chunks": {"time": 1}}, defaults={"engine": "netcdf4"})
+        # {'engine': 'netcdf4', 'chunks': {'time': 1}}
+
+        # a second call layers defaults that must not be in the caller's options
+        merge_xarray_kwargs({"engine": "netcdf4"}, defaults={"chunks": {}})
+        # {'chunks': {}, 'engine': 'netcdf4'}
+    """
+    effective = dict(defaults or {})
+    effective.update(xarray_kwargs or {})
+    effective.update(kwargs or {})
+    return effective
+
+
 class IntakeXarraySourceAdapter(base.DataSource):
     container = "xarray"
     name = "xarray"
@@ -14,7 +48,10 @@ class IntakeXarraySourceAdapter(base.DataSource):
         Args:
             data (intake.readers.BaseData): The datatype the reader reads from; the backend
                 narrows its ``url`` in place (glob expansion, date filtering).
-            xarray_kwargs (dict, optional): The effective kwargs of the xarray open call.
+            xarray_kwargs (dict, optional): The effective options of the xarray open call:
+                driver defaults, catalog ``xarray_kwargs`` and explicit source/Reader kwargs
+                merged by precedence (see :func:`merge_xarray_kwargs`). Reader-only defaults
+                such as ``chunks={}`` are not repeated here.
             metadata (dict, optional): Catalog metadata for this source, set as ``self.metadata``.
         """
         self.data = data
