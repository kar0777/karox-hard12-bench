diff --git a/aqua/core/intake_drivers/xarray/base.py b/aqua/core/intake_drivers/xarray/base.py
index 06ebee3..8dc9772 100644
--- a/aqua/core/intake_drivers/xarray/base.py
+++ b/aqua/core/intake_drivers/xarray/base.py
@@ -1,6 +1,32 @@
 from intake.source import base
 
 
+def merge_xarray_kwargs(defaults=None, xarray_kwargs=None, kwargs=None):
+    """Return the effective xarray open kwargs for an intake source.
+
+    Precedence, from lowest to highest, is: ``defaults`` (driver defaults),
+    ``xarray_kwargs`` (catalog options) and ``kwargs`` (explicit source or Reader
+    options). The merge is shallow, so a higher-level ``chunks`` mapping replaces
+    the lower-level one as a whole. Input dictionaries are never modified.
+
+    Args:
+        defaults (dict, optional): Driver defaults. Defaults to None.
+        xarray_kwargs (dict, optional): Catalog ``xarray_kwargs``. Defaults to None.
+        kwargs (dict, optional): Explicit source or Reader kwargs. Defaults to None.
+
+    Returns:
+        dict: The effective options, as a new dictionary.
+    """
+    effective = dict(defaults or {})
+    effective.update(xarray_kwargs or {})
+    effective.update(kwargs or {})
+    return effective
+
+
+# Internal alias for callers that prefer the package's private-helper convention.
+_merge_xarray_kwargs = merge_xarray_kwargs
+
+
 class IntakeXarraySourceAdapter(base.DataSource):
     container = "xarray"
     name = "xarray"
