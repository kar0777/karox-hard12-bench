+def add_multi_insert_column_lineage(
+    holder: SubQueryLineageHolder,
+    tgt_table: Path | SubQuery | Table | None,
+    tgt_columns: list[Column],
+    values_columns: list[Column],
+    source_columns: dict[str, Column],
+    alias_mapping: dict[str, Path | SubQuery | Table],
+) -> None:
+    """
+    In a multi-table insert, the n-th value of an INTO clause feeds the n-th column of its column list.
+    A value referring to a column of the shared source query maps to whatever that column comes from:
+
+    .. code-block:: sql
+
+        INSERT ALL
+            INTO tab1 (col1) VALUES (col1)
+            INTO tab2 (col2) VALUES (col2)
+        SELECT col1, col2 FROM tab3
+    """
+    if tgt_table is None:
+        return
+    for idx, values_column in enumerate(values_columns):
+        if idx < len(tgt_columns):
+            tgt_col = tgt_columns[idx]
+        else:
+            # no column list specified, the target column is named after the value
+            tgt_col = values_column
+        tgt_col.parent = tgt_table
+        resolved_source_columns: list[tuple[str, str | None]] = []
+        for name, qualifier in values_column.source_columns:
+            if qualifier is None and name in source_columns:
+                resolved_source_columns += source_columns[name].source_columns
+            else:
+                resolved_source_columns.append((name, qualifier))
+        values_column.source_columns = resolved_source_columns
+        for src_col in values_column.to_source_columns(alias_mapping):
+            holder.add_column_lineage(src_col, tgt_col)
+
+
