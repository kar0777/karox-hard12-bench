+    @staticmethod
+    def _is_multi_table_insert(segments: list[BaseSegment]) -> bool:
+        """
+        Multi-table insert writes the same source query into multiple target tables, one INTO clause each:
+
+        .. code-block:: sql
+
+            INSERT ALL
+                INTO tab1 (col1) VALUES (col1)
+                INTO tab2 (col2) VALUES (col2)
+            SELECT col1, col2 FROM tab3
+
+        Oracle spells it as INSERT ALL, Snowflake as INSERT [OVERWRITE] ALL/FIRST, with optional WHEN condition
+        and ELSE before an INTO clause.
+        """
+        keywords = [
+            segment.raw_upper for segment in segments[:3] if segment.type == "keyword"
+        ]
+        return keywords[:1] == ["INSERT"] and bool({"ALL", "FIRST"} & set(keywords))
+
+    def _extract_multi_table_insert(
+        self, segments: list[BaseSegment], holder: SubQueryLineageHolder
+    ) -> SubQueryLineageHolder:
+        source_query = next(
+            (seg for seg in segments if seg.type in SOURCE_QUERY_SEGMENT_TYPES), None
+        )
+        source_columns, alias_mapping = self._extract_multi_insert_source_query(
+            source_query, holder
+        )
+        in_into = False
+        tgt_table = None
+        tgt_columns: list[Column] = []
+        for segment in segments[2:]:
+            if segment.type == "keyword" and segment.raw_upper == "INTO":
+                in_into, tgt_table, tgt_columns = True, None, []
+            elif not in_into:
+                # WHEN condition THEN, and ELSE, keywords between two INTO clauses
+                continue
+            elif segment.type in ("table_reference", "object_reference"):
+                if tgt_table is None:
+                    tgt_table = SqlFluffTable.of(segment, dialect=self.dialect)
+                    holder.add_write(tgt_table)
+            elif segment.type == "bracketed":
+                if not tgt_columns:
+                    # the target column list of the INTO clause, like INTO tab1 (col1, col2)
+                    tgt_columns = [
+                        SqlFluffColumn.of(seg)
+                        for seg in list_child_segments(segment)
+                        if seg.type in ("column_reference", "column_definition")
+                    ]
+            elif segment.type == "values_clause":
+                add_multi_insert_column_lineage(
+                    holder,
+                    tgt_table,
+                    tgt_columns,
+                    [
+                        SqlFluffColumn.of(expression)
+                        for values in segment.get_children("bracketed")
+                        for expression in values.get_children("expression")
+                    ],
+                    source_columns,
+                    alias_mapping,
+                )
+                in_into = False
+        return holder
+
+    def _extract_multi_insert_source_query(
+        self, source_query: BaseSegment | None, holder: SubQueryLineageHolder
+    ) -> tuple[dict[str, Column], dict[str, Path | SubQuery | Table]]:
+        """
+        Extract the source query shared by all the INTO clauses of a multi-table insert.
+        Return its columns, and the dataset alias mapping needed to resolve them.
+        """
+        source_columns: dict[str, Column] = {}
+        alias_mapping: dict[str, Path | SubQuery | Table] = {}
+        if source_query is not None:
+            if source_query.type == "with_compound_statement":
+                holder |= self.delegate_to_cte(source_query, holder)
+            else:
+                select_extractor = SelectExtractor(
+                    self.dialect, self.metadata_provider
+                )
+                holder |= select_extractor.extract(
+                    source_query, AnalyzerContext(cte=holder.cte)
+                )
+                alias_mapping = holder.get_alias_mapping_from_table_group(
+                    select_extractor.tables
+                )
+                for column in select_extractor.columns:
+                    # for UNION, the column of the first query names the result column
+                    source_columns.setdefault(column.raw_name, column)
+        return source_columns, alias_mapping
