+    @staticmethod
+    def _is_multi_table_insert(token: TokenList) -> bool:
+        """
+        INSERT ALL / INSERT FIRST writes the source query into multiple target tables, one INTO clause each:
+
+        .. code-block:: sql
+
+            INSERT ALL
+                INTO tab1 (col1) VALUES (col1)
+                INTO tab2 (col2) VALUES (col2)
+            SELECT col1, col2 FROM tab3
+        """
+        if not isinstance(token, Statement) or token.get_type() != "INSERT":
+            return False
+        leading = [t for t in token.tokens if not is_token_negligible(t)][:4]
+        keywords = [t.normalized for t in leading]
+        return keywords[:1] == ["INSERT"] and bool({"ALL", "FIRST"} & set(keywords))
+
+    @staticmethod
+    def _extract_from_dml_multi_insert(
+        stmt: Statement,
+        context: AnalyzerContext,
+        metadata_provider: MetaDataProvider,
+    ) -> SubQueryLineageHolder:
+        holder = SubQueryLineageHolder()
+        if context.cte is not None:
+            for cte in context.cte:
+                holder.add_cte(cte)
+        # sqlparse groups the INTO clauses that follow the first VALUES clause into that Values token
+        tokens = [
+            sub_token
+            for token in stmt.tokens
+            for sub_token in (token.tokens if isinstance(token, Values) else (token,))
+            if not is_token_negligible(sub_token)
+        ]
+        source_query_start = next(
+            (
+                idx
+                for idx, token in enumerate(tokens)
+                if token.is_keyword and token.normalized == "SELECT"
+            ),
+            len(tokens),
+        )
+        source_tokens = tokens[source_query_start:]
+        holder |= SqlParseLineageAnalyzer._extract_from_dml(
+            TokenList(source_tokens), AnalyzerContext(cte=holder.cte), metadata_provider
+        )
+        source_handler = SqlParseLineageAnalyzer._list_source_columns(
+            source_tokens, holder
+        )
+        source_columns = {col.raw_name: col for col in source_handler.columns}
+        alias_mapping = holder.get_alias_mapping_from_table_group(
+            source_handler.tables
+        )
+        in_into = False
+        tgt_table = None
+        tgt_columns: list[Column] = []
+        for token in tokens[:source_query_start]:
+            if token.is_keyword and token.normalized == "INTO":
+                in_into, tgt_table, tgt_columns = True, None, []
+            elif not in_into:
+                # WHEN condition THEN, and ELSE, between two INTO clauses
+                continue
+            elif isinstance(token, (Identifier, Function)) and tgt_table is None:
+                tgt_table, tgt_columns = SqlParseLineageAnalyzer._parse_into_target(
+                    token
+                )
+                holder.add_write(tgt_table)
+            elif isinstance(token, Parenthesis) and tgt_table is not None:
+                # the VALUES clause of the INTO clause
+                identifiers = SqlParseLineageAnalyzer._list_identifiers(token)
+                add_multi_insert_column_lineage(
+                    holder,
+                    tgt_table,
+                    tgt_columns,
+                    [SqlParseColumn.of(identifier) for identifier in identifiers],
+                    source_columns,
+                    alias_mapping,
+                )
+                in_into = False
+        return holder
+
+    @staticmethod
+    def _parse_into_target(token: Identifier | Function) -> tuple[Table, list[Column]]:
+        """
+        Parse the target table of an INTO clause, along with its column list. sqlparse parses
+        INTO tab1 (col1, col2) as a Function, with the table as identifier and the column list as parenthesis.
+        """
+        if isinstance(token, Identifier):
+            return SqlParseTable.of(token), []
+        column_list = next(
+            (t for t in token.tokens if isinstance(t, Parenthesis)), None
+        )
+        tgt_columns = []
+        if column_list is not None:
+            identifiers = SqlParseLineageAnalyzer._list_identifiers(column_list)
+            tgt_columns = [
+                SqlParseColumn.of(identifier) for identifier in identifiers
+            ]
+        return SqlParseTable.of(token.token_first(skip_cm=True)), tgt_columns
+
+    @staticmethod
+    def _list_identifiers(token_list: TokenList) -> list[Identifier]:
+        identifiers = []
+        for token in token_list.tokens:
+            if isinstance(token, Identifier):
+                identifiers.append(token)
+            elif isinstance(token, IdentifierList):
+                identifiers.extend(token.get_identifiers())
+        return identifiers
+
+    @staticmethod
+    def _list_source_columns(
+        source_tokens: list[Token], holder: SubQueryLineageHolder
+    ) -> SourceHandler:
+        """
+        Run the source handler over the source query of a multi-table insert, to collect the columns the INTO
+        clauses read from, along with the datasets they come from.
+        """
+        source_handler = SourceHandler()
+        for sub_token in source_tokens:
+            if is_token_negligible(sub_token):
+                continue
+            if sub_token.is_keyword:
+                source_handler.indicate(sub_token)
+            elif source_handler.indicator:
+                source_handler.handle(sub_token, holder)
+        return source_handler
