diff --git a/src/a2a/utils/_callable_compat.py b/src/a2a/utils/_callable_compat.py
new file mode 100644
index 0000000..0ce4cbd
--- /dev/null
+++ b/src/a2a/utils/_callable_compat.py
@@ -0,0 +1,53 @@
+"""Helpers for calling extension points that gained optional parameters."""
+
+from collections.abc import Callable
+from inspect import Parameter, signature
+from typing import Any, Literal, TypeVar
+
+
+_T = TypeVar('_T')
+_ContextStyle = Literal['keyword', 'positional']
+
+
+def _context_parameter_style(
+    method: Callable[..., Any],
+) -> _ContextStyle | None:
+    """Returns how `method` accepts a `context` argument, if it accepts one."""
+    try:
+        parameters = signature(method).parameters
+    except (TypeError, ValueError):
+        # Builtins and some extension callables expose no inspectable
+        # signature. Prefer the current API and let the call decide.
+        return 'positional'
+
+    context = parameters.get('context')
+    if context is not None:
+        if context.kind in (Parameter.KEYWORD_ONLY, Parameter.VAR_KEYWORD):
+            return 'keyword'
+        return 'positional'
+    if any(
+        parameter.kind is Parameter.VAR_KEYWORD
+        for parameter in parameters.values()
+    ):
+        return 'positional'
+    return None
+
+
+def invoke_with_optional_context(
+    method: Callable[..., _T],
+    *args: Any,
+    context: Any,
+    **kwargs: Any,
+) -> _T:
+    """Calls `method`, passing `context` only when the method accepts it.
+
+    This keeps third-party implementations written against the older
+    signatures working after an extension point gained an optional
+    `context` parameter.
+    """
+    style = _context_parameter_style(method)
+    if style is None:
+        return method(*args, **kwargs)
+    if style == 'keyword':
+        return method(*args, context=context, **kwargs)
+    return method(*args, context, **kwargs)
