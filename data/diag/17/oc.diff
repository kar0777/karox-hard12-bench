     reconfigure_stdio_utf8_on_windows(stdout_errors="replace", stderr_errors="replace")
 
 
+# Grace period a hook-spawned mine gets to shut down after its work is done.
+# Interpreter shutdown can block joining a non-daemon thread or an atexit
+# handler left behind by chromadb/onnxruntime; the mine itself has already
+# printed its summary and released its palace locks by then.
+_HOOK_MINE_EXIT_GRACE_SECONDS = 60
+
+# Set by main() so the watchdog preserves a failed mine's exit status if the
+# process hangs during shutdown after the exception was raised.
+_HOOK_MINE_EXIT_STATUS = 0
+
+
+def _arm_hook_mine_exit_watchdog(exit_code=None):
+    """Force-exit a hook-spawned mine whose interpreter shutdown hangs.
+
+    Only hook-spawned mines carry ``MEMPALACE_MINE_PID_FILE``. A manual
+    ``mempalace mine`` is never force-exited, even if its shutdown is slow.
+
+    The timer is a daemon thread, so it keeps running while
+    ``threading._shutdown()`` waits on a non-daemon thread and while atexit
+    handlers run — the two places a completed mine can wedge. A normal exit
+    finishes long before the grace period and is not delayed.
+    """
+    if not os.environ.get("MEMPALACE_MINE_PID_FILE"):
+        return None
+    if exit_code is None:
+        exit_code = _HOOK_MINE_EXIT_STATUS
+
+    import threading
+
+    from ..miner import _cleanup_mine_pid_file
+
+    def _force_exit():
+        try:
+            _cleanup_mine_pid_file()
+        except Exception:  # noqa: BLE001 - exiting is the point
+            pass
+        try:
+            sys.stdout.flush()
+            sys.stderr.flush()
+        except Exception:  # noqa: BLE001 - exiting is the point
+            pass
+        os._exit(exit_code)
+
+    timer = threading.Timer(_HOOK_MINE_EXIT_GRACE_SECONDS, _force_exit)
+    timer.daemon = True
+    timer.start()
+    return timer
+
+
 def main():
     """CLI entry point for the ``mempalace`` console script.
 
@@ -1209,4 +1258,26 @@ def main():
         "status": cmd_status,
         "update": cmd_update,
     }
-    dispatch[args.command](args)
+    global _HOOK_MINE_EXIT_STATUS
+    _HOOK_MINE_EXIT_STATUS = 0
+    try:
+        dispatch[args.command](args)
+    except SystemExit as exc:
+        code = exc.code
+        if code is None:
+            _HOOK_MINE_EXIT_STATUS = 0
+        elif isinstance(code, int):
+            _HOOK_MINE_EXIT_STATUS = code
+        else:
+            _HOOK_MINE_EXIT_STATUS = 1
+        raise
+    except BaseException:
+        _HOOK_MINE_EXIT_STATUS = 1
+        raise
+    finally:
+        if args.command == "mine" and os.environ.get("MEMPALACE_MINE_PID_FILE"):
+            # Release the slot as soon as the command returns or fails, even
+            # if the caller replaced cmd_mine or the mine mode skipped its own
+            # cleanup. The watchdog repeats it in case shutdown wedges first.
+            _cleanup_hook_mine_pid_slot()
+            _arm_hook_mine_exit_watchdog()
