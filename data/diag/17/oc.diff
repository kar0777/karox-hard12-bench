 def cmd_mine(args):
+    """Mine through the requested mode and release the hook PID slot.
+
+    ``miner.mine`` already cleans up in its own ``finally``, but the convos
+    and extract paths (and every early return before mining starts) do not.
+    A hook-spawned process therefore used to leave its ``mine_pids`` slot
+    behind after a clean conversation mine. Clean up here, once, for every
+    exit path. The cleanup itself is a no-op unless this process owns a
+    slot, so manual mines are unaffected.
+    """
+    try:
+        return _cmd_mine_impl(args)
+    finally:
+        _cleanup_hook_mine_pid_slot()
+
+
+def _cleanup_hook_mine_pid_slot() -> None:
+    """Remove this process's hook mine slot, if it has one.
+
+    Check the env var before importing ``miner``: this wrapper runs for every
+    ``cmd_mine`` call, including manual ones, and importing the Chroma-heavy
+    miner just to discover there is no slot is unnecessary.
+    """
+    if not os.environ.get("MEMPALACE_MINE_PID_FILE"):
+        return
+    try:
+        from ..miner import _cleanup_mine_pid_file
+
+        _cleanup_mine_pid_file()
+    except Exception:  # noqa: BLE001 - PID bookkeeping must never fail the mine
+        pass
+
+
+def _cmd_mine_impl(args):
     palace_path = os.path.expanduser(args.palace) if args.palace else MempalaceConfig().palace_path
     mode = getattr(args, "mode", None) or "projects"
     source_adapter = getattr(args, "source", None)
