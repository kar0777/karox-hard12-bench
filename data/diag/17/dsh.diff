+def _cleanup_hook_mine_pid_file() -> None:
+    """Release this process's hook-spawned mine slot, if it owns one.
+
+    Every ``mempalace mine`` mode must clear the per-target PID slot the hook
+    claimed before spawning it. Project and format mines already do this in
+    their own ``finally`` blocks; routing the cleanup through the CLI covers
+    convos and source-adapter mines as well, including paths that return early
+    or fail. ``_cleanup_mine_pid_file`` only removes a slot that names this
+    process, so calling it more than once is safe.
+    """
+    if not os.environ.get("MEMPALACE_MINE_PID_FILE"):
+        return
+    try:
+        from ..miner import _cleanup_mine_pid_file
+    except Exception:  # noqa: BLE001 - bookkeeping must not mask the mine outcome
+        return
+    try:
+        _cleanup_mine_pid_file()
+    except Exception:  # noqa: BLE001 - bookkeeping must not mask the mine outcome
+        pass
