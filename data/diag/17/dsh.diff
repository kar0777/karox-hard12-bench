+# Grace period a hook-spawned mine gets to shut down after its work is done.
+# Normal exits are never delayed: this timer only fires if interpreter
+# shutdown (thread joining / atexit handlers) is still running when it expires.
+_HOOK_MINE_EXIT_GRACE_SECONDS = 60
+
+
+def _arm_hook_mine_exit_watchdog(exit_code=0):
+    """Force-exit a hook-spawned mine whose interpreter shutdown hangs.
+
+    Hook-spawned mines inherit ``MEMPALACE_MINE_PID_FILE``; a manual
+    ``mempalace mine`` does not, so it is never force-exited. The timer is a
+    daemon thread, which keeps running while ``threading._shutdown()`` waits
+    on a non-daemon thread and while ``atexit`` handlers run -- the two places
+    the reported post-completion hang can live.
+    """
+    if not os.environ.get("MEMPALACE_MINE_PID_FILE"):
+        return None
+
+    if not isinstance(exit_code, int):
+        exit_code = 0 if exit_code is None else 1
+
+    # Resolve the cleanup before shutdown starts: importing the miner during
+    # interpreter teardown can fail ("can't register atexit after shutdown"),
+    # which would leave the PID slot behind.
+    try:
+        from ..miner import _cleanup_mine_pid_file
+    except Exception:  # noqa: BLE001 - the forced exit is still useful
+        _cleanup_mine_pid_file = None
+
+    def _force_exit():
+        try:
+            if _cleanup_mine_pid_file is not None:
+                _cleanup_mine_pid_file()
+        except Exception:  # noqa: BLE001 - exiting is the point
+            pass
+        finally:
+            try:
+                sys.stdout.flush()
+                sys.stderr.flush()
+            except Exception:  # noqa: BLE001 - exiting is the point
+                pass
+            os._exit(exit_code)
+
+    timer = threading.Timer(_HOOK_MINE_EXIT_GRACE_SECONDS, _force_exit)
+    timer.daemon = True
+    timer.start()
+    return timer
+
