 def getXSTypeLabelFromNumber(xsTypeNumber: int) -> str:
     """
-    Convert a XSID label (e.g. 65) to an XS label (e.g. 'A').
+    Convert a XSID number (e.g. 65) to an XS label (e.g. 'A').
 
     Useful for visualizing XS type in XTVIEW.
 
-    2-digit labels are supported when there is only one burnup group.
+    The number is the concatenation of the 2-digit ASCII codes of the characters that make up the
+    label. So 2-digit labels (e.g. 6570 is 'AF') are supported when there is only one burnup
+    group, and numerical labels (e.g. 49 is '1') are supported as well.
     """
-    try:
-        if xsTypeNumber > ord("Z"):
-            # two digit. Parse
-            return chr(int(str(xsTypeNumber)[:2])) + chr(int(str(xsTypeNumber)[2:]))
-        elif xsTypeNumber < ord("A"):
-            raise ValueError(
-                f"Cannot convert invalid xsTypeNumber `{xsTypeNumber}` to char. "
-                "The number must be >= 65 (corresponding to 'A')."
-            )
-        else:
-            return chr(xsTypeNumber)
-    except ValueError:
-        runLog.error(f"Error converting {xsTypeNumber} to label.")
+    numberString = str(xsTypeNumber)
+
+    # the label is made up of the 2-digit ASCII code of each of its characters
+    if len(numberString) % 2 == 0:
+        label = "".join(chr(int(numberString[i : i + 2])) for i in range(0, len(numberString), 2))
+        if label.isalnum():
+            return label
+
+    if ord("0") <= xsTypeNumber <= ord("9"):
+        # a single numerical label, e.g. 49 is '1'
+        return chr(xsTypeNumber)
+    elif xsTypeNumber > ord("Z") and len(numberString) > 2:
+        # two digit. Parse
+        return chr(int(numberString[:2])) + chr(int(numberString[2:]))
+
+    raise ValueError(
+        f"Cannot convert invalid xsTypeNumber `{xsTypeNumber}` to a label. The number must be the "
+        "2-digit ASCII codes of the characters of a letter or number label (e.g. 65 for 'A')."
+    )
 
 
