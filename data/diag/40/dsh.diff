+class _XsTypeString(str):
+    """A string subclass used to coerce numeric XS type labels to strings in blueprints."""
+
+
+def _representXsType(dumper, data, roundTripData):
+    """Represent XS type labels as plain strings when writing blueprints."""
+    return dumper.represent_data(str(data))
+
+
+class XsTypeList(yamlize.StrList):
+    """A list of cross-section type labels that accepts numeric labels as well as strings."""
+
+    item_type = yamlize.Typed(_XsTypeString, compare_after_cast=False, to_yaml=_representXsType)
+
+    def append(self, item):
+        super().append(item)
+        # Keep the list values as plain strings so they can be serialized normally.
+        self[-1] = str(self[-1])
+
+
