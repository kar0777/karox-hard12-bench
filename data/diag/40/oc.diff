-_ALLOWABLE_XS_TYPE_LIST = list(string.ascii_uppercase + string.ascii_lowercase)
+_ALLOWABLE_XS_TYPE_LIST = list(string.ascii_uppercase + string.ascii_lowercase + string.digits)
+_ALLOWABLE_XS_TYPE_CHARS = set(_ALLOWABLE_XS_TYPE_LIST)
 
 
 def getXSTypeNumberFromLabel(xsTypeLabel: str) -> int:
@@ -90,8 +92,12 @@ def getXSTypeNumberFromLabel(xsTypeLabel: str) -> int:
 
     Useful for visualizing XS type in XTVIEW.
 
-    2-digit labels are supported when there is only one burnup group.
+    2-digit labels are supported when there is only one burnup group. Numeric
+    labels (e.g. '1' or '10') are also supported.
     """
+    if not isinstance(xsTypeLabel, str):
+        xsTypeLabel = str(xsTypeLabel)
+
     return int("".join(["{:02d}".format(ord(si)) for si in xsTypeLabel]))
 
 
@@ -101,20 +107,47 @@ def getXSTypeLabelFromNumber(xsTypeNumber: int) -> str:
 
     Useful for visualizing XS type in XTVIEW.
 
-    2-digit labels are supported when there is only one burnup group.
+    2-digit labels are supported when there is only one burnup group. Numeric
+    labels (e.g. '1' or '10') are also supported.
     """
+
+    def invalidNumber():
+        return ValueError(
+            f"Cannot convert invalid xsTypeNumber `{xsTypeNumber}` to char. "
+            "The number must be >= 48 (corresponding to '0'). "
+            "The number must also correspond to an alphanumeric character."
+        )
+
     try:
-        if xsTypeNumber > ord("Z"):
-            # two digit. Parse
-            return chr(int(str(xsTypeNumber)[:2])) + chr(int(str(xsTypeNumber)[2:]))
-        elif xsTypeNumber < ord("A"):
-            raise ValueError(
-                f"Cannot convert invalid xsTypeNumber `{xsTypeNumber}` to char. "
-                "The number must be >= 65 (corresponding to 'A')."
-            )
-        else:
-            return chr(xsTypeNumber)
-    except ValueError:
+        if xsTypeNumber < 0:
+            raise invalidNumber()
+
+        # Single-character labels are stored as their ASCII value. This includes
+        # numbers (e.g. 49 is '1'), capital letters (e.g. 65 is 'A'), and
+        # lowercase letters (e.g. 97 is 'a').
+        if xsTypeNumber <= 127:
+            xsTypeLabel = chr(xsTypeNumber)
+            if xsTypeLabel in _ALLOWABLE_XS_TYPE_CHARS:
+                return xsTypeLabel
+
+            raise invalidNumber()
+
+        # Multi-character labels are stored as the concatenation of the
+        # two-digit ASCII values of each character (e.g. 6565 is 'AA' and 4948
+        # is '10').
+        xsTypeNumberStr = str(xsTypeNumber)
+        if len(xsTypeNumberStr) % 2 == 0:
+            xsTypeLabel = "".join(chr(int(xsTypeNumberStr[i : i + 2])) for i in range(0, len(xsTypeNumberStr), 2))
+            if all(char in _ALLOWABLE_XS_TYPE_CHARS for char in xsTypeLabel):
+                return xsTypeLabel
+
+        # Retain support for historical values that do not map to valid
+        # alphanumeric labels, as some parameters may contain arbitrary numbers.
+        try:
+            return chr(int(xsTypeNumberStr[:2])) + chr(int(xsTypeNumberStr[2:]))
+        except ValueError:
+            raise invalidNumber()
+    except (TypeError, ValueError):
         runLog.error(f"Error converting {xsTypeNumber} to label.")
 
 
