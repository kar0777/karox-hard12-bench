+    def _values_for_sample(
+        self,
+        sample: int | None = None,
+        agg: str | float | None = None,
+        caller: str = "values",
+    ) -> np.ndarray:
+        """Return the values of one `sample` or the `agg`-aggregated values of a stochastic series.
+
+        If the series is stochastic and neither `sample` nor `agg` is given, a warning is logged and the values of
+        the first sample are returned.
+        """
+        if sample is not None and agg is not None:
+            raise_log(
+                ValueError(
+                    f"Only one of `sample` and `agg` can be specified in `{caller}()`, received both."
+                ),
+            )
+        if agg is not None:
+            return self._aggregate_samples(agg)
+
+        if sample is None:
+            if not self.is_deterministic:
+                logger.warning(
+                    f"You are calling `{caller}()` on a stochastic TimeSeries (it contains several samples) "
+                    "without specifying a `sample` or an `agg`. Only the first sample (`sample=0`) is "
+                    "returned, which is a single random Monte Carlo draw and not a point forecast. If this "
+                    "is not the expected behavior, pass an explicit `sample=...`, aggregate the samples with "
+                    "`agg=\"mean\"`, `agg=\"median\"` or a quantile (e.g. `agg=0.5`), or extract the statistic "
+                    "from the TimeSeries before calling it (e.g. with `TimeSeries.quantile(0.5)`, "
+                    "`TimeSeries.mean()`, `TimeSeries.median()`)."
+                )
+            sample = 0
+        elif self.is_deterministic and sample != 0:
+            raise_log(
+                ValueError(
+                    "This series contains one sample only (deterministic),"
+                    "so only sample=0 is accepted.",
+                ),
+            )
+        return self._values[:, :, sample]
