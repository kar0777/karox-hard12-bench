+    def _aggregate_samples(self, agg: str | float) -> np.ndarray:
+        """Aggregate the samples of the series into a 2-D array of shape (time, component).
+
+        Parameters
+        ----------
+        agg
+            The aggregation to apply over the samples. Either `"mean"`, `"median"`, or a float between 0 and 1
+            interpreted as a quantile.
+        """
+        valid_aggs = {"mean": np.mean, "median": np.median}
+        if isinstance(agg, str):
+            if agg.lower() not in valid_aggs:
+                raise_log(
+                    ValueError(
+                        f"Invalid `agg` value `{agg}`. Supported values are 'mean', 'median', or a float "
+                        "between 0 and 1 (quantile)."
+                    ),
+                )
+            return valid_aggs[agg.lower()](self._values, axis=SMPL_AX)
+        if isinstance(agg, bool) or not isinstance(agg, (int, float)):
+            raise_log(
+                ValueError(
+                    f"Invalid `agg` value `{agg}`. Supported values are 'mean', 'median', or a float "
+                    "between 0 and 1 (quantile)."
+                ),
+            )
+        if not 0 <= agg <= 1:
+            raise_log(
+                ValueError(
+                    f"The `agg` quantile must be between 0 and 1 (inclusive), received `{agg}`."
+                ),
+            )
+        return np.quantile(self._values, q=agg, axis=SMPL_AX)
