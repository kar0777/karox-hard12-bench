+    @staticmethod
+    def http_environment(tools: ToolCache) -> dict[str, str]:
+        """The environment variables used to configure HTTP requests.
+
+        :param tools: The tool cache for the current command.
+        :returns: The environment variables that configure HTTP requests.
+        """
+        return dict(tools.os.environ)
+
+    @classmethod
+    def verify_ssl_environment(cls, tools: ToolCache) -> None:
+        """Verify that SSL certificate configuration in the environment is usable.
+
+        `httpx2` honors the `SSL_CERT_FILE` and `SSL_CERT_DIR` environment variables
+        when it constructs the SSL context used for downloads. If either variable
+        points at a location that doesn't exist (or that is of the wrong type), the
+        error raised by the underlying SSL library is opaque, so validate the values
+        up front.
+
+        :param tools: The tool cache for the current command.
+        :raises BriefcaseCommandError: If an environment variable is set to a path
+            that doesn't exist, or that is of the wrong type.
+        """
+        environment = cls.http_environment(tools)
+        for env_var, kind, is_kind in [
+            ("SSL_CERT_FILE", "file", Path.is_file),
+            ("SSL_CERT_DIR", "directory", Path.is_dir),
+        ]:
+            if value := environment.get(env_var):
+                path = Path(value)
+                if not path.exists():
+                    problem = "does not exist"
+                elif not is_kind(path):
+                    problem = f"is not a {kind}"
+                else:
+                    continue
+
+                raise BriefcaseCommandError(
+                    f"The path specified by {env_var} {problem}.\n"
+                    "\n"
+                    f"    {path}\n"
+                    "\n"
+                    f"Please update the {env_var} environment variable so that it "
+                    f"points at an existing {kind}, or unset it."
+                )
+
+    @classmethod
+    def proxy_environment(cls, tools: ToolCache) -> list[str]:
+        """The proxy configuration environment variables that are currently set.
+
+        :param tools: The tool cache for the current command.
+        :returns: The names of the proxy environment variables that are in use.
+        """
+        environment = cls.http_environment(tools)
+        return [env_var for env_var in PROXY_ENV_VARS if environment.get(env_var)]
+
