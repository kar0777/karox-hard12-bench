diff --git a/tests/integrations/file/test_File__ssl_environment.py b/tests/integrations/file/test_File__ssl_environment.py
new file mode 100644
index 0000000..22df740
--- /dev/null
+++ b/tests/integrations/file/test_File__ssl_environment.py
@@ -0,0 +1,153 @@
+import os
+from unittest import mock
+
+import httpx2
+import pytest
+
+from briefcase.exceptions import BriefcaseCommandError, NetworkFailure
+from briefcase.integrations.file import File
+
+
+@pytest.fixture
+def mock_tools(mock_tools):
+    mock_tools.httpx2 = mock.MagicMock(spec_set=httpx2)
+    return mock_tools
+
+
+@pytest.mark.parametrize("env_var", ["SSL_CERT_FILE", "SSL_CERT_DIR"])
+def test_missing_ssl_path(mock_tools, env_var, tmp_path):
+    """If an SSL environment variable points at a path that doesn't exist, an error is
+    raised."""
+    mock_tools.os.environ = {env_var: os.fsdecode(tmp_path / "does-not-exist")}
+
+    with pytest.raises(
+        BriefcaseCommandError,
+        match=rf"The path specified by {env_var} does not exist",
+    ):
+        File.verify_ssl_environment(mock_tools)
+
+
+def test_ssl_cert_file_not_a_file(mock_tools, tmp_path):
+    """If SSL_CERT_FILE doesn't point at a file, an error is raised."""
+    mock_tools.os.environ = {"SSL_CERT_FILE": os.fsdecode(tmp_path)}
+
+    with pytest.raises(
+        BriefcaseCommandError,
+        match=r"The path specified by SSL_CERT_FILE is not a file",
+    ):
+        File.verify_ssl_environment(mock_tools)
+
+
+def test_ssl_cert_dir_not_a_directory(mock_tools, tmp_path):
+    """If SSL_CERT_DIR doesn't point at a directory, an error is raised."""
+    cert_file = tmp_path / "cert.pem"
+    cert_file.touch()
+    mock_tools.os.environ = {"SSL_CERT_DIR": os.fsdecode(cert_file)}
+
+    with pytest.raises(
+        BriefcaseCommandError,
+        match=r"The path specified by SSL_CERT_DIR is not a directory",
+    ):
+        File.verify_ssl_environment(mock_tools)
+
+
+def test_valid_ssl_environment(mock_tools, tmp_path):
+    """If the SSL environment variables point at valid paths, no error is raised."""
+    cert_file = tmp_path / "cert.pem"
+    cert_file.touch()
+    cert_dir = tmp_path / "certs"
+    cert_dir.mkdir()
+    mock_tools.os.environ = {
+        "SSL_CERT_FILE": os.fsdecode(cert_file),
+        "SSL_CERT_DIR": os.fsdecode(cert_dir),
+    }
+
+    File.verify_ssl_environment(mock_tools)
+
+
+def test_process_environment(mock_tools, monkeypatch, tmp_path):
+    """SSL configuration in the process environment is honored."""
+    mock_tools.os = os
+    monkeypatch.setenv("SSL_CERT_FILE", os.fsdecode(tmp_path / "does-not-exist"))
+
+    with pytest.raises(
+        BriefcaseCommandError,
+        match=r"The path specified by SSL_CERT_FILE does not exist",
+    ):
+        File.verify_ssl_environment(mock_tools)
+
+
+def test_verify_invalid_ssl_environment(mock_tools, tmp_path):
+    """The File tool can't be verified if the SSL environment is invalid."""
+    delattr(mock_tools, "file")
+    mock_tools.os.environ = {
+        "SSL_CERT_FILE": os.fsdecode(tmp_path / "does-not-exist"),
+    }
+
+    with pytest.raises(BriefcaseCommandError, match=r"SSL_CERT_FILE"):
+        File.verify(mock_tools)
+
+    assert not hasattr(mock_tools, "file")
+
+
+def test_download_invalid_ssl_environment(mock_tools, tmp_path):
+    """A download reports an invalid SSL environment as a network failure, without
+    making a request."""
+    mock_tools.os.environ = {
+        "SSL_CERT_FILE": os.fsdecode(tmp_path / "does-not-exist"),
+    }
+    download_path = tmp_path / "downloads"
+
+    with pytest.raises(
+        NetworkFailure,
+        match=r"The path specified by SSL_CERT_FILE does not exist",
+    ):
+        mock_tools.file.download(
+            url="https://example.com/something.zip",
+            download_path=download_path,
+            role="something",
+        )
+
+    mock_tools.httpx2.stream.assert_not_called()
+    assert not download_path.exists()
+
+
+@pytest.mark.parametrize(
+    ("proxies", "expected"),
+    [
+        (
+            ["HTTPS_PROXY"],
+            r"HTTPS_PROXY environment variable",
+        ),
+        (
+            ["HTTP_PROXY", "ALL_PROXY"],
+            r"HTTP_PROXY and ALL_PROXY environment variables",
+        ),
+    ],
+)
+def test_proxy_connection_error_hint(mock_tools, tmp_path, proxies, expected):
+    """A connection error names any proxy configuration that is in use."""
+    mock_tools.os.environ = {
+        proxy: "http://proxy.example.com:8080" for proxy in proxies
+    }
+    mock_tools.httpx2.stream.side_effect = [
+        httpx2.ConnectError("proxy connection error")
+    ]
+
+    with pytest.raises(NetworkFailure, match=expected):
+        mock_tools.file.download(
+            url="https://example.com/something.zip",
+            download_path=tmp_path,
+        )
+
+
+def test_no_proxy_connection_error_hint(mock_tools, tmp_path):
+    """If no proxy is configured, a connection error doesn't mention a proxy."""
+    mock_tools.os.environ = {}
+    mock_tools.httpx2.stream.side_effect = [httpx2.ConnectError("connection error")]
+
+    with pytest.raises(NetworkFailure, match=r"The reported cause of the problem was"):
+        mock_tools.file.download(
+            url="https://example.com/something.zip",
+            download_path=tmp_path,
+        )
