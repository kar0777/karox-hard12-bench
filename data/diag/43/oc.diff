+    def _http_environment(self) -> dict[str, str]:
+        """Return the environment used to configure HTTP requests.
+
+        ``ToolCache`` exposes a mockable ``os`` module, so use its environment.
+        In production, this is the process environment; in tests, it is the
+        environment configured on the tool cache.
