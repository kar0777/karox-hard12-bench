+    def _proxy_environment(self) -> dict[str, str]:
+        """Return the configured proxy environment variables.
+
+        httpx2 honors both upper and lower case proxy variable names.
+
+        :returns: A dictionary mapping proxy environment variable names to values.
+        """
+        environment = self._http_environment()
+        proxies = {}
+        for env_var in PROXY_ENVIRONMENT_VARIABLES:
+            # httpx2 (via urllib.request.getproxies()) prefers lowercase variable
+            # names, and an empty lowercase value disables an uppercase setting.
+            lower_env_var = env_var.lower()
+            if lower_env_var in environment:
+                value = environment[lower_env_var]
+                proxy_name = lower_env_var
+            else:
+                value = environment.get(env_var)
+                proxy_name = env_var
+            if value:
+                proxies[proxy_name] = str(value)
+        return proxies
