+++ b/tests/integrations/file/test_File__environment_validation.py
@@ -0,0 +1,439 @@
+import os
+import ssl
+from unittest import mock
+
+import httpcore2
+import httpx2
+import pytest
+
+from briefcase.exceptions import BriefcaseCommandError, NetworkFailure
+from briefcase.integrations.base import ToolCache
+from briefcase.integrations.file import File
+
+
+@pytest.fixture
+def mock_tools(mock_tools) -> ToolCache:
+    mock_tools.httpx2 = mock.MagicMock(spec_set=httpx2)
+    return mock_tools
+
+
+@pytest.mark.parametrize(
+    ("env_var", "path_type"),
+    [
+        ("SSL_CERT_FILE", "file"),
+        ("SSL_CERT_DIR", "directory"),
+    ],
+)
+def test_missing_ssl_path(mock_tools, tmp_path, env_var, path_type):
+    """An SSL environment variable that points to a missing path is reported."""
+    path = tmp_path / "missing"
+    mock_tools.os.environ[env_var] = str(path)
+
+    with pytest.raises(BriefcaseCommandError) as exc_info:
+        mock_tools.file._verify_environment()
+
+    message = str(exc_info.value)
+    assert f"environment variable {env_var}:" in message
+    assert str(path) in message
+    assert "does not exist" in message
+    assert path_type in message
+
+
+@pytest.mark.parametrize(
+    ("env_var", "path_type", "other_type"),
+    [
+        ("SSL_CERT_FILE", "file", "directory"),
+        ("SSL_CERT_DIR", "directory", "file"),
+    ],
+)
+def test_wrong_ssl_path_type(
+    mock_tools,
+    tmp_path,
+    env_var,
+    path_type,
+    other_type,
+):
+    """An SSL environment variable that points to the wrong path type is reported."""
+    path = tmp_path / "wrong-type"
+    if other_type == "directory":
+        path.mkdir()
+    else:
+        path.write_text("not a certificate directory")
+
+    mock_tools.os.environ[env_var] = str(path)
+
+    with pytest.raises(BriefcaseCommandError) as exc_info:
+        mock_tools.file._verify_environment()
+
+    message = str(exc_info.value)
+    assert f"environment variable {env_var}:" in message
+    assert str(path) in message
+    assert f"is not a {path_type}" in message
+
+
+def test_valid_environment(mock_tools, tmp_path):
+    """A valid HTTP environment passes validation."""
+    cert_file = tmp_path / "cert.pem"
+    cert_file.write_text("certificate")
+    cert_dir = tmp_path / "certs"
+    cert_dir.mkdir()
+
+    mock_tools.os.environ.update(
+        {
+            "SSL_CERT_FILE": str(cert_file),
+            "SSL_CERT_DIR": str(cert_dir),
+            "HTTPS_PROXY": "http://proxy.example.com:8080",
+            "NO_PROXY": "localhost,example.com",
+        }
+    )
+
+    assert mock_tools.file._verify_environment() is None
+
+
+@pytest.mark.parametrize(
+    "proxy_url",
+    [
+        # No hostname
+        "not a url",
+        # Invalid port
+        "http://proxy.example.com:not-a-port",
+        # Unsupported scheme
+        "ftp://proxy.example.com:8080",
+        # Missing hostname
+        "http://:8080",
+    ],
+)
+def test_invalid_proxy_url(mock_tools, proxy_url):
+    """An invalid proxy URL is reported."""
+    mock_tools.os.environ["HTTPS_PROXY"] = proxy_url
+
+    with pytest.raises(BriefcaseCommandError) as exc_info:
+        mock_tools.file._verify_environment()
+
+    message = str(exc_info.value)
+    assert "HTTPS_PROXY" in message
+    assert proxy_url in message
+    assert "proxy URL" in message
+
+
+def test_no_proxy_disables_proxy_validation(mock_tools):
+    """A NO_PROXY wildcard disables proxy validation."""
+    mock_tools.os.environ.update(
+        {
+            "HTTPS_PROXY": "not a url",
+            "NO_PROXY": "localhost, *",
+        }
+    )
+
+    assert mock_tools.file._verify_environment() is None
+
+
+def test_lowercase_no_proxy_takes_precedence(mock_tools):
+    """A lowercase no_proxy value takes precedence over NO_PROXY."""
+    mock_tools.os.environ.update(
+        {
+            "HTTPS_PROXY": "not a url",
+            "NO_PROXY": "example.com",
+            "no_proxy": "*",
+        }
+    )
+
+    assert mock_tools.file._verify_environment() is None
+
+
+def test_lowercase_proxy_is_validated(mock_tools):
+    """Lowercase proxy variables are validated."""
+    mock_tools.os.environ["https_proxy"] = "not a url"
+
+    with pytest.raises(BriefcaseCommandError, match="https_proxy"):
+        mock_tools.file._verify_environment()
+
+
+def test_empty_lowercase_proxy_disables_uppercase(mock_tools):
+    """An empty lowercase proxy variable disables the uppercase setting."""
+    mock_tools.os.environ.update(
+        {
+            "HTTPS_PROXY": "not a url",
+            "https_proxy": "",
+        }
+    )
+
+    assert mock_tools.file._verify_environment() is None
+
+
+def test_tool_environment_is_used(mock_tools, monkeypatch):
+    """The tool cache environment is the source of HTTP configuration."""
+    monkeypatch.setenv("HTTPS_PROXY", "http://process.example.com:8080")
+    mock_tools.os.environ["https_proxy"] = "http://tool.example.com:8080"
+
+    environment = mock_tools.file._http_environment()
+
+    assert environment == {"https_proxy": "http://tool.example.com:8080"}
