+def test_connect_error_environment(
+    mock_tools,
+    tmp_path,
+    ssl_environment,
+    certificate_context,
+    expected,
+):
+    """Connect errors mention the relevant environment configuration."""
+    if ssl_environment:
+        cert_file = tmp_path / "cert.pem"
+        cert_file.write_text("certificate")
+        mock_tools.os.environ["SSL_CERT_FILE"] = str(cert_file)
+    else:
+        mock_tools.os.environ["HTTPS_PROXY"] = "http://proxy.example.com:8080"
+
+    error = httpx2.ConnectError("connection error")
+    if certificate_context:
+        error.__context__ = httpcore2.ConnectError()
+        error.__context__.__context__ = ssl.SSLCertVerificationError()
+
+    mock_tools.httpx2.stream.side_effect = error
+
+    with pytest.raises(NetworkFailure) as exc_info:
+        mock_tools.file.download(
+            url="https://example.com/something.zip",
+            download_path=mock_tools.base_path,
+        )
+
+    assert expected in str(exc_info.value)
+
