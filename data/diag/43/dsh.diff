+    def _environment(self, tools: ToolCache | None = None) -> dict[str, str]:
+        """Return the environment used to configure HTTP requests.
+
+        In normal operation, this is the process environment. When a `ToolCache` is
+        using a mocked environment, any values that aren't explicitly mocked fall
+        back to the process environment.
+
+        :param tools: The tool cache to inspect. If not provided, use the tool cache
+            associated with this `File` instance.
+        :returns: A mapping of environment variable names to values.
+        """
+        if isinstance(self, File):
+            if tools is None:
+                tools = self.tools
+        else:
+            # Allow this method to be invoked as File._environment(tools).
+            tools = self
+
+        try:
+            return {**os.environ, **tools.os.environ}
+        except TypeError:
+            # A fully mocked environment may not be a mapping.
+            return tools.os.environ
+
+    def _verify_environment(self, tools: ToolCache | None = None) -> None:
+        """Verify that the HTTP-related environment variables are valid.
+
+        `httpx2` honors several environment variables that configure SSL
+        certificates and proxies. If one of those variables refers to a path that
+        doesn't exist, httpx2 either raises an opaque error or silently ignores the
+        configuration. Validate the values before making a request so that the user
+        gets an actionable error message.
+
+        :param tools: The tool cache to inspect. If not provided, use the tool cache
+            associated with this `File` instance.
+        :raises BriefcaseCommandError: If an environment variable has an invalid value.
+        """
+        if isinstance(self, File):
+            environ = self._environment(tools)
+        else:
+            # Allow this method to be invoked as File._verify_environment(tools).
+            environ = File._environment(self)
+
+        for env_var, path_type, description in (
+            ("SSL_CERT_FILE", "is_file", "file"),
+            ("SSL_CERT_DIR", "is_dir", "directory"),
+        ):
+            if path_value := environ.get(env_var):
+                path = Path(path_value)
+                if not getattr(path, path_type)():
+                    if path.exists():
+                        problem = f"is not a {description}"
+                    else:
+                        problem = "does not exist"
+                    raise InvalidEnvironmentError(
+                        f"The path specified by {env_var} {problem}: {path}"
+                    )
+
+        for env_var in PROXY_ENVIRONMENT_VARIABLES:
+            if proxy_value := environ.get(env_var):
+                # httpx2 assumes an HTTP proxy if the value doesn't include a scheme.
+                proxy_url = (
+                    proxy_value if "://" in proxy_value else f"http://{proxy_value}"
+                )
+                try:
+                    if any(character.isspace() for character in proxy_value):
+                        raise ValueError("proxy URL contains whitespace")
+                    proxy = httpx2.Proxy(proxy_url)
+                except (ValueError, httpx2.InvalidURL) as e:
+                    raise InvalidEnvironmentError(
+                        f"The proxy specified by {env_var} is invalid: "
+                        f"{proxy_value!r}.\n\n{e}"
+                    ) from e
+
+                if not proxy.url.host:
+                    raise InvalidEnvironmentError(
+                        f"The proxy specified by {env_var} is invalid: "
+                        f"{proxy_value!r}."
+                    )
+
+    # Aliases for the environment validation, retained for clarity in callers that
+    # describe the check in terms of SSL or HTTP configuration.
