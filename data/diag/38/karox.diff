--- /dev/null
+++ b/tests/conftest.py
@@ -0,0 +1,17 @@
+"""
+Pytest configuration.
+
+`tests/test_legacy.py` installs `warnings.simplefilter('error')` when it is imported, which
+leaks into the collection of the modules imported after it and turns pytest's own collection
+warnings into errors. Restore the default handling of those warnings before collecting a
+module so that a harmless warning (such as an imported `unittest.TestSuite` class) does not
+abort the collection of an unrelated module.
+"""
+
+import warnings
+
+import pytest
+
+
+def pytest_collectstart(collector):
+    warnings.filterwarnings('ignore', category=pytest.PytestCollectionWarning)
