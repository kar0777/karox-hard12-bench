@@ -100,6 +100,20 @@ def find_table_identifier(segment: BaseSegment) -> BaseSegment | None:
     return table_identifier
 
 
+def find_stage_path(segment: BaseSegment) -> BaseSegment | None:
+    """
+    recursively find a Snowflake stage path, like @mystage/path/.
+    A stage path is parsed as an identifier segment with get_type() returning
+    stage_path.
+    """
+    if segment.type == "stage_path" or segment.get_type() == "stage_path":
+        return segment
+    for sub_segment in segment.segments:
+        if stage_path := find_stage_path(sub_segment):
+            return stage_path
+    return None
+
