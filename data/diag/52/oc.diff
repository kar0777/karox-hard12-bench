+    def _handle_from_clause(
+        self, segment: BaseSegment, holder: SubQueryLineageHolder
+    ) -> None:
+        if from_expression_element := find_from_expression_element(segment):
+            for table_expression in from_expression_element.get_children(
+                "table_expression"
+            ):
+                if storage_location := table_expression.get_child("storage_location"):
+                    holder.add_read(Path(storage_location.raw))
+                elif stage_path := find_stage_path(table_expression):
+                    holder.add_read(Path(stage_path.raw))
+
+    def _handle_subquery(
+        self, segment: BaseSegment, holder: SubQueryLineageHolder
+    ) -> None:
+        from .cte import CteExtractor
+        from .select import SelectExtractor
+
+        subquery = segment
+        if segment.type == "bracketed":
+            subquery = segment.get_child(
+                "select_statement", "set_expression", "with_compound_statement"
+            )
+        if subquery is None:
+            return
+        extractor_cls = (
+            CteExtractor
+            if subquery.type == "with_compound_statement"
+            else SelectExtractor
+        )
+        holder |= self.delegate_to(
+            extractor_cls,
+            subquery,
+            AnalyzerContext(
+                cte=holder.cte,
+                write=holder.write,
+                write_columns=holder.write_columns,
+            ),
+        )
