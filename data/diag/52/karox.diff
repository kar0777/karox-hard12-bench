--- a/sqllineage/core/parser/sqlfluff/utils.py
+++ b/sqllineage/core/parser/sqlfluff/utils.py
@@ -100,6 +100,23 @@ def find_table_identifier(segment: BaseSegment) -> BaseSegment | None:
     return table_identifier
 
 
+def find_stage_path(segment: BaseSegment) -> BaseSegment | None:
+    """
+    Find the snowflake stage path (like @mystage/path/) a segment refers to. It's either
+    a table_reference, as in FROM @mystage/path/, or a direct child of table_expression
+    when the stage is followed by an option list, as in
+    FROM @mystage/path/ (FILE_FORMAT => 'myformat')
+    """
+    stage_path = segment.get_child("stage_path")
+    if stage_path is None:
+        if table_expression := segment.get_child("table_expression"):
+            stage_path = table_expression.get_child("stage_path")
+            if stage_path is None:
+                if table_reference := table_expression.get_child("table_reference"):
+                    stage_path = table_reference.get_child("stage_path")
+    return stage_path
+
