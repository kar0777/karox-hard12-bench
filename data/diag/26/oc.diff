+name: Changelog
+
+on:
+  pull_request:
+    branches:
+      - dev
+    paths:
+      - "CHANGELOG.md"
+      - "scripts/check_changelog.py"
+      - "scripts/changelog_utils.py"
+      - ".github/workflows/changelog.yml"
+
+permissions:
+  contents: read
+
+jobs:
+  validate:
+    name: Validate changelog entries
+    runs-on: ubuntu-latest
+
+    defaults:
+      run:
+        shell: bash -l {0}
+
+    steps:
+      - name: Checkout repository
+        uses: actions/checkout@v7
+        with:
+          fetch-depth: 0
+
+      - name: Setup Pixi Environment
+        uses: prefix-dev/setup-pixi@v0.11.2
+        with:
+          pixi-version: latest
+          cache: true
+          cache-write: false
+
+      - name: Check that new entries are under Unreleased
+        run: |
+          pixi run python scripts/check_changelog.py \
+            --path CHANGELOG.md \
+            --base "${{ github.event.pull_request.base.sha }}" \
+            --head HEAD
