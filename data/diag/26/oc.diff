+"""Validate that new changelog entries are filed under ``[Unreleased]``.
+
+The script compares a pull request's changelog with the merge base of its
+target branch.  Only genuinely new entries are considered, so rebases,
+release-generated changelog rotations, link updates, and merge commits do not
+produce false positives.
+"""
+
+from __future__ import annotations
+
+import argparse
+import sys
+from pathlib import Path
+
+_SCRIPT_DIR = Path(__file__).resolve().parent
+if str(_SCRIPT_DIR) not in sys.path:
+    sys.path.insert(0, str(_SCRIPT_DIR))
+
+from changelog_utils import (  # noqa: E402
+    changelog_entries,
+    check_changelog,
+    check_changelog_additions,
+    check_changelog_entries,
+    extract_changelog_entries,
+    find_added_entries,
+    find_changelog_additions,
+    find_changelog_entries_outside_unreleased,
+    find_entries_added_between,
+    find_entries_outside_unreleased,
+    find_entries_since_release,
+    find_entries_since_tag,
+    find_misplaced_changelog_entries,
+    find_misplaced_entries,
+    find_repo,
+    get_added_changelog_entries,
+    get_changelog_entries,
+    git_file_at_ref,
+    git_ref_exists,
+    parse_changelog,
+    parse_entries,
+    parse_sections,
+    unreleased_entries,
+    validate_added_entries,
+    validate_changelog,
+    validate_changelog_additions,
+    validate_changelog_changes,
+    validate_changelog_entries,
+    validate_entries_since_release,
+    validate_entries_since_tag,
+    validate_git_changelog,
+    validate_pr_changelog,
+    validate_release_changelog,
+    validate_unreleased_changes,
+)
+
+__all__ = [
+    "changelog_entries",
+    "check_changelog",
+    "check_changelog_additions",
+    "check_changelog_entries",
+    "extract_changelog_entries",
+    "find_added_entries",
+    "find_changelog_additions",
+    "find_changelog_entries_outside_unreleased",
+    "find_entries_added_between",
+    "find_entries_outside_unreleased",
+    "find_entries_since_release",
+    "find_entries_since_tag",
+    "find_misplaced_changelog_entries",
+    "find_misplaced_entries",
+    "get_added_changelog_entries",
+    "get_changelog_entries",
+    "main",
+    "parse_changelog",
+    "parse_entries",
+    "parse_sections",
+    "unreleased_entries",
+    "validate_added_entries",
+    "validate_changelog",
+    "validate_changelog_additions",
+    "validate_changelog_changes",
+    "validate_changelog_entries",
+    "validate_entries_since_release",
+    "validate_entries_since_tag",
+    "validate_git_changelog",
+    "validate_pr_changelog",
+    "validate_release_changelog",
+    "validate_unreleased_changes",
+]
+
+
+def _resolve_merge_base(repo: Path, base: str, head: str) -> str:
+    """Return the merge base of ``base`` and ``head`` when one exists."""
+
+    import subprocess
+
+    result = subprocess.run(
+        ["git", "merge-base", base, head],
+        cwd=repo,
+        check=False,
+        capture_output=True,
+        text=True,
+    )
+    if result.returncode == 0 and result.stdout.strip():
+        return result.stdout.strip()
+    return base
+
+
+def main(argv: list[str] | None = None) -> int:
+    """Run the changelog validation command.
+
+    Args:
+        argv: Command-line arguments.  Defaults to ``sys.argv[1:]``.
+
+    Returns:
+        ``0`` when the changelog is valid, or ``1`` when a new entry is filed
+        outside ``[Unreleased]``.
+    """
+
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument(
+        "--path",
+        "--changelog",
+        "--changelog-path",
+        dest="path",
+        type=Path,
+        default=Path("CHANGELOG.md"),
+    )
+    parser.add_argument(
+        "--base",
+        "--base-ref",
+        "--base-sha",
+        "--from-ref",
+        dest="base",
+        required=True,
+        help="Base revision for the comparison.",
+    )
+    parser.add_argument(
+        "--head",
+        "--head-ref",
+        "--head-sha",
+        "--to-ref",
+        dest="head",
+        default="HEAD",
+        help="Head revision for the comparison (default: HEAD).",
+    )
+    parser.add_argument(
+        "--repo",
+        "--repo-path",
+        "--repo-root",
+        dest="repo_path",
+        type=Path,
+        help="Repository root (inferred from --path by default).",
+    )
+    parser.add_argument(
+        "--warn-only",
+        action="store_true",
+        help="Report a warning instead of failing.",
+    )
+    parser.add_argument(
+        "--no-merge-base",
+        action="store_true",
+        help="Compare with --base directly instead of its merge base.",
+    )
+    args = parser.parse_args(argv)
+
+    repo = args.repo_path or find_repo(args.path)
+    if repo is None:
+        parser.error(f"could not find a Git repository containing {args.path}")
+
+    base = args.base
+    if not args.no_merge_base:
+        base = _resolve_merge_base(repo, base, args.head)
+
+    if not git_ref_exists(repo, base):
+        parser.error(f"unknown Git revision: {base}")
+
+    try:
+        base_text = git_file_at_ref(repo, base, args.path)
+        if args.head == "HEAD" and args.path.is_file():
+            head_text = args.path.read_text(encoding="utf-8")
+        else:
+            head_text = git_file_at_ref(repo, args.head, args.path)
+        validate_changelog_additions(
+            base_text,
+            head_text,
+            warn_only=args.warn_only,
+        )
+    except ValueError as error:
+        print(error, file=sys.stderr)
+        return 1
+
+    print("Changelog additions are confined to [Unreleased].")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
