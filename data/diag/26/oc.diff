+++ b/tests/test_changelog_safeguards.py
@@ -0,0 +1,149 @@
+"""Tests for changelog validation safeguards."""
+
+from __future__ import annotations
+
+import subprocess
+from pathlib import Path
+
+import pytest
+
+from scripts.changelog_utils import (
+    find_entries_outside_unreleased,
+    validate_changelog_additions,
+)
+from scripts.update_changelog import rotate_changelog
+
+_BASE = """# Changelog
+
+## [Unreleased]
+
+## [v0.1.0] - 2026-01-01
+
+- An older entry.
+"""
+
+
+def _git(repo: Path, *args: str) -> None:
+    subprocess.run(
+        ["git", *args],
+        cwd=repo,
+        check=True,
+        capture_output=True,
+        text=True,
+    )
+
+
+def _init_repo(tmp_path: Path) -> Path:
+    repo = tmp_path / "repo"
+    repo.mkdir()
+    _git(repo, "init", "--quiet")
+    _git(repo, "config", "user.email", "test@example.com")
+    _git(repo, "config", "user.name", "Test User")
+    return repo
+
+
+def _write_changelog(path: Path, body: str) -> None:
+    path.write_text(
+        "# Changelog\n\n"
+        "## [Unreleased]\n"
+        f"{body}\n"
+        "## [v0.1.0] - 2026-01-01\n\n"
+        "- An older entry.\n\n"
+        "[Unreleased]: https://example.com/compare/v0.1.0...HEAD\n",
+        encoding="utf-8",
+    )
+
+
+def test_validate_changelog_allows_unreleased_additions():
+    """New entries under Unreleased are valid."""
+
+    head = _BASE.replace(
+        "## [Unreleased]\n\n",
+        "## [Unreleased]\n\n- [BUG] Fix a pending issue.\n\n",
+    )
+
+    assert validate_changelog_additions(_BASE, head) == []
+
+
+def test_validate_changelog_rejects_entry_filed_under_release():
+    """An entry added under a dated section is reported."""
+
+    head = _BASE.replace(
+        "- An older entry.",
+        "- An older entry.\n- [BUG] A misplaced entry.",
+    )
+
+    assert find_entries_outside_unreleased(_BASE, head) == [
+        "[BUG] A misplaced entry."
+    ]
+    with pytest.raises(ValueError, match="outside"):
+        validate_changelog_additions(_BASE, head)
+
+
+def test_validate_changelog_allows_release_rotation():
+    """Moving an Unreleased entry into a new release section is valid."""
+
+    base = _BASE.replace(
+        "## [Unreleased]\n\n",
+        "## [Unreleased]\n\n- [BUG] A pending entry.\n\n",
+    )
+    head = base.replace(
+        "## [Unreleased]\n\n- [BUG] A pending entry.\n\n",
+        "## [Unreleased]\n\n"
+        "## [v0.2.0] - 2026-02-01\n\n"
+        "- [BUG] A pending entry.\n\n",
+    )
+
+    assert validate_changelog_additions(base, head) == []
+
+
+def test_validate_changelog_ignores_link_updates():
+    """Comparison-link maintenance does not count as a changelog entry."""
+
+    head = _BASE.replace(
+        "[Unreleased]: https://example.com/compare/v0.1.0...HEAD\n",
+        "[Unreleased]: https://example.com/compare/v0.1.0...HEAD\n\n"
+        "[v0.0.1]: https://example.com/compare/v0.0.0...v0.0.1\n",
+    )
+
+    assert validate_changelog_additions(_BASE, head) == []
+
+
+def test_rotate_changelog_accepts_pending_git_entry(tmp_path: Path):
+    """Rotation succeeds when the pending entry is under Unreleased."""
+
+    repo = _init_repo(tmp_path)
+    changelog = repo / "CHANGELOG.md"
+    _write_changelog(changelog, "")
+    _git(repo, "add", "CHANGELOG.md")
+    _git(repo, "commit", "--quiet", "-m", "Prepare release")
+    _git(repo, "tag", "v0.1.0")
+
