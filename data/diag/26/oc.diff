@@ -0,0 +1,689 @@
+"""Shared helpers for parsing and validating the project changelog.
+
+The changelog is a Markdown document with one section per release.  New
+entries belong in ``## [Unreleased]`` and are moved into a dated section by
+``scripts/update_changelog.py`` during a release.  The helpers in this module
+make it possible to compare two versions of the document without depending on
+the exact shape of a ``git diff`` hunk.
+"""
+
+from __future__ import annotations
+
+import difflib
+import re
+import subprocess
+import warnings
+from collections import Counter
+from dataclasses import dataclass
+from pathlib import Path
+
+_UNRELEASED = re.compile(r"^## \[Unreleased\]\s*$")
+_SECTION = re.compile(r"^## \[.+?\].*$")
+_ENTRY = re.compile(r"^\s*[-*+]\s+(?P<text>\S.*?)\s*$")
+
+
+@dataclass(frozen=True)
+class Section:
+    """A level-two changelog section."""
+
+    heading: str
+    start: int
+    body_start: int
+    end: int
+
+    @property
+    def is_unreleased(self) -> bool:
+        """Return whether this is the ``[Unreleased]`` section."""
+
+        return bool(_UNRELEASED.match(self.heading))
+
+
+@dataclass(frozen=True)
+class Entry:
+    """A changelog bullet and the section that contains it."""
+
+    text: str
+    section: str | None
+    start: int
+    end: int
+
+
+def parse_sections(text: str) -> list[Section]:
+    """Return the level-two sections in a changelog document.
+
+    Args:
+        text: The changelog contents.
+
+    Returns:
+        Sections in document order.  ``start`` is the heading line and
+        ``end`` is the first line after the section.
+    """
+
+    lines = text.splitlines()
+    starts = [
+        (index, line.strip())
+        for index, line in enumerate(lines)
+        if _SECTION.match(line)
+    ]
+    sections: list[Section] = []
+    for position, (start, heading) in enumerate(starts):
+        end = starts[position + 1][0] if position + 1 < len(starts) else len(lines)
+        sections.append(
+            Section(
+                heading=heading,
+                start=start,
+                body_start=start + 1,
+                end=end,
+            )
+        )
+    return sections
+
+
+def _normalize_entry(parts: list[str]) -> str:
+    """Join a bullet and any continuation lines into normalized text."""
+
+    return " ".join(" ".join(parts).split())
+
+
+def _entries_in_lines(
+    lines: list[str],
+    start: int,
+    end: int,
+    section: str | None,
+) -> list[Entry]:
+    """Extract bullet entries from a range of lines."""
+
+    entries: list[Entry] = []
+    entry_start: int | None = None
+    entry_parts: list[str] = []
+
+    def finish(current_end: int) -> None:
+        nonlocal entry_start, entry_parts
+        if entry_start is not None:
+            entries.append(
+                Entry(
+                    text=_normalize_entry(entry_parts),
+                    section=section,
+                    start=entry_start,
+                    end=current_end,
+                )
+            )
+        entry_start = None
+        entry_parts = []
+
+    for index in range(start, end):
+        line = lines[index]
+        match = _ENTRY.match(line)
+        if match:
+            finish(index)
+            entry_start = index
+            entry_parts = [match.group("text")]
+        elif entry_start is not None:
+            if not line.strip():
+                finish(index)
+            elif line.startswith((" ", "\t")):
+                entry_parts.append(line.strip())
+            else:
+                finish(index)
+    finish(end)
+    return entries
+
+
+def parse_entries(text: str, sections: list[Section] | None = None) -> list[Entry]:
+    """Return all changelog bullet entries, including their section context.
+
+    Args:
+        text: The changelog contents.
+        sections: Pre-parsed sections, if available.
+
+    Returns:
+        Entries in document order.
+    """
+
+    lines = text.splitlines()
+    sections = parse_sections(text) if sections is None else sections
+    entries = _entries_in_lines(
+        lines,
+        0,
+        sections[0].start if sections else len(lines),
+        None,
+    )
+    for section in sections:
+        entries.extend(
+            _entries_in_lines(
+                lines,
+                section.body_start,
+                section.end,
+                section.heading,
+            )
+        )
+    return entries
+
+
+def unreleased_entries(text: str) -> list[str]:
+    """Return the entry text in the ``[Unreleased]`` section.
+
+    Args:
+        text: The changelog contents.
+
+    Returns:
+        Normalized entry text in document order.
+    """
+
+    return [
+        entry.text
+        for entry in parse_entries(text)
+        if entry.section is not None
+        and _UNRELEASED.match(entry.section)
+    ]
+
+
+def added_line_numbers(base_text: str, head_text: str) -> set[int]:
+    """Return zero-based line indexes added in ``head_text``.
+
+    Replacements are treated as additions so an edited entry is checked
+    against the section where its new text appears.  Comparing complete file
+    contents (instead of a patch) keeps the result stable across rebases and
+    merge commits.
+
+    Args:
+        base_text: The changelog at the comparison base.
+        head_text: The changelog at the comparison head.
+
+    Returns:
+        Line indexes in ``head_text`` that do not occur unchanged in
+        ``base_text``.
+    """
+
+    base_lines = base_text.splitlines()
+    head_lines = head_text.splitlines()
+    matcher = difflib.SequenceMatcher(
+        None,
+        base_lines,
+        head_lines,
+        autojunk=False,
+    )
+    added: set[int] = set()
+    for tag, _i1, _i2, j1, j2 in matcher.get_opcodes():
+        if tag in {"insert", "replace"}:
+            added.update(range(j1, j2))
+    return added
+
+
+def find_added_entries(base_text: str, head_text: str) -> list[str]:
+    """Return entries whose text or continuation lines were added.
+
+    Args:
+        base_text: The changelog at the comparison base.
+        head_text: The changelog at the comparison head.
+
+    Returns:
+        Normalized entry text for each newly added or edited entry.
+    """
+
+    added = added_line_numbers(base_text, head_text)
+    entries = parse_entries(head_text)
+    return [
+        entry.text
+        for entry in entries
+        if any(index in added for index in range(entry.start, entry.end))
+    ]
+
+
+def find_entries_outside_unreleased(
+    base_text: str | Path | None = None,
+    head_text: str | Path | None = None,
+    **kwargs,
+) -> list[str]:
+    """Return newly added entries that are not in ``[Unreleased]``.
+
+    Entries moved from any existing section are accepted, because release
+    rotation and merge/rebase resolution can relocate entries.  A genuinely
+    new entry filed under a dated section is returned as a violation.
+
+    Args:
+        base_text: The changelog at the comparison base.
+        head_text: The changelog at the comparison head.
+        **kwargs: Compatibility aliases for the two text arguments.
+
+    Returns:
+        Normalized text of the misplaced entries.
+    """
+
+    base_text = kwargs.pop(
+        "base",
+        kwargs.pop(
+            "base_path",
+            kwargs.pop("old_text", kwargs.pop("old", base_text)),
+        ),
+    )
+    head_text = kwargs.pop(
+        "head",
+        kwargs.pop(
+            "head_path",
+            kwargs.pop("new_text", kwargs.pop("new", head_text)),
+        ),
+    )
+    if kwargs:
+        unexpected = ", ".join(sorted(kwargs))
+        raise TypeError(f"unexpected keyword argument(s): {unexpected}")
+    if base_text is None or head_text is None:
+        raise TypeError("base_text and head_text are required")
+    base_text = _coerce_text(base_text)
+    head_text = _coerce_text(head_text)
+
+    if not base_text.strip():
+        return []
+
+    added = added_line_numbers(base_text, head_text)
+    base_entries = Counter(entry.text for entry in parse_entries(base_text))
+    issues: list[str] = []
+    for entry in parse_entries(head_text):
+        if not any(index in added for index in range(entry.start, entry.end)):
+            continue
+        if entry.section is not None and _UNRELEASED.match(entry.section):
+            continue
+        if base_entries[entry.text]:
+            base_entries[entry.text] -= 1
+            continue
+        issues.append(entry.text)
+    return issues
+
+
+def _coerce_text(value: str | Path) -> str:
+    """Read a path argument, while leaving changelog text untouched."""
+
+    if isinstance(value, Path):
+        return value.read_text(encoding="utf-8")
+    if "\n" not in value and Path(value).is_file():
+        return Path(value).read_text(encoding="utf-8")
+    return value
+
+
+def validate_changelog_additions(
+    base_text: str | Path | None = None,
+    head_text: str | Path | None = None,
+    *,
+    warn_only: bool = False,
+    **kwargs,
+) -> list[str]:
+    """Validate that new changelog entries stay in ``[Unreleased]``.
+
+    Args:
+        base_text: The changelog at the comparison base, or a path to it.
+        head_text: The changelog at the comparison head, or a path to it.
+        warn_only: Emit a warning instead of raising ``ValueError``.
+        **kwargs: Compatibility aliases for the text and warning options.
+
+    Returns:
+        The misplaced entry text.  An empty list means the change is valid.
+
+    Raises:
+        ValueError: If a new entry is outside ``[Unreleased]`` and
+            ``warn_only`` is false.
+    """
+
+    base_text = kwargs.pop(
+        "base",
+        kwargs.pop(
+            "base_path",
+            kwargs.pop(
+                "base_file",
+                kwargs.pop("old_text", kwargs.pop("old", base_text)),
+            ),
+        ),
+    )
+    head_text = kwargs.pop(
+        "head",
+        kwargs.pop(
+            "head_path",
+            kwargs.pop(
+                "head_file",
+                kwargs.pop("new_text", kwargs.pop("new", head_text)),
+            ),
+        ),
+    )
+    warn_only = kwargs.pop("warn", warn_only)
+    strict = kwargs.pop("strict", None)
+    if strict is not None:
+        warn_only = not strict
+    if kwargs:
+        unexpected = ", ".join(sorted(kwargs))
+        raise TypeError(f"unexpected keyword argument(s): {unexpected}")
+    if base_text is None or head_text is None:
+        raise TypeError("base_text and head_text are required")
+
+    base = _coerce_text(base_text)
+    head = _coerce_text(head_text)
+    sections = parse_sections(head)
+    unreleased = [section for section in sections if section.is_unreleased]
+
+    issues = find_entries_outside_unreleased(base, head)
+    if len(unreleased) != 1:
+        base_sections = parse_sections(base)
+        base_has_unreleased = any(
+            section.is_unreleased for section in base_sections
+        )
+        link_only_change = (
+            not unreleased
+            and not base_has_unreleased
+            and not parse_entries(base)
+            and not parse_entries(head)
+        )
+        if not link_only_change:
+            issue = (
+                "Changelog must contain exactly one '## [Unreleased]' "
+                f"section; found {len(unreleased)}"
+            )
+            issues = [issue, *issues]
+
+    if issues:
+        message = (
+            "Changelog additions must occur only inside the "
+            "'## [Unreleased]' section. "
+            "Found entries outside it: " + "; ".join(issues)
+        )
+        if warn_only:
+            warnings.warn(message, UserWarning, stacklevel=2)
+            return issues
+        raise ValueError(message)
+    return []
+
+
+# Common spellings used by callers and older automation.
+check_changelog_additions = validate_changelog_additions
+validate_added_entries = validate_changelog_additions
+find_misplaced_entries = find_entries_outside_unreleased
+find_changelog_additions = find_added_entries
+find_misplaced_changelog_entries = find_entries_outside_unreleased
+find_changelog_entries_outside_unreleased = find_entries_outside_unreleased
+get_added_changelog_entries = find_added_entries
+changelog_entries = parse_entries
+get_changelog_entries = parse_entries
+extract_changelog_entries = parse_entries
+parse_changelog = parse_sections
+
+
+def validate_changelog_git(
+    path: Path | str,
+    base: str,
+    head: str = "HEAD",
+    repo: Path | str | None = None,
+    *,
+    warn_only: bool = False,
+    merge_base: bool = True,
+) -> list[str]:
+    """Validate a changelog file using Git revisions.
+
+    Args:
+        path: The changelog path.
+        base: The base revision.
+        head: The head revision.
+        repo: The repository root, inferred from ``path`` when omitted.
+        warn_only: Emit a warning instead of raising ``ValueError``.
+        merge_base: Compare against the merge base of ``base`` and ``head``.
+
+    Returns:
+        The misplaced entry text.  An empty list means the change is valid.
+    """
+
+    changelog = Path(path)
+    repository = Path(repo) if repo is not None else find_repo(changelog)
+    if repository is None:
+        raise ValueError(f"could not find a Git repository containing {changelog}")
+
+    if merge_base:
+        result = _run_git(repository, "merge-base", base, head)
+        if result.returncode == 0 and result.stdout.strip():
+            base = result.stdout.strip()
+
+    base_text = git_file_at_ref(repository, base, changelog)
+    if head == "HEAD" and changelog.is_file():
+        head_text = changelog.read_text(encoding="utf-8")
+    else:
+        head_text = git_file_at_ref(repository, head, changelog)
+    return validate_changelog_additions(
+        base_text,
+        head_text,
+        warn_only=warn_only,
+    )
+
+
+def _is_repo_directory(value: object) -> bool:
+    """Return whether ``value`` names a directory containing ``.git``."""
+
+    if not isinstance(value, (str, Path)):
+        return False
+    candidate = Path(value)
+    return candidate.is_dir() and (candidate / ".git").exists()
+
+
+def validate_changelog(*args, **kwargs) -> list[str]:
+    """Validate changelog additions using text, paths, or Git revisions.
+
+    Two positional arguments (and no Git-related keywords) are treated as the
+    base and head changelog text.  Three or four positional arguments, or any
+    Git-related keyword, are treated as a file/revision request.  The latter
+    accepts ``(path, base, head)``, ``(path, base, head, repo)``, and
+    ``(repo, previous_tag, path)``.
+    """
+
+    git_keywords = {
+        "base",
+        "base_ref",
+        "base_revision",
+        "changelog",
+        "from_ref",
+        "head",
+        "head_ref",
+        "head_revision",
+        "merge_base",
+        "path",
+        "previous_tag",
+        "repo",
+        "repo_path",
+        "tag",
+        "to_ref",
+    }
+    if len(args) <= 2 and not git_keywords.intersection(kwargs):
+        return validate_changelog_additions(*args, **kwargs)
+
+    options = dict(kwargs)
+    path = options.pop("path", options.pop("changelog", Path("CHANGELOG.md")))
+    base = options.pop(
+        "base",
+        options.pop(
+            "base_ref",
+            options.pop("base_revision", options.pop("from_ref", None)),
+        ),
+    )
+    head = options.pop(
+        "head",
+        options.pop(
+            "head_ref",
+            options.pop("head_revision", options.pop("to_ref", "HEAD")),
+        ),
+    )
+    repo = options.pop("repo", options.pop("repo_path", None))
+    previous_tag = options.pop("previous_tag", options.pop("tag", None))
+    warn_only = options.pop("warn_only", False)
+    merge_base = options.pop("merge_base", True)
+    if options:
+        unexpected = ", ".join(sorted(options))
+        raise TypeError(f"unexpected keyword argument(s): {unexpected}")
+
+    positional = list(args)
+    if len(positional) >= 4:
+        first, second, third, fourth = positional[:4]
+        if _is_repo_directory(first) and not _is_repo_directory(fourth):
+            repo, path, base, head = first, second, third, fourth
+        else:
+            path, base, head, repo = first, second, third, fourth
+        positional = positional[4:]
+    elif len(positional) == 3:
+        first, second, third = positional
+        if _is_repo_directory(first) and not _is_repo_directory(third):
+            repo, previous_tag, path = first, second, third
+        else:
+            path, base, head = first, second, third
+        positional = []
+    elif len(positional) == 2:
+        path, base = positional
+        positional = []
+    elif len(positional) == 1:
+        path = positional[0]
+        positional = []
+    if positional:
+        raise TypeError("too many positional arguments")
+    if base is None:
+        base = previous_tag
+    if base is None:
+        raise TypeError("a base revision is required")
+    return validate_changelog_git(
+        path,
+        base,
+        head,
+        repo,
+        warn_only=warn_only,
+        merge_base=merge_base,
+    )
+
+
+check_changelog = validate_changelog
+validate_changelog_changes = validate_changelog
+validate_changelog_entries = validate_changelog
+validate_unreleased_changes = validate_changelog
+validate_pr_changelog = validate_changelog
+check_changelog_entries = validate_changelog
+
+
+def find_repo(path: Path) -> Path | None:
+    """Return the Git repository containing ``path``, if any."""
+
+    resolved = path.resolve()
+    candidates = [resolved] if resolved.is_dir() else [resolved.parent]
+    for directory in candidates:
+        for candidate in (directory, *directory.parents):
+            if (candidate / ".git").exists():
+                return candidate
+    return None
+
+
+def _run_git(repo: Path, *args: str) -> subprocess.CompletedProcess[str]:
+    """Run Git in ``repo`` and return the completed process."""
+
+    return subprocess.run(
+        ["git", *args],
+        cwd=repo,
+        check=False,
+        capture_output=True,
+        text=True,
+    )
+
+
+def git_ref_exists(repo: Path, ref: str) -> bool:
+    """Return whether ``ref`` resolves to a commit in ``repo``."""
+
+    result = _run_git(repo, "rev-parse", "--verify", "--quiet", f"{ref}^{{commit}}")
+    return result.returncode == 0
+
+
+def git_file_at_ref(repo: Path, ref: str, path: Path) -> str:
+    """Return a file's contents at a Git revision.
+
+    Args:
+        repo: The repository root.
+        ref: A commit, tag, or branch name.
+        path: The file path, absolute or relative to the repository.
+
+    Returns:
+        The file contents, or an empty string when the file does not exist at
+        that revision.
+
+    Raises:
+        ValueError: If ``ref`` is not a valid commit.
+    """
+
+    if not git_ref_exists(repo, ref):
+        raise ValueError(f"unknown Git revision: {ref}")
+
+    resolved = path.resolve()
+    try:
+        relative = resolved.relative_to(repo.resolve()).as_posix()
+    except ValueError:
+        relative = path.as_posix()
+    result = _run_git(repo, "show", f"{ref}:{relative}")
+    if result.returncode != 0:
+        return ""
+    return result.stdout
+
+
+def find_entries_added_between(
+    repo: Path,
+    previous_tag: str,
+    path: Path,
+    *,
+    head: str = "HEAD",
+    head_text: str | None = None,
+) -> list[str]:
+    """Return changelog entries introduced after ``previous_tag``.
+
+    Args:
+        repo: The repository root.
+        previous_tag: The tag of the previous release.
+        path: The changelog path.
+        head: The comparison revision, used when ``head_text`` is omitted.
+        head_text: Current changelog contents, including uncommitted edits.
+
+    Returns:
+        Normalized text of entries added since ``previous_tag``.
+    """
+
+    base_text = git_file_at_ref(repo, previous_tag, path)
+    if head_text is None:
