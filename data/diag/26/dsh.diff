+"""Validate that changelog additions stay under the Unreleased section."""
+
+from __future__ import annotations
+
+import importlib.util
+from pathlib import Path
+from types import ModuleType
+from typing import Any
+
+
+def _load_update_module() -> ModuleType:
+    """Load the changelog implementation from its sibling script."""
+
+    script = Path(__file__).with_name("update_changelog.py")
+    spec = importlib.util.spec_from_file_location("_changelog_update", script)
+    assert spec is not None and spec.loader is not None
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+_UPDATE = _load_update_module()
+
+
+def __getattr__(name: str) -> Any:
+    """Delegate public helpers and aliases to the implementation module."""
+
+    return getattr(_UPDATE, name)
+
+
+def main() -> None:
+    """Run validation by default, or rotation when ``--version`` is supplied."""
+
+    import sys
+
+    argv = sys.argv[1:]
+    check_flags = {"--check", "--validate", "--validate-only"}
+    if "--version" not in argv and not check_flags.intersection(argv):
+        argv = ["--check", *argv]
+    _UPDATE.main(argv)
+
+
+if __name__ == "__main__":
+    main()
