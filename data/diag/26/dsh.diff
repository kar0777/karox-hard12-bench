new file mode 100644
index 0000000..0881873
--- /dev/null
+++ b/scripts/check_changelog.py
@@ -0,0 +1,44 @@
+"""Validate that changelog additions stay under the Unreleased section."""
+
+from __future__ import annotations
+
+import importlib.util
+from pathlib import Path
+from types import ModuleType
+from typing import Any
+
+
+def _load_update_module() -> ModuleType:
+    """Load the changelog implementation from its sibling script."""
+
+    script = Path(__file__).with_name("update_changelog.py")
+    spec = importlib.util.spec_from_file_location("_changelog_update", script)
+    assert spec is not None and spec.loader is not None
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+_UPDATE = _load_update_module()
+
+
+def __getattr__(name: str) -> Any:
+    """Delegate public helpers and aliases to the implementation module."""
+
+    return getattr(_UPDATE, name)
+
+
+def main() -> None:
+    """Run validation by default, or rotation when ``--version`` is supplied."""
+
+    import sys
+
+    argv = sys.argv[1:]
+    check_flags = {"--check", "--validate", "--validate-only"}
+    if "--version" not in argv and not check_flags.intersection(argv):
+        argv = ["--check", *argv]
+    _UPDATE.main(argv)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/scripts/update_changelog.py b/scripts/update_changelog.py
index e03db3b..1db0e5f 100644
--- a/scripts/update_changelog.py
+++ b/scripts/update_changelog.py
@@ -1,15 +1,535 @@
-"""Move the pending changelog entries into a versioned release section."""
+"""Move pending changelog entries into a versioned release section."""
 
 from __future__ import annotations
 
 import argparse
 import re
+import subprocess
+from collections import Counter
 from datetime import date
 from pathlib import Path
+from typing import Iterable, Mapping
 
 _UNRELEASED = re.compile(r"^## \[Unreleased\]\s*$", re.MULTILINE)
 _SECTION = re.compile(r"^## \[.+?\].*$", re.MULTILINE)
+_SECTION_HEADING = re.compile(r"^## \[(?P<label>[^\]]+)\](?P<rest>.*)$")
 _UNRELEASED_LINK = re.compile(r"^\[Unreleased\]: (?P<url>\S+)[ \t]*$", re.MULTILINE)
+_LINK_DEFINITION = re.compile(r"^\[[^\]]+\]:\s+\S+")
+_RELEASE_COMMIT = re.compile(
+    r"\bPrepare release v?(?P<version>\d+\.\d+\.\d+)\b", re.IGNORECASE
+)
+_EMPTY_RELEASE = "-   No user-facing changes; see the generated release notes."
+
+
+class _ChangelogSection:
+    """The meaningful body of one changelog section."""
+
+    __slots__ = ("label", "body")
+
+    def __init__(self, label: str, body: tuple[str, ...]) -> None:
+        self.label = label
+        self.body = body
+
+
+def _parse_sections(text: str) -> list[_ChangelogSection]:
+    """Split changelog text into sections, excluding links and blank lines."""
+
+    sections: list[_ChangelogSection] = []
+    label: str | None = None
+    body: list[str] = []
+
+    def append_section() -> None:
+        if label is None:
+            return
+        meaningful_body = tuple(
+            line.strip()
+            for line in body
+            if line.strip() and not _LINK_DEFINITION.match(line.strip())
+        )
+        sections.append(_ChangelogSection(label=label, body=meaningful_body))
+
+    for line in text.splitlines():
+        heading = _SECTION_HEADING.match(line)
+        if heading is not None:
+            append_section()
+            label = heading.group("label")
+            body = []
+        elif label is not None:
+            body.append(line)
+    append_section()
+    return sections
+
+
+def _version_key(version: str) -> str:
+    """Return a version label without its optional ``v`` prefix."""
+
+    return version.strip().removeprefix("v")
+
+
+def _counter_without_placeholder(body: Iterable[str]) -> Counter[str]:
+    """Return a line counter that ignores the generated empty-release text."""
+
+    counter = body.copy() if isinstance(body, Counter) else Counter(body)
+    counter.pop(_EMPTY_RELEASE, None)
+    return counter
+
+
+def _is_release_rotation(
+    body: tuple[str, ...],
+    base_unreleased: Counter[str],
+) -> bool:
+    """Return whether a new section looks like release-generated rotation."""
+
+    if not body or body == (_EMPTY_RELEASE,):
+        return True
+    return _counter_without_placeholder(body) <= _counter_without_placeholder(
+        base_unreleased
+    )
+
+
+def _is_rotation_into_existing_section(
+    base_body: tuple[str, ...],
+    head_body: tuple[str, ...],
+    base_unreleased: Counter[str],
+) -> bool:
+    """Allow release rotation into a heading that already existed in the base."""
+
+    base_counter = _counter_without_placeholder(base_body)
+    head_counter = _counter_without_placeholder(head_body)
+    additions = head_counter - base_counter
+    removals = base_counter - head_counter
+    if not additions:
+        return False
+    return additions <= _counter_without_placeholder(base_unreleased) and not removals
+
+
+def _compare_section_bodies(
+    label: str,
+    expected_body: tuple[str, ...],
+    actual_body: tuple[str, ...],
+) -> list[str]:
+    """Describe additions and removals between two version-section bodies."""
+
+    if expected_body == actual_body:
+        return []
+    expected_counter = _counter_without_placeholder(expected_body)
+    actual_counter = _counter_without_placeholder(actual_body)
+    additions = actual_counter - expected_counter
+    removals = expected_counter - actual_counter
+    violations = [
+        f"entry {line!r} was added to release section "
+        f"'## [{label}]' instead of '## [Unreleased]'"
+        for line in additions.elements()
+    ]
+    violations.extend(
+        f"entry {line!r} was removed from release section "
+        f"'## [{label}]' outside '## [Unreleased]'"
+        for line in removals.elements()
+    )
+    if not additions and not removals:
+        violations.append(
+            f"release section '## [{label}]' was modified outside "
+            "'## [Unreleased]'"
+        )
+    return violations
+
+
+def find_changelog_violations(
+    base_text: str,
+    head_text: str,
+    *,
+    allowed_release_versions: Iterable[str] = (),
+    release_section_bodies: Mapping[str, Iterable[str]] | None = None,
+) -> list[str]:
+    """Find changelog changes that could assign entries to the wrong release.
+
+    Changes under ``[Unreleased]`` and comparison-link definitions are always
+    allowed. New or changed version sections are allowed only when they look
+    like release-generated rotation (their entries came from the base
+    ``[Unreleased]`` body) or belong to a release tag created since the base.
+
+    Args:
+        base_text: The changelog contents at the comparison base.
+        head_text: The changelog contents to validate.
+        allowed_release_versions: Version labels whose sections may have been
+            generated by releases between the base and the candidate revision.
+        release_section_bodies: Optional expected bodies for allowed release
+            versions. When supplied, additions after the release are still
+            detected instead of skipping the whole section.
+
+    Returns:
+        Human-readable descriptions of each violation. An empty list means the
+        changelog only adds entries under ``[Unreleased]`` (apart from allowed
+        release-generated changes).
+    """
+
+    allowed_versions = {
+        _version_key(version) for version in allowed_release_versions
+    }
+    allowed_bodies = {
+        _version_key(version): tuple(body)
+        for version, body in (release_section_bodies or {}).items()
+    }
+    base_sections = _parse_sections(base_text)
+    head_sections = _parse_sections(head_text)
+    base_by_label = {section.label: section for section in base_sections}
+    head_by_label = {section.label: section for section in head_sections}
+    base_unreleased = Counter(
+        base_by_label.get("Unreleased", _ChangelogSection("Unreleased", ())).body
+    )
+    violations: list[str] = []
+
+    for label, base_section in base_by_label.items():
+        if label == "Unreleased":
+            continue
+        version = _version_key(label)
+        if label in head_by_label:
+            continue
+        if version in allowed_bodies and allowed_bodies[version]:
+            violations.extend(
+                _compare_section_bodies(label, allowed_bodies[version], ())
+            )
+        elif version not in allowed_versions:
+            violations.append(
+                f"release section '## [{label}]' was removed outside "
+                "'## [Unreleased]'"
+            )
+
+    for label, head_section in head_by_label.items():
+        if label == "Unreleased":
+            continue
+
+        version = _version_key(label)
+        if version in allowed_bodies:
+            violations.extend(
+                _compare_section_bodies(
+                    label,
+                    allowed_bodies[version],
+                    head_section.body,
+                )
+            )
+            continue
+        if version in allowed_versions:
+            continue
+
+        base_section = base_by_label.get(label)
+        if base_section is None:
+            if _is_release_rotation(head_section.body, base_unreleased):
+                continue
+            extra_lines = _counter_without_placeholder(
+                head_section.body
+            ) - _counter_without_placeholder(base_unreleased)
+            for line in extra_lines.elements():
+                violations.append(
+                    f"entry {line!r} was added to release section "
+                    f"'## [{label}]' instead of '## [Unreleased]'"
+                )
+            continue
+
+        if head_section.body == base_section.body:
+            continue
+        if _is_rotation_into_existing_section(
+            base_section.body,
+            head_section.body,
+            base_unreleased,
+        ):
+            continue
+
+        violations.extend(
+            _compare_section_bodies(
+                label,
+                base_section.body,
+                head_section.body,
+            )
+        )
+
+    return violations
+
+
+def _run_git(repo: Path, *args: str) -> str:
+    """Run a git command in ``repo`` and return its stripped standard output."""
+
+    result = subprocess.run(
+        ["git", "-C", str(repo), *args],
+        check=False,
+        capture_output=True,
+        text=True,
+    )
+    if result.returncode != 0:
+        message = result.stderr.strip() or result.stdout.strip()
+        raise ValueError(f"git {' '.join(args)} failed: {message}")
+    return result.stdout.strip()
+
+
+def _find_repo_root(path: Path, repo_path: Path | None) -> Path:
+    """Locate the git worktree containing ``path``."""
+
+    start = repo_path if repo_path is not None else path.resolve().parent
+    result = subprocess.run(
+        ["git", "-C", str(start), "rev-parse", "--show-toplevel"],
+        check=False,
+        capture_output=True,
+        text=True,
+    )
+    if result.returncode != 0:
+        raise ValueError(f"{path} is not inside a git repository")
+    return Path(result.stdout.strip()).resolve()
+
+
+def _resolve_base(repo: Path, base_ref: str, use_merge_base: bool) -> str:
+    """Resolve a base reference to the commit whose changelog is compared."""
+
+    reference = base_ref.strip()
+    if not reference:
+        raise ValueError("base reference must not be empty")
+    _run_git(repo, "rev-parse", "--verify", f"{reference}^{{commit}}")
+    if not use_merge_base:
+        return _run_git(repo, "rev-parse", f"{reference}^{{commit}}")
+    return _run_git(repo, "merge-base", reference, "HEAD")
+
+
+def _latest_release_base(repo: Path, base_commit: str) -> str:
+    """Advance the base to the latest release tag reachable from ``HEAD``.
+
+    A pull request can be based on an older commit and then merge or rebase
+    onto a release commit. Comparing against that older base would incorrectly
+    treat the release-generated changelog section as part of the pull request.
+    Using the latest reachable tag as the base keeps those changes out of the
+    comparison while still exposing entries added to the tagged section later.
+    Tags at ``HEAD`` are skipped because release workflows create a candidate
+    tag before rotating the changelog.
+    """
+
+    try:
+        latest_tag = _run_git(
+            repo,
+            "describe",
+            "--tags",
+            "--match",
+            "v*",
+            "--abbrev=0",
+            "HEAD",
+        )
+        latest_commit = _run_git(
+            repo,
+            "rev-parse",
+            f"{latest_tag}^{{commit}}",
+        )
+        head_commit = _run_git(repo, "rev-parse", "HEAD")
+        if latest_commit == head_commit:
+            # Release workflows create a candidate tag before rotating the
+            # changelog. A tag at HEAD therefore cannot yet be treated as a
+            # completed release baseline.
+            latest_tag = _run_git(
+                repo,
+                "describe",
+                "--tags",
+                "--match",
+                "v*",
+                "--abbrev=0",
+                "HEAD^",
+            )
+            latest_commit = _run_git(
+                repo,
+                "rev-parse",
+                f"{latest_tag}^{{commit}}",
+            )
+    except ValueError:
+        return base_commit
+
+    if latest_commit == base_commit:
+        return base_commit
+    result = subprocess.run(
+        [
+            "git",
+            "-C",
+            str(repo),
+            "merge-base",
+            "--is-ancestor",
+            base_commit,
+            latest_commit,
+        ],
+        check=False,
+        capture_output=True,
+        text=True,
+    )
+    return latest_commit if result.returncode == 0 else base_commit
+
+
+def _section_body_for_version(
+    text: str,
+    version: str,
+) -> tuple[str, ...] | None:
+    """Return the body of the section for ``version`` in changelog text."""
+
+    normalized_version = _version_key(version)
+    for section in _parse_sections(text):
+        if _version_key(section.label) == normalized_version:
+            return section.body
+    return None
+
+
+def _release_sections_since(
+    repo: Path,
+    base_commit: str,
+    relative_path: str,
+) -> dict[str, tuple[str, ...]]:
+    """Return known release-section bodies created after ``base_commit``."""
+
+    head_tags = set(
+        _run_git(repo, "tag", "--merged", "HEAD", "--list", "v*").splitlines()
+    )
+    base_tags = set(
+        _run_git(repo, "tag", "--merged", base_commit, "--list", "v*").splitlines()
+    )
+    release_sections: dict[str, tuple[str, ...]] = {}
+
+    for tag in sorted(head_tags - base_tags):
+        version = _version_key(tag)
+        try:
+            text = _run_git(repo, "show", f"{tag}:{relative_path}")
+        except ValueError:
+            continue
+        body = _section_body_for_version(text, version)
+        if body is not None:
+            release_sections[version] = body
+
+    commits = _run_git(
+        repo,
+        "log",
+        "--format=%H%x00%s",
+        f"{base_commit}..HEAD",
+        "--",
+        relative_path,
+    ).splitlines()
+    for entry in commits:
+        commit_hash, _, subject = entry.partition("\0")
+        match = _RELEASE_COMMIT.search(subject)
+        if match is None:
+            continue
+        version = _version_key(match.group("version"))
+        if version in release_sections:
+            continue
+        try:
+            text = _run_git(repo, "show", f"{commit_hash}:{relative_path}")
+        except ValueError:
+            continue
+        body = _section_body_for_version(text, version)
+        if body is not None:
+            release_sections[version] = body
+
+    return release_sections
+
+
+def validate_changelog(
+    path: Path,
+    base_ref: str,
+    *,
+    repo_path: Path | None = None,
+    use_merge_base: bool = True,
+) -> bool:
+    """Validate that changelog changes since ``base_ref`` stay in Unreleased.
+
+    The comparison uses the merge base by default, so rebased branches and
+    merge commits are compared by their final content rather than by their
+    commit-by-commit history. Release-generated version sections, release
+    commit messages, tags created since the base, and comparison-link updates
+    are ignored.
+
+    Args:
+        path: Path to the changelog to validate.
+        base_ref: Git revision to compare against, such as ``origin/dev`` or
+            the previous release tag.
+        repo_path: Optional path inside the git repository. Defaults to the
+            changelog's parent directory.
+        use_merge_base: Compare against the merge base of ``base_ref`` and
+            ``HEAD`` instead of the exact base commit.
+
+    Returns:
+        ``True`` when the changelog is valid.
+
+    Raises:
+        ValueError: If the changelog modifies versioned sections outside
+            ``[Unreleased]``, or if git cannot resolve the comparison base.
+    """
+
+    path = Path(path)
+    repo = _find_repo_root(path, repo_path)
+    try:
+        relative_path = path.resolve().relative_to(repo).as_posix()
+    except ValueError as exc:
+        raise ValueError(f"{path} is outside the git repository {repo}") from exc
+
+    base_commit = _resolve_base(repo, base_ref, use_merge_base)
+    base_commit = _latest_release_base(repo, base_commit)
+    try:
+        base_text = _run_git(repo, "show", f"{base_commit}:{relative_path}")
+    except ValueError:
+        # The changelog did not exist at the base revision. Treat it as empty
+        # so that newly added version sections still receive normal checks.
+        base_text = ""
+
+    head_text = path.read_text(encoding="utf-8")
+    release_sections = _release_sections_since(
+        repo,
+        base_commit,
+        relative_path,
+    )
+    violations = find_changelog_violations(
+        base_text,
+        head_text,
+        allowed_release_versions=release_sections,
+        release_section_bodies=release_sections,
+    )
+    if violations:
+        details = "\n".join(f"  - {violation}" for violation in violations)
+        raise ValueError(
+            "changelog changes outside '## [Unreleased]' may assign entries "
+            f"to the wrong release:\n{details}"
+        )
+    return True
+
+
