+def _iter_entries(text: str) -> Iterator[tuple[str | None, str]]:
+    """Yield the section heading and text of every changelog entry."""
+
+    section = None
+    lines = text.splitlines()
+    index = 0
+    while index < len(lines):
+        line = lines[index]
+        index += 1
+        heading = _SECTION.match(line)
+        if heading is not None:
+            section = heading.group(0).strip()
+            continue
+        entry = _ENTRY.match(line)
+        if entry is None:
+            continue
+        parts = [entry["text"].strip()]
+        while index < len(lines) and _CONTINUATION.match(lines[index]):
+            parts.append(lines[index].strip())
+            index += 1
+        yield section, " ".join(parts)
+
+
+def _normalize(text: str) -> str:
+    """Collapse whitespace so reflowed entries still compare equal."""
+
+    return " ".join(text.split())
+
+
+def _entry_text(line: str) -> str:
+    """Return the entry text of a bullet line, without the bullet marker."""
+
+    match = _ENTRY.match(line)
+    return match["text"].strip() if match is not None else line.strip()
+
+
+def _is_unreleased(section: str | None) -> bool:
+    """Report whether a section heading is the ``[Unreleased]`` heading."""
+
+    return section is not None and section.startswith("## [Unreleased]")
+
+
+def find_misfiled_entries(base_text: str, head_text: str) -> list[str]:
+    """Find entries that were added outside the ``[Unreleased]`` section.
+
+    Comparing entry text against the base revision keeps the check stable
+    across rebases, merge commits, and reordering. Entries that already
+    existed in the base revision are not new, so a release rotation that
+    moves them under a version heading is not reported. Link definitions
+    and the empty-release placeholder are ignored as well.
+
+    Args:
+        base_text: Contents of the changelog at the base revision.
+        head_text: Contents of the changelog at the head revision.
+
+    Returns:
+        The text of each newly added entry that is not filed under
+        ``## [Unreleased]``, in changelog order.
+    """
+
+    known = {_normalize(text) for _, text in _iter_entries(base_text)}
+    known.add(_normalize(_entry_text(EMPTY_RELEASE_PLACEHOLDER)))
+
+    misfiled = []
+    for section, text in _iter_entries(head_text):
+        normalized = _normalize(text)
+        if _is_unreleased(section) or normalized in known:
+            continue
+        known.add(normalized)
+        misfiled.append(text)
+    return misfiled
+
+
+def check_changelog_update(base_text: str, head_text: str) -> None:
+    """Reject changelog entries that were added outside ``[Unreleased]``.
+
+    Args:
+        base_text: Contents of the changelog at the base revision.
+        head_text: Contents of the changelog at the head revision.
+
+    Raises:
+        ValueError: If any new entry is filed under a released version.
+    """
+
+    misfiled = find_misfiled_entries(base_text, head_text)
+    if not misfiled:
+        return
+    entries = "\n".join(f"  {entry}" for entry in misfiled)
+    raise ValueError(
+        "changelog entries must be added under '## [Unreleased]', but these "
+        f"entries were added elsewhere:\n{entries}"
+    )
+
+
+def _read_git_file(path: Path, ref: str) -> str:
+    """Read ``path`` as it exists at ``ref`` in the git repository."""
+
+    spec = f"{ref}:{path.as_posix()}"
+    result = subprocess.run(
+        ["git", "show", spec],
+        check=False,
+        capture_output=True,
+        text=True,
+    )
+    if result.returncode != 0:
+        raise ValueError(
+            f"could not read {spec} for the changelog check: "
+            f"{result.stderr.strip()}"
+        )
+    return result.stdout
+
