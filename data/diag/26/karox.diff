diff --git a/.github/workflows/changelog.yml b/.github/workflows/changelog.yml
new file mode 100644
index 0000000..59683f4
--- /dev/null
+++ b/.github/workflows/changelog.yml
@@ -0,0 +1,59 @@
+name: Changelog placement
+
+on:
+  # Pull requests must only add entries under the "## [Unreleased]" heading.
+  pull_request:
+    branches:
+      - dev
+    paths:
+      - "CHANGELOG.md"
+  # A release can rotate the pending entries while a PR is still open.
+  # The merge commit then files that PR entry under the new version, so the
+  # same check runs against the previous dev commit after the merge.
+  push:
+    branches:
+      - dev
+    paths:
+      - "CHANGELOG.md"
+
+permissions:
+  contents: read
+
+concurrency:
+  group: ${{ github.workflow }}-${{ github.ref }}
+  cancel-in-progress: true
+
+jobs:
+  check-changelog:
+    name: Guard changelog placement
+    runs-on: ubuntu-latest
+
+    steps:
+      - name: Checkout repository
+        uses: actions/checkout@v7
+        with:
+          fetch-depth: 0
+
+      - name: Setup Python
+        uses: actions/setup-python@v7
+        with:
+          python-version: 3.13
+
+      - name: Compare changelog with the base revision
+        env:
+          EVENT_NAME: ${{ github.event_name }}
+          BASE_REF: ${{ github.event.pull_request.base.ref }}
+          BEFORE_SHA: ${{ github.event.before }}
+        run: |
+          set -euo pipefail
+          if [[ "$EVENT_NAME" == "pull_request" ]]; then
+            git fetch --no-tags origin "$BASE_REF"
+            compare_ref="origin/$BASE_REF"
+          else
+            compare_ref="$BEFORE_SHA"
+            if [[ -z "$compare_ref" || "$compare_ref" =~ ^0+$ ]]; then
+              echo "No previous dev commit to compare against."
+              exit 0
+            fi
+          fi
+          python scripts/update_changelog.py --check --base-ref "$compare_ref"
