+def session_share_token(session_id: str) -> str | None:
+    """The share token ``session_id``'s live sidecar still carries, or None.
+
+    A public share is only served while its conversation still exists and still
+    holds that token: the sidecar is removed with the conversation, and a revoke
+    clears the token, so a snapshot whose session is gone (or has moved on to a
+    newer link) is dead even when no revoke ever reached the snapshot store.
+    The bounded metadata prefix answers the common case; a prefix miss parses
+    the whole sidecar. A missing, unreadable or tokenless sidecar reports no
+    live share, so callers fail closed instead of serving an orphaned link.
+    """
+    sid = str(session_id or "").strip()
+    if not sid or not is_safe_session_id(sid):
+        return None
+    try:
+        fields = _persisted_share_fields(SESSION_DIR / f"{sid}.json")
+    except Exception:
+        logger.debug("Failed to read the share fields of session %s", sid, exc_info=True)
+        return None
+    if fields is _SHARE_FIELDS_ABSENT:
+        return None
+    return fields[0]
+
+
