+def _share_source_sidecar(source_session_id: str) -> dict | None:
+    """Read the sidecar that must still own a public snapshot's token.
+
+    The metadata prefix is the normal path. A sidecar written by an
+    exp-v0.52.621..630 build can carry the share keys after ``messages`` (#8830),
+    so fall back to the full file only when the prefix does not expose them.
+    The caller treats every read failure as "not owned": public serving must
+    fail closed when liveness cannot be proven.
+    """
+    sid = str(source_session_id or "").strip()
+    if not sid:
+        return None
+    try:
+        from api import models
+    except Exception:
+        return None
+    if not models.is_safe_session_id(sid):
+        return None
+    session_dir = getattr(models, "SESSION_DIR", None)
+    # Tests and embedders sometimes patch the share module directly; honour an
+    # explicit override there while still following models.SESSION_DIR at
+    # runtime (the share module deliberately has no import-time copy).
+    override = globals().get("SESSION_DIR")
+    if override is not None:
+        session_dir = override
+    if session_dir is None:
+        return None
+    path = session_dir / f"{sid}.json"
+    data = None
+    try:
+        raw = models._read_metadata_json_prefix(path)
+        data = json.loads(raw) if raw else None
+    except FileNotFoundError:
+        return None
+    except Exception:
+        data = None
+    if not isinstance(data, dict) or "share_token" not in data:
+        try:
+            data = json.loads(path.read_text(encoding="utf-8"))
+        except FileNotFoundError:
+            return None
+        except Exception:
+            logger.debug("Failed to read share source sidecar %s", path, exc_info=True)
+            return None
+    if not isinstance(data, dict):
+        return None
+    # A copied/edited sidecar whose own id names another session cannot prove
+    # that this snapshot's source is still alive. Legacy sidecars without an
+    # id are still checked by the token below.
+    sidecar_sid = str(data.get("session_id") or "").strip()
+    if sidecar_sid and sidecar_sid != sid:
+        return None
+    return data
+
+
