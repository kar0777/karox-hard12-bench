+def session_share_token(session_id: str) -> str:
+    """Return the token the session's live sidecar records, or ``""``.
+
+    Public serving is bound to the conversation: a snapshot is readable only
+    while the sidecar it names still exists and still carries that same token.
+    This also closes links orphaned by deletes from before delete revoked, and
+    refuses a snapshot whose session was deleted or re-shared since. The bounded
+    metadata prefix answers the normal case; ``_persisted_share_fields`` falls
+    back to a full parse for a legacy sidecar whose share keys sit after the
+    message body (#8815/#8830).
+    """
+    sid = str(session_id or "").strip()
+    if not sid:
+        return ""
+    try:
+        from api.models import SESSION_DIR, _persisted_share_fields, is_safe_session_id
+    except Exception:
+        logger.debug("Could not load session sidecar helpers for share validation", exc_info=True)
+        return ""
+    if not is_safe_session_id(sid):
+        return ""
+    try:
+        persisted = _persisted_share_fields(SESSION_DIR / f"{sid}.json")
+    except Exception:
+        logger.warning("Failed to read the share token for session %s", sid, exc_info=True)
+        return ""
+    if not isinstance(persisted, tuple):
+        return ""
+    return str(persisted[0] or "").strip()
+
