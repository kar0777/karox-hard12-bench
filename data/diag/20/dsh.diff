+@pytest.mark.parametrize("engine", ["pandas", "polars"])
+def test_backtick_alias_with_space_orders_by_quoted_alias(odd_columns_graph, engine):
+    if engine == "polars":
+        pytest.importorskip("polars")
+    out = odd_columns_graph.gfql(
+        "MATCH (n) RETURN n.id AS `the id` ORDER BY `the id` DESC",
+        engine=engine,
+    )
+
+    assert out._nodes["the id"].to_list() == ["b", "a"]
+
+
 def test_unquoted_identifiers_are_not_quoted():
