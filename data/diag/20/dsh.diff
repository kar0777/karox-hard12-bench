+def _render_order_key_column(order_key: str, available_columns: AbstractSet[str]) -> str:
+    """Render a direct projected column as Cypher source text.
+
+    Order keys are expression text, so an output column that requires backticks
+    (spaces, reserved words, punctuation, escaped backticks) must keep its
+    quoting when used as a direct column reference. Otherwise order_by
+    validation parses the raw column name as an invalid expression.
+    """
+    if order_key in available_columns:
+        return render_cypher_identifier(order_key)
+    return order_key
+
+
