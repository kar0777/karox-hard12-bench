@@ -0,0 +1,126 @@
+import sys
+from types import ModuleType
+from typing import Any, Dict, List
+
+import pandas as pd
+import pytest
+
+import graphistry
+from graphistry.plugins import cugraph as cugraph_plugin
+from graphistry.plugins.cugraph import _reserve_graph_return_endpoints
+
+
+class _CudfLikeFrame(pd.DataFrame):
+    """Match cuDF's rejection of duplicate column names during rename."""
+
+    def rename(self, *args: Any, **kwargs: Any) -> "_CudfLikeFrame":
+        out = super().rename(*args, **kwargs)
+        if out.columns.duplicated().any():
+            raise ValueError("Duplicate column names are not allowed")
+        return out
+
+
+class _FakeCugraphOut:
+    def __init__(
+        self,
+        edges: pd.DataFrame,
+        source_columns: str = "src",
+        destination_columns: str = "dst",
+    ):
+        self._edges = edges
+        self.source_columns = source_columns
+        self.destination_columns = destination_columns
+
+    def view_edge_list(self) -> pd.DataFrame:
+        return self._edges.copy()
+
+
+@pytest.fixture
+def fake_rapids(monkeypatch: pytest.MonkeyPatch) -> None:
+    cudf = ModuleType("cudf")
+    cudf.DataFrame = _CudfLikeFrame
+    cudf.Series = pd.Series
+    cudf.from_pandas = _CudfLikeFrame
+    monkeypatch.setitem(sys.modules, "cudf", cudf)
+
+    cugraph = ModuleType("cugraph")
+    cugraph.k_core = lambda G, **params: G
+    monkeypatch.setitem(sys.modules, "cugraph", cugraph)
+
+
+def _edges_with(extra_columns: List[str]) -> _CudfLikeFrame:
+    data: Dict[str, Any] = {
+        "s": ["a", "b", "c"],
+        "d": ["b", "c", "a"],
+        "weight": [1.0, 2.0, 3.0],
+    }
+    for col in extra_columns:
+        data[col] = [f"{col}-{i}" for i in range(3)]
+    return _CudfLikeFrame(pd.DataFrame(data))
+
+
+def test_reserve_graph_return_endpoints_skips_user_columns() -> None:
+    columns = ["s", "d", "src", "dst", "__cugraph_src_0__", "__cugraph_dst_0__"]
+    source, destination = _reserve_graph_return_endpoints(pd.DataFrame(columns=columns))
+
+    assert source not in columns
+    assert destination not in columns
+    assert source != destination
+
+
+@pytest.mark.parametrize(
+    "extra_columns",
+    [
+        [],
+        ["src"],
+        ["dst"],
+        ["src", "dst"],
+        ["source"],
+        ["target"],
+        ["source", "target"],
+        ["__cugraph_src_0__", "__cugraph_dst_0__"],
+    ],
+)
+def test_graph_return_preserves_edges_with_reserved_endpoint_names(
+    fake_rapids: None,
+    monkeypatch: pytest.MonkeyPatch,
+    extra_columns: List[str],
+) -> None:
+    edges = _edges_with(extra_columns)
+    g = graphistry.edges(edges, "s", "d")
+    out = _FakeCugraphOut(pd.DataFrame({"src": edges["s"], "dst": edges["d"]}))
+    monkeypatch.setattr(cugraph_plugin, "to_cugraph", lambda *args, **kwargs: out)
+
+    first = cugraph_plugin.compute_cugraph_core(g, "k_core")
+    second = cugraph_plugin.compute_cugraph_core(first, "k_core")
+
+    for result in (first, second):
+        assert result._source == "s"
+        assert result._destination == "d"
+        assert list(result._edges.columns) == list(edges.columns)
+        assert result._edges.equals(edges)
+
+    assert list(g._edges.columns) == list(edges.columns)
+    assert g._source == "s"
+    assert g._destination == "d"
+    assert g._edges.equals(edges)
+
+
+def test_graph_return_reserves_names_for_differently_named_user_endpoints(
+    fake_rapids: None,
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    edges = _edges_with(["src", "dst"])
+    g = graphistry.edges(edges, "src", "dst")
+    out = _FakeCugraphOut(
+        pd.DataFrame({"src": edges["src"], "dst": edges["dst"]}),
+        source_columns="source",
+        destination_columns="target",
+    )
+    monkeypatch.setattr(cugraph_plugin, "to_cugraph", lambda *args, **kwargs: out)
+
+    result = cugraph_plugin.compute_cugraph_core(g, "k_core")
+
+    assert result._source == "src"
+    assert result._destination == "dst"
+    assert result._edges.equals(edges)
