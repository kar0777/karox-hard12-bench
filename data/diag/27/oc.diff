+def _reserve_graph_return_endpoints(edges: Any) -> Tuple[str, str]:  # hygiene-ok: explicit-any -- pandas/cuDF/dask edge frame
+    """Pick temporary endpoint names that cannot shadow user edge columns."""
+    from graphistry.compute.util import generate_safe_column_name_from
+
+    occupied = list(edges.columns)
+    source = generate_safe_column_name_from('src', occupied, prefix='__cugraph_', suffix='__', start=0)
+    occupied.append(source)
+    destination = generate_safe_column_name_from('dst', occupied, prefix='__cugraph_', suffix='__', start=0)
+    return source, destination
+
+
+class _CugraphEndpointAlias:
+    """View a cuGraph graph through temporary endpoint column names."""
+
+    def __init__(self, G: Any, source: str, destination: str) -> None:  # hygiene-ok: explicit-any -- wraps a cugraph.Graph
+        self._G = G
+        self.source_columns = source
+        self.destination_columns = destination
+
+    def view_edge_list(self) -> Any:  # hygiene-ok: explicit-any -- pandas/cuDF edge list
+        edges = self._G.view_edge_list()
+        original_source = getattr(self._G, 'source_columns', None)
+        original_destination = getattr(self._G, 'destination_columns', None)
+        rename = {}
+        if isinstance(original_source, str) and original_source in edges.columns:
+            rename[original_source] = self.source_columns
+        elif 'src' in edges.columns:
+            rename['src'] = self.source_columns
+        if isinstance(original_destination, str) and original_destination in edges.columns:
+            rename[original_destination] = self.destination_columns
+        elif 'dst' in edges.columns:
+            rename['dst'] = self.destination_columns
+        return edges.rename(columns=rename) if rename else edges
+
+    def __getattr__(self, name: str) -> Any:  # hygiene-ok: explicit-any -- delegate arbitrary cugraph.Graph attributes
+        return getattr(self._G, name)
+
