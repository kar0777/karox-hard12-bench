+def _rename_endpoints_to_cugraph(self: Plottable) -> DataFrameT:
+    """Rename edge endpoints to cuGraph's 'src'/'dst', moving colliding user columns to generated names"""
+
+    from graphistry.compute.util import generate_safe_column_name_from
+
+    assert self._edges is not None
+    assert self._source is not None
+    assert self._destination is not None
+
+    occupied = list(self._edges.columns)
+    rename: Dict[str, str] = {}
+    for col in self._edges.columns:
+        if col in [TEMP_SRC_CUGRAPH, TEMP_DST_CUGRAPH] and col not in [self._source, self._destination]:
+            reserved = generate_safe_column_name_from(col, occupied, prefix='__cugraph_')
+            occupied.append(reserved)
+            rename[col] = reserved
+    rename[self._source] = TEMP_SRC_CUGRAPH
+    rename[self._destination] = TEMP_DST_CUGRAPH
+    return self._edges.rename(columns=rename)
+
