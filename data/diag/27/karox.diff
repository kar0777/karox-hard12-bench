@@ -0,0 +1,186 @@
+"""cuGraph graph-return endpoint name reservation; fakes keep these tests GPU-free"""
+
+import pytest
+import pandas as pd
+
+import graphistry
+from graphistry.plugins.cugraph import from_cugraph, to_cugraph, compute_cugraph
+
+
+class _FakeCudfFrame(pd.DataFrame):
+    """cuDF-like frame: refuses the duplicate columns cuDF rejects"""
+
+    @property
+    def _constructor(self):
+        return _FakeCudfFrame
+
+    def rename(self, *args, **kwargs):
+        out = super().rename(*args, **kwargs)
+        if out.columns.duplicated().any():
+            raise ValueError('Duplicate column names are not allowed')
+        return out
+
+
+class _FakeCuGraphGraph:
+    """cugraph.Graph stand-in: keeps the edge list and reports its endpoint names"""
+
+    def __init__(self, directed: bool = True):
+        self.directed = directed
+        self.edges_df = None
+        self.source_columns = None
+        self.destination_columns = None
+
+    def from_cudf_edgelist(self, df, source=None, destination=None, **kwargs):
+        self.source_columns = source
+        self.destination_columns = destination
+        self.edges_df = df.rename(columns={source: 'src', destination: 'dst'})
+        return self
+
+    def from_pandas_edgelist(self, df, source=None, destination=None, **kwargs):
+        return self.from_cudf_edgelist(df, source=source, destination=destination, **kwargs)
+
+    def add_nodes_from(self, nodes):
+        return self
+
+    def view_edge_list(self):
+        return self.edges_df[['src', 'dst']].reset_index(drop=True)
+
+
+@pytest.fixture
+def fake_cugraph(monkeypatch):
+    """Install stand-in cudf/cugraph modules so graph-return runs without a GPU"""
+
+    import sys
+    import types
+
+    cudf_mod = types.ModuleType('cudf')
+    cudf_mod.DataFrame = _FakeCudfFrame
+    cudf_mod.Series = pd.Series
+    cudf_mod.from_pandas = _FakeCudfFrame
+    cudf_api_mod = types.ModuleType('cudf.api')
+    cudf_api_types_mod = types.ModuleType('cudf.api.types')
+    cudf_api_types_mod.is_numeric_dtype = pd.api.types.is_numeric_dtype
+    cudf_api_mod.types = cudf_api_types_mod
+    cudf_mod.api = cudf_api_mod
+
+    def subgraph(G, **kwargs):
+        """cuGraph returns a subgraph whose endpoints are reported as src/dst"""
+        out = _FakeCuGraphGraph(directed=G.directed)
+        out.edges_df = G.view_edge_list().iloc[:-1]
+        out.source_columns = 'src'
+        out.destination_columns = 'dst'
+        return out
+
+    cugraph_mod = types.ModuleType('cugraph')
+    cugraph_mod.Graph = _FakeCuGraphGraph
+    cugraph_mod.MultiGraph = _FakeCuGraphGraph
+    cugraph_mod.BiPartiteGraph = _FakeCuGraphGraph
+    cugraph_mod.k_core = subgraph
+
+    for name, mod in [
+        ('cudf', cudf_mod),
+        ('cudf.api', cudf_api_mod),
+        ('cudf.api.types', cudf_api_types_mod),
+        ('cugraph', cugraph_mod),
+    ]:
+        monkeypatch.setitem(sys.modules, name, mod)
+
+    return cugraph_mod
+
+
+def _graph_return_edges(**extra):
+    return _FakeCudfFrame({
+        'a': ['x', 'y', 'z'],
+        'b': ['y', 'z', 'x'],
+        'v': [1, 2, 3],
+        **extra,
+    })
+
+
+@pytest.mark.parametrize('extra', [
+    {},
+    {'src': [10, 20, 30]},
+    {'dst': [40, 50, 60]},
+    {'src': [10, 20, 30], 'dst': [40, 50, 60]},
+    {'source': [1, 2, 3], 'target': [4, 5, 6]},
+])
+def test_graph_return_preserves_topology_and_attributes(fake_cugraph, extra):
+    df = _graph_return_edges(**extra)
+    g = graphistry.edges(df, 'a', 'b')
+
+    out = compute_cugraph(g, 'k_core', directed=False)
+
+    assert out._source == 'a'
+    assert out._destination == 'b'
+    assert list(out._edges.columns) == list(df.columns)
+    assert out._edges.equals(df)
+
+
+@pytest.mark.parametrize('extra', [
+    {},
+    {'src': [10, 20, 30]},
+    {'dst': [40, 50, 60]},
+    {'src': [10, 20, 30], 'dst': [40, 50, 60]},
+])
+def test_graph_return_repeated_calls(fake_cugraph, extra):
+    df = _graph_return_edges(**extra)
+    g = graphistry.edges(df, 'a', 'b')
+
+    out1 = compute_cugraph(g, 'k_core', directed=False)
+    out2 = compute_cugraph(out1, 'k_core', directed=False)
+
+    assert out2._source == 'a'
+    assert out2._destination == 'b'
+    assert list(out2._edges.columns) == list(df.columns)
+    assert out2._edges.equals(df)
+
+
+def test_graph_return_generated_looking_user_names(fake_cugraph):
+    df = _graph_return_edges(**{
+        'src': [10, 20, 30],
+        '__cugraph_src_0__': [11, 21, 31],
+        'dst': [40, 50, 60],
+        '__cugraph_dst_0__': [41, 51, 61],
+    })
+    g = graphistry.edges(df, 'a', 'b')
+
+    out = compute_cugraph(g, 'k_core', directed=False)
+
+    assert list(out._edges.columns) == list(df.columns)
+    assert out._edges.equals(df)
+
+
+def test_graph_return_endpoint_names_bound_as_src_dst(fake_cugraph):
+    df = _FakeCudfFrame({
+        'dst': ['x', 'y', 'z'],
+        'src': ['y', 'z', 'x'],
+        'v': [1, 2, 3],
+    })
+    g = graphistry.edges(df, 'dst', 'src')
+
+    out = compute_cugraph(g, 'k_core', directed=False)
+
+    assert out._source == 'dst'
+    assert out._destination == 'src'
+    assert list(out._edges.columns) == list(df.columns)
+    assert out._edges.equals(df)
+
+
+@pytest.mark.parametrize('extra', [
+    {},
+    {'src': [10, 20, 30]},
+    {'dst': [40, 50, 60]},
+    {'src': [10, 20, 30], 'dst': [40, 50, 60]},
+])
+def test_direct_conversion_controls(fake_cugraph, extra):
+    df = _graph_return_edges(**extra)
+    g = graphistry.edges(df, 'a', 'b')
+
+    G = to_cugraph(g)
+    assert G.source_columns == 'a'
+    assert G.destination_columns == 'b'
+
+    g2 = from_cugraph(g, G, load_nodes=False)
+    assert g2._source == 'a'
+    assert g2._destination == 'b'
+    assert g2._edges[['a', 'b']].equals(df[['a', 'b']])
