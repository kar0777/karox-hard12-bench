+++ b/graphistry/tests/plugins/test_cugraph_graph_return_collisions.py
@@ -0,0 +1,181 @@
+"""Regression coverage for cuGraph graph-return endpoint name collisions.
+
+These tests use small pandas-backed fakes so they exercise the graph-return
+conversion without requiring a GPU. The fake cuDF DataFrame rejects duplicate
+column labels, matching cuDF's behavior that exposed the original failure.
+"""
+
+import sys
+import types
+
+import pandas as pd
+import pytest
+
+import graphistry
+from graphistry.plugins.cugraph import compute_cugraph, from_cugraph, to_cugraph
+
+
+class _FakeCudfFrame(pd.DataFrame):
+    @property
+    def _constructor(self):
+        return _FakeCudfFrame
+
+    def rename(self, *args, **kwargs):
+        result = super().rename(*args, **kwargs)
+        if result.columns.duplicated().any():
+            raise ValueError("Duplicate column names are not allowed")
+        return result
+
+
+class _FakeGraph:
+    def __init__(self, directed=True):
+        self.directed = directed
+        self._edges = None
+        self._source = None
+        self._destination = None
+        self.source_columns = None
+        self.destination_columns = None
+
+    def _load(self, edges_df, source, destination):
+        self._edges = _FakeCudfFrame(edges_df).copy()
+        self._source = source
+        self._destination = destination
+        self.source_columns = source
+        self.destination_columns = destination
+
+    def from_cudf_edgelist(self, edges_df, source=None, destination=None, edge_attr=None):
+        self._load(edges_df, source, destination)
+
+    def from_pandas_edgelist(self, edges_df, source=None, destination=None, edge_attr=None):
+        self._load(edges_df, source, destination)
+
+    def view_edge_list(self):
+        return pd.DataFrame({
+            "src": self._edges[self._source].tolist(),
+            "dst": self._edges[self._destination].tolist(),
+        })
+
+    def add_nodes_from(self, nodes):
+        pass
+
+
+class _FakeMultiGraph(_FakeGraph):
+    pass
+
+
+class _FakeBiPartiteGraph(_FakeGraph):
+    pass
+
+
+def _fake_ego_graph(G, n=None, **kwargs):
+    edges = G.view_edge_list()
+    selected = edges[(edges["src"] == n) | (edges["dst"] == n)].reset_index(drop=True)
+    out = _FakeGraph()
+    out._edges = selected
+    out._source = "src"
+    out._destination = "dst"
+    out.source_columns = "src"
+    out.destination_columns = "dst"
+    return out
+
+
+@pytest.fixture
+def fake_cugraph(monkeypatch):
+    cugraph_module = types.ModuleType("cugraph")
+    cugraph_module.Graph = _FakeGraph
+    cugraph_module.MultiGraph = _FakeMultiGraph
+    cugraph_module.BiPartiteGraph = _FakeBiPartiteGraph
+    cugraph_module.ego_graph = _fake_ego_graph
+
+    cudf_module = types.ModuleType("cudf")
+    cudf_module.DataFrame = _FakeCudfFrame
+    cudf_module.Series = pd.Series
+    cudf_module.from_pandas = lambda df: _FakeCudfFrame(df)
+
+    cudf_api_module = types.ModuleType("cudf.api")
+    cudf_api_types_module = types.ModuleType("cudf.api.types")
+    cudf_api_types_module.is_numeric_dtype = pd.api.types.is_numeric_dtype
+    cudf_api_module.types = cudf_api_types_module
+    cudf_module.api = cudf_api_module
+    cudf_module.__path__ = []
+
+    monkeypatch.setitem(sys.modules, "cugraph", cugraph_module)
+    monkeypatch.setitem(sys.modules, "cudf", cudf_module)
+    monkeypatch.setitem(sys.modules, "cudf.api", cudf_api_module)
+    monkeypatch.setitem(sys.modules, "cudf.api.types", cudf_api_types_module)
+    return cugraph_module
+
+
+CASES = {
+    "baseline": {"s": ["a", "b", "c"], "d": ["b", "c", "a"], "w": [1, 2, 3]},
+    "src": {"s": ["a", "b", "c"], "d": ["b", "c", "a"], "src": [10, 11, 12]},
+    "dst": {"s": ["a", "b", "c"], "d": ["b", "c", "a"], "dst": [20, 21, 22]},
+    "both": {
+        "s": ["a", "b", "c"],
+        "d": ["b", "c", "a"],
+        "src": [10, 11, 12],
+        "dst": [20, 21, 22],
+    },
+    "generated_looking": {
+        "s": ["a", "b", "c"],
+        "d": ["b", "c", "a"],
+        "src": [10, 11, 12],
+        "__cugraph_src_2__": [100, 101, 102],
+    },
+    "generated_looking_both": {
+        "s": ["a", "b", "c"],
+        "d": ["b", "c", "a"],
+        "src": [10, 11, 12],
+        "dst": [20, 21, 22],
+        "__cugraph_src_2__": [100, 101, 102],
+        "__cugraph_dst_2__": [200, 201, 202],
+    },
+    "attributes_before_endpoints": {
+        "w": [1, 2, 3],
+        "src": [10, 11, 12],
+        "s": ["a", "b", "c"],
+        "d": ["b", "c", "a"],
+    },
+}
+
+
+@pytest.mark.parametrize("case", CASES)
+def test_graph_return_preserves_columns_topology_and_attributes(fake_cugraph, case):
+    edges_df = pd.DataFrame(CASES[case])
+    g = graphistry.edges(edges_df, "s", "d")
+
+    out = compute_cugraph(g, "ego_graph", params={"n": "b"})
+
+    expected = edges_df[edges_df["s"].isin(["a", "b"])].reset_index(drop=True)
+    assert out._source == "s"
+    assert out._destination == "d"
+    assert out._edges.columns.tolist() == edges_df.columns.tolist()
+    assert out._edges.reset_index(drop=True).equals(expected)
+
+
+@pytest.mark.parametrize("case", CASES)
+def test_graph_return_is_repeatable(fake_cugraph, case):
+    edges_df = pd.DataFrame(CASES[case])
+    g = graphistry.edges(edges_df, "s", "d")
+
+    out1 = compute_cugraph(g, "ego_graph", params={"n": "b"})
+    out2 = compute_cugraph(out1, "ego_graph", params={"n": "b"})
+
+    expected = edges_df[edges_df["s"].isin(["a", "b"])].reset_index(drop=True)
+    assert out2._source == "s"
+    assert out2._destination == "d"
+    assert out2._edges.columns.tolist() == edges_df.columns.tolist()
+    assert out2._edges.reset_index(drop=True).equals(expected)
+
+
+@pytest.mark.parametrize("case", CASES)
+def test_direct_conversion_controls(fake_cugraph, case):
+    edges_df = pd.DataFrame(CASES[case])
+    g = graphistry.edges(edges_df, "s", "d")
+
+    out = from_cugraph(g, to_cugraph(g), load_nodes=False)
+
+    assert out._source == "s"
+    assert out._destination == "d"
+    assert out._edges.columns.tolist() == edges_df.columns.tolist()
+    assert out._edges.reset_index(drop=True).equals(edges_df)
