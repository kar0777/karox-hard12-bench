+#: The calls that read a file's text, and the ones that read a module's own
+#: text off the imported object.
+_TEXT_READS = frozenset({"read_text", "read_bytes", "readlines", "open"})
+_SOURCE_READS = frozenset({"getsource", "getsourcefile", "getsourcelines", "getsourcefiles"})
+
+
+def _named_by(files: Sequence[str]) -> list[str]:
+    """How a test names one of ``files``: its file name, and the module it is
+    imported as (``vera/smt.py`` -> ``smt.py``, ``vera.smt``)."""
+    names: list[str] = []
+    for path in files:
+        names.append(Path(path).name)
+        names.append(path.removesuffix(".py").replace("/", "."))
+    return names
+
+
+def _call_name(node: ast.Call) -> str:
+    func = node.func
+    return func.attr if isinstance(func, ast.Attribute) else func.id if isinstance(func, ast.Name) else ""
+
+
+def _reads_source(node: ast.AST, source: str, names: Sequence[str],
+                 holder: ast.AST | None = None) -> bool:
+    """Whether ``node`` reads the text of a module ``names`` names: a file
+    read whose path names it, or an ``inspect.getsource`` of it in a test that
+    names it."""
+    if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef)):
+        holder = node
+    if isinstance(node, ast.Call):
+        name = _call_name(node)
+        if name in _TEXT_READS:
+            try:
+                text = ast.unparse(node)
+            except (AttributeError, ValueError):  # a node unparse cannot render
+                text = ""
+            if any(n in text for n in names):
+                return True
+        elif name in _SOURCE_READS:
+            # The test names the module it inspects, and it may do so in an
+            # import above it rather than in the function that reads.
+            for text in (ast.get_source_segment(source, holder) if holder is not None else None,
+                         source):
+                if text is not None and any(n in text for n in names):
+                    return True
+    return any(_reads_source(child, source, names, holder) for child in ast.iter_child_nodes(node))
+
+
+def reads_a_modules_source(source: str, files: Sequence[str]) -> bool:
+    """Whether a test module reading ``source`` reads the text of one of
+    ``files`` (``vera/...py``), a bin's mutated files.
+
+    Inside mutmut's copy that text is the engine's generated file with every
+    mutant inlined, so the test fails there with no mutant active and is no
+    mutant's oracle: ``scripts/mutate_diff.py`` drops it after the run that
+    stops on it, which a diff's handful of changed test files affords, and
+    the sweep — whose oracle is every test file its rule admits, so that one
+    bin may mutate many such modules — leaves it out of the bin's selection
+    up front instead, where dropping it would cost a stats pass a test."""
+    return bool(reading_tests(source, "", files))
+
+
+def _tests_of(tree: ast.Module) -> list[tuple[str, ast.AST]]:
+    """Every test of the module with the id pytest gives it: a module-level
+    ``test_*`` function, or a ``test_*`` method of a top-level class."""
+    found: list[tuple[str, ast.AST]] = []
+    for stmt in tree.body:
+        if isinstance(stmt, ast.FunctionDef) and stmt.name.startswith("test_"):
+            found.append((stmt.name, stmt))
+        elif isinstance(stmt, ast.ClassDef):
+            found += [(f"{stmt.name}::{m.name}", m) for m in stmt.body
+                      if isinstance(m, ast.FunctionDef) and m.name.startswith("test_")]
+    return found
+
+
+def reading_tests(source: str, path: str, files: Sequence[str]) -> list[str]:
+    """The ids of the tests in ``source`` (``path``) that read the text of one
+    of ``files``: the deselects a bin's run needs, one test at a time, so the
+    module's other tests stay its oracle."""
+    names = _named_by(files)
+    if not any(name in source for name in names):
+        return []
+    return [f"{path}::{name}" for name, node in _tests_of(ast.parse(source))
+            if _reads_source(node, source, names)]
+
+
