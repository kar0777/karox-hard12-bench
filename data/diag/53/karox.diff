diff --git a/tests/test_mutation_oracle_roster.py b/tests/test_mutation_oracle_roster.py
new file mode 100644
index 0000000..20f1201
--- /dev/null
+++ b/tests/test_mutation_oracle_roster.py
@@ -0,0 +1,89 @@
+"""A test that reads a mutated module's own text is no mutant's oracle there.
+
+The class: a test that asserts over a `vera/**/*.py` module's text passes in
+the live tree and fails inside mutmut's copy, where the file it reads is
+mutmut's generated one with every mutant inlined.  It cannot kill a mutant of
+the module it reads, and the lane can only learn that by dropping it and
+starting the stats pass again — which a diff's handful of changed test files
+affords and the nightly sweep does not: its oracle is every test file its rule
+admits, so one bin may mutate many such modules, and a bin that met more of
+them than the lane's drop bound stopped the slice before it decided a mutant.
+
+`scripts/mutate_sweep.py`'s `reads_a_modules_source` decides which of a bin's
+admitted tests read the text of a file that bin mutates, and the slice leaves
+them out of its selection up front.  These pin the rule: a file read, an
+`inspect.getsource` of a module the test names, and the negative that matters
+most — a test that merely NAMES a module (a `pytest.mark.matrix(decides=[…])`
+marker, say) is still an oracle and must stay in the selection.
+"""
+
+from __future__ import annotations
+
+import importlib.util
+import sys
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parent.parent
+
+
+def _sweep() -> object:
+    path = ROOT / "scripts" / "mutate_sweep.py"
+    spec = importlib.util.spec_from_file_location("mutate_sweep", path)
+    assert spec is not None and spec.loader is not None
+    module = importlib.util.module_from_spec(spec)
+    sys.modules["mutate_sweep"] = module
+    spec.loader.exec_module(module)
+    return module
+
+
+sw = _sweep()
+
+
+class TestReadsAModulesSource:
+    def test_a_file_read_of_a_mutated_module_is_left_out(self) -> None:
+        source = "def test_x():\n    text = (ROOT / 'vera' / 'smt.py').read_text()\n"
+        assert sw.reads_a_modules_source(source, ["vera/smt.py"]) is True
+
+    def test_a_file_read_of_a_module_this_bin_does_not_mutate_is_no_reason_to_drop_it(self) -> None:
+        source = "def test_x():\n    text = (ROOT / 'vera' / 'smt.py').read_text()\n"
+        assert sw.reads_a_modules_source(source, ["vera/verifier.py"]) is False
+
+    def test_a_module_opened_by_its_dotted_name_is_left_out(self) -> None:
+        source = ("import vera.smt as smt\n\n\ndef test_x():\n"
+                  "    return open(vera.smt.__file__).read()\n")
+        assert sw.reads_a_modules_source(source, ["vera/smt.py"]) is True
+
+    def test_an_inspect_getsource_of_a_mutated_module_is_left_out(self) -> None:
+        source = ("import inspect\nimport vera.smt as smt_mod\n\n\n"
+                  "def test_x():\n    src_file = inspect.getsourcefile(smt_mod)\n")
+        assert sw.reads_a_modules_source(source, ["vera/smt.py"]) is True
+
+    def test_a_marker_that_only_names_a_mutated_module_stays_in_the_selection(self) -> None:
+        """A class instrument names the modules that decide its class and
+        reads none of them; it can still kill their mutants."""
+        source = ("import pytest\n\npytestmark = pytest.mark.matrix(\n"
+                  "    decides=['vera/wasm/context.py', 'vera/smt.py'])\n\n\n"
+                  "def test_x():\n    assert True\n")
+        assert sw.reads_a_modules_source(source, ["vera/wasm/context.py", "vera/smt.py"]) is False
+
+    def test_a_read_of_a_file_the_bin_does_not_mutate_stays(self) -> None:
+        source = ("def test_x():\n"
+                  "    text = (ROOT / 'vera' / 'README.md').read_text()\n"
+                  "    src = (ROOT / 'vera' / 'smt.py').read_text()\n")
+        assert sw.reads_a_modules_source(source, ["vera/verifier.py"]) is False
+        assert sw.reads_a_modules_source(source, ["vera/smt.py"]) is True
+
+    def test_the_reading_test_is_named_and_its_module_s_others_stay(self) -> None:
+        """The deselect is the test, not the module: a module whose other
+        tests exercise the compiler is still the bin's oracle."""
+        source = ("class TestReads:\n"
+                  "    def test_reads(self):\n"
+                  "        return (ROOT / 'vera' / 'smt.py').read_text()\n\n"
+                  "    def test_behaves(self):\n"
+                  "        assert verify('fn f() requires(true) ensures(true) { 1 }')\n\n"
+                  "def test_module_level():\n"
+                  "    return (ROOT / 'vera' / 'smt.py').read_text()\n")
+        assert sw.reading_tests(source, "tests/test_x.py", ["vera/smt.py"]) == [
+            "tests/test_x.py::TestReads::test_reads",
+            "tests/test_x.py::test_module_level",
+        ]
