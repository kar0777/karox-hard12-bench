+    @classmethod
+    def _get_rotation_gates(cls, statement, gate_name, target_basis_set):
+        """Return the decomposition of a rotation gate in the target basis set.
+
+        Args:
+            statement: The rotation gate statement to decompose.
+            gate_name: The rotation gate to emit for the statement.
+            target_basis_set: The target basis set to rebase the module to.
+
+        Returns:
+            list: The rotation itself when the target basis set contains it, and its
+            exact Clifford+T decomposition otherwise.
+        """
+        if gate_name in BASIS_GATE_MAP[target_basis_set]:
+            return [
+                qasm3_ast.QuantumGate(
+                    modifiers=[],
+                    name=qasm3_ast.Identifier(name=gate_name),
+                    arguments=[qasm3_ast.FloatLiteral(value=statement.arguments[0].value)],
+                    qubits=fresh_qubits(*statement.qubits),
+                )
+            ]
+        return cls._get_clifford_t_rotation(statement, gate_name)
+
