+        struct = structs.get(name)
+        if struct is None:
+            continue
+        nested = _block_members(struct)
+        if _has_explicit_placement(nested) or _has_nested_placement(
+            codegen, nested, (*stack, name)
+        ):
+            return True
+    return False
