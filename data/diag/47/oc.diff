+def _has_nested_placement(codegen, members, stack=()):
+    """Whether a struct member of ``members`` carries ``@ offset`` or ``@ align`` at any depth."""
+    structs = getattr(codegen, "struct_declarations", None) or {}
+    for member in members:
+        name = _type_struct_name(_member_tuple(member)[1])
+        if name is None or name in stack:
