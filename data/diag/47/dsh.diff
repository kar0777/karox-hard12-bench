+def resolve_cbuffer_offsets(layout_type):
+    """``layout_type`` with each constant-buffer struct's unplaced members given their packing offsets.
+
+    A nested struct may place some members with ``@ offset`` and leave the rest in declaration order, which
+    ``cbuffer_struct_placements`` cannot lay out directly (HLSL itself does not mix ``packoffset`` with declaration
+    order). The register loader places both by resolving the unplaced members against the previous member first.
+    """
+    kind = layout_type.kind
+    if kind == "array":
+        return replace(
+            layout_type, element=resolve_cbuffer_offsets(layout_type.element)
+        )
+    if kind != "struct":
+        return layout_type
+    members = tuple(
+        (name, resolve_cbuffer_offsets(member))
+        for name, member in layout_type.members
+    )
+    explicit_offsets = layout_type.offsets
+    alignments = layout_type.alignments or (None,) * len(members)
+    if not explicit_offsets and not any(alignments):
+        return replace(layout_type, members=members)
+    if (
+        explicit_offsets
+        and None not in explicit_offsets
+        and not any(alignments)
+    ):
+        return replace(layout_type, members=members)
+    offsets = []
+    cursor = 0
+    for (name, member), explicit, alignment in zip(
+        members, explicit_offsets or (None,) * len(members), alignments
+    ):
+        if explicit is None:
+            start, size = cbuffer_placement(member, cursor)
+            if alignment:
+                start = align_to(start, alignment)
+        else:
+            if explicit < cursor:
+                raise HlslLayoutError(
+                    f"member '{name}' at byte {explicit} overlaps the member before it"
+                )
+            start, size = cbuffer_placement(member, explicit)
+            if start != explicit:
+                raise HlslLayoutError(
+                    f"member '{name}' at byte {explicit} breaks the constant-buffer "
+                    f"packing of its type, which starts at byte {start}"
+                )
+        offsets.append(start)
+        cursor = start + size
+    return replace(layout_type, members=members, offsets=tuple(offsets))
+
+
+def without_explicit_placements(layout_type):
+    """``layout_type`` with every explicit offset and alignment, nested ones included, removed."""
+    kind = layout_type.kind
+    if kind == "array":
+        return replace(
+            layout_type,
+            element=without_explicit_placements(layout_type.element),
+        )
+    if kind == "struct":
+        return replace(
+            layout_type,
+            members=tuple(
+                (name, without_explicit_placements(member))
+                for name, member in layout_type.members
+            ),
+            offsets=(),
+            alignments=(),
+        )
+    return layout_type
