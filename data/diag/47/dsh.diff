+def layout_type_has_explicit_placement(layout_type):
+    """Whether a value, or a struct nested in it, carries an ``offset`` or ``align`` qualifier."""
+    if layout_type.kind == "array":
+        return layout_type_has_explicit_placement(layout_type.element)
+    if layout_type.kind == "struct":
+        if layout_type.offsets or layout_type.alignments:
+            return True
+        return any(
+            layout_type_has_explicit_placement(member)
+            for _name, member in layout_type.members
+        )
+    return False
