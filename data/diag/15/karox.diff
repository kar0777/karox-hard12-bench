+@dataclass(frozen=True)
+class CounterOptions:
+    """Options used to create a :class:`~opentelemetry.metrics.Counter`.
+
+    Instrument creation parameters introduced after the initial release of the
+    metrics API are added as fields of this class. This keeps
+    :meth:`~opentelemetry.metrics.Meter.create_counter_with_options` and the
+    other instrument creation methods forward compatible, because their
+    signatures never need to change for new creation parameters.
+
+    Args:
+        unit: The unit for observations this instrument reports. For
+            example, ``By`` for bytes. UCUM units are recommended.
+        description: A description for this instrument and what it measures.
+        attributes_advisory: Advisory list of the attributes this instrument is
+            expected to report. Implementations that do not support it ignore
+            it.
+    """
+
+    unit: str = ""
+    description: str = ""
+    attributes_advisory: Sequence[str] | None = None
+
+
+@dataclass(frozen=True)
+class UpDownCounterOptions:
+    """Options used to create a :class:`~opentelemetry.metrics.UpDownCounter`.
+
+    See :class:`~opentelemetry.metrics.CounterOptions` for details.
+
+    Args:
+        unit: The unit for observations this instrument reports. For
+            example, ``By`` for bytes. UCUM units are recommended.
+        description: A description for this instrument and what it measures.
+        attributes_advisory: Advisory list of the attributes this instrument is
+            expected to report. Implementations that do not support it ignore
+            it.
+    """
+
+    unit: str = ""
+    description: str = ""
+    attributes_advisory: Sequence[str] | None = None
+
+
+@dataclass(frozen=True)
+class GaugeOptions:
+    """Options used to create a :class:`~opentelemetry.metrics.Gauge`.
+
+    See :class:`~opentelemetry.metrics.CounterOptions` for details.
+
+    Args:
+        unit: The unit for observations this instrument reports. For
+            example, ``By`` for bytes. UCUM units are recommended.
+        description: A description for this instrument and what it measures.
+        attributes_advisory: Advisory list of the attributes this instrument is
+            expected to report. Implementations that do not support it ignore
+            it.
+    """
+
+    unit: str = ""
+    description: str = ""
+    attributes_advisory: Sequence[str] | None = None
+
+
+@dataclass(frozen=True)
+class HistogramOptions:
+    """Options used to create a :class:`~opentelemetry.metrics.Histogram`.
+
+    See :class:`~opentelemetry.metrics.CounterOptions` for details.
+
+    Args:
+        unit: The unit for observations this instrument reports. For
+            example, ``By`` for bytes. UCUM units are recommended.
+        description: A description for this instrument and what it measures.
+        attributes_advisory: Advisory list of the attributes this instrument is
+            expected to report. Implementations that do not support it ignore
+            it.
+        explicit_bucket_boundaries_advisory: Advisory list of bucket boundaries
+            to use for this instrument. Implementations that do not support it
+            ignore it.
+    """
+
+    unit: str = ""
+    description: str = ""
+    attributes_advisory: Sequence[str] | None = None
+    explicit_bucket_boundaries_advisory: Sequence[float] | None = None
+
+
+@dataclass(frozen=True)
+class ObservableCounterOptions:
+    """Options used to create an
+    :class:`~opentelemetry.metrics.ObservableCounter`.
+
+    See :class:`~opentelemetry.metrics.CounterOptions` for details.
+
+    Args:
+        callbacks: A sequence of callbacks that return an iterable of
+            :class:`~opentelemetry.metrics.Observation`. Alternatively, can be a
+            sequence of generators that each yields iterables of
+            :class:`~opentelemetry.metrics.Observation`.
+        unit: The unit for observations this instrument reports. For
+            example, ``By`` for bytes. UCUM units are recommended.
+        description: A description for this instrument and what it measures.
