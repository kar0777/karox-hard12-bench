+# Copyright The OpenTelemetry Authors
+# SPDX-License-Identifier: Apache-2.0
+# type: ignore
+
+# pylint: disable=protected-access
+
+from opentelemetry.metrics import (
+    CounterCreationOptions,
+    CounterOptions,
+    GaugeOptions,
+    HistogramCreationOptions,
+    HistogramOptions,
+    InstrumentCreationOptions,
+    InstrumentOptions,
+    NoOpMeter,
+    ObservableCounterOptions,
+    ObservableGaugeOptions,
+    ObservableUpDownCounterOptions,
+    UpDownCounterOptions,
+)
+
+
+def callback(options):
+    return []
+
+
+def test_option_aliases():
+    for options_type in (
+        CounterOptions,
+        UpDownCounterOptions,
+        ObservableCounterOptions,
+        HistogramOptions,
+        GaugeOptions,
+        ObservableGaugeOptions,
+        ObservableUpDownCounterOptions,
+    ):
+        assert options_type is InstrumentOptions
+
+    assert InstrumentCreationOptions is InstrumentOptions
+    assert CounterCreationOptions is CounterOptions
+    assert HistogramCreationOptions is HistogramOptions
+
+
+def test_synchronous_instruments_with_options():
+    meter = NoOpMeter("test")
+    instrument_options = [
+        (meter.create_counter_with_options, CounterOptions),
+        (meter.create_up_down_counter_with_options, UpDownCounterOptions),
+        (meter.create_histogram_with_options, HistogramOptions),
+        (meter.create_gauge_with_options, GaugeOptions),
+    ]
+
+    for index, (create_instrument, options_type) in enumerate(instrument_options):
+        options = options_type(attributes_advisory=["attribute"])
+        instrument = create_instrument(
+            f"instrument-{index}",
+            options,
+            "unit",
+            "description",
+        )
+        assert instrument._advisory.attributes_advisory == ["attribute"]
+
+        instrument = create_instrument(
+            f"instrument-last-{index}",
+            "unit",
+            "description",
+            options,
+        )
+        assert instrument._advisory.attributes_advisory == ["attribute"]
+
+        instrument = create_instrument(
+            f"instrument-keyword-{index}",
+            unit="unit",
+            description="description",
+            options=options,
+        )
+        assert instrument._advisory.attributes_advisory == ["attribute"]
+
+
+def test_asynchronous_instruments_with_options():
+    meter = NoOpMeter("test")
+    instrument_options = [
+        (meter.create_observable_counter_with_options, ObservableCounterOptions),
+        (meter.create_observable_gauge_with_options, ObservableGaugeOptions),
+        (
+            meter.create_observable_up_down_counter_with_options,
+            ObservableUpDownCounterOptions,
+        ),
+    ]
+
+    for index, (create_instrument, options_type) in enumerate(instrument_options):
+        options = options_type(attributes_advisory=["attribute"])
+        instrument = create_instrument(
+            f"instrument-{index}",
+            options,
+            [callback],
+            "unit",
+            "description",
+        )
+        assert instrument._advisory.attributes_advisory == ["attribute"]
+
+        instrument = create_instrument(
+            f"instrument-last-{index}",
+            [callback],
+            "unit",
+            "description",
+            options,
+        )
+        assert instrument._advisory.attributes_advisory == ["attribute"]
+
+        instrument = create_instrument(
+            f"instrument-keyword-{index}",
+            callbacks=[callback],
+            unit="unit",
+            description="description",
+            options=options,
+        )
+        assert instrument._advisory.attributes_advisory == ["attribute"]
+
+
+def test_histogram_explicit_bucket_boundaries_advisory():
+    meter = NoOpMeter("test")
+    options = HistogramOptions(explicit_bucket_boundaries_advisory=[1.0, 2.0])
+
+    instrument = meter.create_histogram_with_options(
+        "histogram",
+        options,
+        "unit",
+        "description",
+    )
+
+    assert instrument._advisory.explicit_bucket_boundaries == [1.0, 2.0]
+
+
+def test_legacy_methods_accept_options():
+    meter = NoOpMeter("test")
+    options = CounterOptions(attributes_advisory=["attribute"])
+
+    instrument = meter.create_counter("counter", options=options)
+
+    assert instrument._advisory.attributes_advisory == ["attribute"]
