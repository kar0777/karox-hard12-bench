+def test_the_import_title_queue_refuses_a_session_loaded_from_a_copy(store, monkeypatch):
+    """``_queue_generated_title_for_imported_session`` re-loads the session its id names in a
+    background thread. A copy object would therefore retitle the session its body names. Over
+    HTTP the import passes the session it just saved under its own id; this covers a direct
+    caller."""
+    from api import models, routes
+
+    _victim(store)
+    victim_path = store / f"{VICTIM}.json"
+    victim_raw = json.loads(victim_path.read_text(encoding="utf-8"))
+    victim_raw["title"] = "CLI Session"
+    victim_path.write_text(json.dumps(victim_raw, indent=2), encoding="utf-8")
+    _copy(store, partials=False)
+    before = _files(store)
+    started = []
+    generated = []
+
+    class InlineThread:
+        def __init__(self, *, target, daemon, name):
+            self._target = target
+
+        def start(self):
+            started.append(self)
+            self._target()
+
+    monkeypatch.setattr(routes.threading, "Thread", InlineThread)
+    monkeypatch.setattr(
+        routes,
+        "generate_session_title_for_session",
+        lambda current: generated.append(current.session_id) or ("Hijacked by copy", "llm", "raw"),
+    )
+    monkeypatch.setattr(routes, "_sync_session_title_to_insights", lambda session: None)
+    monkeypatch.setattr(routes, "_publish_session_list_changed", lambda *args, **kwargs: None)
+
+    routes._queue_generated_title_for_imported_session(
+        models.Session.load(COPY),
+        {"title": "CLI Session", "source_tag": "cli"},
+    )
+
+    assert started == []
+    assert generated == []
+    assert _files(store) == before
+    assert f"{VICTIM}.json.bak" not in _files(store)
+    assert json.loads(before[f"{VICTIM}.json"])["title"] == "CLI Session"
+
+
+def test_the_wakeup_pause_merge_refuses_a_session_loaded_from_a_copy(store):
+    """``_merge_process_wakeup_pause_into_current_session`` re-resolves the session its id names
+    and saves the pause there. A copy object would stamp the session its body names. Turn
+    admission 404s a copy before either production caller; this covers a direct caller."""
+    from api import models, streaming
+
+    _victim(store)
+    _copy(store, partials=False)
+    before = _files(store)
+
+    recorded = streaming._merge_process_wakeup_pause_into_current_session(
+        models.Session.load(COPY),
+        classification="credential_pool_empty",
+        model="test-model",
+        provider="test-provider",
+    )
+
+    assert recorded is None
+    _unchanged_victim(store, before)
+    assert _files(store) == before
+
+
+def test_the_compression_snapshot_refuses_a_session_loaded_from_a_copy(store, monkeypatch):
+    """``_preserve_pre_compression_snapshot`` re-loads ``old_sid`` and stamps the snapshot fields
+    on it. A copy object whose body id is passed as ``old_sid`` would stamp the session its body
+    names. Compression ownership migration blocks a copy before this helper in production; this
+    covers a direct caller."""
+    from api import models, streaming
+
+    monkeypatch.setattr(streaming, "SESSION_DIR", store)
+    _victim(store)
+    _copy(store, partials=False)
+    before = _files(store)
+    copy_session = models.Session.load(COPY)
+
+    preserved = streaming._preserve_pre_compression_snapshot(
+        copy_session,
+        copy_session.session_id,
+        continuation_sid="continuation-8852",
+    )
+
+    assert preserved is False
+    _unchanged_victim(store, before)
+    assert _files(store) == before
+    assert json.loads(before[f"{VICTIM}.json"]).get("pre_compression_snapshot") is not True
+
+
