+def test_the_imported_title_queue_refuses_a_session_loaded_from_a_copy(store, monkeypatch):
+    """``_queue_generated_title_for_imported_session`` re-loads the session its
+    object's id names in a background thread and saves the title there, so a
+    copy object would retitle the session its body names. The CLI import
+    caller passes the object it just saved under its own id; this covers a
+    direct caller."""
+    from api import models, routes
+
+    _victim(store)
+    victim = models.Session.load(VICTIM)
+    victim.title = "CLI Session"
+    victim.save(touch_updated_at=False)
+    models.SESSIONS.clear()
+    _copy(store, partials=False)
+    before = _files(store)
+
+    class InlineThread:
+        def __init__(self, *, target, daemon, name):
+            self._target = target
+
+        def start(self):
+            self._target()
+
+    monkeypatch.setattr(routes.threading, "Thread", InlineThread)
+    monkeypatch.setattr(
+        routes,
+        "generate_session_title_for_session",
+        lambda session: ("Hijacked by copy", "test", ""),
+    )
+
+    routes._queue_generated_title_for_imported_session(
+        models.get_session(COPY),
+        {"title": "CLI Session", "source_tag": "cli"},
+    )
+
+    assert _files(store) == before
+    assert json.loads(before[f"{VICTIM}.json"])["title"] == "CLI Session"
+
+
+def test_the_wakeup_pause_writer_refuses_a_session_loaded_from_a_copy(store):
+    """``_merge_process_wakeup_pause_into_current_session`` re-resolves the
+    session its object's id names and saves the pause there, so a copy object
+    would stamp the pause on the session its body names. Turn admission refuses
+    a copy before a wakeup can reach this helper; this covers a direct caller."""
+    from api import models, streaming
+
+    _victim(store)
+    _copy(store, partials=False)
+    before = _files(store)
+    session = models.get_session(COPY)
+
+    recorded = streaming._merge_process_wakeup_pause_into_current_session(
+        session,
+        classification="credential_pool_empty",
+        model="test-model",
+        provider="test-provider",
+    )
+
+    assert recorded is None
+    _unchanged_victim(store, before)
+    assert _files(store) == before
+
+
+def test_the_compression_snapshot_writer_refuses_a_session_loaded_from_a_copy(store, monkeypatch):
+    """``_preserve_pre_compression_snapshot`` reloads and saves the old id, so
+    a copy object would stamp the snapshot and continuation fields on the
+    session its body names. The compression migration blocks a copy before this
+    helper; this covers a direct caller."""
+    from api import models, streaming
+
+    _victim(store)
+    _copy(store, partials=False)
+    before = _files(store)
+    monkeypatch.setattr(streaming, "SESSION_DIR", store)
+    session = models.get_session(COPY)
+
+    assert streaming._preserve_pre_compression_snapshot(session, VICTIM) is False
+
+    _unchanged_victim(store, before)
+    assert _files(store) == before
+
+
