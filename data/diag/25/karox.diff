+def test_the_import_title_queue_refuses_a_session_loaded_from_a_copy(store, monkeypatch):
+    """``_queue_generated_title_for_imported_session`` hands the object's id to a thread that
+    reloads the session by that id and saves the generated title there, so a copy object would
+    retitle the session its body names. The CLI import passes the session it just built and saved
+    under its own id; this covers a direct caller."""
+    from api import models, routes
+
+    path = _victim(store)
+    raw = json.loads(path.read_text(encoding="utf-8"))
+    # An imported CLI session still carries the framework placeholder title, which is what the
+    # queue helper looks for on the session it reloads.
+    raw.update(
+        title="CLI Session",
+        source_tag="cli",
+        raw_source="cli",
+        session_source="external_agent",
+        source_label="CLI",
+    )
+    path.write_text(json.dumps(raw, indent=2), encoding="utf-8")
+    _copy(store, partials=False)
+    before = _files(store)
+    generated = []
+
+    class InlineThread:
+        def __init__(self, *, target, daemon, name):
+            self._target = target
+
+        def start(self):
+            self._target()
+
+    monkeypatch.setattr(routes.threading, "Thread", InlineThread)
+    monkeypatch.setattr(
+        routes,
+        "generate_session_title_for_session",
+        lambda session: generated.append(session.session_id) or ("Hijacked by copy", "llm", "raw"),
+    )
+
+    routes._queue_generated_title_for_imported_session(
+        models.get_session(COPY), {"title": "CLI Session", "source_tag": "cli"}
+    )
+
+    assert generated == []
+    assert _files(store) == before
+    victim = json.loads(before[f"{VICTIM}.json"])
+    assert (victim["title"], victim["llm_title_generated"]) == ("CLI Session", False)
+
+
+def test_the_wakeup_pause_merge_refuses_a_session_loaded_from_a_copy(store):
+    """``_merge_process_wakeup_pause_into_current_session`` resolves the CURRENT object for the
+    object's id and saves the pause there, so a copy object would stamp the pause on the session
+    its body names. Turn admission refuses a copy before this runs; this covers a direct caller."""
+    from api import models, streaming
+
+    _victim(store)
+    _copy(store, partials=False)
+    before = _files(store)
+    session = models.get_session(COPY)
+    assert getattr(session, "_sidecar_names_other_session", None) == COPY
+
+    recorded = streaming._merge_process_wakeup_pause_into_current_session(
+        session,
+        classification="credential_pool_empty",
+        model="test-model",
+        provider="test-provider",
+    )
+
+    assert recorded is None
+    _unchanged_victim(store, before)
+    assert _files(store) == before
+
+
+def test_the_compression_snapshot_refuses_a_session_loaded_from_a_copy(store, monkeypatch):
+    """``_preserve_pre_compression_snapshot`` writes the pre-compression snapshot under the id
+    the object carries, reloading that session when the file is already as complete as memory,
+    so a copy object would stamp the snapshot over the session its body names. The compression
+    path blocks a copy before this runs; this covers a direct caller."""
+    from api import models, streaming
+
+    _victim(store)
+    _copy(store, partials=False)
+    before = _files(store)
+    monkeypatch.setattr(streaming, "SESSION_DIR", store)
+    session = models.get_session(COPY)
+    assert getattr(session, "_sidecar_names_other_session", None) == COPY
+
+    preserved = streaming._preserve_pre_compression_snapshot(
+        session, session.session_id, "continuation-8852"
+    )
+
+    assert preserved is False
+    _unchanged_victim(store, before)
+    assert _files(store) == before
+
+
