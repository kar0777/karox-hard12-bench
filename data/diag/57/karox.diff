diff --git a/tests/conftest.py b/tests/conftest.py
new file mode 100644
index 0000000..ad8669c
--- /dev/null
+++ b/tests/conftest.py
@@ -0,0 +1,16 @@
+"""
+Pytest configuration for the test suite.
+
+Some test modules (for example `test_legacy.py`) adjust the global warning filters
+when they are imported so that any warning raised by a test is an error. Those
+filters must not leak into the collection of later test modules, where they turn
+pytest's own collection warnings into errors and abort the run. Reset the filters
+before each module is collected; pytest applies the warning filters it is
+configured with to each test when it runs.
+"""
+
+import warnings
+
+
+def pytest_collectstart(collector):
+    warnings.resetwarnings()
