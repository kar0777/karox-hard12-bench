@@ -45,6 +45,40 @@ CACHES_TTL = 7 * 24 * 60 * 60  # 7 days
 MAX_RETRIES = 4
 
 
+_legacy_cache_lock = threading.Lock()
+_cleaned_cache_dirs: set[Path] = set()
+
+
+def _cleanup_legacy_cache(cache_dir: Path, cache_db: Path) -> None:
+    """Remove the caches written by the pdm versions using hishel < 2.
+
+    Those versions kept the responses in the ``.cache/hishel`` directory and the downloaded
+    files directly under the cache directory, neither of which the SQLite storage can use.
+    It runs at most once per directory and process, so that clients created concurrently
+    don't wipe each other's cache, and never when the current cache is already there.
+    """
+    import shutil
+
+    key = cache_dir.resolve()
+    with _legacy_cache_lock:
+        if key in _cleaned_cache_dirs:
+            return
+        _cleaned_cache_dirs.add(key)
+        if cache_db.is_file() or not cache_dir.is_dir():
+            # The current cache is already there, or there is nothing to clean up.
+            return
+        for entry in cache_dir.iterdir():
+            if entry.is_file() and entry.name.startswith(cache_db.name):
+                continue
+            try:
+                if entry.is_dir() and not entry.is_symlink():
+                    shutil.rmtree(entry, ignore_errors=True)
+                else:
+                    entry.unlink()
+            except OSError:
+                pass
+
