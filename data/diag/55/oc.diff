+def _get_routine_suffix_info(stmt):
+    '''Extract the information contained in the suffix of a Fortran routine
+    statement. A subroutine statement can have a language-binding-spec as its
+    suffix while a function statement can have a language-binding-spec, a
+    result-name or both.
+
+    :param stmt: the fparser2 subroutine or function statement.
+    :type stmt: :py:class:`fparser.two.Fortran2003.Subroutine_Stmt` |
+        :py:class:`fparser.two.Fortran2003.Function_Stmt`
+
+    :returns: a tuple containing the name of the result (or None if there is
+        no result-name) and the language-binding-spec (or None if there is
+        no such specification).
+    :rtype: tuple[Optional[str],
+        Optional[:py:class:`fparser.two.Fortran2003.Language_Binding_Spec`]]
+
+    '''
+    suffix = stmt.children[3]
+    result_name = None
+    bind_spec = None
+    bind_types = (Fortran2003.Language_Binding_Spec,
+                  Fortran2003.Proc_Language_Binding_Spec)
+    if suffix:
+        if isinstance(suffix, bind_types):
+            bind_spec = suffix
+        else:
+            for child in suffix.children:
+                if isinstance(child, bind_types):
+                    bind_spec = child
+                elif child is not None:
+                    # fparser does not always create a Result_Name node for
+                    # the result-name in a Suffix (it can just be a Name).
+                    result_name = child.string
+    return result_name, bind_spec
+
+
