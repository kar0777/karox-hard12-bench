     raise ValueError  # Type not found
 
 
+def _get_routine_binding(stmt):
+    '''Return the BIND(C) information associated with the supplied fparser2
+    routine statement.
+
+    :param stmt: the fparser2 Subroutine_Stmt or Function_Stmt to examine.
+    :type stmt: :py:class:`fparser.two.Fortran2003.Subroutine_Stmt` |
+        :py:class:`fparser.two.Fortran2003.Function_Stmt`
+
+    :returns: whether the routine has a language-binding specification and,
+        if so, the name supplied via a NAME= clause (or None) together with
+        its original textual representation.
+    :rtype: tuple[bool, str | NoneType, str | NoneType]
+
+    '''
+    suffix = stmt.children[3]
+    if not suffix:
+        return False, None, None
+    bindings = walk(suffix, Fortran2003.Language_Binding_Spec)
+    if not bindings:
+        return False, None, None
+    binding = bindings[0]
+    name = None
+    name_text = None
+    if binding.children and binding.children[0] is not None:
+        name_text = binding.children[0].string.strip()
+        name = name_text
+        if (len(name) >= 2 and name[0] == name[-1] and
+                name[0] in "'\""):
+            quote = name[0]
+            name = name[1:-1].replace(quote + quote, quote)
+    return True, name, name_text
+
