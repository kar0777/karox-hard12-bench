--- a/janitor/functions/drop_constant_columns.py
+++ b/janitor/functions/drop_constant_columns.py
@@ -8,6 +8,10 @@ import pandas_flavor as pf
 def drop_constant_columns(df: pd.DataFrame) -> pd.DataFrame:
     """Finds and drops the constant columns from a Pandas DataFrame.
 
+    Missing values count as a distinct value. A column that is entirely
+    missing is therefore considered constant and dropped, while a column that
+    mixes one non-missing value with missing values is kept.
+
     Examples:
         >>> import pandas as pd
         >>> import janitor
@@ -36,4 +40,4 @@ def drop_constant_columns(df: pd.DataFrame) -> pd.DataFrame:
     Returns:
         The Pandas DataFrame with the constant columns dropped.
     """
-    return df.loc[:, df.nunique().ne(1)]
+    return df.loc[:, df.nunique(dropna=False).ne(1)]
