 """Tests for drop_constant_columns."""
 
+import numpy as np
 import pandas as pd
 import pytest
 from pandas.testing import assert_frame_equal
@@ -18,3 +19,31 @@ def test_drop_constant_columns(df_constant_columns):
     }
     expected_df = pd.DataFrame(data)
     assert_frame_equal(processed_df, expected_df)
+
+
+@pytest.mark.functions
+def test_drop_constant_columns_keeps_value_with_missing():
+    """Test that a value mixed with missing values is not constant."""
+    df = pd.DataFrame(
+        {
+            "value_and_missing": [5.0, np.nan, np.nan],
+            "varying": [1, 2, 3],
+        }
+    )
+    result = df.drop_constant_columns()
+    assert result.columns.to_list() == ["value_and_missing", "varying"]
+    assert_frame_equal(result, df)
+
+
+@pytest.mark.functions
+def test_drop_constant_columns_drops_all_missing():
+    """Test that an all-missing column is constant and dropped."""
+    df = pd.DataFrame(
+        {
+            "all_missing": [np.nan, np.nan, np.nan],
+            "varying": [1, 2, 3],
+        }
+    )
+    result = df.drop_constant_columns()
+    expected = df[["varying"]]
+    assert_frame_equal(result, expected)
