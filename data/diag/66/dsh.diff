 """Tests for drop_constant_columns."""
 
+import numpy as np
 import pandas as pd
 import pytest
 from pandas.testing import assert_frame_equal
@@ -18,3 +19,34 @@ def test_drop_constant_columns(df_constant_columns):
     }
     expected_df = pd.DataFrame(data)
     assert_frame_equal(processed_df, expected_df)
+
+
+@pytest.mark.functions
+def test_drop_constant_columns_keeps_value_and_missing():
+    """Keep a column that mixes one value with missing values."""
+    df = pd.DataFrame(
+        {
+            "value_and_missing": [5.0, np.nan, np.nan],
+            "varying": [1, 2, 3],
+        }
+    )
+
+    processed_df = df.drop_constant_columns()
+
+    assert_frame_equal(processed_df, df)
+
+
+@pytest.mark.functions
+def test_drop_constant_columns_drops_all_missing():
+    """Drop a column whose values are all missing."""
+    df = pd.DataFrame(
+        {
+            "all_missing": [np.nan, np.nan, np.nan],
+            "varying": [1, 2, 3],
+        }
+    )
+    expected_df = pd.DataFrame({"varying": [1, 2, 3]})
+
+    processed_df = df.drop_constant_columns()
+
+    assert_frame_equal(processed_df, expected_df)
