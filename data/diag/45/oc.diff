+def _restrict_to_support(rho: np.ndarray, sigma: np.ndarray, tol: float = 1e-12) -> tuple[np.ndarray, np.ndarray]:
+    """Restrict two operators to the support of the first one."""
+    eigvals, eigvecs = np.linalg.eigh((rho + rho.conj().T) / 2)
+    support = eigvals > tol
+    if np.all(support):
+        return rho, sigma
+    basis = eigvecs[:, support]
+    return basis.conj().T @ rho @ basis, basis.conj().T @ sigma @ basis
