+def _restrict_to_support(rho: np.ndarray, sigma: np.ndarray) -> tuple[np.ndarray, np.ndarray]:
+    """Restrict ``rho`` and ``sigma`` to the support of ``rho``."""
+    eigvals, eigvecs = np.linalg.eigh((rho + rho.conj().T) / 2)
+    support = eigvals > 1e-12
+    if np.all(support):
+        return rho, sigma
+    basis = eigvecs[:, support]
+    return basis.conj().T @ rho @ basis, basis.conj().T @ sigma @ basis
+
