index 0000000..5be5b15
--- /dev/null
+++ b/cyclopts/_fromfile.py
@@ -0,0 +1,85 @@
+"""Support for expanding ``@file`` arguments, inspired by :mod:`argparse`."""
+
+from collections.abc import Callable, Iterable
+from pathlib import Path
+
+from cyclopts.exceptions import CycloptsError
+
+
+def default_convert_arg_line_to_args(arg_line: str) -> list[str]:
+    """Convert a single line from an argument file into CLI tokens.
+
+    The default mirrors :meth:`argparse.ArgumentParser.convert_arg_line_to_args`:
+    every line is treated as exactly one argument.
+    """
+    return [arg_line]
+
+
+def expand_args_from_files(
+    args: Iterable[str],
+    prefix_chars: str | None,
+    convert_arg_line_to_args: Callable[[str], Iterable[str]] | None = None,
+) -> list[str]:
+    """Recursively expand arguments that reference files.
+
+    Parameters
+    ----------
+    args:
+        CLI tokens to expand.
+    prefix_chars:
+        Characters that mark the following token as an argument-file path.
+        If empty or :obj:`None`, no expansion is performed.
+    convert_arg_line_to_args:
+        Callable that converts one line from an argument file into zero or
+        more CLI tokens.
+
+    Returns
+    -------
+    list[str]
+        The expanded CLI tokens.
+    """
+    if not prefix_chars:
+        return list(args)
+
+    if convert_arg_line_to_args is None:
+        convert_arg_line_to_args = default_convert_arg_line_to_args
+
+    return _expand_args_from_files(args, prefix_chars, convert_arg_line_to_args)
+
+
+def _expand_args_from_files(
+    args: Iterable[str],
+    prefix_chars: str,
+    convert_arg_line_to_args: Callable[[str], Iterable[str]],
+    seen_paths: tuple[Path, ...] = (),
+) -> list[str]:
+    expanded: list[str] = []
+    for arg in args:
+        if not arg or arg[0] not in prefix_chars:
+            expanded.append(arg)
+            continue
+
+        path = Path(arg[1:])
+        try:
+            resolved_path = path.resolve()
+        except (OSError, RuntimeError):
+            resolved_path = path.absolute()
+
+        if resolved_path in seen_paths:
+            chain = " -> ".join(str(p) for p in (*seen_paths, resolved_path))
+            raise CycloptsError(msg=f"Recursive argument file reference detected: {chain}")
+
+        file_args: list[str] = []
+        for line in path.read_text(encoding="utf-8").splitlines():
+            file_args.extend(convert_arg_line_to_args(line))
+
+        expanded.extend(
+            _expand_args_from_files(
+                file_args,
+                prefix_chars,
+                convert_arg_line_to_args,
+                (*seen_paths, resolved_path),
+            )
+        )
+
+    return expanded
