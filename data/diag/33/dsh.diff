@@ -2097,13 +2117,58 @@ class App:
 
         return command, bound, ignored
 
+    @property
+    def convert_arg_line_to_args(self) -> Callable[[str], Iterable[str]]:
+        """Convert one line from an argument file into CLI tokens.
+
+        This defaults to treating each line as exactly one argument, matching
+        :meth:`argparse.ArgumentParser.convert_arg_line_to_args`. Pass a callable
+        via the ``convert_arg_line_to_args`` constructor argument, assign one to
+        this attribute, or override this method in an :class:`App` subclass.
+        """
+        if self._convert_arg_line_to_args is None:
+            return default_convert_arg_line_to_args
+        return self._convert_arg_line_to_args
+
+    @convert_arg_line_to_args.setter
+    def convert_arg_line_to_args(self, value: Callable[[str], Iterable[str]] | None) -> None:
+        self._convert_arg_line_to_args = value
+
+    def _get_convert_arg_line_to_args(self) -> Callable[[str], Iterable[str]]:
+        """Resolve the argument-line converter from the current app hierarchy."""
+
+        def is_default(converter: Callable[[str], Iterable[str]]) -> bool:
+            return converter is default_convert_arg_line_to_args or (
+                getattr(converter, "__func__", None) is default_convert_arg_line_to_args
+            )
+
+        for app in reversed(self.app_stack.current_frame):
+            converter = app.convert_arg_line_to_args
+            if not is_default(converter):
+                return converter
+
+            meta_app = app
+            while (meta_app := meta_app._meta_parent) is not None:
+                converter = meta_app.convert_arg_line_to_args
+                if not is_default(converter):
+                    return converter
+
+        return default_convert_arg_line_to_args
+
+    def _expand_args_from_files(self, tokens: Iterable[str]) -> list[str]:
+        """Expand argument-file references using the current app hierarchy."""
+        prefix_chars = self.app_stack.resolve("fromfile_prefix_chars")
+        if not prefix_chars:
+            return list(tokens)
+        return expand_args_from_files(tokens, prefix_chars, self._get_convert_arg_line_to_args())
+
     def _normalize_tokens(self, tokens: None | str | Iterable[str]) -> list[str]:
         """Tokenize ``tokens``, reporting a failure like any other parse error.
 
         Must be called inside an :attr:`app_stack` context so error settings resolve.
         """
         try:
-            return normalize_tokens(tokens)
+            return self._expand_args_from_files(normalize_tokens(tokens))
         except CycloptsError as e:
             self._handle_parse_error(e, [])
 
