@@ -0,0 +1,108 @@
+"""Expand command-line arguments from ``@file``-style argument files."""
+
+from collections.abc import Callable, Iterable
+from pathlib import Path
+
+from cyclopts.exceptions import ArgumentFileError
+
+
+def _convert_arg_line_to_args(arg_line: str) -> list[str]:
+    return [arg_line]
+
+
+def _normalize_prefix_chars(prefix_chars: str | Iterable[str] | None) -> str:
+    if not prefix_chars:
+        return ""
+    if isinstance(prefix_chars, str):
+        return prefix_chars
+    return "".join(prefix_chars)
+
+
+def expand_args_from_files(
+    args: Iterable[str],
+    prefix_chars: str | Iterable[str] | None = "@",
+    convert_arg_line_to_args: Callable[[str], Iterable[str]] | None = None,
+    *,
+    encoding: str = "utf-8",
+    _parents: tuple[Path, ...] = (),
+) -> list[str]:
+    """Expand references to argument files in ``args``.
+
+    A token whose first character is one of ``prefix_chars`` is replaced by the
+    arguments read from the file named by the remainder of the token.  By
+    default, each line in the file becomes one argument.  References to files
+    inside argument files are expanded recursively.
+
+    Parameters
+    ----------
+    args: Iterable[str]
+        Arguments to expand.
+    prefix_chars: str | Iterable[str] | None
+        Characters that mark an argument as a file reference.  Set to an empty
+        string or :obj:`None` to disable expansion.
+    convert_arg_line_to_args: Callable[[str], Iterable[str]] | None
+        Hook for converting a line from an argument file into zero or more
+        arguments.  By default, each line is returned unchanged as one
+        argument.
+    encoding: str
+        Encoding used to read argument files.
+    """
+    prefix_chars = _normalize_prefix_chars(prefix_chars)
+    if not prefix_chars:
+        return list(args)
+
+    converter = convert_arg_line_to_args or _convert_arg_line_to_args
+    expanded: list[str] = []
+    for arg in args:
+        if not arg or arg[0] not in prefix_chars:
+            expanded.append(arg)
+            continue
+
+        path = Path(arg[1:]).expanduser()
+        if not path.is_absolute() and _parents:
+            # Match argparse's working-directory behavior, but also make
+            # nested references relative to the file that contains them when
+            # no working-directory match exists.
+            sibling = _parents[-1].parent / path
+            if not path.exists() and sibling.exists():
+                path = sibling
+        try:
+            resolved_path = path.resolve()
+        except OSError:  # pragma: no cover - Path.resolve is very permissive.
+            resolved_path = path.absolute()
+
+        if resolved_path in _parents:
+            chain = " -> ".join(str(x) for x in (*_parents, resolved_path))
+            raise ArgumentFileError(msg=f"Recursive argument file reference detected: {chain}")
+
+        try:
+            contents = path.read_text(encoding=encoding)
+        except (OSError, UnicodeError) as e:
+            raise ArgumentFileError(msg=f'Unable to read argument file "{path}": {e}') from e
+
+        file_args: list[str] = []
+        for line in contents.splitlines():
+            converted = converter(line)
+            if converted is None:
+                continue
+            if isinstance(converted, str):
+                converted = [converted]
+            file_args.extend(converted)
+
+        expanded.extend(
+            expand_args_from_files(
+                file_args,
+                prefix_chars,
+                converter,
+                encoding=encoding,
+                _parents=(*_parents, resolved_path),
+            )
+        )
+
+    return expanded
+
+
+read_args_from_files = expand_args_from_files
+_read_args_from_files = expand_args_from_files
+
+
