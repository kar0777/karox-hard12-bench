 from cyclopts._convert import _bool, _none, create_empty_instance
@@ -63,6 +64,66 @@ def normalize_tokens(tokens: None | str | Iterable[str]) -> list[str]:
     return tokens
 
 
+def _default_convert_arg_line_to_args(arg_line: str) -> list[str]:
+    """Default :attr:`App.convert_arg_line_to_args`; every line is a single argument."""
+    return [arg_line]
+
+
+def expand_args_from_files(
+    tokens: Iterable[str],
+    prefix_chars: str,
+    convert_arg_line_to_args: Callable[[str], Iterable[str]] = _default_convert_arg_line_to_args,
+) -> list[str]:
+    """Replace ``@file`` tokens with the arguments contained in ``file``.
+
+    Parameters
+    ----------
+    tokens: Iterable[str]
+        CLI tokens to expand.
+    prefix_chars: str
+        Characters that, when they start a token, mark the remainder of the token as a filename.
+        An empty string disables expansion.
+    convert_arg_line_to_args: Callable[[str], Iterable[str]]
+        Converts a single (non-blank) line of an argument file into tokens.
+        Defaults to one argument per line.
+
+    Returns
+    -------
+    list[str]
+        ``tokens`` with every argument-file reference expanded in-place.
+
+    Raises
+    ------
+    CycloptsError
+        If a referenced file cannot be read, or references itself.
+    """
+    if not prefix_chars:
+        return list(tokens)
+
+    def _expand(tokens: Iterable[str], chain: tuple[Path, ...]) -> list[str]:
+        expanded: list[str] = []
+        for token in tokens:
+            if not token or token[0] not in prefix_chars:
+                expanded.append(token)
+                continue
+
+            path = Path(token[1:])
+            if path in chain:
+                raise CycloptsError(msg=f'Recursive argument file reference "{path}".')
+            try:
+                contents = path.read_text(encoding="utf-8")
+            except (OSError, UnicodeDecodeError) as e:
+                raise CycloptsError(msg=f'Unable to read argument file "{path}": {e}.') from e
+
+            file_tokens = [
+                arg for line in contents.splitlines() if line.strip() for arg in convert_arg_line_to_args(line)
+            ]
+            expanded.extend(_expand(file_tokens, (*chain, path)))
+        return expanded
+
+    return _expand(tokens, ())
+
+
 class _ProbeResult(NamedTuple):
     """Result of :func:`_probe_unclaimed`."""
 
