diff --git a/tests/test_arg_files.py b/tests/test_arg_files.py
new file mode 100644
index 0000000..b75074d
--- /dev/null
+++ b/tests/test_arg_files.py
@@ -0,0 +1,140 @@
+import shlex
+
+import pytest
+
+from cyclopts import App, CycloptsError
+
+
+@pytest.fixture
+def arg_app():
+    app = App(fromfile_prefix_chars="@", exit_on_error=False, print_error=False, result_action="return_value")
+
+    @app.command
+    def run(host: str, port: int, description: str = ""):
+        return host, port, description
+
+    return app
+
+
+def test_arg_file_expanded_in_place(tmp_path, arg_app):
+    (tmp_path / "run.args").write_text("--host\ndb.example.internal\n--port\n5432\n")
+
+    assert arg_app(["run", "@run.args"]) == ("db.example.internal", 5432, "")
+
+
+def test_arg_file_can_supply_command(tmp_path, arg_app):
+    (tmp_path / "run.args").write_text("run\n--host\ndb.example.internal\n--port\n5432\n")
+
+    assert arg_app(["@run.args"]) == ("db.example.internal", 5432, "")
+
+
+def test_arg_file_multi_word_line_is_a_single_argument(tmp_path, arg_app):
+    (tmp_path / "run.args").write_text("run\n--host\nlocalhost\n--port\n5432\n--description\nnightly integration run\n")
+
+    assert arg_app(["@run.args"]) == ("localhost", 5432, "nightly integration run")
+
+
+def test_blank_lines_are_skipped(tmp_path, arg_app):
+    (tmp_path / "run.args").write_text("run\n\n--host\nlocalhost\n   \n--port\n5432\n")
+
+    assert arg_app(["@run.args"]) == ("localhost", 5432, "")
+
+
+def test_nested_arg_files(tmp_path, arg_app):
+    (tmp_path / "nested.args").write_text("--port\n5432\n")
+    (tmp_path / "run.args").write_text(f"run\n--host\nlocalhost\n@{tmp_path / 'nested.args'}\n")
+
+    assert arg_app(["@run.args"]) == ("localhost", 5432, "")
+
+
+def test_disabled_by_default(tmp_path):
+    (tmp_path / "run.args").write_text("run\n")
+    app = App(exit_on_error=False, print_error=False)
+
+    @app.command
+    def run():
+        pass
+
+    with pytest.raises(CycloptsError):
+        app.parse_args(["@run.args"])
+
+
+def test_missing_arg_file(arg_app):
+    with pytest.raises(CycloptsError, match="Unable to read argument file"):
+        arg_app.parse_args(["@does-not-exist.args"])
+
+
+def test_missing_arg_file_prints_and_exits(console):
+    app = App(fromfile_prefix_chars="@", error_console=console)
+
+    @app.command
+    def run():
+        pass
+
+    with console.capture() as capture, pytest.raises(SystemExit) as e:
+        app(["@does-not-exist.args"])
+
+    assert e.value.code == 2
+    assert "Unable to read argument file" in capture.get()
+
+
+def test_recursive_arg_file_reference(arg_app, tmp_path):
+    (tmp_path / "a.args").write_text(f"@{tmp_path / 'b.args'}\n")
+    (tmp_path / "b.args").write_text(f"@{tmp_path / 'a.args'}\n")
+
+    with pytest.raises(CycloptsError, match="Recursive argument file reference"):
+        arg_app.parse_args([f"@{tmp_path / 'a.args'}"])
+
+
+def test_convert_arg_line_to_args(tmp_path):
+    def convert_arg_line_to_args(line: str) -> list[str]:
+        if not line.strip() or line.startswith("#"):
+            return []
+        return shlex.split(line)
+
+    (tmp_path / "run.args").write_text("# a comment\nrun --host localhost --port 5432\n")
+    app = App(
+        fromfile_prefix_chars="@",
+        convert_arg_line_to_args=convert_arg_line_to_args,
+        exit_on_error=False,
+        print_error=False,
+        result_action="return_value",
+    )
+
+    @app.command
+    def run(host: str, port: int):
+        return host, port
+
+    assert app(["@run.args"]) == ("localhost", 5432)
+
+
+def test_multiple_prefix_chars(tmp_path, arg_app):
+    (tmp_path / "run.args").write_text("run\n--host\nlocalhost\n--port\n5432\n")
+
+    arg_app.fromfile_prefix_chars = "@+"
+
+    assert arg_app([f"+{tmp_path / 'run.args'}"]) == ("localhost", 5432, "")
+
+
+def test_arg_file_inherited_by_subcommand(tmp_path):
+    app = App(fromfile_prefix_chars="@", exit_on_error=False, print_error=False, result_action="return_value")
+    sub_app = App(name="sub")
+
+    @sub_app.default
+    def sub(value: int):
+        return value
+
+    app.command(sub_app)
+    (tmp_path / "sub.args").write_text("sub\n7\n")
+
+    assert app(["@sub.args"]) == 7
+
+
+def test_arg_file_used_by_parse_known_args(tmp_path, arg_app):
+    (tmp_path / "run.args").write_text("run\n--host\nlocalhost\n--port\n5432\n")
+
+    command, bound, unused_tokens, _ = arg_app.parse_known_args(["@run.args"])
+
+    assert command is arg_app["run"].default_command
+    assert bound.args == ("localhost", 5432)
+    assert unused_tokens == []
