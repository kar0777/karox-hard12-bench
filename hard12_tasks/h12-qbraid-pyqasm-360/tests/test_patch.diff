+    """Barriers inside a loop or switch must be visible before unroll() (issue #354)."""
+    qasm_str = """OPENQASM 3.0;
+    include "stdgates.inc";
+    qubit[2] q;
+    for int i in [0:1] { h q[i]; barrier q; }
+    """
+    expected_qasm = """OPENQASM 3.0;
+    include "stdgates.inc";
+    qubit[2] q;
+    h q[0];
+    h q[1];
+    """
