+    }
+    assert (
+        cfg._available_models_cache is None
+        or cfg._available_models_cache != expected_fallback
+    )
+
+    deadline = time.monotonic() + 3.0
+    while time.monotonic() < deadline:
+        if cfg._available_models_cache == live_result:
+            break
+        time.sleep(0.01)
