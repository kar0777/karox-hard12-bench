+def _checkpoint_payload():
+    """The payload ``_save_diary_direct`` hands the detached checkpoint child."""
+    return {
+        "entry": "CHECKPOINT:2026-09-29|msgs:3",
+        "agent_name": "claude",
+        "topic": "checkpoint",
+        "wing": "wing_project",
+        "messages_folded": 3,
+        "session_id": "sess1",
+        "exchange_count": 3,
+        "ack_ts": "2026-09-29T00:00:00Z",
