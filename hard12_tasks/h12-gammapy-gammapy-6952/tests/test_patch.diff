     integral = np.sum(model.map.data * solid_angle, axis=-1)
 
     assert_allclose(integral, [1.0, 1.0])
+
+
+def test_piecewise_spatial_model_to_dict_big_endian():
+    geom = WcsGeom.create(skydir=(0, 0), npix=(2, 2), binsz=0.3, frame="galactic")
+    footprint = MapCoord.create(geom.footprint)
+    coords = MapCoord.create(
+        {
+            "lon": np.asarray(footprint["lon"], dtype=">f8") * u.deg,
+            "lat": np.asarray(footprint["lat"], dtype=">f8") * u.deg,
+        },
+        frame="galactic",
+    )
+    model = PiecewiseNormSpatialModel(coords, frame="galactic")
+
+    data = model.to_dict()["spatial"]
+
+    assert_allclose(data["lon"]["data"], model.coords["lon"].value)
+    assert_allclose(data["lat"]["data"], model.coords["lat"].value)
diff --git a/gammapy/modeling/models/tests/test_spectral.py b/gammapy/modeling/models/tests/test_spectral.py
index 9bd9e7479a..13546c36a7 100644
--- a/gammapy/modeling/models/tests/test_spectral.py
+++ b/gammapy/modeling/models/tests/test_spectral.py
@@ -1598,3 +1598,46 @@ def test_bpl_evalaute_array():
         np.ones(3) * 0.5 * u.TeV,
     )
     assert values.shape == (2, 3)
+
+
+def _big_endian(values):
+    return np.asarray(values, dtype=">f8")
+
+
+@pytest.mark.parametrize(
+    ("model_class", "kwargs"),
+    [
+        (
+            TemplateSpectralModel,
+            dict(
+                energy=_big_endian([1, 3, 10]) * u.TeV,
+                values=_big_endian([1e-11, 3e-12, 5e-13]) * u.Unit("cm-2 s-1 TeV-1"),
+            ),
+        ),
+        (
+            PiecewiseNormSpectralModel,
+            dict(
+                energy=_big_endian([1, 3, 10]) * u.TeV,
+                norms=_big_endian([1, 2, 3]) * u.Unit(""),
+            ),
+        ),
+        (
+            EBLAbsorptionNormSpectralModel,
+            dict(
+                energy=_big_endian([1, 2, 3]) * u.keV,
+                param=_big_endian([0, 1]) * u.Unit(""),
+                data=u.Quantity(np.ones((2, 3)), ""),
+                redshift=0.5,
+                alpha_norm=1,
+            ),
+        ),
+    ],
+    ids=["template", "piecewise_norm", "ebl_absorption_norm"],
+)
+def test_to_dict_big_endian(model_class, kwargs):
+    model = model_class(**kwargs)
+    data = model.to_dict()["spectral"]
+
+    assert_allclose(data["energy"]["data"], model.energy.value)
+    new_model = model_class.from_dict({"spectral": data})
+    assert_allclose(new_model.energy, model.energy)
