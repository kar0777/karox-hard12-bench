+
+
+@pytest.mark.parametrize(
+    ("filename", "content", "namespace"),
+    [
+        pytest.param(
+            "tox.toml",
+            'env_list = ["a"]\n[env_run_base]\nskip_install = true\ncommands = [["python"]]\n',
+            "env_run_base",
+            id="toml",
+        ),
+        pytest.param(
+            "tox.ini",
+            "[tox]\nenv_list = a\n[testenv]\nskip_install = true\ncommands = python\n",
