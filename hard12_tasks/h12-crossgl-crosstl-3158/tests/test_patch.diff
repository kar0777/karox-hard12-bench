+            ],
+        ),
+        ("work_group_barrier(0)", ["workgroupExecutionBarrier();"]),
+        (
+            "barrier(mask)",
+            ["allMemoryBarrier();", "workgroupBarrier();", "allMemoryBarrier();"],
