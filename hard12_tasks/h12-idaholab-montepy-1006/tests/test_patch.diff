+    def test_get_by_comment(self, read_simple_problem):
+        by_text_generator = read_simple_problem.cells.get_by_comment("hidden vertical")
+        assert isinstance(by_text_generator, Generator)
+        by_text = list(by_text_generator)
+        assert by_text == [read_simple_problem.cells[1]]
+
+        by_regex = list(
+            read_simple_problem.cells.get_by_comment(re.compile(r"HIDDEN", re.I))
+        )
+        assert by_regex == [read_simple_problem.cells[1]]
+
+        by_bytes_regex = list(
+            read_simple_problem.cells.get_by_comment(re.compile(b"hidden"))
+        )
+        assert by_bytes_regex == [read_simple_problem.cells[1]]
+
+        assert list(read_simple_problem.cells.get_by_comment("not present")) == []
+
+        with pytest.raises(TypeError):
+            list(read_simple_problem.cells.get_by_comment(5))
+
