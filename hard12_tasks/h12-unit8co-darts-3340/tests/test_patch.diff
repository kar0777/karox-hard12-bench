+        model = FourTheta(
+            model_mode=ADDITIVE,
+            trend_mode=LINEAR,
+            season_mode=ADDITIVE,
+            normalization=False,
+        )
+        with caplog.at_level(logging.WARNING):
+            model.fit(sine_series)
+            assert "Fallback to additive and linear model" not in caplog.text
+        caplog.clear()
