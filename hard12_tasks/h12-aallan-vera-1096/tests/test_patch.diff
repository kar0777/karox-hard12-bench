@@ -1096,6 +1249,18 @@ def test_reverse_of_reverse_typevar_pin(self) -> None:
   let @Array<Int> = array_reverse(array_reverse([10, 20, 30]));
   @Array<Int>.0[0]
 }
+"""
+        assert _run(src, fn="g") == 10
+
